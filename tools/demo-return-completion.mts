 const session=f.receiving.open(f.operator.scope,{request_id:f.request.id,location_id:'warehouse-one'}),scan=f.receiving.scan(f.operator.scope,{session_id:session.session_id,scan_id:'demo-scan',expected_revision:0,items:[{line_id:'alpha',observed_variant:'shirt-small',quantity:1,grade:'sellable',evidence_ids:[]},{line_id:'beta',observed_variant:'hat-small',quantity:1,grade:'damaged',evidence_ids:[]},{line_id:'gamma',observed_variant:'shoe-small',quantity:1,grade:'sellable',evidence_ids:[]}]});
