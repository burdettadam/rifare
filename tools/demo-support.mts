import{createSupportDemo}from'../packages/development/support-demo.mts';import{startCommerceServer}from'../apps/commerce-api/server.mts';import{mkdtempSync,writeFileSync,rmSync}from'node:fs';import{join}from'node:path';import{tmpdir}from'node:os';
if(process.argv.length>3||process.argv.length===3&&process.argv[2]!=='--serve')throw new Error('Use no arguments or --serve');const f=createSupportDemo();try{if(process.argv.includes('--serve')){const directory=mkdtempSync(join(tmpdir(),'rifare-support-')),sessionFile=join(directory,'sessions.json');const server=await startCommerceServer({kernel:f.kernel,caps:f.caps,simulator:f.simulator,customers:f.customers,reads:f.reads,support:f.support});writeFileSync(sessionFile,JSON.stringify({operator:f.operator.token,reviewer:f.reviewer.token,owner:f.owner.token,customer:f.customer.token,case_id:'support_case',skills:f.skills},null,2),{mode:0o600});console.log(JSON.stringify({url:server.url+'/support',tracking:server.url+'/tracking',session_file:sessionFile,profile:'synthetic_only',external_calls:0},null,2));await new Promise<void>(resolve=>{process.once('SIGINT',resolve);process.once('SIGTERM',resolve);});await server.close();rmSync(directory,{recursive:true,force:true});}
 else{const tracking=f.support.workflows.complete(f.operator.scope,'support_case','shipment-assistance',f.skills['shipment-assistance'],'initial_status');const returned=f.approvedReturn();const mail=f.support.delivery.queue(f.operator.scope,f.message());f.source.fault='after';const unknown=await f.support.delivery.dispatch(f.operator.scope,mail.operation_id);f.source.fault='none';const reconciled=await f.support.delivery.reconcile(f.operator.scope,mail.operation_id);f.support.ownership.assign(f.owner.scope,{case_id:'support_case',expected_generation:1,actor_id:'agent'});const preTakeover=f.support.workflows.context(f.agent.scope,{case_id:'support_case',workflow:'support-reply',skill_digest:f.skills['support-reply']});f.support.ownership.takeover(f.operator.scope,{case_id:'support_case',expected_generation:2,reason:'provider_unavailable'});f.stopModel();let lateDenied=false;try{f.support.workflows.answer(f.agent.scope,{case_id:'support_case',workflow:'support-reply',skill_digest:f.skills['support-reply'],context_digest:preTakeover.context_digest,fact_ids:[],handling:'handoff',request_id:'late'});}catch{lateDenied=true;}const manual=f.support.workflows.complete(f.operator.scope,'support_case','support-reply',f.skills['support-reply'],'manual_after_stop');console.log(JSON.stringify({profile:'synthetic_only',tracking:tracking.text,return_request_id:returned.request.id,return_approved:!!returned.receipt.return_request_id,refund_executed:false,message_before_reconciliation:unknown.state,message_after_reconciliation:reconciled.state,customer_delivery_confirmed:reconciled.customer_delivered,synthetic_source_messages:f.sourceDb.prepare('SELECT count(*) n FROM support_source_effects').get().n,late_agent_output_rejected:lateDenied,model_disabled_manual_status:manual.status,history_complete:f.support.context(f.operator.scope,'support_case').history.history_complete,external_calls:0},null,2));}}
finally{f.cleanup();}
