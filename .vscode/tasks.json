{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rifare: verify starter",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/verify.py"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "tools/verify.py"
        ]
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Rifare: render goals",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/render_plan.py",
        "--root",
        "."
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "tools/render_plan.py",
          "--root",
          "."
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Rifare: start explicit smoke profile",
      "type": "process",
      "command": "node",
      "args": [
        "--experimental-strip-types",
        "tools/dev-smoke.mts"
      ],
      "problemMatcher": []
    },
    {
      "label": "Rifare: stop this smoke instance",
      "type": "process",
      "command": "node",
      "args": [
        "--experimental-strip-types",
        "tools/dev-stop.mts"
      ],
      "problemMatcher": []
    },
    {
      "label": "Rifare: verify including runtime smoke",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/verify.py",
        "--runtime"
      ],
      "problemMatcher": []
    }
  ]
}
