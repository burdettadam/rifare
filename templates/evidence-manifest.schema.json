{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed ready-for-review commerce goal evidence",
  "description": "Structural format only. Review authenticity, artifact hashes, native report provenance and observed effects require trusted independent validation.",
  "type": "object",
  "required": [
    "schema_version",
    "goal_id",
    "status",
    "candidate_sha",
    "base_sha",
    "source_tree_sha256",
    "build_sha256",
    "configuration_digest",
    "environment",
    "pins",
    "commands",
    "test_results",
    "artifacts",
    "red_green_evidence",
    "independent_review_references"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "ready_for_review"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^M[0-9]{2}-G[0-9]{2}$"
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "source_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_digest": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "required": [
        "class",
        "versions"
      ],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "versions": {
          "type": "object"
        }
      }
    },
    "pins": {
      "type": "object"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "argv",
          "cwd",
          "exit_code",
          "native_report_path",
          "native_report_sha256"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "native_report_path": {
            "type": "string"
          },
          "native_report_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "test_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "runner_case_id",
          "status",
          "evidence_path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "runner_case_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "not_run"
            ]
          },
          "evidence_path": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "red_green_evidence": {
      "type": "string",
      "minLength": 1
    },
    "independent_review_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trusted_acceptance_reference": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
