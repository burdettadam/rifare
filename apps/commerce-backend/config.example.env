# Copy to .env in this directory; keep it out of Git.
RIFARE_COMMERCE_PROFILE=local-medusa
NODE_ENV=development
DATABASE_URL=postgresql://rifare:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/rifare_commerce
RIFARE_WEB_ORIGIN=http://127.0.0.1:9000
RIFARE_HMR_PORT=9001
# Generate two independent random values of at least 32 characters.
JWT_SECRET=
COOKIE_SECRET=
MEDUSA_DISABLE_TELEMETRY=true
MEDUSA_FF_ANALYTICS=false

# Optional external customer identity: see docs/EXTERNAL-CUSTOMER-IDENTITY.md.
# Leave unset until a real client and provider login/consent UI are configured.
# RIFARE_IDENTITY_PROVIDER=supabase
# RIFARE_OIDC_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1
# RIFARE_OIDC_CLIENT_ID=YOUR-RIFARE-CLIENT-ID
# RIFARE_OIDC_CLIENT_SECRET=YOUR-PRIVATE-CONFIDENTIAL-CLIENT-SECRET
# RIFARE_OIDC_SIGNING_ALG=RS256
# RIFARE_OIDC_CALLBACK_URL=http://127.0.0.1:9000/auth/customer/external-oidc/callback

# Optional persisted-cart observation; both values are required together.
# This namespace is deployment configuration, not an ElevenID organization claim.
# RIFARE_MERCHANT_NAMESPACE=local-merchant
# RIFARE_NATIVE_STORE_ID=store_YOUR_NATIVE_STORE_ID

# Optional private key for the internal local journal. Use 32 random bytes
# encoded as canonical base64url. Preserve it with the installation privacy state.
# RIFARE_JOURNAL_PRIVACY_KEY=
# Native Medusa user assigned to the internal privacy operations.
# RIFARE_JOURNAL_PRIVACY_OPERATOR_ID=
