# Copy to .env in this directory; keep it out of Git.
RIFARE_COMMERCE_PROFILE=local-medusa
NODE_ENV=development
DATABASE_URL=postgresql://rifare:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/rifare_commerce
RIFARE_WEB_ORIGIN=http://127.0.0.1:9000
RIFARE_HMR_PORT=9001
# Generate two independent random values of at least 32 characters.
JWT_SECRET=
COOKIE_SECRET=
MEDUSA_DISABLE_TELEMETRY=true
MEDUSA_FF_ANALYTICS=false
