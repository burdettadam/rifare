      ],
      "checks": [
        {
          "name": "rifare_operation_original_uuid",
          "expression": "original_command_uuid ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'",
          "definition": "check ((original_command_uuid ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'))"
        },
        {
          "name": "rifare_operation_revision",
          "expression": "revision >= 0",
          "definition": "check ((revision >= 0))"
        },
        {
          "name": "rifare_operation_no_soft_delete",
          "expression": "deleted_at is null",
          "definition": "check ((deleted_at is null))"
        },
        {
          "name": "rifare_operation_challenge_digest",
          "expression": "challenge_fingerprint ~ '^sha256:[0-9a-f]{64}$'",
          "definition": "check ((challenge_fingerprint ~ '^sha256:[0-9a-f]{64}$'))"
        },
        {
          "name": "rifare_operation_first_observation_pair",
          "expression": "(first_observation_digest is null) = (first_observed_at is null)",
          "definition": "check (((first_observation_digest is null) = (first_observed_at is null)))"
        },
        {
          "name": "rifare_operation_start_owner",
          "expression": "start_owner_digest ~ '^sha256:[0-9a-f]{64}$'",
          "definition": "check ((start_owner_digest ~ '^sha256:[0-9a-f]{64}$'))"
        },
        {
          "name": "rifare_operation_start_claim",
          "expression": "start_claimed_at is null or start_owner_digest is not null",
          "definition": "check ((start_claimed_at is null or start_owner_digest is not null))"
        },
        {
          "name": "rifare_operation_start_bytes",
          "expression": "(start_command_bytes is null) = (start_command_digest is null) and (start_command_bytes is null) = (start_correlation is null)",
          "definition": "check (((start_command_bytes is null) = (start_command_digest is null) and (start_command_bytes is null) = (start_correlation is null)))"
        },
        {
          "name": "rifare_operation_start_digest",
          "expression": "start_command_digest ~ '^sha256:[0-9a-f]{64}$'",
          "definition": "check ((start_command_digest ~ '^sha256:[0-9a-f]{64}$'))"
        },
        {
          "name": "rifare_operation_start_response",
          "expression": "(start_response_bytes is null) = (start_response_digest is null) and (start_response_bytes is null) = (start_response_observed_at is null)",
          "definition": "check (((start_response_bytes is null) = (start_response_digest is null) and (start_response_bytes is null) = (start_response_observed_at is null)))"
        },
        {
          "name": "rifare_operation_start_response_digest",
