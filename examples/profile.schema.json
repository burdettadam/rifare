{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed merchant profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "base_skill",
    "platform_pack",
    "locale",
    "returns",
    "authority",
    "secrets"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "base_skill": {
      "const": "handle-return@0.1.0"
    },
    "platform_pack": {
      "enum": [
        "shopify@0.1.0",
        "woocommerce@0.1.0"
      ]
    },
    "locale": {
      "type": "string"
    },
    "tone": {
      "enum": [
        "concise",
        "warm",
        "formal"
      ]
    },
    "returns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_days",
        "excluded_tags",
        "evidence_reasons",
        "outcomes",
        "review_above_minor",
        "currency"
      ],
      "properties": {
        "window_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365
        },
        "excluded_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "refund",
              "store_credit",
              "variant_exchange"
            ]
          }
        },
        "review_above_minor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autonomy",
        "platform_capabilities_override",
        "publish_requires_human"
      ],
      "properties": {
        "autonomy": {
          "enum": [
            "read_only",
            "approval_required"
          ]
        },
        "platform_capabilities_override": {
          "const": false
        },
        "publish_requires_human": {
          "const": true
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^secret-ref:"
      }
    }
  }
}
