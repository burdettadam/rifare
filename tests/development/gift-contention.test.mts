import test from 'node:test';import assert from 'node:assert/strict';import {spawn} from 'node:child_process';import {usingGift} from './gift-helpers.mts';
test('M06-G05-TWO-PROCESS-PURCHASER-RECIPIENT-UNIT-CONTENTION',()=>usingGift(async f=>{f.createGift();f.prepareGift();f.cases.create(f.buyer,{case_id:'purchaser_case',resource_id:f.giftOrder.id,profile_id:'default',policy_id:'returns'});const quote=f.intake.evaluate(f.buyer,{case_id:'purchaser_case',lines:[{line_id:'gamma',quantity:1}],outcome:'exchange',reason:'size',note:'',evidence_ids:[]}),buyer=f.intake.prepare(f.buyer,{quote_id:quote.id,quote_digest:quote.digest,request_key:'purchaser-request',override_id:null}),gift=f.intake.read(f.a.scope,'gift_case');
 const children=[gift,buyer].map(r=>{const a=f.gateway.approve(f.reviewer.scope,{preview_id:r.preview_id,preview_digest:r.preview_digest}),cfg={filename:f.filename,now:f.now(),bearer:f.a.bearer,input:{preview_id:r.preview_id,preview_digest:r.preview_digest,approval_id:a.id}},p=spawn(process.execPath,['--experimental-strip-types','tests/development/gift-submit-child.mts'],{env:{...process.env,RIFARE_GIFT_SUBMIT:JSON.stringify(cfg)},stdio:['pipe','pipe','pipe']});let output='',stderr='';let readyResolve:()=>void,readyReject:(e:Error)=>void;const ready=new Promise<void>((resolve,reject)=>{readyResolve=resolve;readyReject=reject;});p.stdout.on('data',b=>{output+=b;if(output.includes('"ready":true'))readyResolve();});p.stderr.on('data',b=>stderr+=b);p.on('error',readyReject!);const done=new Promise<any>((resolve,reject)=>{p.on('error',reject);p.on('close',code=>{if(code!==0){readyReject!(new Error(stderr));reject(new Error(stderr));}else resolve(JSON.parse(output.trim().split('\n').at(-1)!));});});return {p,ready,done};});
 try{await Promise.all(children.map(c=>c.ready));for(const c of children)c.p.stdin.end('start\n');const results=await Promise.all(children.map(c=>c.done));assert.equal(results.filter(r=>r.result==='submitted').length,1);assert.equal(results.filter(r=>r.result==='rejected').length,1);assert.match(results.find(r=>r.result==='rejected').code,/RETURN_QUOTE_CHANGED|PREVIEW_STALE/);assert.equal(f.db.prepare("SELECT count(*) n FROM commerce_return_requests WHERE resource_id=? AND state='submitted'").get(f.giftOrder.id).n,1);}finally{for(const c of children)if(c.p.exitCode===null)c.p.kill();}
}));
