import test from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';
import {readFileSync,writeFileSync,symlinkSync,statSync} from 'node:fs';import {join} from 'node:path';
import {usingExecution} from './execution-helpers.mts';import {CommerceKernel} from '../../packages/commerce/kernel.mts';
import {createRecoverySnapshot,restoreRecoverySnapshot,suppressionCheckpoint,activateDiagnosticRestore} from '../../packages/commerce/safe-recovery.mts';
import {PrivacyLifecycle} from '../../packages/commerce/privacy-lifecycle.mts';import {contentDigest} from '../../packages/commerce/configuration-values.mts';
import {SecretVault} from '../../packages/commerce/secrets.mts';import {ActionGateway} from '../../packages/commerce/action-gateway.mts';
import {DurableWork} from '../../packages/commerce/durable-work.mts';
function fixture(f:any,build?:any){const snapshot=build??createRecoverySnapshot(f.kernel,join(f.directory,'backup'));const cp=suppressionCheckpoint(f.kernel);
 const input={snapshot:snapshot.directory,destination:join(f.directory,'restored'),manifest_sha256:snapshot.manifest_sha256,suppression:cp,suppression_sha256:contentDigest(cp)};
 return {snapshot,cp,input,restore:()=>restoreRecoverySnapshot(input,f.now)};}
function owner(k:CommerceKernel){return k.authenticate(k.issueSession('tenant-a','store-a','owner'));}
test('CASE-M02-G25-01',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.execute(p,a);const attachment=f.kernel.attach(f.a.scope,f.order().id,{private_fixture:'retained'});const x=fixture(f),r=x.restore(),db=new DatabaseSync(r.database);try{const k=new CommerceKernel(db,f.now),s=owner(k);assert.equal(k.attachment(s,attachment).private_fixture,'retained');assert.throws(()=>new ActionGateway(k).prepare(s,f.proposal()),/RESTORE_WRITE_BLOCKED/);assert.equal(db.prepare('SELECT revoked FROM commerce_action_approvals').get().revoked,1);}finally{db.close();}}));
test('CASE-M02-G25-02',()=>usingExecution(async f=>{let calls=0;const keys={activeId:'one',get:()=>Buffer.alloc(32,3)},vault=new SecretVault(f.kernel,keys,{probe:()=>{calls++;return true;}});const secret=vault.put(f.owner.scope,{provider:'synthetic',adapter:'probe',value:'SYNTHETIC-KEY'});const x=fixture(f),r=x.restore(),db=new DatabaseSync(r.database);try{const k=new CommerceKernel(db,f.now),v=new SecretVault(k,keys,{probe:()=>{calls++;return true;}});await assert.rejects(()=>v.probe(owner(k),secret.ref,'probe'),/RESTORE_EGRESS_BLOCKED|RESTORE_WRITE_BLOCKED/);assert.equal(calls,0);}finally{db.close();}}));
test('CASE-M02-G25-03',()=>usingExecution(f=>{const x=fixture(f),first=x.restore();x.input.destination=join(f.directory,'second');const second=x.restore();assert.notEqual(first.restore_id,second.restore_id);for(const r of [first,second]){const db=new DatabaseSync(r.database);try{const k=new CommerceKernel(db,f.now);assert.equal(k.get(owner(k),f.order().id).id,f.order().id);assert.equal(db.prepare('SELECT mode FROM commerce_recovery_state').get().mode,'quarantine');}finally{db.close();}}}));
test('M02-G25-COPIED-SESSIONS-INVALID',()=>usingExecution(f=>{const r=fixture(f).restore(),db=new DatabaseSync(r.database);try{const k=new CommerceKernel(db,f.now);assert.throws(()=>k.authenticate(f.a.bearer),/ACCESS_DENIED/);}finally{db.close();}}));
test('M02-G25-MANIFEST-PIN-REQUIRED',()=>usingExecution(f=>{const x=fixture(f);x.input.manifest_sha256='0'.repeat(64);assert.throws(x.restore,/RECOVERY_MANIFEST_MISMATCH/);}));
test('M02-G25-DATABASE-TAMPER',()=>usingExecution(f=>{const x=fixture(f),path=join(x.snapshot.directory,'database.sqlite');writeFileSync(path,Buffer.concat([readFileSync(path),Buffer.from('tamper')]));assert.throws(x.restore,/RECOVERY_DATABASE_MISMATCH/);}));
test('M02-G25-NO-OVERWRITE',()=>usingExecution(f=>{const x=fixture(f);x.restore();assert.throws(x.restore,/RECOVERY_TARGET_EXISTS/);}));
test('M02-G25-EXTRA-FILE-REJECTED',()=>usingExecution(f=>{const x=fixture(f);writeFileSync(join(x.snapshot.directory,'wrapping-key'),'SYNTHETIC');assert.throws(x.restore,/RECOVERY_MEMBERSHIP_INVALID/);}));
test('M02-G25-PRIVATE-FILE-MODE',()=>usingExecution(f=>{const x=fixture(f);assert.equal(statSync(join(x.snapshot.directory,'database.sqlite')).mode&0o777,0o600);assert.equal(statSync(x.snapshot.directory).mode&0o777,0o700);}));
test('M02-G25-NEWER-ERASURES-REPLAYED',()=>usingExecution(f=>{const resource=f.order(),snapshot=createRecoverySnapshot(f.kernel,join(f.directory,'backup'));f.advance(100);new PrivacyLifecycle(f.kernel).erase(f.owner.scope,resource.customer_id);const x=fixture(f,snapshot),r=x.restore(),db=new DatabaseSync(r.database);try{const k=new CommerceKernel(db,f.now);assert.throws(()=>k.get(owner(k),resource.id),/SUBJECT_ERASED/);assert.equal(db.prepare('SELECT payload FROM commerce_resources WHERE id=?').get(resource.id).payload,'{"redacted":true}');}finally{db.close();}}));
test('M02-G25-STALE-SUPPRESSION-REJECTED',()=>usingExecution(f=>{const cp=suppressionCheckpoint(f.kernel);f.advance(10);const x=fixture(f);x.input.suppression=cp;x.input.suppression_sha256=contentDigest(cp);assert.throws(x.restore,/SUPPRESSION_CHECKPOINT_STALE/);}));
test('M02-G25-NO-EGRESS-AFTER-DIAGNOSTIC-ACTIVATION',()=>usingExecution(f=>{const r=fixture(f).restore(),db=new DatabaseSync(r.database);try{const k=new CommerceKernel(db,f.now),s=owner(k);assert.equal(activateDiagnosticRestore(k,s,r.restore_id).egress_enabled,false);assert.throws(()=>k.authorize(s,'model.run'),/RESTORE_EGRESS_BLOCKED/);}finally{db.close();}}));
test('M02-G25-UNKNOWN-RESULT-BLOCKS-ACTIVATION',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.execute(p,a);f.db.exec("UPDATE commerce_operations SET state='unknown'");const r=fixture(f).restore(),db=new DatabaseSync(r.database);try{const k=new CommerceKernel(db,f.now);assert.throws(()=>activateDiagnosticRestore(k,owner(k),r.restore_id),/RESTORE_RECONCILIATION_REQUIRED/);}finally{db.close();}}));
test('M02-G25-OLD-QUEUE-NEVER-AUTO-REPLAY',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.execute(p,a);const op=f.db.prepare('SELECT id FROM commerce_operations').get().id;const r=fixture(f).restore(),db=new DatabaseSync(r.database);try{const k=new CommerceKernel(db,f.now),s=owner(k);activateDiagnosticRestore(k,s,r.restore_id);assert.throws(()=>new DurableWork(k).claim(s,op),/RESTORED_OPERATION_REPLAY_BLOCKED/);}finally{db.close();}}));
