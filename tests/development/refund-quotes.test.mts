import test from 'node:test';import assert from 'node:assert/strict';
import { usingResolution } from './resolution-helpers.mts';
test('CASE-M03-G07-01',()=>usingResolution(f=>{const p=f.allocate(),q=f.quote(p.allocations[0]);assert.equal(q.quote.amount_minor,'1726');assert.deepEqual(q.quote.components,{gross_minor:'2000',discount_minor:'200',tax_minor:'100',shipping_minor:'30',duties_minor:'10',paid_minor:'1940',restocking_minor:'180',return_shipping_minor:'34'});assert.equal(q.quote.remaining_before_minor,'6800');}));
import { contentDigest } from '../../packages/commerce/configuration-values.mts';
import { financialFacts } from '../../packages/commerce/resolution-ledger.mts';
import { CaseConfigurations } from '../../packages/commerce/case-configurations.mts';
test('CASE-M03-G07-02',()=>usingResolution(f=>{const p=f.allocate();assert.throws(()=>f.quotes.quote(f.a.scope,{allocation_id:p.allocations[0].id,amount_minor:'999999',currency:'EUR'}),/INVALID_INPUT/);}));
test('CASE-M03-G07-03',()=>usingResolution(f=>{const p=f.allocate(),q=f.quote(p.allocations[0]),pv=f.gateway.prepare(f.a.scope,q.proposal),a=f.gateway.approve(f.reviewer.scope,{preview_id:pv.id,preview_digest:pv.digest});f.update({resolution_facts:{...f.facts,revision:2,prior_refunded_minor:'2000'}});assert.throws(()=>f.gateway.execute(f.a.scope,{preview_id:pv.id,preview_digest:pv.digest,approval_id:a.id}),/REFUND_QUOTE_CHANGED/);assert.equal(f.quote(p.allocations[0]).quote.remaining_before_minor,'6740');}));
test('M03-G07-CATALOG-PRICE-NOT-REFUND-BASIS',()=>usingResolution(f=>{const p=f.allocate();f.catalog({unit_price_minor:'999999'});assert.equal(f.quote(p.allocations[0]).quote.amount_minor,'1726');}));
test('M03-G07-MISSING-PAID-FACTS-REJECTED',()=>usingResolution(f=>{const p=f.allocate();f.update({resolution_facts:null});assert.throws(()=>f.quote(p.allocations[0]));}));
test('M03-G07-MIXED-CURRENCY-FACTS-REJECTED',()=>usingResolution(f=>{const p=f.allocate();f.update({resolution_facts:{...f.facts,currency:'EUR'}});assert.throws(()=>f.quote(p.allocations[0]),/RESOLUTION_SOURCE_UNQUALIFIED/);}));
test('M03-G07-UNEXPLAINED-CAPTURE-REJECTED',()=>usingResolution(f=>{f.update({resolution_facts:{...f.facts,original_paid_minor:'99999'}});assert.throws(()=>f.allocate(),/PAID_TOTAL_MISMATCH/);}));
test('M03-G07-PRIOR-REFUNDS-ABOVE-CAPTURE-REJECTED',()=>usingResolution(f=>{f.update({resolution_facts:{...f.facts,prior_refunded_minor:'99999'}});assert.throws(()=>f.allocate(),/PAID_TOTAL_MISMATCH/);}));
test('M03-G07-STALE-SOURCE-DENIED',()=>usingResolution(f=>{const p=f.allocate();f.advance(900001);f.kernel.issueSession(f.a.tenant,f.a.store,'operator');assert.throws(()=>f.quote(p.allocations[0]),/ACCESS_DENIED|FINANCIAL_SOURCE_STALE|CURRENT_FACTS_UNAVAILABLE|CONFIGURATION_REPREVIEW_REQUIRED/);}));
test('M03-G07-EXPIRED-PREVIEW-DENIED',()=>usingResolution(f=>{const p=f.allocate(),q=f.quote(p.allocations[0]);f.advance(300001);assert.throws(()=>f.gateway.prepare(f.a.scope,q.proposal),/REFUND_QUOTE_EXPIRED/);}));
test('M03-G07-CHANGED-FEES-REQUIRE-NEW-PLAN',()=>usingResolution(f=>{const p=f.allocate();f.intake.configure(f.owner.scope,{expected_revision:1,settings:{...f.settings,restocking_bps:500}});assert.throws(()=>f.quote(p.allocations[0]),/REFUND_FEES_CHANGED/);}));
test('M03-G07-CASH-QUOTE-CANNOT-QUOTE-EXCHANGE',()=>usingResolution(f=>{const p=f.allocate();assert.throws(()=>f.quote(p.allocations[2]),/OUTCOME_UNSUPPORTED/);}));
test('M03-G07-NATIVE-RETURN-REQUIRED',()=>usingResolution(f=>{const p=f.allocate();assert.throws(()=>f.quote(p.allocations[0]),/NATIVE_RETURN_REQUIRED/);},{noNative:true}));
test('M03-G07-DIFFERENT-CASE-CANNOT-USE-QUOTE',()=>usingResolution(f=>{const p=f.allocate(),q=f.quote(p.allocations[0]);assert.throws(()=>f.gateway.prepare(f.a.scope,{...q.proposal,case_id:'case_one'}),/REFUND_QUOTE_CHANGED/);}));
test('M03-G07-MODIFIED-QUOTE-DIGEST-REJECTED',()=>usingResolution(f=>{const p=f.allocate(),q=f.quote(p.allocations[0]);assert.throws(()=>f.gateway.prepare(f.a.scope,{...q.proposal,arguments:{quote_id:q.id,quote_digest:'0'.repeat(64)}}),/REFUND_QUOTE_CHANGED/);}));
test('M03-G07-BALANCE-RESERVED-AT-AUTHORIZATION',()=>usingResolution(f=>{const p=f.allocate(),first=f.authorize(f.quote(p.allocations[0]));assert.ok(first.id);assert.equal(f.quote(p.allocations[1]).quote.remaining_before_minor,'5074');}));
test('M03-G07-NO-SECOND-AUTHORIZATION-PER-ALLOCATION',()=>usingResolution(f=>{const p=f.allocate();f.authorize(f.quote(p.allocations[0]));assert.throws(()=>f.quote(p.allocations[0]),/ALLOCATION_ALREADY_AUTHORIZED/);}));
test('M03-G07-PAID-LINE-DISCOUNT-MODIFICATION-REJECTED',()=>usingResolution(f=>{const p=f.allocate(),facts=structuredClone(f.facts);facts.paid_lines[0].discount_minor='0';facts.original_paid_minor='9340';f.update({resolution_facts:facts});assert.throws(()=>f.quote(p.allocations[0]),/PAID_ALLOCATION_CHANGED/);}));
test('M03-G07-DUPLICATE-PAID-LINES-REJECTED',()=>usingResolution(f=>{f.update({resolution_facts:{...f.facts,paid_lines:[...f.facts.paid_lines,f.facts.paid_lines[0]]}});assert.throws(()=>f.allocate(),/PAID_ALLOCATIONS_INVALID/);}));
test('M03-G07-REVIEW-REQUEST-INVALIDATES-PREVIEW',()=>usingResolution(f=>{const p=f.allocate(),q=f.quote(p.allocations[0]);f.db.prepare("INSERT INTO commerce_return_review_events(tenant_id,store_id,case_id,actor_id,event,reason,observed_at) VALUES(?,?,?,?,?,?,?)").run(f.a.tenant,f.a.store,'resolution_case','reviewer','evidence_requested','photo_required',f.now());assert.throws(()=>f.gateway.prepare(f.a.scope,q.proposal),/REFUND_QUOTE_CHANGED|RETURN_REVIEW_REQUIRED/);}));
