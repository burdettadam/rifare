import test from 'node:test';import assert from 'node:assert/strict';
import { useReliability } from './reliability-helpers.mts';
import { contentDigest } from '../../packages/commerce/configuration-values.mts';

test('CASE-M02-G15-01',()=>useReliability(f=>{const {op,r}=f.executeOperation(),p={receipt_id:r.id,idempotency_key:'request-one',expected_receipt_digest:contentDigest(r)},other=f.reopen();try{assert.equal(other.ops.fromReceipt(other.scope,p).id,op.id);assert.equal(f.ops.fromReceipt(f.a.scope,p).id,op.id);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_operations').get().n,1);}finally{other.db.close();}}));
test('CASE-M02-G15-02',()=>useReliability(f=>{f.executeOperation();const preview=f.gateway.prepare(f.a.scope,f.proposal('case_one','none')),approval=f.approve(preview),r=f.execute(preview,approval);assert.throws(()=>f.ops.fromReceipt(f.a.scope,{receipt_id:r.id,idempotency_key:'request-one',expected_receipt_digest:contentDigest(r)}),/IDEMPOTENCY_CONFLICT/);}));
test('CASE-M02-G15-03',()=>useReliability(async f=>{const {op}=f.executeOperation();f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,op.id,f.journal);const other=f.reopen();try{const r=await other.work.dispatch(other.scope,op.id,f.journal);assert.equal(r.id,op.id);assert.equal(r.state,'unknown');assert.equal(f.journal.count(),1);}finally{other.db.close();}}));
test('M02-G15-ALIASES-NOT-NEW-EFFECTS',()=>useReliability(f=>{const {op,r}=f.executeOperation();for(const key of ['alias-two','alias-three'])assert.equal(f.ops.fromReceipt(f.a.scope,{receipt_id:r.id,idempotency_key:key,expected_receipt_digest:contentDigest(r)}).id,op.id);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_operation_work').get().n,1);}));
test('M02-G15-CHANGED-EXPECTED-DIGEST-CONFLICT',()=>useReliability(f=>{const {r}=f.executeOperation();assert.throws(()=>f.ops.fromReceipt(f.a.scope,{receipt_id:r.id,idempotency_key:'new',expected_receipt_digest:'0'.repeat(64)}),/IDEMPOTENCY_CONFLICT/);}));
test('M02-G15-UNAPPROVED-PREVIEW-NOT-OPERATION',()=>useReliability(f=>{const p=f.preview();assert.throws(()=>f.ops.fromReceipt(f.a.scope,{receipt_id:p.id,idempotency_key:'new',expected_receipt_digest:p.digest}),/NOT_FOUND/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_operations').get().n,0);}));
test('M02-G15-MONEY-ARGUMENT-CANNOT-OVERRIDE',()=>useReliability(f=>{const {r}=f.executeOperation();assert.throws(()=>f.ops.fromReceipt(f.a.scope,{receipt_id:r.id,idempotency_key:'new',expected_receipt_digest:contentDigest(r),amount:'999'}),/INVALID_INPUT/);}));
test('M02-G15-CROSS-TENANT-RECEIPT-DENIED',()=>useReliability(f=>{const {r}=f.executeOperation();assert.throws(()=>f.ops.fromReceipt(f.b.scope,{receipt_id:r.id,idempotency_key:'new',expected_receipt_digest:contentDigest(r)}),/NOT_FOUND/);}));
test('M02-G15-RESOURCE-SCOPE-RECHECK',()=>useReliability(f=>{const {op}=f.executeOperation();f.permissions.change(f.owner.scope,{actor_id:'operator',expected_revision:0,role:'operator',actions:['operation.read','resource.read'],resource_ids:[]});assert.throws(()=>f.ops.read(f.a.scope,op.id),/ACCESS_DENIED/);}));
test('M02-G15-IDENTITY-IMMUTABLE-IN-DATABASE',()=>useReliability(f=>{f.executeOperation();assert.throws(()=>f.db.prepare("UPDATE commerce_operations SET payload_hash='changed'").run(),/OPERATION_IDENTITY_IMMUTABLE/);}));
test('M02-G15-COMMAND-NOT-RETURNED-BY-STATUS',()=>useReliability(f=>{const {op}=f.executeOperation();assert.equal(Object.hasOwn(f.ops.read(f.a.scope,op.id),'command'),false);assert.equal(Object.hasOwn(f.ops.read(f.a.scope,op.id).work,'lease_token'),false);}));
test('M02-G15-STABLE-RETRY-ID',()=>useReliability(async f=>{const {op}=f.executeOperation();f.journal.arm('not_sent');await f.work.dispatch(f.a.scope,op.id,f.journal);f.advance(1000);const result=await f.work.dispatch(f.a.scope,op.id,f.journal);assert.equal(result.id,op.id);assert.equal(result.payload_hash,op.payload_hash);assert.equal(f.journal.lookup(op.id).kind,'applied');}));
test('M02-G15-PROVIDER-REPLAY-ONE-LOGICAL-EFFECT',()=>useReliability(f=>{const {op}=f.executeOperation(),c=f.work.claim(f.a.scope,op.id)!;const command=f.work.beginSend(f.a.scope,op.id,c.lease_token);const one=f.journal.send(command),two=f.journal.send(command);assert.deepEqual(one,two);assert.equal(f.journal.count(),1);}));
test('M02-G15-PROVIDER-CHANGED-PAYLOAD-REJECTED',()=>useReliability(f=>{const {op}=f.executeOperation(),c=f.work.claim(f.a.scope,op.id)!;const command=f.work.beginSend(f.a.scope,op.id,c.lease_token);f.journal.send(command);const changed={...command,command:{...command.command,resolution:'exchange'}};changed.payload_hash=contentDigest(changed.command);assert.throws(()=>f.journal.send(changed),/JOURNAL_CONFLICT/);assert.equal(f.journal.count(),1);}));
test('M02-G15-COMPLETION-REPLAY-NO-SECOND-RECEIPT',()=>useReliability(async f=>{const {op}=f.executeOperation();await f.work.dispatch(f.a.scope,op.id,f.journal);const before=f.receipts.list(f.a.scope,op.id).length;await f.work.dispatch(f.a.scope,op.id,f.journal);assert.equal(f.receipts.list(f.a.scope,op.id).length,before);assert.equal(f.journal.count(),1);}));
test('M02-G15-INDEPENDENT-OPERATIONS-SERIALIZED',()=>useReliability(async f=>{const a=f.executeOperation('refund','one').op,b=f.executeOperation('none','two').op;assert.notEqual(a.id,b.id);await f.work.dispatch(f.a.scope,a.id,f.journal);await f.work.dispatch(f.a.scope,b.id,f.journal);assert.equal(f.journal.count(),2);assert.equal(f.gateway.state(f.a.scope,'case_one').resolution,'none');}));
test('M02-G15-AUDIT-INSERT-FAILURE-ROLLS-BACK-EFFECT',()=>useReliability(f=>{const p=f.preview(),a=f.approve(p);f.db.exec("CREATE TRIGGER fail_receipt BEFORE INSERT ON commerce_operation_receipts BEGIN SELECT RAISE(ABORT,'audit_full');END;");assert.throws(()=>f.execute(p,a),/audit_full/);assert.equal(f.gateway.state(f.a.scope,'case_one').revision,0);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_operation_work').get().n,0);assert.equal(f.db.prepare('SELECT uses FROM commerce_action_approvals WHERE id=?').get(a.id).uses,0);}));
test('M02-G15-REVOKED-SESSION-CANNOT-READ',()=>useReliability(f=>{const {op}=f.executeOperation();f.kernel.revoke(f.a.scope);assert.throws(()=>f.ops.read(f.a.scope,op.id),/ACCESS_DENIED/);}));
