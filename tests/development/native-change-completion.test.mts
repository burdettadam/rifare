import test from 'node:test';import assert from 'node:assert/strict';import {usingCompletion} from './completion-helpers.mts';
const refund=(f:any,overrides:any={})=>f.snapshot({refunds:[{id:'external_refund',amount_minor:'1900',currency:'USD',state:'settled',operation_id:null}],completed_units:[{line_id:'alpha',unit_index:2,kind:'refund',native_id:'external_refund'}],...overrides});
test('CASE-M03-G21-01',()=>usingCompletion(async f=>{f.enableFeed();f.feed.publish(refund(f));const r=await f.changes.refresh(f.a.scope,f.request.id);assert.equal(r.source.total_refunded_minor,'3840');assert.deepEqual(f.order().payload.resolution_facts.paid_lines[0].resolved_units,[1,2]);assert.equal(r.external_writes,0);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);}));
test('CASE-M03-G21-02',()=>usingCompletion(async f=>{f.enableFeed();f.feed.publish(f.snapshot());await f.changes.refresh(f.a.scope,f.request.id);const a=f.plan.allocations.find(a=>a.outcome==='refund'),q=f.quotes.quote(f.a.scope,{allocation_id:a.id});f.feed.publish(f.snapshot({source_version:2,exists:false,return_status:'MISSING'}));await f.changes.refresh(f.a.scope,f.request.id);assert.throws(()=>f.gateway.prepare(f.a.scope,q.proposal),/NATIVE_CHANGE_REVIEW_REQUIRED/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_resolution_operations').get().n,0);}));
test('CASE-M03-G21-03',()=>usingCompletion(async f=>{f.enableFeed();f.feed.publish(refund(f));await f.changes.refresh(f.a.scope,f.request.id);const v=f.order().source_version;await f.changes.refresh(f.a.scope,f.request.id);assert.equal(f.order().source_version,v);const a=f.plan.allocations.find(a=>a.outcome==='refund');assert.throws(()=>f.quotes.quote(f.a.scope,{allocation_id:a.id}),/UNIT_EXTERNALLY_RESOLVED|UNIT_ALREADY_RESOLVED/);}));
test('NATIVE-CHANGE-COMPLETION-INCOMPLETE-OBSERVATION-BLOCKS-WRITES-ONCE-CONFIGURED',()=>usingCompletion(f=>{f.enableFeed();assert.throws(()=>f.quotes.quote(f.a.scope,{allocation_id:f.plan.allocations[0].id}),/NATIVE_REFRESH_REQUIRED/);}));
test('NATIVE-CHANGE-COMPLETION-WRONG-ORIGINAL-PAYMENT-REJECTED-ATOMICALLY',()=>usingCompletion(async f=>{f.enableFeed();f.feed.publish(f.snapshot({payment_id:'another-payment'}));const v=f.order().source_version;await assert.rejects(f.changes.refresh(f.a.scope,f.request.id),/NATIVE_PAYMENT_MISMATCH/);assert.equal(f.order().source_version,v);assert.equal(f.changes.read(f.a.scope,f.request.id).source,null);}));
test('NATIVE-CHANGE-COMPLETION-EXTERNAL-HISTORY-CANNOT-DISAPPEAR-IN-LATER-SNAPSHOTS',()=>usingCompletion(async f=>{f.enableFeed();f.feed.publish(refund(f));await f.changes.refresh(f.a.scope,f.request.id);f.feed.publish(f.snapshot({source_version:2}));await assert.rejects(f.changes.refresh(f.a.scope,f.request.id),/NATIVE_BALANCE_REGRESSION|NATIVE_HISTORY_REMOVED/);assert.equal(f.changes.read(f.a.scope,f.request.id).source.source_version,1);}));
test('NATIVE-CHANGE-COMPLETION-FUTURE-SOURCE-OBSERVATION-REJECTED',()=>usingCompletion(async f=>{f.enableFeed();f.feed.publish(f.snapshot({observed_at:f.now()+1}));await assert.rejects(f.changes.refresh(f.a.scope,f.request.id),/NATIVE_SOURCE_STALE/);}));
test('NATIVE-CHANGE-COMPLETION-LATER-STALE-VERSION-CANNOT-UNDO-EXTERNAL-RESOLUTION',()=>usingCompletion(async f=>{f.enableFeed();f.feed.publish(refund(f,{source_version:2}));await f.changes.refresh(f.a.scope,f.request.id);const lookup=f.feed.lookup.bind(f.feed);f.feed.lookup=async r=>({...await lookup(r),snapshot:f.snapshot()});const next=await f.changes.refresh(f.a.scope,f.request.id);assert.equal(next.stale_ignored,true);assert.equal(next.source.total_refunded_minor,'3840');}));
test('NATIVE-CHANGE-COMPLETION-SOURCE-UNAVAILABLE-LEAVES-CURRENT-FACTS-UNCHANGED',()=>usingCompletion(async f=>{f.enableFeed();await assert.rejects(f.changes.refresh(f.a.scope,f.request.id),/NATIVE_SOURCE_UNAVAILABLE/);assert.equal(f.order().payload.resolution_facts.prior_refunded_minor,'1940');}));
test('NATIVE-CHANGE-COMPLETION-REFUNDS-CANNOT-EXCEED-ORIGINAL-PAID-VALUE',()=>usingCompletion(async f=>{f.enableFeed();const raw=refund(f);raw.refunds[0].amount_minor='999999';f.feed.publish(raw);await assert.rejects(f.changes.refresh(f.a.scope,f.request.id),/NATIVE_BALANCE_REGRESSION/);}));
test('NATIVE-CHANGE-COMPLETION-STORE-ISOLATION-APPLIES-TO-SOURCE-READS',()=>usingCompletion(async f=>{f.enableFeed();await assert.rejects(f.changes.refresh(f.b.scope,f.request.id),/NOT_FOUND/);assert.equal(f.feed.reads,0);}));
test('NATIVE-CHANGE-COMPLETION-EXTERNAL-RECEIPT-CANNOT-BE-LOCALLY-RESTOCKED-TWICE',()=>usingCompletion(async f=>{const r=f.full();f.enableFeed();f.feed.publish(f.snapshot({receipts:[{id:'receipt_one',line_id:'alpha',ordinal:1,variant_id:'shirt-small',grade:'sellable',location_id:'warehouse-one',disposition:'restock'}]}));await f.changes.refresh(f.a.scope,f.request.id);assert.throws(()=>f.disposition.quote(f.a.scope,{session_id:r.session_id,unit_ids:[r.units.find(u=>u.line_id==='alpha').id],disposition:'restock'}),/UNIT_ALREADY_DISPOSED/);assert.equal(f.warehouse.stock('shirt-small','warehouse-one'),0);}));
test('NATIVE-CHANGE-COMPLETION-ACCOUNT-OBSERVATIONS-CANNOT-PRETEND-TO-SETTLE-LOCAL-MONEY',()=>usingCompletion(async f=>{const a=f.plan.allocations.find(a=>a.outcome==='refund'),op=f.authorize(f.quotes.quote(f.a.scope,{allocation_id:a.id}));const issue=f.source.issue.bind(f.source);f.source.issue=async i=>{await issue(i);throw new Error('lost');};await f.executor.dispatch(f.a.scope,op.id);const receipt=await f.source.lookup(op.id);f.enableFeed();f.feed.publish(f.snapshot({refunds:[{id:receipt.id,amount_minor:receipt.amount_minor,currency:receipt.currency,state:'settled',operation_id:op.id}]}));await f.changes.refresh(f.a.scope,f.request.id);assert.equal(f.executor.read(f.a.scope,op.id).state,'unknown');assert.ok(f.changes.read(f.a.scope,f.request.id).source.conflicts.length>0);}));
test('NATIVE-CHANGE-COMPLETION-A-LATER-NATIVE-DISPOSITION-ADVANCES-THE-RECEIPT-WITHOUT-DUPLICATING-IT',()=>usingCompletion(async f=>{const r=f.full();f.enableFeed();const receipt={id:'receipt_progress',line_id:'alpha',ordinal:1,variant_id:'shirt-small',grade:'sellable',location_id:'warehouse-one',disposition:null};f.feed.publish(f.snapshot({receipts:[receipt]}));await f.changes.refresh(f.a.scope,f.request.id);f.feed.publish(f.snapshot({source_version:2,receipts:[{...receipt,disposition:'restock'}]}));await f.changes.refresh(f.a.scope,f.request.id);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_native_receipts').get().n,1);assert.equal(JSON.parse(f.db.prepare('SELECT body FROM commerce_native_receipts').get().body).disposition,'restock');assert.throws(()=>f.disposition.quote(f.a.scope,{session_id:r.session_id,unit_ids:[r.units.find(u=>u.line_id==='alpha').id],disposition:'restock'}),/UNIT_ALREADY_DISPOSED/);}));
