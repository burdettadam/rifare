import test from 'node:test';import assert from 'node:assert/strict';
import { usingFulfillment } from './fulfillment-helpers.mts';
import { PrivacyLifecycle } from '../../packages/commerce/privacy-lifecycle.mts';

test('M03-G14-REVIEW-MISSED-VOID-ACK-CAN-RECONCILE',()=>usingFulfillment(async f=>{const b=await f.buy(),read=f.fulfillmentSource.label.bind(f.fulfillmentSource);f.fulfillmentSource.fault='after';f.fulfillmentSource.label=async()=>{throw Error('UNAVAILABLE');};const v=await f.voidLabel(b.labelId);assert.equal(v.result.state,'unknown');f.fulfillmentSource.confirmVoid(b.labelId,true);f.fulfillmentSource.reimburse(b.labelId);f.fulfillmentSource.label=read;await f.execution.reconcile(f.a.scope,v.id);assert.equal(f.labels.inspect(f.a.scope,b.labelId).reimbursement.state,'refunded');assert.equal(f.fulfillmentSource.calls.void,1);}));
test('M03-G15-REVIEW-POLICY-CHANGE-DOES-NOT-REINTERPRET',()=>usingFulfillment(async f=>{const b=await f.buy();f.fulfillmentSource.carrierEvent(b.labelId,{id:'transit-policy',sequence:1,status:'in_transit',at:f.now()});await f.tracking.refresh(f.a.scope,b.labelId);f.config.configure(f.owner.scope,{...f.configInput,expected_revision:1,resolution_trigger:'carrier_transit'});const result=f.tracking.read(f.a.scope,b.labelId);assert.equal(result.resolution_trigger.eligible,false);assert.equal(result.resolution_trigger.policy,'carrier_delivery');}));
test('M03-G14-REVIEW-REJECTED-VOID-IS-NOT-VOIDED-LABEL',()=>usingFulfillment(async f=>{const b=await f.buy(),v=await f.voidLabel(b.labelId);f.fulfillmentSource.confirmVoid(b.labelId,false);await f.execution.reconcile(f.a.scope,v.id);assert.equal(f.labels.inspect(f.a.scope,b.labelId).usable,true);assert.equal(f.labels.inspect(f.a.scope,b.labelId).reimbursement_counted,false);}));
test('M03-G13-REVIEW-ERASURE-SCRUBS-ADDRESS-CONTEXT',()=>usingFulfillment(async f=>{const b=await f.buy(),customer=f.order().customer_id;new PrivacyLifecycle(f.kernel).erase(f.owner.scope,customer);const parcel=f.db.prepare('SELECT body FROM commerce_return_parcels').get() as any;assert.equal(JSON.parse(parcel.body).redacted,true);assert(!parcel.body.includes('customer-address-one'));const op=f.db.prepare('SELECT command FROM commerce_fulfillment_operations WHERE id=?').get(b.id) as any;assert(!op.command.includes('customer-address-one'));assert.throws(()=>f.execution.read(f.a.scope,b.id),/SUBJECT_ERASED/);}));
