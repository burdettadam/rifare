import test from 'node:test';import assert from 'node:assert/strict';
import { useReliability } from './reliability-helpers.mts';
import { syntheticHeaders } from './execution-helpers.mts';

test('CASE-M02-G13-01',()=>useReliability(f=>{const a=f.receive(),b=f.receive(2,'approved');assert.equal(f.events.process(f.a.scope,a.id).disposition,'applied');assert.equal(f.events.process(f.a.scope,a.id).replayed,true);assert.equal(f.events.process(f.a.scope,b.id).disposition,'applied');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_operations').get().n,2);assert.equal(f.events.state(f.a.scope,f.order().id).state,'approved');}));
test('CASE-M02-G13-02',()=>useReliability(f=>{f.events.process(f.a.scope,f.receive(8,'closed').id);assert.equal(f.events.process(f.a.scope,f.receive(7,'approved').id).disposition,'stale');assert.equal(f.events.state(f.a.scope,f.order().id).state,'closed');}));
test('CASE-M02-G13-03',()=>useReliability(f=>{const e=f.receive(),a=f.events.process(f.a.scope,e.id),other=f.reopen();try{assert.equal(other.events.process(other.scope,e.id).operation_id,a.operation_id);assert.equal(other.db.prepare('SELECT count(*) n FROM commerce_event_consumption').get().n,1);}finally{other.db.close();}}));
test('M02-G13-TEST-005-REVERSED-REPLAY',()=>useReliability(f=>{for(const [v,s] of [[3,'closed'],[1,'open'],[2,'approved']] as const)f.events.process(f.a.scope,f.receive(v,s).id);assert.equal(f.events.state(f.a.scope,f.order().id).source_version,3);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_operation_work').get().n,1);}));
test('M02-G13-DIFFERENT-DELIVERY-SAME-EVENT',()=>useReliability(f=>{f.events.process(f.a.scope,f.receive().id);const e=f.receive(1,'open',{},'another-delivery');assert.equal(f.events.process(f.a.scope,e.id).disposition,'duplicate');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_operations').get().n,1);}));
test('M02-G13-LOGICAL-ID-CONFLICT',()=>useReliability(f=>{f.events.process(f.a.scope,f.receive().id);assert.equal(f.events.process(f.a.scope,f.receive(2,'closed',{event_id:'event-1'}).id).disposition,'conflict');assert.equal(f.events.state(f.a.scope,f.order().id).state,'open');}));
test('M02-G13-SAME-VERSION-DIFFERENT-STATE',()=>useReliability(f=>{f.events.process(f.a.scope,f.receive().id);assert.equal(f.events.process(f.a.scope,f.receive(1,'closed',{event_id:'different'},'new-delivery').id).disposition,'conflict');}));
test('M02-G13-SAME-SNAPSHOT-NEW-ID',()=>useReliability(f=>{f.events.process(f.a.scope,f.receive().id);assert.equal(f.events.process(f.a.scope,f.receive(1,'open',{event_id:'different'},'new-delivery').id).disposition,'duplicate');}));
test('M02-G13-TERMINAL-CANNOT-REOPEN-HIGHER-VERSION',()=>useReliability(f=>{f.events.process(f.a.scope,f.receive(1,'closed').id);assert.equal(f.events.process(f.a.scope,f.receive(2,'open').id).disposition,'conflict');}));
test('M02-G13-APPROVED-CANNOT-REGRESS',()=>useReliability(f=>{f.events.process(f.a.scope,f.receive(1,'approved').id);assert.equal(f.events.process(f.a.scope,f.receive(2,'open').id).disposition,'conflict');}));
test('M02-G13-OLDER-TIME-NEW-VERSION',()=>useReliability(f=>{f.events.process(f.a.scope,f.receive().id);assert.equal(f.events.process(f.a.scope,f.receive(2,'closed',{source_updated_at:f.now()-1}).id).disposition,'stale');}));
test('M02-G13-CROSS-STORE-DENIED',()=>useReliability(f=>{const e=f.receive();assert.throws(()=>f.events.process(f.b.scope,e.id),/NOT_FOUND/);}));
test('M02-G13-UNVERIFIED-ROUTING-BLOCKED',()=>useReliability(f=>{const e=f.receive();f.db.prepare("UPDATE commerce_webhook_inbox SET status='quarantined'").run();assert.throws(()=>f.events.process(f.a.scope,e.id),/EVENT_NOT_PROCESSABLE/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_operations').get().n,0);}));
test('M02-G13-TAMPERED-BODY-BLOCKED',()=>useReliability(f=>{const e=f.receive();f.db.prepare('UPDATE commerce_webhook_inbox SET body=?').run(Buffer.from('{}'));assert.throws(()=>f.events.process(f.a.scope,e.id),/WEBHOOK_INTEGRITY/);}));
test('M02-G13-UNKNOWN-PAYLOAD-BLOCKED',()=>useReliability(f=>{const e=f.receive(1,'open',{extra:'not-authority'});assert.throws(()=>f.events.process(f.a.scope,e.id),/INVALID_INPUT/);}));
test('M02-G13-FUTURE-SOURCE-BLOCKED',()=>useReliability(f=>{assert.throws(()=>f.events.process(f.a.scope,f.receive(1,'open',{source_updated_at:f.now()+1}).id),/EVENT_INVALID/);}));
test('M02-G13-DISABLED-ROUTE-BLOCKS-CONSUMPTION',()=>useReliability(f=>{const e=f.receive();f.inbox.disable(f.owner.scope,f.route.id);assert.throws(()=>f.events.process(f.a.scope,e.id),/EVENT_NOT_PROCESSABLE/);}));
test('M02-G13-REVOKED-ACTOR-BLOCKS',()=>useReliability(f=>{const e=f.receive();f.kernel.revoke(f.a.scope);assert.throws(()=>f.events.process(f.a.scope,e.id),/ACCESS_DENIED/);}));
test('M02-G13-AGENT-CANNOT-PROCESS-EXTERNAL-EVENT',()=>useReliability(f=>{const e=f.receive();assert.throws(()=>f.events.process(f.agent.scope,e.id),/ACCESS_DENIED/);}));
test('M02-G13-ATOMIC-PROJECTION-WITH-OUTBOX',()=>useReliability(f=>{const e=f.receive();f.db.exec("CREATE TRIGGER fail_outbox BEFORE INSERT ON commerce_operation_work BEGIN SELECT RAISE(ABORT,'fault');END;");assert.throws(()=>f.events.process(f.a.scope,e.id),/fault/);for(const table of ['commerce_event_projections','commerce_event_consumption','commerce_event_identities','commerce_operations'])assert.equal(f.db.prepare('SELECT count(*) n FROM '+table).get().n,0);f.db.exec('DROP TRIGGER fail_outbox');assert.equal(f.events.process(f.a.scope,e.id).disposition,'applied');}));
