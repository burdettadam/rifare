test('M09-PREP-PORT-026',()=>usingMarketing(async f=>{f.enroll();for(const m of f.members)f.grant(m);const d=f.ready({experiment_id:'checkout-one'}),first=f.queue(f.members[0]),second=f.queue(f.members[1]);assert.throws(()=>f.queue(f.members[2]),/HOLDOUT_EXCLUDED/);f.advance(1);f.grant(f.members[1],'withdrawn',2);await f.delivery.dispatch(f.a.scope,first.operation_id);await assert.rejects(()=>f.delivery.dispatch(f.a.scope,second.operation_id),/DELIVERY_SUPPRESSED/);const report=f.campaigns.summary(f.a.scope,d.id);assert.equal(report.provider_accepted,1);assert.equal(report.suppressed,1);assert.equal(report.delivered,0);assert.equal(f.source.calls,1);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM support_source_effects').get().n,1);assert.equal(f.experiments.assign(f.a.scope,{experiment_id:'checkout-one',case_id:f.members[2].case_id,frontend_variants:['holdout','treatment']}).arm,'holdout');}));
