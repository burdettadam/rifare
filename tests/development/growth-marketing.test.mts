  await withChangedModule('../../packages/commerce/cart-recovery.mts',"if(cart.status==='purchased')throw new Error('RECOVERY_PURCHASED');","if(false)throw new Error('RECOVERY_PURCHASED');",async m=>{const broken=new m.CartRecovery(f.kernel,cart.carts,f.campaigns);assert.throws(()=>assert.throws(()=>broken.final(f.a.scope,'campaign-one','case_one'),/RECOVERY_PURCHASED/),assert.AssertionError);});assert.equal(f.kernel.db.prepare('SELECT count(*) n FROM commerce_cart_recoveries').get().n,1);assert.equal(f.source.calls,0);}finally{cart.cleanup();}}));
test('CASE-M09-G09-01',()=>usingCancellation(async f=>{const response=await f.handler(f.request('POST',{intent:'confirm',token:f.issued.token,preview_digest:f.preview.digest,confirmed:true}));assert.equal(response.status,200);assert.equal(f.native.order(f.original.id).cancelled,true);assert.equal(f.edits.status(f.a.scope,f.operation.id).state,'awaiting_refund');assert.equal(f.native.finance(f.operation.id).state,'accepted');const count=Number(f.sourceDb.prepare('SELECT count(*) n FROM edit_source_effects').get().n);assert.equal((await f.handler(f.request('POST',{intent:'confirm',token:f.issued.token,preview_digest:f.preview.digest,confirmed:true}))).status,200);assert.equal(Number(f.sourceDb.prepare('SELECT count(*) n FROM edit_source_effects').get().n),count);}));
test('CASE-M09-G09-02',()=>usingCancellation(async f=>{const before=JSON.stringify(f.kernel.db.prepare('SELECT * FROM commerce_email_action_links').all());for(const method of ['GET','HEAD']){const response=await f.handler(f.request(method));assert.equal(response.status,200);}assert.equal(JSON.stringify(f.kernel.db.prepare('SELECT * FROM commerce_email_action_links').all()),before);assert.equal(f.native.order(f.original.id).cancelled,false);const denied=await f.handler(f.request('POST',{intent:'confirm',token:f.issued.token,preview_digest:f.preview.digest,confirmed:true},f.b.bearer));assert.equal(denied.status,403);f.advance(60001);assert.equal((await f.handler(f.request('POST',{intent:'confirm',token:f.issued.token,preview_digest:f.preview.digest,confirmed:true}))).status,403);assert.equal(f.native.order(f.original.id).cancelled,false);}));
test('CASE-M09-G09-03',()=>usingCancellation(async f=>{const before=()=>Number(f.sourceDb.prepare('SELECT count(*) n FROM edit_source_effects').get().n);
  await withChangedModule('../../packages/commerce/email-action-links.mts',"if(request.method==='GET'||request.method==='HEAD')return readonlyResponse(request.method);","if(request.method==='GET'||request.method==='HEAD'){await links.unsafeScannerDispatch(new URL(request.url).searchParams.get('token')!);return readonlyResponse(request.method);}",async m=>{const broken=new m.EmailActionLinks(f.kernel,f.edits);broken.unsafeScannerDispatch=()=>f.edits.dispatch(f.a.scope,f.operation.id);const handler=m.emailActionHandler(broken);await handler(f.request('GET'));assert.throws(()=>assert.equal(f.native.order(f.original.id).cancelled,false,'A scanner GET must not cancel an order'),assert.AssertionError);});
  const count=before();await f.handler(f.request('POST',{intent:'confirm',token:f.issued.token,preview_digest:f.preview.digest,confirmed:true}));assert.equal(before(),count);
}));
