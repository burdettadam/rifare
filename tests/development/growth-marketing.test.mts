  f.grant();f.ready();const q=f.queue();f.source.fault='after';assert.equal((await f.delivery.dispatch(f.a.scope,q.operation_id)).state,'unknown');await f.delivery.dispatch(f.a.scope,q.operation_id);assert.equal(f.source.calls,1);await f.delivery.reconcile(f.a.scope,q.operation_id);await f.delivery.reconcile(f.a.scope,q.operation_id);assert.equal(f.campaigns.summary(f.a.scope,'campaign-one').delivered,0);
  const other=f.shopper(2);f.seedMember(other);f.grant(other);const d=f.draft({campaign_id:'next-campaign'});f.campaigns.approve(f.reviewer.scope,{campaign_id:d.id,expected_digest:d.digest,expires_at:f.now()+60000});f.campaigns.schedule(f.a.scope,d.id);const queued=f.queue(other,d.id);f.advance(1);f.grant(other,'withdrawn',2);f.source.fault='none';
  await withChangedModule('../../packages/commerce/support-delivery.mts',"if(!eligibility.allowed)throw new Error('DELIVERY_SUPPRESSED');","if(!eligibility.allowed&&!payload.campaign_id)throw new Error('DELIVERY_SUPPRESSED');",async m=>{const broken=new m.SupportDelivery(f.kernel,f.tracking,[f.source],null,f.campaigns);const before=f.source.calls;await broken.dispatch(f.a.scope,queued.operation_id);assert.throws(()=>assert.equal(f.source.calls,before,'Withdrawn consent must be checked at final campaign send'),assert.AssertionError);});
}));
test('CASE-M09-G08-01',()=>usingMarketing(async f=>{const cart=await installShoppingCart(f),recovery=attachMarketingRecovery(f,cart.carts);f.grant();f.ready({recovery_after_ms:100});f.advance(101);const p=recovery.propose(f.a.scope,{cart_id:cart.cart_id,campaign_id:'campaign-one'});assert.equal(p.state,'proposed');assert.equal(recovery.propose(f.a.scope,{cart_id:cart.cart_id,campaign_id:'campaign-one'}).id,p.id);const q=f.queue();await f.delivery.dispatch(f.a.scope,q.operation_id);assert.equal(f.source.calls,1);assert.equal(recovery.inspect(f.a.scope,p.id).service,'automated_recovery_proposal');cart.cleanup();}));
