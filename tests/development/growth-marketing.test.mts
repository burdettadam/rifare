test('CASE-M09-G03-01',()=>usingMarketing(f=>{
  f.enroll();for(const member of f.members){const input={experiment_id:'checkout-one',case_id:member.case_id,frontend_variants:['holdout','treatment']},a=f.experiments.assign(f.a.scope,input);assert.equal(a.arm,marketingOracle.assignment_customer_arms[member.customer_id]);assert.deepEqual(f.experiments.assign(member.customer,{...input,frontend_variants:['treatment','holdout']}),a);}
  const e={experiment_id:'checkout-one',case_id:'case_one',channel:'checkout',offer_shown:true,event_id:'first-render'};
  f.experiments.expose(f.a.scope,e);f.experiments.expose(f.a.scope,{...e,event_id:'second-render'});
  assert.equal(f.kernel.db.prepare('SELECT count(*) n FROM commerce_checkout_exposures').get().n,1);assert.deepEqual(f.experiments.inspect(f.a.scope,'checkout-one').denominators,marketingOracle.denominators);
}));
test('CASE-M09-G03-02',()=>usingMarketing(f=>{
  const bot=f.shopper(2,{marketing_eligibility:{eligible:true,bot:true}});f.experiments.configure(f.owner.scope,f.experiment());
  assert.equal(f.experiments.assign(f.a.scope,{experiment_id:'checkout-one',case_id:bot.case_id,frontend_variants:['treatment','holdout']}).state,'excluded');
  assert.throws(()=>f.experiments.configure(f.owner.scope,f.experiment({version:2})),/FROZEN/);assert.throws(()=>f.experiments.assign(f.b.scope,{experiment_id:'checkout-one',case_id:'case_one',frontend_variants:['treatment','holdout']}));
  assert.throws(()=>f.experiments.assign(f.a.scope,{experiment_id:'checkout-one',case_id:'case_one',frontend_variants:['new_variant']}),/VARIANTS_CHANGED/);
}));
