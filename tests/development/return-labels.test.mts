import test from 'node:test';import assert from 'node:assert/strict';import { usingFulfillment } from './fulfillment-helpers.mts';
import { ExecutionStops } from '../../packages/commerce/execution-stops.mts';
test('CASE-M03-G13-01',()=>usingFulfillment(async f=>{const b=await f.buy(),l=f.labels.inspect(f.a.scope,b.labelId);assert.equal(b.result.state,'purchased');assert.equal(l.amount_minor,'500');assert.equal(l.currency,'USD');assert.match(l.charge_id,/^charge_/);assert.equal(l.request_id,f.request.id);assert.equal(f.fulfillmentSource.effects().length,1);}));
test('CASE-M03-G13-02',()=>usingFulfillment(f=>{const q=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null});f.labels.configureParcel(f.owner.scope,{...f.parcelInput,expected_revision:1,address_revision:2,to_address_ref:'warehouse-two'});assert.throws(()=>f.gateway.prepare(f.a.scope,q.proposal),/RATE_CHANGED/);assert.equal(f.fulfillmentSource.calls.buy,0);}));
test('CASE-M03-G13-03',()=>usingFulfillment(async f=>{const q=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null}),op=f.authorizeFulfillment(q);f.fulfillmentSource.fault='after';assert.equal((await f.execution.dispatch(f.a.scope,op.id)).state,'unknown');await f.execution.dispatch(f.a.scope,op.id);const r=await f.execution.reconcile(f.a.scope,op.id);assert.equal(r.state,'purchased');assert.equal(f.fulfillmentSource.calls.buy,1);assert.equal(f.fulfillmentSource.effects().length,1);}));
test('M03-G13-RATE-PREVIEW-HAS-NO-CHARGE',()=>usingFulfillment(f=>{const before=f.fulfillmentDb.prepare('SELECT total_changes() n').get().n;const q=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null});assert.equal(q.execution_authorized,false);assert.equal(f.fulfillmentSource.calls.rate,1);assert.equal(f.fulfillmentSource.calls.buy,0);assert.equal(f.fulfillmentDb.prepare('SELECT total_changes() n').get().n,before);}));
test('M03-G13-RATE-EXPIRY-BEFORE-PREPARATION',()=>usingFulfillment(f=>{const q=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null});f.advance(300000);assert.throws(()=>f.gateway.prepare(f.a.scope,q.proposal),/FULFILLMENT_QUOTE_EXPIRED/);assert.equal(f.fulfillmentSource.calls.buy,0);}));
test('M03-G13-PACKAGE-CHANGE-INVALIDATES-RATE',()=>usingFulfillment(f=>{const q=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null});f.labels.configureParcel(f.owner.scope,{...f.parcelInput,expected_revision:1,package:{...f.parcelInput.package,weight_g:501}});assert.throws(()=>f.gateway.prepare(f.a.scope,q.proposal),/RATE_CHANGED/);}));
test('M03-G13-SERVICE-CHANGE-INVALIDATES-RATE',()=>usingFulfillment(f=>{const q=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null});f.labels.configureParcel(f.owner.scope,{...f.parcelInput,expected_revision:1,service:'express'});assert.throws(()=>f.gateway.prepare(f.a.scope,q.proposal),/RATE_CHANGED/);}));
test('M03-G13-CUSTOMER-CANNOT-SET-DESTINATION',()=>usingFulfillment(f=>{assert.throws(()=>f.labels.configureParcel(f.customer,{...f.parcelInput,expected_revision:1}),/ACCESS_DENIED/);}));
test('M03-G13-PRICE-IS-SERVER-DERIVED',()=>usingFulfillment(f=>{assert.throws(()=>f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null,amount_minor:'0'}),/INVALID_INPUT/);assert.equal(f.fulfillmentSource.calls.rate,0);}));
test('M03-G13-PREVIEW-AMOUNT-EXACT',()=>usingFulfillment(f=>{const q=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null}),p=f.gateway.prepare(f.a.scope,q.proposal);assert.equal(p.preview.amount.minor,'500');assert.equal(p.preview.amount.currency,'USD');assert.equal(p.preview.financial_effect,false);}));
test('M03-G13-DUPLICATE-APPROVAL-NO-SECOND-LABEL',()=>usingFulfillment(f=>{const q=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null});f.authorizeFulfillment(q);const q2=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null});assert.throws(()=>f.authorizeFulfillment(q2),/OBLIGATION_ALREADY_AUTHORIZED/);assert.equal(f.fulfillmentSource.effects().length,0);}));
test('M03-G13-PURCHASE-RESPONSE-MUST-HAVE-CHARGE',()=>usingFulfillment(async f=>{const q=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null}),op=f.authorizeFulfillment(q),send=f.fulfillmentSource.buy.bind(f.fulfillmentSource);f.fulfillmentSource.buy=async c=>({...await send(c),charge_id:null});assert.equal((await f.execution.dispatch(f.a.scope,op.id)).state,'unknown');assert.equal((await f.execution.reconcile(f.a.scope,op.id)).state,'purchased');}));
test('M03-G13-CHANGED-ACCOUNT-INVALIDATES-PREVIEW',()=>usingFulfillment(f=>{const q=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null});f.config.configure(f.owner.scope,{...f.configInput,expected_revision:1,account_id:'other-account'});assert.throws(()=>f.gateway.prepare(f.a.scope,q.proposal),/RATE_CHANGED/);}));
test('M03-G13-CROSS-TENANT-QUOTE-DENIED',()=>usingFulfillment(f=>{assert.throws(()=>f.labels.quote(f.b.scope,{request_id:f.request.id,replaces:null}),/NOT_FOUND/);assert.equal(f.fulfillmentSource.calls.rate,0);}));
test('M03-G13-LABEL-READ-RECHECKS-SESSION',()=>usingFulfillment(async f=>{const b=await f.buy();f.kernel.revoke(f.a.scope);assert.throws(()=>f.labels.inspect(f.a.scope,b.labelId),/ACCESS_DENIED/);}));
test('M03-G13-SOURCE-RATE-CHANGE-NO-UNAPPROVED-CHARGE',()=>usingFulfillment(async f=>{const q=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null}),op=f.authorizeFulfillment(q);f.fulfillmentDb.prepare("UPDATE fixture_rates SET amount_minor='600',revision=2").run();assert.equal((await f.execution.dispatch(f.a.scope,op.id)).state,'unknown');assert.equal(f.fulfillmentSource.effects().length,0);}));
test('M03-G13-STOP-BEFORE-PURCHASE',()=>usingFulfillment(async f=>{const q=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null}),op=f.authorizeFulfillment(q);new ExecutionStops(f.kernel).set(f.owner.scope,{action:'diagnostic.label.purchase',stopped:true,reason:'incident',expected_revision:0});await assert.rejects(()=>f.execution.dispatch(f.a.scope,op.id),/EXECUTION_STOPPED/);assert.equal(f.fulfillmentSource.calls.buy,0);}));
test('M03-G13-ZERO-DIMENSION-REJECTED',()=>usingFulfillment(f=>{assert.throws(()=>f.labels.configureParcel(f.owner.scope,{...f.parcelInput,expected_revision:1,package:{...f.parcelInput.package,weight_g:0}}),/INVALID_INPUT/);}));
