import test from 'node:test';
import assert from 'node:assert/strict';
import { usingGift } from './gift-helpers.mts';
import { PrivacyLifecycle } from '../../packages/commerce/privacy-lifecycle.mts';
import { createRecoverySnapshot,restoreRecoverySnapshot,suppressionCheckpoint } from '../../packages/commerce/safe-recovery.mts';
import { contentDigest } from '../../packages/commerce/configuration-values.mts';
import { DatabaseSync } from 'node:sqlite';
import { join } from 'node:path';
import { readFileSync } from 'node:fs';
import { GiftReturns } from '../../packages/commerce/gift-returns.mts';
import { ReturnEvidence } from '../../packages/commerce/return-evidence.mts';

test('CASE-M06-G05-01',()=>usingGift(f=>{const choices=f.gifts.choices(f.accessInput);assert.deepEqual(choices.lines,[{line_id:'gamma',remaining:1}]);assert.deepEqual(choices.outcomes,['exchange','store_credit']);f.createGift();assert.equal(f.prepareGift().state,'awaiting_review');assert.equal(f.cases.verified(f.a.scope,'gift_case').customer_id,f.giftOrder.customer_id);assert.equal(f.cases.verified(f.a.scope,'gift_case').recipient_customer_id,'recipient-one');const text=JSON.stringify([choices,f.gifts.status({...f.accessInput,case_id:'gift_case'})]);for(const hidden of ['Private Purchaser','Hidden Buyer Address','8740','payment-one',f.giftOrder.id,f.giftFacts.recipient_email])assert.equal(text.includes(hidden),false);}));
test('CASE-M06-G05-02',()=>usingGift(f=>{assert.throws(()=>f.gifts.choices({store_id:f.a.store,token:'a'.repeat(43)}),/GIFT_VERIFICATION_REQUIRED/);f.createGift();assert.throws(()=>f.prepareGift({outcome:'refund'}),/GIFT_OUTCOME_DENIED/);assert.throws(()=>f.kernel.authenticate(f.verified.token),/ACCESS_DENIED/);}));
test('CASE-M06-G05-03',()=>usingGift(async f=>{f.createGift();f.prepareGift();f.cases.create(f.buyer,{case_id:'purchaser_case',resource_id:f.giftOrder.id,profile_id:'default',policy_id:'returns'});const q=f.intake.evaluate(f.buyer,{case_id:'purchaser_case',lines:[{line_id:'gamma',quantity:1}],outcome:'exchange',reason:'size',note:'',evidence_ids:[]});const buyer=f.intake.prepare(f.buyer,{quote_id:q.id,quote_digest:q.digest,request_key:'purchaser-request',override_id:null}),gift=f.intake.read(f.a.scope,'gift_case');const items=[gift,buyer].map(r=>({r,approval:f.gateway.approve(f.reviewer.scope,{preview_id:r.preview_id,preview_digest:r.preview_digest})}));const results=await Promise.allSettled(items.map(({r,approval})=>Promise.resolve().then(()=>f.gateway.execute(f.a.scope,{preview_id:r.preview_id,preview_digest:r.preview_digest,approval_id:approval.id}))));assert.equal(results.filter(r=>r.status==='fulfilled').length,1);assert.equal(results.filter(r=>r.status==='rejected').length,1);assert.equal(f.db.prepare("SELECT count(*) n FROM commerce_return_requests WHERE resource_id=? AND state='submitted'").get(f.giftOrder.id).n,1);}));
test('M06-G05-GIFT-TEXT-NEVER-VERIFIES',()=>usingGift(f=>{const before=f.outbox.length,q=f.gifts.request({store_id:f.a.store,gift_id:'message_says_gift',email:f.giftFacts.recipient_email},'fake-gift-client');assert.equal(q.accepted,true);assert.equal(f.outbox.length,before);assert.throws(()=>f.gifts.complete({store_id:f.a.store,challenge_id:q.challenge_id,proof:f.proof.proof}),/GIFT_VERIFICATION_REQUIRED/);}));
test('M06-G05-PROOF-ONE-TIME',()=>usingGift(f=>{assert.throws(()=>f.gifts.complete({store_id:f.a.store,challenge_id:f.challenge.challenge_id,proof:f.proof.proof}),/GIFT_VERIFICATION_REQUIRED/);}));
test('M06-G05-PROOF-ATTEMPT-LIMIT',()=>usingGift(f=>{const q=f.gifts.request({store_id:f.a.store,gift_id:f.giftFacts.gift_id,email:f.giftFacts.recipient_email},'proof-limits');const correct=f.outbox.at(-1).proof;for(let i=0;i<5;i++)assert.throws(()=>f.gifts.complete({store_id:f.a.store,challenge_id:q.challenge_id,proof:'wrong'}),/GIFT_VERIFICATION_REQUIRED/);assert.throws(()=>f.gifts.complete({store_id:f.a.store,challenge_id:q.challenge_id,proof:correct}),/GIFT_VERIFICATION_REQUIRED/);}));
test('M06-G05-CROSS-STORE-PROOF-DENIED',()=>usingGift(f=>{assert.throws(()=>f.gifts.choices({store_id:f.b.store,token:f.verified.token}),/GIFT_VERIFICATION_REQUIRED/);assert.throws(()=>f.gifts.createCase(f.b.scope,{gift_token:f.verified.token,case_id:'gift_case',profile_id:'default',policy_id:'returns'}),/GIFT_VERIFICATION_REQUIRED/);}));
test('M06-G05-PURCHASER-CANNOT-READ-RECIPIENT-CASE',()=>usingGift(f=>{f.createGift();f.prepareGift();assert.throws(()=>f.cases.inspect(f.buyer,'gift_case'),/NOT_FOUND/);assert.throws(()=>f.intake.read(f.buyer,'gift_case'),/NOT_FOUND/);assert.equal(f.kernel.get(f.buyer,f.giftOrder.id).payload.total_minor,'8740');}));
test('M06-G05-PRIVILEGED-STAFF-CANNOT-WIDEN-GIFT-LINES',()=>usingGift(f=>{f.createGift();assert.throws(()=>f.prepareGift({lines:[{line_id:'alpha',quantity:1}]}),/GIFT_UNITS_DENIED/);assert.throws(()=>f.prepareGift({lines:[{line_id:'gamma',quantity:2}]}),/GIFT_UNITS_DENIED/);}));
test('M06-G05-GENERIC-REFUND-AND-EDIT-GATEWAY-DENIED',()=>usingGift(f=>{f.createGift();assert.throws(()=>f.gateway.prepare(f.a.scope,{case_id:'gift_case',action:'diagnostic.resolution.set',arguments:{resolution:'refund'}}),/GIFT_ACTION_DENIED/);assert.throws(()=>f.gateway.prepare(f.a.scope,{case_id:'gift_case',action:'diagnostic.order.edit',arguments:{quote_id:'invented',quote_digest:'0'.repeat(64)}}),/GIFT_ACTION_DENIED/);}));
test('M06-G05-REVOKED-PROOF-BLOCKS-PENDING-APPROVAL',()=>usingGift(f=>{f.createGift();f.prepareGift();const r=f.intake.read(f.a.scope,'gift_case');f.gifts.revoke(f.accessInput);assert.throws(()=>f.gateway.approve(f.reviewer.scope,{preview_id:r.preview_id,preview_digest:r.preview_digest}),/GIFT_VERIFICATION_REQUIRED/);}));
test('M06-G05-EXPIRED-PROOF-BLOCKS-STAFF-CONTINUATION',()=>usingGift(f=>{f.createGift();f.advance(300001);assert.throws(()=>f.cases.verified(f.a.scope,'gift_case'),/GIFT_VERIFICATION_REQUIRED/);}));
test('M06-G05-SOURCE-RECIPIENT-CHANGE-REQUIRES-NEW-PROOF',()=>usingGift(f=>{f.createGift();f.updateGift({gift_facts:{...f.giftFacts,revision:2,recipient_email:'changed@example.invalid'}});assert.throws(()=>f.cases.verified(f.a.scope,'gift_case'),/GIFT_VERIFICATION_REQUIRED/);}));
test('M06-G05-DUPLICATE-CHOICE-NO-SECOND-REQUEST',()=>usingGift(f=>{f.createGift();f.prepareGift();assert.equal(f.prepareGift().duplicate,true);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_return_requests WHERE case_id=?').get('gift_case').n,1);assert.throws(()=>f.prepareGift({outcome:'store_credit'}),/GIFT_CHOICE_CONFLICT/);}));
test('M06-G05-DELIVERY-FAILURE-NEVER-VERIFIES',()=>usingGift(f=>{const deliveryFailure=new GiftReturns(f.kernel,()=>{throw new Error('delivery-failed');});const q=deliveryFailure.request({store_id:f.a.store,gift_id:f.giftFacts.gift_id,email:f.giftFacts.recipient_email},'delivery-failure');assert.equal(q.accepted,true);assert.equal(f.db.prepare('SELECT consumed FROM commerce_gift_challenges WHERE id=?').get(q.challenge_id).consumed,1);}));
test('M06-G05-RECIPIENT-EXPORT-EXCLUDES-PURCHASER',()=>usingGift(f=>{const out=new PrivacyLifecycle(f.kernel).export(f.owner.scope,'recipient-one'),text=JSON.stringify(out);assert.equal(out.resources.length,0);assert.equal(out.gift_returns.length,1);for(const hidden of ['Private Purchaser','Hidden Buyer Address','8740','payment-one',f.giftOrder.id,f.giftOrder.customer_id])assert.equal(text.includes(hidden),false);}));
test('M06-G05-RECIPIENT-ERASURE-PRESERVES-PURCHASER',()=>usingGift(f=>{f.createGift();const before=f.giftOrderNow();assert.equal(new PrivacyLifecycle(f.kernel).erase(f.owner.scope,'recipient-one').status,'logically_erased');const after=f.giftOrderNow();assert.equal(after.customer_id,before.customer_id);assert.equal(after.payload.total_minor,'8740');assert.equal(JSON.stringify(after.payload).includes('recipient@example.invalid'),false);assert.throws(()=>f.gifts.choices(f.accessInput),/GIFT_VERIFICATION_REQUIRED/);assert.throws(()=>f.updateGift({gift_facts:f.giftFacts}),/SUBJECT_ERASED/);}));
test('M06-G05-PURCHASER-ERASURE-REVOKES-GIFT-PROOF',()=>usingGift(f=>{f.createGift();new PrivacyLifecycle(f.kernel).erase(f.owner.scope,f.giftOrder.customer_id);assert.throws(()=>f.gifts.choices(f.accessInput),/GIFT_VERIFICATION_REQUIRED/);}));
test('M06-G05-RESTORE-SUPPRESSES-ERASED-RECIPIENT-GRANT',()=>usingGift(f=>{f.createGift();const snapshot=createRecoverySnapshot(f.kernel,join(f.directory,'gift-snapshot'));new PrivacyLifecycle(f.kernel).erase(f.owner.scope,'recipient-one');const suppression=suppressionCheckpoint(f.kernel),restored=restoreRecoverySnapshot({snapshot:snapshot.directory,destination:join(f.directory,'gift-restored'),manifest_sha256:snapshot.manifest_sha256,suppression,suppression_sha256:contentDigest(suppression)},f.now);const db=new DatabaseSync(restored.database);try{const row=db.prepare('SELECT payload FROM commerce_resources WHERE id=?').get(f.giftOrder.id);assert.equal(JSON.stringify(row).includes('recipient@example.invalid'),false);assert.equal(JSON.parse(row.payload).total_minor,'8740');assert.equal(db.prepare('SELECT count(*) n FROM commerce_gift_sessions WHERE revoked=0').get().n,0);}finally{db.close();}}));

test('M06-G05-RENEWAL-REQUIRES-FRESH-APPROVAL',()=>usingGift(f=>{f.createGift();f.prepareGift();const before=f.intake.read(f.a.scope,'gift_case'),approval=f.gateway.approve(f.reviewer.scope,{preview_id:before.preview_id,preview_digest:before.preview_digest}),renewed=f.renewGift();const r=f.gifts.rebind(f.a.scope,{gift_token:renewed.token,case_id:'gift_case',expected_revision:1});assert.equal(r.verification_revision,2);assert.equal(r.requires_new_preview,true);assert.throws(()=>f.gateway.execute(f.a.scope,{preview_id:before.preview_id,preview_digest:before.preview_digest,approval_id:approval.id}),/APPROVAL_UNAVAILABLE/);assert.throws(()=>f.gateway.approve(f.reviewer.scope,{preview_id:before.preview_id,preview_digest:before.preview_digest}),/PREVIEW_STALE/);f.prepareGift({gift_token:renewed.token});const after=f.intake.read(f.a.scope,'gift_case');assert.equal(after.id,before.id);assert.notEqual(after.preview_id,before.preview_id);f.submit(after);assert.equal(f.gifts.status({store_id:f.a.store,token:renewed.token,case_id:'gift_case'}).state,'submitted');}));
test('M06-G05-EXPIRED-PROOF-CAN-RESUME-SAME-CASE',()=>usingGift(f=>{f.createGift();f.prepareGift();const before=f.intake.read(f.a.scope,'gift_case');f.advance(300001);f.updateGift({gift_facts:{...f.giftFacts,revision:2,observed_at:f.now()}});const renewed=f.renewGift();f.gifts.rebind(f.a.scope,{gift_token:renewed.token,case_id:'gift_case',expected_revision:1});f.prepareGift({gift_token:renewed.token});const after=f.intake.read(f.a.scope,'gift_case');assert.equal(after.id,before.id);assert.notEqual(after.preview_id,before.preview_id);assert.equal(f.cases.verified(f.a.scope,'gift_case').recipient_customer_id,'recipient-one');}));
test('M06-G05-RENEWAL-CANNOT-TRANSFER-RECIPIENT',()=>usingGift(f=>{f.createGift();f.updateGift({gift_facts:{...f.giftFacts,revision:2,recipient_customer_id:'recipient-two',recipient_email:'recipient-two@example.invalid'}});const renewed=f.renewGift();assert.throws(()=>f.gifts.rebind(f.a.scope,{gift_token:renewed.token,case_id:'gift_case',expected_revision:1}),/GIFT_VERIFICATION_REQUIRED/);}));
test('M06-G05-RENEWAL-PRESERVES-ALLOCATED-UNITS',()=>usingGift(async f=>{const plan=await f.authorizeGift(),renewed=f.renewGift();f.gifts.rebind(f.a.scope,{gift_token:renewed.token,case_id:'gift_case',expected_revision:1});assert.deepEqual(f.ledger.read(f.a.scope,plan.id).allocations.map(a=>a.id),plan.allocations.map(a=>a.id));assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_resolution_units WHERE resource_id=?').get(f.giftOrder.id).n,1);assert.equal(f.gifts.choices({store_id:f.a.store,token:renewed.token}).lines[0].remaining,0);}));
test('M06-G05-PURCHASER-EXPORT-OMITS-RECIPIENT-ACTIVITY',()=>usingGift(f=>{f.createGift();f.prepareGift();const r=f.intake.read(f.a.scope,'gift_case'),out=new PrivacyLifecycle(f.kernel).export(f.owner.scope,f.giftOrder.customer_id),text=JSON.stringify(out);assert.equal(out.resources.some(o=>o.id===f.giftOrder.id),true);for(const hidden of ['gift_case',r.id,r.preview_id])assert.equal(text.includes(hidden),false);}));
test('M06-G05-GIFT-FREE-TEXT-USES-ERASABLE-EVIDENCE',()=>usingGift(f=>{f.createGift();assert.throws(()=>f.intake.evaluate(f.a.scope,{case_id:'gift_case',lines:[{line_id:'gamma',quantity:1}],outcome:'exchange',reason:'size',note:'recipient-private-marker',evidence_ids:[]}),/GIFT_PRIVATE_NOTE_REQUIRES_EVIDENCE/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_return_quotes WHERE case_id=?').get('gift_case').n,0);}));
test('M06-G05-ERASURE-KEEPS-PURCHASER-RETURN-WORKING',()=>usingGift(async f=>{const plan=await f.authorizeGift(),evidence=new ReturnEvidence(f.kernel),photo=JSON.parse(readFileSync(new URL('../fixtures/return-intake/photo.v1.json',import.meta.url),'utf8')).base64,e=evidence.upload(f.a.scope,{case_id:'gift_case',mime:'image/png',base64:photo,note:'recipient-private-marker'}),before=f.intake.read(f.a.scope,'gift_case');new PrivacyLifecycle(f.kernel).erase(f.owner.scope,'recipient-one');const stored=f.db.prepare('SELECT bytes,note,state FROM commerce_return_evidence WHERE id=?').get(e.id);assert.deepEqual({...stored},{bytes:null,note:'',state:'erased'});assert.equal(f.intake.read(f.a.scope,'gift_case').preview_digest,before.preview_digest);assert.equal(f.ledger.read(f.a.scope,plan.id).allocations[0].id,plan.allocations[0].id);f.cases.create(f.buyer,{case_id:'post_erasure_buyer',resource_id:f.giftOrder.id,profile_id:'default',policy_id:'returns'});const q=f.intake.evaluate(f.buyer,{case_id:'post_erasure_buyer',lines:[{line_id:'alpha',quantity:1}],outcome:'refund',reason:'size',note:'',evidence_ids:[]});assert.equal(q.quote.decision.decision,'allow');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_resolution_units WHERE resource_id=?').get(f.giftOrder.id).n,1);}));
test('M06-G05-LEDGER-CANNOT-UPGRADE-GIFT-TO-CASH',()=>usingGift(async f=>{await f.authorizeGift();const request=f.intake.read(f.a.scope,'gift_case');assert.throws(()=>f.ledger.allocate(f.a.scope,{request_id:request.id,request_key:'gift-allocation',lines:[{line_id:'gamma',units:[1],outcome:'refund'}]}),/GIFT_OUTCOME_DENIED/);}));
test('M06-G05-CREDIT-USES-VERIFIED-RECIPIENT-ACCOUNT',()=>usingGift(async f=>{const plan=await f.authorizeGift('store_credit'),gift=f.cases.verified(f.a.scope,'gift_case');f.source.seedGiftRecipient({resource_id:f.giftOrder.id,recipient_customer_id:gift.recipient_customer_id,gift_source_digest:gift.source_digest});const q=f.credit.quote(f.a.scope,plan.allocations[0].id);assert.equal(q.quote.customer_id,f.giftOrder.customer_id);assert.equal(q.quote.credit_beneficiary_id,'recipient-one');const op=f.authorize(q);assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'issued');const instrument=f.credit.instrument(f.a.scope,f.executor,op.id);assert.equal(instrument.instrument.customer_id,'recipient-one');assert.equal(instrument.amount_issued_minor,'1000');assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_credit_accounts WHERE customer_id=?').get(f.giftOrder.customer_id).n,0);await f.executor.dispatch(f.a.scope,op.id);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,1);}));
test('M06-G05-CREDIT-LOST-RESPONSE-RECONCILES-AFTER-ERASURE',()=>usingGift(async f=>{const plan=await f.authorizeGift('store_credit'),gift=f.cases.verified(f.a.scope,'gift_case');f.source.seedGiftRecipient({resource_id:f.giftOrder.id,recipient_customer_id:gift.recipient_customer_id,gift_source_digest:gift.source_digest});const op=f.authorize(f.credit.quote(f.a.scope,plan.allocations[0].id)),issue=f.source.issue.bind(f.source);let sends=0;f.source.issue=async p=>{sends++;await issue(p);throw new Error('lost');};assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');new PrivacyLifecycle(f.kernel).erase(f.owner.scope,'recipient-one');assert.equal((await f.executor.reconcile(f.a.scope,op.id)).state,'issued');assert.equal(sends,1);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,1);}));
