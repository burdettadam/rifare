import test from 'node:test';import assert from 'node:assert/strict';import{usingSupportModel}from'./support-model-helpers.mts';import{ModelBudgets}from'../../packages/commerce/model-budgets.mts';import{ExecutionStops}from'../../packages/commerce/execution-stops.mts';
test('CASE-M05-G10-01',()=>usingSupportModel(async f=>{f.fail('openai');const r=await f.routing.run(f.a.scope,'case_one',f.task.id,'route_one',f.runner,f.reads);assert.equal(r.status,'grounded_read');assert.deepEqual(r.attempted,['openai','anthropic']);assert.equal(r.task_id,f.task.id);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_receipts').get().n,0);}));
test('CASE-M05-G10-02',()=>usingSupportModel(async f=>{f.routing.configure(f.owner.scope,f.route({expected_version:1,fallbacks:[]}));f.fail('openai');const r=await f.routing.run(f.a.scope,'case_one',f.task.id,'route_one',f.runner,f.reads);assert.equal(r.status,'handoff');assert.deepEqual(f.requests.map(r=>r.provider),['openai']);assert.equal(r.restart_business_actions,false);}));
test('CASE-M05-G10-03',()=>usingSupportModel(async f=>{f.fail('openai');f.fail('anthropic');await f.routing.run(f.a.scope,'case_one',f.task.id,'route_one',f.runner,f.reads);const count=f.requests.length,r=await f.routing.run(f.a.scope,'case_one',f.task.id,'route_one',f.runner,f.reads);assert.equal(r.reason,'CIRCUIT_OPEN');assert.equal(f.requests.length,count);assert.equal(f.reads.task(f.a.scope,f.task.id).id,f.task.id);}));
test('CASE-M05-G11-01',()=>usingSupportModel(async f=>{f.ownership.assign(f.owner.scope,{case_id:'case_one',expected_generation:1,actor_id:'agent'});let first=true;f.before(()=>{if(first){first=false;f.ownership.takeover(f.a.scope,{case_id:'case_one',expected_generation:2,reason:'exception'});}});await assert.rejects(()=>f.routing.run(f.agent.scope,'case_one',f.task.id,'route_one',f.runner,f.reads),/OWNERSHIP_CHANGED|TAKEN_OVER/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_assistance_receipts').get().n,0);}));
test('CASE-M05-G11-02',()=>usingSupportModel(async f=>{new ExecutionStops(f.kernel).set(f.owner.scope,{action:'model.run',stopped:true,reason:'incident',expected_revision:0});await assert.rejects(()=>f.routing.run(f.a.scope,'case_one',f.task.id,'route_one',f.runner,f.reads),/EXECUTION_STOPPED/);assert.equal(f.tracking.read(f.a.scope,'case_one').status,'available');assert.equal(f.requests.length,0);}));
test('CASE-M05-G11-03',()=>usingSupportModel(f=>{f.ownership.assign(f.owner.scope,{case_id:'case_one',expected_generation:1,actor_id:'agent'});f.ownership.takeover(f.a.scope,{case_id:'case_one',expected_generation:2,reason:'operator_requested'});assert.throws(()=>f.gateway.prepare(f.agent.scope,f.proposal()),/TAKEN_OVER/);assert.throws(()=>f.delivery.queue(f.agent.scope,f.message({expected_generation:2})),/OWNERSHIP_CHANGED|TAKEN_OVER/);assert.equal(f.source.calls,0);}));
test('M05-G09-RUNNER-08',()=>usingSupportModel(async f=>{const b=new ModelBudgets(f.kernel);b.configure(f.owner.scope,{provider_id:'openai',period_id:'period',starts_at:f.now(),ends_at:f.now()+60000,limit_micro:'1000000',input_micro:'1',output_micro:'2',max_input_bytes:50000,max_output_tokens:512,expected_revision:0});const r=await f.runner.run(f.a.scope,f.task.id,'openai');assert.equal(r.status,'grounded_read');const totals=b.inspect(f.a.scope,'openai','period');assert.equal(totals.reservation_count,2);assert.equal(totals.charged_micro,'40');assert.equal(totals.held_micro,'0');}));
test('M05-G10-04',()=>usingSupportModel(async f=>{const fake={run:f.runner.run.bind(f.runner),configuration:()=>({...f.catalog[0],configuration_digest:'a'.repeat(64)})};await assert.rejects(()=>f.routing.run(f.a.scope,'case_one',f.task.id,'route_one',fake,f.reads),/DESTINATION_CHANGED/);assert.equal(f.requests.length,0);}));
