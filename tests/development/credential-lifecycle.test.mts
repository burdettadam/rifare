import test from 'node:test';import assert from 'node:assert/strict';
import { usingControls,credentials } from './worker-controls-helpers.mts';
import { CredentialLifecycle } from '../../packages/commerce/credential-lifecycle.mts';import { SecretVault } from '../../packages/commerce/secrets.mts';

test('CASE-M02-G20-01',()=>usingControls(async f=>{const w=f.claim(),c=credentials(f);c.put();const first=await c.service.probe(f.a.scope,'test-model');c.put('SYNTHETIC-KEY-TWO',1);const second=await c.service.probe(f.a.scope,'test-model');assert.deepEqual(c.seen,['SYNTHETIC-KEY-ONE','SYNTHETIC-KEY-TWO']);assert.equal(first.version,1);assert.equal(second.version,2);assert.equal(w.context().lease.generation,1);assert.deepEqual(c.service.history(f.owner.scope,'test-model').map(r=>r.version).sort(),[1,2]);}));
test('CASE-M02-G20-02',()=>usingControls(async f=>{const c=credentials(f);c.put();c.service.revoke(f.owner.scope,'test-model',1);await assert.rejects(c.service.probe(f.a.scope,'test-model'),/CREDENTIAL_UNAVAILABLE/);assert.equal(c.seen.length,0);}));
test('CASE-M02-G20-03',()=>usingControls(async f=>{const c=credentials(f);c.put();c.keys.activeId='two';c.service.rewrap(f.owner.scope,'test-model');c.keys.get=id=>id==='two'?c.two:undefined;const r=f.reopen();try{const vault=new SecretVault(r.kernel,c.keys,{'local-probe':()=>true}),service=new CredentialLifecycle(r.kernel,vault);assert.equal((await service.probe(r.scope,'test-model')).state,'succeeded');}finally{r.db.close();}}));
test('M02-G20-CUTOVER-REJECTS-STALE-REVISION',()=>usingControls(f=>{const c=credentials(f);c.put();assert.throws(()=>c.put('SYNTHETIC-BAD',0),/CREDENTIAL_CHANGED/);assert.equal(c.vault.list(f.owner.scope).length,1);}));
test('M02-G20-TARGET-CANNOT-CHANGE-DURING-CUTOVER',()=>usingControls(f=>{const c=credentials(f);c.put();assert.throws(()=>c.service.configure(f.owner.scope,{slot_id:'test-model',provider:'other',adapter:'local-probe',value:'bad',expected_revision:1}),/CREDENTIAL_TARGET_CHANGED/);}));
test('M02-G20-REVOKED-RAW-REFERENCE-CANNOT-BE-REUSED',()=>usingControls(async f=>{const c=credentials(f);c.put();const old=c.vault.list(f.owner.scope)[0].ref;c.put('NEW',1);await assert.rejects(c.vault.probe(f.a.scope,old,'local-probe'),/SECRET_UNAVAILABLE/);assert.equal(c.seen.length,0);}));
test('M02-G20-ROTATION-IN-FLIGHT-REMAINS-UNKNOWN',()=>usingControls(async f=>{let release!:(v:boolean)=>void;const c=credentials(f,()=>new Promise(r=>release=r));c.put();const pending=c.service.probe(f.a.scope,'test-model');await Promise.resolve();c.put('NEW',1);release(true);const result=await pending;assert.equal(result.state,'unknown');assert.equal(result.configured,null);assert.equal(result.version,1);assert.equal(result.automatic_retry,false);}));
test('M02-G20-REVOCATION-IN-FLIGHT-REMAINS-UNKNOWN',()=>usingControls(async f=>{let release!:(v:boolean)=>void;const c=credentials(f,()=>new Promise(r=>release=r));c.put();const pending=c.service.probe(f.a.scope,'test-model');await Promise.resolve();c.service.revoke(f.owner.scope,'test-model',1);release(true);assert.equal((await pending).state,'unknown');}));
test('M02-G20-REVOKED-AUTHORITY-BLOCKS-NEW-CALL',()=>usingControls(async f=>{const c=credentials(f);c.put();f.permissions.change(f.owner.scope,{actor_id:'operator',role:'operator',expected_revision:0,actions:['resource.read'],resource_ids:null});await assert.rejects(c.service.probe(f.a.scope,'test-model'),/ACCESS_DENIED/);assert.equal(c.seen.length,0);}));
test('M02-G20-CROSS-TENANT-SLOT-DENIED',()=>usingControls(async f=>{const c=credentials(f);c.put();await assert.rejects(c.service.probe(f.b.scope,'test-model'),/CREDENTIAL_UNAVAILABLE/);assert.deepEqual(c.service.history(f.b.scope,'test-model'),[]);}));
test('M02-G20-NO-PLAINTEXT-IN-RESULTS-OR-DATABASE',()=>usingControls(async f=>{const c=credentials(f);c.put('SECRET-CANARY-DO-NOT-LOG');const result=await c.service.probe(f.a.scope,'test-model');for(const value of [result,c.service.status(f.owner.scope,'test-model'),c.service.history(f.owner.scope,'test-model'),f.db.prepare('SELECT * FROM commerce_secrets').all(),f.db.prepare('SELECT * FROM commerce_control_events').all()])assert.equal(JSON.stringify(value).includes('SECRET-CANARY-DO-NOT-LOG'),false);}));
test('M02-G20-PROVIDER-ERROR-REDACTED',()=>usingControls(async f=>{const c=credentials(f,()=>{throw new Error('SECRET-CANARY-DO-NOT-LOG');});c.put('SECRET-CANARY-DO-NOT-LOG');const result=await c.service.probe(f.a.scope,'test-model');assert.equal(result.state,'unknown');assert.equal(JSON.stringify(result).includes('SECRET-CANARY'),false);}));
test('M02-G20-MISSING-KEY-HAS-NO-RECOVERY-FALLBACK',()=>usingControls(async f=>{const c=credentials(f);c.put();c.keys.get=()=>undefined;assert.equal((await c.service.probe(f.a.scope,'test-model')).state,'unknown');assert.deepEqual(c.seen,[]);}));
test('M02-G20-FAILED-KEY-CUTOVER-IS-ATOMIC',()=>usingControls(f=>{const c=credentials(f);c.put();c.keys.activeId='missing';assert.throws(()=>c.put('NEW',1),/SECRET_UNAVAILABLE/);assert.equal(c.service.status(f.owner.scope,'test-model').version,1);}));
test('M02-G20-STOP-BEFORE-NEW-CALL',()=>usingControls(async f=>{const c=credentials(f);c.put();f.stops.set(f.owner.scope,{action:'credential.probe',stopped:true,expected_revision:0,reason:'incident'});await assert.rejects(c.service.probe(f.a.scope,'test-model'),/EXECUTION_STOPPED/);assert.equal(c.seen.length,0);}));
test('M02-G20-CREDENTIAL-VERSION-IDENTITY-IMMUTABLE',()=>usingControls(f=>{const c=credentials(f);c.put();assert.throws(()=>f.db.prepare('UPDATE commerce_credential_versions SET version=99').run(),/CREDENTIAL_VERSION_IMMUTABLE/);}));
