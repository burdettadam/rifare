import test from 'node:test';import assert from 'node:assert/strict';
import { Permissions,ROLE_ACTIONS } from '../../packages/commerce/authorization.mts';
import { readFixture,useRead } from './read-workflow-helpers.mts';
import { useAgent } from './agent-helpers.mts';
import { useModel } from './agent-provider-helpers.mts';
import { SecretVault } from '../../packages/commerce/secrets.mts';
function prepare(f:any){
 f.kernel.provisionMember(f.a.tenant,f.a.store,'owner','owner');const ownerToken=f.kernel.issueSession(f.a.tenant,f.a.store,'owner');const owner=f.kernel.authenticate(ownerToken);
 const roles:any={};for(const role of ['operator','reviewer','integration','agent']){const actor='role-'+role;f.kernel.provisionMember(f.a.tenant,f.a.store,actor,role);const bearer=f.kernel.issueSession(f.a.tenant,f.a.store,actor);roles[role]={scope:f.kernel.authenticate(bearer),actor,bearer};}
 return {p:new Permissions(f.kernel),owner,ownerToken,roles};
}
test('CASE-M02-G01-01',()=>useRead(f=>{const {p,roles,owner}=prepare(f);const resource=f.order().id;
 const expected={operator:[true,false,true],reviewer:[true,false,false],integration:[true,false,false],agent:[true,false,true]};
 for(const [role,values] of Object.entries(expected)){assert.deepEqual(['resource.read','authority.manage','model.run'].map(a=>p.preview(roles[role].scope,a,resource).allowed),values);}
 assert.equal(p.preview(owner,'authority.manage').allowed,true);assert.equal(f.kernel.get(roles.agent.scope,resource).id,resource);}));
test('CASE-M02-G01-02',()=>useRead(f=>{const {p,roles}=prepare(f);assert.throws(()=>p.change(roles.agent.scope,{role:'owner',budget:'infinite',approval_threshold:0}),/ACCESS_DENIED/);
 const rows=f.db.prepare('SELECT * FROM commerce_security_events').all();assert.equal(rows.at(-1).decision,'denied');assert.equal(JSON.stringify(rows).includes('infinite'),false);}));
test('CASE-M02-G01-03',()=>useRead(f=>{const {p,roles,owner}=prepare(f);const resource=f.order().id;assert.equal(p.preview(roles.agent.scope,'resource.read',resource).allowed,true);
 p.change(owner,{actor_id:roles.agent.actor,role:'agent',actions:[],resource_ids:null,expected_revision:0});assert.throws(()=>f.kernel.get(roles.agent.scope,resource),/ACCESS_DENIED/);}));
test('M02-G01-NO-ROLE-FORGED-IN-SCOPE',()=>useRead(f=>{assert.throws(()=>new Permissions(f.kernel).preview({role:'owner',tenant_id:f.a.tenant},'authority.manage'),/ACCESS_DENIED/);}));
test('M02-G01-CROSS-STORE-GRANT',()=>useRead(f=>{const {p,roles,owner}=prepare(f);assert.throws(()=>p.change(owner,{actor_id:roles.agent.actor,role:'agent',actions:null,resource_ids:[f.order(f.b).id],expected_revision:0}),/NOT_FOUND/);}));
test('M02-G01-SCOPED-ORDER-AND-LIST',()=>useRead(f=>{const {p,roles,owner}=prepare(f),first=f.order().id;const second=f.kernel.ingest(f.a.scope,{kind:'order',source_system:'synthetic',external_id:'OTHER',source_version:1,source_updated_at:f.now(),customer_id:'C-1001',payload:{status:'processing'}});
 p.change(owner,{actor_id:roles.agent.actor,role:'agent',actions:null,resource_ids:[first],expected_revision:0});assert.equal(f.kernel.get(roles.agent.scope,first).id,first);assert.throws(()=>f.kernel.get(roles.agent.scope,second.id),/ACCESS_DENIED/);assert.deepEqual(f.kernel.list(roles.agent.scope,'order').map(r=>r.id),[first]);}));
test('M02-G01-REISSUED-SESSIONS-NO-ESCALATION',()=>useRead(f=>{const {p,roles,owner}=prepare(f);p.change(owner,{actor_id:roles.agent.actor,role:'reviewer',actions:null,resource_ids:null,expected_revision:0});assert.throws(()=>f.kernel.get(roles.agent.scope,f.order().id),/ACCESS_DENIED/);
 const scope=f.kernel.authenticate(f.kernel.issueSession(f.a.tenant,f.a.store,roles.agent.actor));assert.equal(p.preview(scope,'model.run').allowed,false);}));
test('M02-G01-STALE-AUTHORITY-REVISION',()=>useRead(f=>{const {p,roles,owner}=prepare(f),change={actor_id:roles.agent.actor,role:'agent',actions:null,resource_ids:null,expected_revision:0};p.change(owner,change);assert.throws(()=>p.change(owner,change),/AUTHORITY_CHANGED/);}));
test('M02-G01-LAST-OWNER-PRESERVED',()=>useRead(f=>{const {p,owner}=prepare(f);assert.throws(()=>p.change(owner,{actor_id:'owner',role:'operator',actions:null,resource_ids:null,expected_revision:0}),/LAST_OWNER/);assert.equal(p.preview(owner,'authority.manage').allowed,true);}));
test('M02-G01-OWNER-CANNOT-LOCK-OUT-ADMIN',()=>useRead(f=>{const {p,owner}=prepare(f);assert.throws(()=>p.change(owner,{actor_id:'owner',role:'owner',actions:[],resource_ids:null,expected_revision:0}),/INVALID_PERMISSION/);}));
test('M02-G01-UNKNOWN-ACTIONS-NO-DEFAULT-ALLOW',()=>useRead(f=>{const {p,owner}=prepare(f);assert.equal(p.preview(owner,'refund.execute').allowed,false);assert.throws(()=>f.kernel.authorize(owner,'invented.write'),/ACCESS_DENIED/);}));
test('M02-G01-ROLES-CANNOT-GRANT-UNAVAILABLE-ACTIONS',()=>useRead(f=>{const {p,roles,owner}=prepare(f);assert.throws(()=>p.change(owner,{actor_id:roles.agent.actor,role:'agent',actions:['authority.manage'],resource_ids:null,expected_revision:0}),/INVALID_PERMISSION/);}));
test('M02-G01-REVIEWER-CANNOT-CHANGE-PROFILE',()=>useRead(f=>{const {roles}=prepare(f);assert.throws(()=>f.reads.profiles.put(roles.reviewer.scope,f.profile()),/ACCESS_DENIED/);assert.throws(()=>f.reads.knowledge.put(roles.reviewer.scope,f.source()),/ACCESS_DENIED/);}));
test('M02-G01-AGENT-CANNOT-INGEST',()=>useRead(f=>{const {roles}=prepare(f);assert.throws(()=>f.kernel.ingest(roles.agent.scope,{kind:'order',source_system:'synthetic',external_id:'x',source_version:1,source_updated_at:f.now(),customer_id:null,payload:{}}),/ACCESS_DENIED/);}));
test('M02-G01-INTEGRATION-CAN-INGEST-NOT-ADMIN',()=>useRead(f=>{const {roles,p}=prepare(f);assert.equal(f.kernel.ingest(roles.integration.scope,{kind:'catalog',source_system:'synthetic',external_id:'x',source_version:1,source_updated_at:f.now(),customer_id:null,payload:{}}).external_id,'x');assert.equal(p.preview(roles.integration.scope,'authority.manage').allowed,false);}));
test('M02-G01-PRIVATE-AUDIT-SCOPING',()=>useRead(f=>{const {p,roles}=prepare(f);assert.throws(()=>p.change(roles.agent.scope,{}));assert.equal(p.events(roles.reviewer.scope).length,1);assert.equal(p.events(f.b.scope).length,0);assert.throws(()=>p.events(roles.agent.scope),/ACCESS_DENIED/);}));
test('M02-G01-CANNOT-MODIFY-ANOTHER-TENANT',()=>useRead(f=>{const {p,owner}=prepare(f);assert.throws(()=>p.change(owner,{actor_id:'nonexistent',role:'agent',actions:null,resource_ids:null,expected_revision:0}),/NOT_FOUND/);}));
test('M02-G01-PROFILE-TEXT-CANNOT-CHANGE-AUTHORITY',()=>useRead(f=>{const {p,roles}=prepare(f);assert.throws(()=>f.reads.profiles.put(roles.agent.scope,{...f.profile(),role:'owner'}),/ACCESS_DENIED/);assert.equal(p.preview(roles.agent.scope,'authority.manage').allowed,false);}));
test('M02-G01-PRIVILEGED-CHANGE-ATOMIC-AUDIT',()=>useRead(f=>{const {p,roles,owner}=prepare(f);const r=p.change(owner,{actor_id:roles.agent.actor,role:'agent',actions:['resource.read'],resource_ids:null,expected_revision:0});const events=p.events(owner);assert.equal(r.revision,1);assert.equal(events[0].authority_revision,1);assert.equal(events[0].operation,'authority_change');assert.equal(events[0].target_actor,roles.agent.actor);}));
test('M02-G01-MIDFLIGHT-MODEL-REVOCATION',()=>useModel(async f=>{const {p,owner}=prepare(f);f.setBefore(()=>p.change(owner,{actor_id:'operator',role:'operator',actions:['resource.read','task.read','profile.read','skill.read'],resource_ids:null,expected_revision:0}));await assert.rejects(()=>f.runner.run(f.a.scope,f.task.id,'openai'),/ACCESS_DENIED/);}));
test('M02-G01-OWNER-POLICY-HTTP',()=>useAgent(async f=>{const {p,roles,ownerToken}=prepare(f);let r=await f.request('/v1/permissions');assert.equal(r.status,200);r=await f.request('/v1/permissions/change',{actor_id:roles.agent.actor,role:'agent',actions:['resource.read'],resource_ids:null,expected_revision:0},ownerToken);assert.equal(r.status,200);assert.equal(p.preview(roles.agent.scope,'model.run').allowed,false);}));
test('M02-G01-AGENT-HTTP-NO-SELF-APPROVAL',()=>useAgent(async f=>{const {roles}=prepare(f);const r=await f.request('/v1/permissions/change',{actor_id:roles.agent.actor,role:'owner',actions:null,resource_ids:null,expected_revision:0},roles.agent.bearer);assert.equal(r.status,403);}));
test('M02-G01-TABLES-FROZEN',()=>{assert.ok(Object.isFrozen(ROLE_ACTIONS));assert.ok(Object.isFrozen(ROLE_ACTIONS.agent));assert.throws(()=>{(ROLE_ACTIONS.agent as any).push('authority.manage');});});
