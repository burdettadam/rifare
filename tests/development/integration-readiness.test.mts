import { DurableWork } from "../../packages/commerce/durable-work.mts";
import test from 'node:test';import assert from 'node:assert/strict';
import { usingExecution } from './execution-helpers.mts';
import { IntegrationReadiness,qualifyLocalDraft,DRAFT_ACTION } from '../../packages/commerce/integration-readiness.mts';
import { Permissions } from '../../packages/commerce/authorization.mts';
import { startCommerceServer } from '../../apps/commerce-api/server.mts';

test('CASE-M02-G23-01',()=>usingExecution(f=>{const r=new IntegrationReadiness(f.kernel);assert.equal(r.inspect(f.agent.scope,DRAFT_ACTION).ready,true);assert.equal(r.inspect(f.agent.scope,'order.refund').ready,false);assert.equal(r.inspect(f.agent.scope,DRAFT_ACTION).production_qualified,false);}));
test('CASE-M02-G23-02',()=>usingExecution(f=>{f.db.prepare("UPDATE commerce_connections SET adapter='woocommerce',qualification='unverified' WHERE store_id=?").run(f.a.store);assert.equal(new IntegrationReadiness(f.kernel).inspect(f.owner.scope,'order.edit').ready,false);assert.throws(()=>f.preview());assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_receipts').get().n,0);}));
test('CASE-M02-G23-03',()=>usingExecution(f=>{qualifyLocalDraft(f.kernel,f.kernel.require(f.owner.scope),1,100);const p=f.preview(),a=f.approve(p);f.advance(101);assert.throws(()=>f.execute(p,a),/INTEGRATION_NOT_READY/);assert.equal(f.db.prepare('SELECT uses FROM commerce_action_approvals').get().uses,0);}));
test('M02-G23-SCOPE-REMOVAL',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.db.prepare("UPDATE commerce_connections SET granted_scopes='[]' WHERE store_id=?").run(f.a.store);assert.equal(new IntegrationReadiness(f.kernel).inspect(f.agent.scope,DRAFT_ACTION).ready,false);assert.throws(()=>f.execute(p,a));}));
test('M02-G23-PROOF-REVOCATION',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);new IntegrationReadiness(f.kernel).revoke(f.owner.scope,{action:DRAFT_ACTION});assert.throws(()=>f.execute(p,a),/INTEGRATION_NOT_READY/);}));
test('M02-G23-NO-PROFILE-FLAG',()=>usingExecution(f=>{f.db.prepare('DELETE FROM commerce_action_readiness').run();assert.throws(()=>f.preview(),/INTEGRATION_NOT_READY/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_previews').get().n,0);}));
test('M02-G23-PROOF-DIGEST',()=>usingExecution(f=>{f.db.prepare("UPDATE commerce_action_readiness SET evidence_digest=?").run('a'.repeat(64));assert.throws(()=>f.preview(),/INTEGRATION_NOT_READY/);}));
test('M02-G23-ACCOUNT-REVISION',()=>usingExecution(f=>{f.db.prepare('UPDATE commerce_connections SET revision=revision+1 WHERE store_id=?').run(f.a.store);assert.equal(new IntegrationReadiness(f.kernel).inspect(f.agent.scope,DRAFT_ACTION).ready,false);}));
test('M02-G23-AGENT-CANNOT-QUALIFY',()=>usingExecution(f=>{assert.throws(()=>f.gateway.configure(f.agent.scope,{enabled:true,expected_revision:1,profile_id:'default',policy_id:'returns'}),/ACCESS_DENIED/);assert.throws(()=>new IntegrationReadiness(f.kernel).revoke(f.agent.scope,{action:DRAFT_ACTION}),/ACCESS_DENIED/);}));
test('M02-G23-CROSS-STORE-PROOF',()=>usingExecution(f=>{assert.equal(new IntegrationReadiness(f.kernel).inspect(f.b.scope,DRAFT_ACTION).ready,false);}));
test('M02-G23-SCOPE-LIMIT-CURRENT',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);new Permissions(f.kernel).change(f.owner.scope,{actor_id:f.agent.actor,role:'agent',actions:['resource.read','case.read'],resource_ids:null,expected_revision:0});assert.throws(()=>f.execute(p,a),/ACCESS_DENIED/);}));
test('M02-G23-HTTP-READINESS-DENIAL',()=>usingExecution(async f=>{const server=await startCommerceServer({kernel:f.kernel,caps:f.caps,reads:f.reads,customers:f.customers,simulator:f.simulator});try{
 const call=async(path:string,data:any)=>{const r=await fetch(server.url+path,{method:'POST',headers:{authorization:'Bearer '+f.a.bearer,'content-type':'application/json'},body:JSON.stringify(data)});return {status:r.status,body:await r.json()};};
 assert.equal((await call('/v1/integrations/readiness',{action:DRAFT_ACTION})).body.ready,true);new IntegrationReadiness(f.kernel).revoke(f.owner.scope,{action:DRAFT_ACTION});const r=await call('/v1/execution/preview',f.proposal());assert.equal(r.body.error,'INTEGRATION_NOT_READY');assert.notEqual(r.status,200);
 }finally{await server.close();}}));
test('M02-G23-READINESS-RECHECKED-BEFORE-QUEUED-DISPATCH',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.execute(p,a);const op=f.db.prepare('SELECT id FROM commerce_operations').get().id;new IntegrationReadiness(f.kernel).revoke(f.owner.scope,{action:DRAFT_ACTION});assert.throws(()=>new DurableWork(f.kernel).claim(f.owner.scope,op),/INTEGRATION_NOT_READY/);assert.equal(f.db.prepare('SELECT state FROM commerce_operation_work WHERE operation_id=?').get(op).state,'pending');}));
