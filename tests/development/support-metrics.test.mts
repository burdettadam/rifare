import{Permissions}from'../../packages/commerce/authorization.mts';
import test from'node:test';import assert from'node:assert/strict';import{usingSupport}from'./support-helpers.mts';import{installSupportSkills}from'./support-workflow-helpers.mts';import{SupportMetrics}from'../../packages/commerce/support-metrics.mts';
function prepare(f:any){const m=new SupportMetrics(f.kernel),{workflows,digests}=installSupportSkills(f);f.create('case_two');f.create('case_three');m.freeze(f.a.scope,{id:'cohort',case_ids:['case_one','case_two','case_three'],starts_at:f.now(),ends_at:f.now()+60000});f.advance(1);const result=workflows.complete(f.a.scope,'case_one','support-reply',digests['support-reply'],'answer');return{m,result};}
test('CASE-M05-G14-01',()=>usingSupport(f=>{const{m,result}=prepare(f);m.close(f.a.scope,{case_id:'case_two',event_id:'closed'});m.confirm(f.customer,{case_id:'case_one',event_id:'confirmed',attempt_id:result.id});const r=m.report(f.a.scope,'cohort');assert.equal(r.denominator,3);assert.equal(r.correct_handling,1);assert.equal(r.customer_confirmed_resolutions,1);assert.equal(r.ticket_closures,1);assert.equal(r.pending_cases,2);assert.equal(r.resolution_rate,1/3);assert.equal(r.repeat_contact.immature,1);}));
test('CASE-M05-G14-02',()=>usingSupport(f=>{const{m,result}=prepare(f);m.close(f.a.scope,{case_id:'case_one',event_id:'closed'});assert.equal(m.report(f.a.scope,'cohort').customer_confirmed_resolutions,0);assert.throws(()=>m.confirm(f.a.scope,{case_id:'case_one',event_id:'self_claim',attempt_id:result.id}),/CUSTOMER_VERIFICATION_REQUIRED/);m.confirm(f.customer,{case_id:'case_one',event_id:'same',attempt_id:result.id});m.confirm(f.customer,{case_id:'case_one',event_id:'same',attempt_id:result.id});assert.equal(m.report(f.a.scope,'cohort').customer_confirmed_resolutions,1);}));
test('CASE-M05-G14-03',()=>usingSupport(f=>{const{m}=prepare(f);const add=(id:string,cat:string,n:string|null,adjustment:string|null=null)=>m.cost(f.a.scope,{id,case_id:'case_one',category:cat,currency:'USD',amount_minor:n,source_ref:'fixture_receipt',adjustment_of:adjustment});add('revenue','retained_revenue','10000');assert.equal(m.report(f.a.scope,'cohort').cases[0].declared_contribution_minor,null);add('goods','goods','5000');add('shipping','shipping','800');add('fees','platform_fees','200');add('time','operator_time','1000');assert.equal(m.report(f.a.scope,'cohort').cases[0].declared_contribution_minor,'3000');add('late','shipping','200','shipping');assert.equal(m.report(f.a.scope,'cohort').cases[0].declared_contribution_minor,'2800');add('late','shipping','200','shipping');assert.equal(m.report(f.a.scope,'cohort').cases[0].declared_contribution_minor,'2800');}));
test('M05-G14-04',()=>usingSupport(f=>{const{m,result}=prepare(f);m.confirm(f.customer,{case_id:'case_one',event_id:'yes',attempt_id:result.id});f.advance(7*86400000);f.a.scope=f.kernel.authenticate(f.kernel.issueSession(f.a.tenant,f.a.store,'operator'));const r=m.report(f.a.scope,'cohort');assert.equal(r.repeat_contact.missing_followup,1);assert.equal(r.repeat_contact.rate,null);assert.equal(r.denominator,3);}));
test('M05-G14-05',()=>usingSupport(f=>{const{m,result}=prepare(f);m.confirm(f.customer,{case_id:'case_one',event_id:'yes',attempt_id:result.id});f.conversations.link(f.a.scope,f.customer,{case_id:'case_one',channel:'email',account_id:'merchant_mail',external_id:'thread_one',history:'complete',source_revision:2});f.advance(1);f.conversations.ingest(f.a.scope,{link_id:f.link.id,external_id:'repeat',direction:'incoming',visibility:'public',source_at:f.now(),text:'Still unresolved'});f.advance(7*86400000);f.a.scope=f.kernel.authenticate(f.kernel.issueSession(f.a.tenant,f.a.store,'operator'));m.followup(f.a.scope,{case_id:'case_one',through_at:f.now(),expected_version:0,source_ref:'fixture_full_sync'});const r=m.report(f.a.scope,'cohort');assert.equal(r.repeat_contact.mature,1);assert.equal(r.repeat_contact.recontacts,1);assert.equal(r.repeat_contact.rate,1);}));
test('M05-G14-06',()=>usingSupport(f=>{const{m}=prepare(f);assert.throws(()=>m.freeze(f.a.scope,{id:'cohort',case_ids:['case_one'],starts_at:f.now(),ends_at:f.now()+60000}),/CONFIGURATION_CHANGED/);assert.throws(()=>m.freeze(f.a.scope,{id:'duplicates',case_ids:['case_one','case_one'],starts_at:f.now(),ends_at:f.now()+60000}),/COHORT_INVALID/);}));
test('M05-G14-07',()=>usingSupport(f=>{const{m}=prepare(f);assert.throws(()=>m.report(f.b.scope,'cohort'),/CONFIGURATION_MISSING/);const p={id:'cost',case_id:'case_one',category:'shipping',currency:'USD',amount_minor:'100',source_ref:'source',adjustment_of:null};m.cost(f.a.scope,p);assert.throws(()=>m.cost(f.a.scope,{...p,amount_minor:'0'}),/EVENT_CONFLICT/);}));

test('M05-G14-08',()=>usingSupport(f=>{const original=f.kernel.transaction.bind(f.kernel);let once=true;f.kernel.transaction=(fn:any)=>{if(once){once=false;new Permissions(f.kernel).change(f.owner.scope,{actor_id:f.kernel.require(f.a.scope).actor_id,role:'operator',actions:['case.read','support.read'],resource_ids:null,expected_revision:0});}return original(fn);};assert.throws(()=>new SupportMetrics(f.kernel).close(f.a.scope,{case_id:'case_one',event_id:'late_close'}),/ACCESS_DENIED/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_support_completions').get().n,0);}));
