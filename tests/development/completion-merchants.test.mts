import test from 'node:test';import assert from 'node:assert/strict';import {createReturnCompletionDemo} from '../../packages/development/return-completion-demo.mts';
test('M03-G20-TWO-MERCHANTS-SHARED-SKILL-DIFFERENT-INVENTORY-POLICY',async()=>{const a=await createReturnCompletionDemo({store:'merchant_a',inventory_buffer:2}),b=await createReturnCompletionDemo({store:'merchant_b',inventory_buffer:3});try{assert.equal(a.skills['handle-exchange'],b.skills['handle-exchange']);const args=(f:any)=>({request_id:f.request.id,workflow:'exchange',allocation_id:f.plan.allocations.find((a:any)=>a.outcome==='exchange').id,catalog_id:f.catalog.id});assert.equal(a.workflows.quote(a.operator.scope,args(a)).quote.balance_minor,'0');const denied=b.workflows.quote(b.operator.scope,args(b));assert.equal(denied.quote.allowed,false);assert(denied.quote.reasons.includes('INSUFFICIENT_STOCK'));assert.deepEqual(denied.quote.alternatives,['refund','store_credit']);assert.equal(a.nativeSource.effects().length,0);assert.equal(b.nativeSource.effects().length,0);}finally{a.cleanup();b.cleanup();}});
