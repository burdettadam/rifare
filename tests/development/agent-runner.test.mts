import test from 'node:test';import assert from 'node:assert/strict';
import { useModel } from './agent-provider-helpers.mts';
import { ReadRunner } from '../../packages/agent/runner.mts';
import { providerReader } from '../../packages/agent/providers.mts';
import { statusFacts } from '../../packages/agent/facts.mts';

test('CASE-M01-G13-01',()=>useModel(async f=>{const r=await f.runner.run(f.a.scope,f.task.id,'openai');assert.equal(r.status,'grounded_read');
 assert.equal(r.claims.find((c:any)=>c.id==='order.number').value,'ORD-1001');assert.equal(r.source_digest,statusFacts(f.task.facts).digest);assert.equal(r.receipt.model_calls,2);}));
test('CASE-M01-G13-02',()=>useModel(async f=>{f.setMutate(r=>{if(r.output[0].name==='finish_status')r.output[0].arguments=JSON.stringify({source_digest:'invented',fact_ids:['tomorrow']});return r;});
 const r=await f.runner.run(f.a.scope,f.task.id,'openai');assert.equal(r.status,'handoff');assert.equal(r.answer,null);assert.equal(r.reason,'UNGROUNDED_OUTPUT');}));
test('CASE-M01-G13-03',()=>useModel(async f=>{await f.runner.run(f.a.scope,f.task.id,'openai');const resumed=new ReadRunner(f.kernel,f.reads,f.vault,f.configs);
 const r=await resumed.run(f.a.scope,f.task.id,'openai');assert.equal(r.status,'grounded_read');
 const saved=JSON.stringify(f.db.prepare('SELECT * FROM commerce_assistance_receipts').all());assert.equal(saved.includes('private_response'),false);assert.equal(saved.includes('call_id'),false);
 for(const request of f.requests){assert.equal('previous_response_id' in request.body,false);assert.equal('conversation' in request.body,false);}}));
test('M01-G13-MALFORMED-ARGUMENTS',()=>useModel(async f=>{f.setMutate(r=>{r.output[0].arguments='{';return r;});const r=await f.runner.run(f.a.scope,f.task.id,'openai');assert.equal(r.status,'handoff');assert.equal(r.reason,'MODEL_UNAVAILABLE');}));
test('M01-G13-NO-WRITE-TOOLS',()=>useModel(async f=>{f.setMutate(r=>{r.output[0].name='refund_order';return r;});const r=await f.runner.run(f.a.scope,f.task.id,'openai');assert.equal(r.reason,'MODEL_OUTPUT_INVALID');assert.equal(r.receipt.history.length,0);}));
test('M01-G13-READ-BEFORE-ANSWER',()=>useModel(async f=>{f.setMutate(r=>{r.output[0].name='finish_status';r.output[0].arguments='{}';return r;});assert.equal((await f.runner.run(f.a.scope,f.task.id,'openai')).reason,'READ_REQUIRED');}));
test('M01-G13-EXACT-READ-ARGS',()=>useModel(async f=>{f.setMutate(r=>{r.output[0].arguments='{"other_order":"secret"}';return r;});assert.equal((await f.runner.run(f.a.scope,f.task.id,'openai')).status,'handoff');}));
test('M01-G13-SOURCE-RECHECK',()=>useModel(async f=>{let done=false;f.setBefore(()=>{if(!done){done=true;f.simulator.advanceShipment(f.a.scope,{operation_id:'agent-observation',shipment:'SHIP-1001',expected_version:1,to:'delivered'});}});
 const r=await f.runner.run(f.a.scope,f.task.id,'openai');assert.equal(r.reason,'SOURCE_CHANGED');assert.equal(r.answer,null);}));
test('M01-G13-REVOKED-SESSION',()=>useModel(async f=>{f.setBefore(()=>f.kernel.revoke(f.a.scope));await assert.rejects(()=>f.runner.run(f.a.scope,f.task.id,'openai'),/ACCESS_DENIED/);assert.equal(f.db.prepare('SELECT count(*) AS n FROM commerce_assistance_receipts').get().n,0);}));
test('M01-G13-REVOKED-KEY',()=>useModel(async f=>{f.setBefore(()=>f.vault.revoke(f.a.scope,f.configs[0].secret_ref));assert.equal((await f.runner.run(f.a.scope,f.task.id,'openai')).status,'handoff');}));
test('M01-G13-BOUNDED-LOOP',()=>useModel(async f=>{f.setMutate(r=>{r.output[0].name='read_order_status';r.output[0].arguments='{}';return r;});const r=await f.runner.run(f.a.scope,f.task.id,'openai');assert.equal(r.reason,'MODEL_LIMIT');assert.equal(r.receipt.model_calls,4);}));
test('M01-G13-NO-SECRET-CONTEXT',()=>useModel(async f=>{const r=await f.runner.run(f.a.scope,f.task.id,'openai');
 for(const request of f.requests){assert.equal(JSON.stringify(request.body).includes(f.a.bearer),false);assert.equal(JSON.stringify(request.body).includes('synthetic-key'),false);assert.equal(request.headers.authorization,'Bearer openai-synthetic-key');}
 assert.equal(JSON.stringify(r).includes('synthetic-key'),false);assert.equal(JSON.stringify(r).includes(f.configs[0].secret_ref),false);}));
test('M01-G13-CROSS-TENANT-CONFIG',()=>useModel(async f=>{const task=f.reads.createTask(f.b.scope,{order_id:f.order(f.b).id,profile_id:'default'});await assert.rejects(()=>f.runner.run(f.b.scope,task.id,'openai'),/NO_CONFIGURATION/);assert.equal(f.requests.length,0);}));
test('M01-G13-RECEIPT-ACCESS',()=>useModel(async f=>{const r=await f.runner.run(f.a.scope,f.task.id,'openai');assert.equal(f.runner.receipt(f.a.scope,f.task.id,r.receipt.id).id,r.receipt.id);assert.throws(()=>f.runner.receipt(f.b.scope,f.task.id,r.receipt.id),/NOT_FOUND/);}));
test('M01-G13-NO-UNAPPROVED-EGRESS',async()=>{const reader=providerReader('openai',{approvedModels:['not-a-live-model']});await assert.rejects(()=>reader.execute(Buffer.from('key'),{model:'not-a-live-model',max_output_tokens:512,instruction:'read',context:{},turns:[]}),/EXTERNAL_EFFECT_DENIED/);});
test('M01-G13-REFUSAL',()=>useModel(async f=>{f.setMutate(r=>({...r,output:[{type:'message',content:[{type:'refusal',refusal:'No'}]}]}));assert.equal((await f.runner.run(f.a.scope,f.task.id,'openai')).reason,'MODEL_HANDOFF');}));
test('M01-G13-PROFILE-RECHECK',()=>useModel(async f=>{f.setBefore(()=>f.reads.profiles.put(f.a.scope,f.profile(f.a,{revision:2,tone:'formal'})));await assert.rejects(()=>f.runner.run(f.a.scope,f.task.id,'openai'),/TASK_CONTEXT_CHANGED/);}));
test('M01-G13-MISSING-CAPABILITY',()=>useModel(async f=>{const configs=structuredClone(f.configs);configs[0].capabilities=['stateless'];const r=await new ReadRunner(f.kernel,f.reads,f.vault,configs).run(f.a.scope,f.task.id,'openai');assert.equal(r.reason,'CAPABILITY_UNAVAILABLE');assert.equal(f.requests.length,0);}));
