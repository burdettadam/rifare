import test from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';
import {usingReturns} from './return-intake-helpers.mts';import {NativeReturns} from '../../packages/commerce/native-returns.mts';
import {ShopifyReturnFixtureAdapter,CREATE_RETURN,nativeReturnRequest} from '../../packages/adapters/shopify-return-fixture.mts';
import {ExecutionStops} from '../../packages/commerce/execution-stops.mts';import {CommerceKernel} from '../../packages/commerce/kernel.mts';
function fixture(f:any,options:any={}){let creates=0,reads=0;const records=new Map<string,any>();const sent:any[]=[];
 const response=(input:any,id='gid://shopify/Return/301')=>({id,status:'OPEN',order:{id:input.orderId},returnLineItems:{nodes:input.returnLineItems.map((l:any,i:number)=>({id:'gid://shopify/ReturnLineItem/'+(401+i),quantity:l.quantity,returnReasonNote:l.returnReasonNote,fulfillmentLineItem:{id:l.fulfillmentLineItemId}})),pageInfo:{hasNextPage:false}},reverseFulfillmentOrders:{nodes:[{id:'gid://shopify/ReverseFulfillmentOrder/501'}],pageInfo:{hasNextPage:false}}});
 const adapter=new ShopifyReturnFixtureAdapter({mode:'fixture',identity:'fixture-shop-1',tenant:f.a.tenant,store:f.a.store,transport:async({query,variables})=>{sent.push({query,variables});
  if(query===CREATE_RETURN){creates++;if(options.reject)return {status:200,api_version:'2026-10',body:{data:{returnCreate:{return:null,userErrors:[{field:['orderId'],message:'unavailable'}]}}}};
   const record=response(variables.returnInput,'gid://shopify/Return/'+(300+creates));records.set(record.id,record);options.change?.(record);if(options.lost)throw new Error('NETWORK_RESPONSE_LOST');
   return {status:200,api_version:options.version??'2026-10',body:{data:{returnCreate:{return:record,userErrors:[]}}}};
  }
  reads++;return {status:200,api_version:'2026-10',body:{data:{return:records.get(variables.id)??null}}};
 }});
 return {adapter,native:new NativeReturns(f.kernel,adapter),records,sent,counts:()=>({creates,reads}),response};}
function approved(f:any){const p=f.prepare();f.submit(p);return p.id;}
test('CASE-M03-G05-01',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f),r=await x.native.create(f.a.scope,id);assert.equal(r.state,'created');assert.equal(r.native?.order_id,'gid://shopify/Order/201');assert.deepEqual(r.native?.lines.map((l:any)=>[l.fulfillment_line_id,l.quantity]),[['gid://shopify/FulfillmentLineItem/101',1]]);assert.deepEqual(r.native?.reverse_fulfillment_ids,['gid://shopify/ReverseFulfillmentOrder/501']);assert.equal(r.qualification,'fixture_only');assert.equal(r.financial_effect,false);}));
test('CASE-M03-G05-02',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f,{lost:true});const r=await x.native.create(f.a.scope,id);assert.equal(r.state,'unknown');assert.equal((await x.native.create(f.a.scope,id)).state,'unknown');assert.deepEqual(x.counts(),{creates:1,reads:0});const reconciled=await x.native.reconcile(f.a.scope,id,[...x.records.keys()][0]);assert.equal(reconciled.state,'created');assert.deepEqual(x.counts(),{creates:1,reads:1});}));
test('CASE-M03-G05-03',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f);const [one,two]=await Promise.all([x.native.create(f.a.scope,id),x.native.create(f.a.scope,id)]);assert.equal(x.counts().creates,1);assert.equal(one.id,two.id);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_native_return_operations').get().n,1);}));
test('M03-G05-NO-APPROVAL-NO-CALL',()=>usingReturns(async f=>{const p=f.prepare(),x=fixture(f);await assert.rejects(()=>x.native.create(f.a.scope,p.id),/RETURN_APPROVAL_REQUIRED/);assert.equal(x.counts().creates,0);}));
test('M03-G05-CUSTOMER-CANNOT-CREATE-NATIVE',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f);await assert.rejects(()=>x.native.create(f.customer,id),/ACCESS_DENIED/);assert.equal(x.counts().creates,0);}));
test('M03-G05-SOURCE-TENANT-ISOLATED',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f);await assert.rejects(()=>x.native.create(f.b.scope,id),/NATIVE_SOURCE_MISMATCH/);}));
test('M03-G05-RESTART-UNKNOWN-NOT-RESENT',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f,{lost:true});await x.native.create(f.a.scope,id);const db=new DatabaseSync(f.filename);try{const k=new CommerceKernel(db,f.now),native=new NativeReturns(k,x.adapter);assert.equal((await native.create(k.authenticate(f.a.bearer),id)).state,'unknown');assert.equal(x.counts().creates,1);}finally{db.close();}}));
test('M03-G05-PARTIAL-NATIVE-LINES-UNKNOWN',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f,{change:(r:any)=>r.returnLineItems.nodes=[]});assert.equal((await x.native.create(f.a.scope,id)).state,'unknown');assert.equal(f.db.prepare('SELECT state FROM commerce_return_requests').get().state,'native_unknown');}));
test('M03-G05-MISMATCHED-QUANTITY-UNKNOWN',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f,{change:(r:any)=>r.returnLineItems.nodes[0].quantity=2});assert.equal((await x.native.create(f.a.scope,id)).state,'unknown');}));
test('M03-G05-PAGINATION-UNKNOWN',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f,{change:(r:any)=>r.reverseFulfillmentOrders.pageInfo.hasNextPage=true});assert.equal((await x.native.create(f.a.scope,id)).state,'unknown');}));
test('M03-G05-WRONG-API-VERSION-UNKNOWN',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f,{version:'2026-07'});assert.equal((await x.native.create(f.a.scope,id)).state,'unknown');assert.equal(x.counts().creates,1);}));
test('M03-G05-REJECTION-NOT-RETRIED',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f,{reject:true});assert.equal((await x.native.create(f.a.scope,id)).state,'rejected');assert.equal((await x.native.create(f.a.scope,id)).state,'rejected');assert.equal(x.counts().creates,1);}));
test('M03-G05-MISMATCHED-SOURCE-NOTE-NOT-LINKED',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f,{lost:true});await x.native.create(f.a.scope,id);const [ref,record]=[...x.records.entries()][0];record.returnLineItems.nodes[0].returnReasonNote='another intent';await assert.rejects(()=>x.native.reconcile(f.a.scope,id,ref),/NATIVE_RETURN_MISMATCH/);assert.equal(x.native.read(f.a.scope,id).state,'unknown');}));
test('M03-G05-STOP-BLOCKS-CREATE-NOT-LOOKUP',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f,{lost:true});await x.native.create(f.a.scope,id);new ExecutionStops(f.kernel).set(f.owner.scope,{action:'diagnostic.return.create',stopped:true,reason:'incident',expected_revision:0});assert.equal((await x.native.reconcile(f.a.scope,id,[...x.records.keys()][0])).state,'created');assert.equal(x.counts().creates,1);}));
test('M03-G05-STOP-BEFORE-CREATE-NO-EFFECT',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f);new ExecutionStops(f.kernel).set(f.owner.scope,{action:'diagnostic.return.create',stopped:true,reason:'incident',expected_revision:0});await assert.rejects(()=>x.native.create(f.a.scope,id),/EXECUTION_STOPPED/);assert.equal(x.counts().creates,0);}));
test('M03-G05-UNKNOWN-LOOKUP-NOT-RESEND',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f,{lost:true});await x.native.create(f.a.scope,id);await assert.rejects(()=>x.native.reconcile(f.a.scope,id,'gid://shopify/Return/999'),/NATIVE_OUTCOME_UNKNOWN/);assert.equal(x.counts().creates,1);}));
test('M03-G05-OMITS-INVENTED-IDEMPOTENCY-INPUT',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f);await x.native.create(f.a.scope,id);const input=x.sent[0].variables.returnInput;assert.deepEqual(Object.keys(input).sort(),['orderId','returnLineItems']);assert(!JSON.stringify(input).includes('idempotency'));assert(!JSON.stringify(input).includes('refundCreate'));}));
test('M03-G05-LIVE-MODE-UNAVAILABLE',()=>{assert.throws(()=>new ShopifyReturnFixtureAdapter({mode:'live',identity:'bad',tenant:'a',store:'s',transport:async()=>null} as any),/NATIVE_RETURN_UNQUALIFIED/);});
test('M03-G05-NO-DEFAULT-NETWORK-TRANSPORT',()=>{assert.throws(()=>new ShopifyReturnFixtureAdapter({mode:'fixture',identity:'bad',tenant:'a',store:'s',transport:undefined} as any),/NATIVE_RETURN_UNQUALIFIED/);});
test('M03-G05-OPERATION-ID-NOT-CALLER-CONTROLLED',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f);const r=await x.native.create(f.a.scope,id);assert.match(r.id!,/^nret_[a-f0-9]{40}$/);assert.equal(x.native.read(f.a.scope,id).id,r.id);}));
test('M03-G05-SOURCE-CHANGED-AFTER-APPROVAL-NO-CREATE',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f),order=f.order();f.kernel.ingest(f.a.scope,{kind:'order',source_system:'synthetic',external_id:order.external_id,source_version:4,source_updated_at:f.now(),customer_id:order.customer_id,payload:{...order.payload,total_minor:1}});await assert.rejects(()=>x.native.create(f.a.scope,id),/RETURN_SOURCE_CHANGED/);assert.equal(x.counts().creates,0);}));
test('M03-G05-UNKNOWN-RECONCILES-AFTER-CUSTOMER-EXPIRY',()=>usingReturns(async f=>{const id=approved(f),x=fixture(f,{lost:true});await x.native.create(f.a.scope,id);f.advance(901000);const scope=f.kernel.authenticate(f.kernel.issueSession(f.a.tenant,f.a.store,'operator'));const r=await x.native.reconcile(scope,id,[...x.records.keys()][0]);assert.equal(r.state,'created');assert.equal(x.counts().creates,1);}));
test('M03-G05-NEW-EVIDENCE-REVIEW-BLOCKS-NATIVE-SEND',()=>usingReturns(async f=>{const q=f.quote(),p=f.prepare(q);f.submit(p);f.review.requestEvidence(f.reviewer.scope,{quote_id:q.id,reason:'photo_unclear'});const x=fixture(f);await assert.rejects(()=>x.native.create(f.a.scope,p.id),/RETURN_REVIEW_CHANGED/);assert.equal(x.counts().creates,0);}));
