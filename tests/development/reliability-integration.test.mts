import test from 'node:test';import assert from 'node:assert/strict';
import { spawn } from 'node:child_process';import { fileURLToPath } from 'node:url';
import { DatabaseSync } from 'node:sqlite';
import { useReliability } from './reliability-helpers.mts';
import { startCommerceServer } from '../../apps/commerce-api/server.mts';
import { contentDigest } from '../../packages/commerce/configuration-values.mts';
import { SyntheticJournal } from '../../packages/adapters/reliability/synthetic-journal.mts';

function child(f:any,p:any){return new Promise<any>((resolve,reject)=>{const cp=spawn(process.execPath,['--experimental-strip-types',fileURLToPath(new URL('../fixtures/reliability/process.mts',import.meta.url))],{stdio:['pipe','pipe','pipe']});let out='',err='';const timer=setTimeout(()=>{cp.kill();reject(new Error('CHILD_TIMEOUT'));},15000);cp.stdout.on('data',b=>out+=b);cp.stderr.on('data',b=>err+=b);cp.on('error',reject);cp.on('close',code=>{clearTimeout(timer);if(code!==0)reject(new Error('CHILD_FAILURE: '+err));else resolve(out?JSON.parse(out):null);});cp.stdin.end(JSON.stringify({filename:f.filename,journal_file:f.journalFile,now:f.now(),bearer:f.a.bearer,tenant:f.a.tenant,store:f.a.store,...p}));});}

test('M02-G13-TWO-PROCESS-CONSUMPTION',()=>useReliability(async f=>{const e=f.receive();const results=await Promise.all([child(f,{mode:'event',event_id:e.id}),child(f,{mode:'event',event_id:e.id})]);assert.equal(results.filter(r=>r.replayed===false).length,1);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_event_consumption').get().n,1);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_operation_work').get().n,1);}));
test('M02-G15-TWO-PROCESS-IDEMPOTENCY',()=>useReliability(async f=>{const {r,op}=f.executeOperation();const input={receipt_id:r.id,idempotency_key:'concurrent',expected_receipt_digest:contentDigest(r)};const results=await Promise.all([child(f,{mode:'bind',input}),child(f,{mode:'bind',input})]);assert.equal(results[0].id,op.id);assert.equal(results[1].id,op.id);assert.equal(f.db.prepare("SELECT count(*) n FROM commerce_operation_keys WHERE key='concurrent'").get().n,1);}));
test('M02-G14-TWO-PROCESS-EXCLUSIVE-CLAIM',()=>useReliability(async f=>{const {op}=f.executeOperation();const results=await Promise.all([child(f,{mode:'claim',operation_id:op.id}),child(f,{mode:'claim',operation_id:op.id})]);assert.equal(results.filter(Boolean).length,1);assert.equal(f.ops.read(f.a.scope,op.id).work.attempts,1);}));
test('M02-G14-PROCESS-CRASH-BEFORE-SEND-RECOVER',()=>useReliability(async f=>{const {op}=f.executeOperation();await child(f,{mode:'crash-claimed',operation_id:op.id});f.advance(101);assert.equal((await child(f,{mode:'dispatch',operation_id:op.id})).state,'succeeded');assert.equal(f.journal.count(),1);}));
test('M02-G14-PROCESS-CRASH-SENDING-CONSERVATIVE',()=>useReliability(async f=>{const {op}=f.executeOperation();await child(f,{mode:'crash-sending',operation_id:op.id});f.advance(101);assert.equal((await child(f,{mode:'dispatch',operation_id:op.id})).state,'unknown');assert.equal(f.journal.count(),0);}));
test('M02-G15-PROCESS-EXIT-AFTER-SOURCE-COMMIT',()=>useReliability(async f=>{const {op}=f.executeOperation();await child(f,{mode:'crash-accepted',operation_id:op.id});assert.equal(f.journal.count(),1);f.advance(101);assert.equal((await child(f,{mode:'dispatch',operation_id:op.id})).state,'unknown');assert.equal(f.journal.count(),1);const r=await f.recon.one(f.a.scope,op.id,f.journal);assert.equal(r.operation.state,'succeeded');assert.equal(f.journal.count(),1);}));
test('M02-G16-PROCESS-EXIT-AFTER-PAGE-COMMIT',()=>useReliability(async f=>{for(let i=0;i<2;i++){const op=f.extraOperation(i);f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,op.id,f.journal);}const run=f.recon.start(f.a.scope,f.journal);assert.equal((await child(f,{mode:'reconcile-page',run_id:run.id})).run.cursor,1);assert.equal((await child(f,{mode:'reconcile-page',run_id:run.id})).run.state,'completed');assert.equal(f.journal.count(),2);}));
test('M02-G16-SAME-NAME-OTHER-JOURNAL-CANNOT-CONFIRM',()=>useReliability(async f=>{const {op}=f.executeOperation(),claim=f.work.claim(f.a.scope,op.id)!;const envelope=f.work.beginSend(f.a.scope,op.id,claim.lease_token);f.journal.arm('after_accept');assert.throws(()=>f.journal.send(envelope),/SYNTHETIC_RESPONSE_LOST/);f.work.finish(f.a.scope,op.id,claim.lease_token,{kind:'unknown'});const db=new DatabaseSync(':memory:');try{const other=new SyntheticJournal(db,f.a.tenant,f.a.store);other.send(envelope);const r=await f.recon.one(f.a.scope,op.id,other);assert.equal(r.disposition,'conflict');assert.equal(r.operation.state,'unknown');assert.equal(f.recon.drift(f.a.scope,op.id)[0].code,'SOURCE_BINDING_CONFLICT');}finally{db.close();}}));
test('M02-G14-SOURCE-PIN-CANNOT-CHANGE',()=>useReliability(async f=>{const {op}=f.executeOperation();const db=new DatabaseSync(':memory:');try{const other=new SyntheticJournal(db,f.a.tenant,f.a.store);await assert.rejects(f.work.dispatch(f.a.scope,op.id,other),/SOURCE_CHANGED/);assert.equal(other.count(),0);}finally{db.close();}}));
test('M02-G16-SAME-NAME-OTHER-JOURNAL-CANNOT-RESUME',()=>useReliability(f=>{const run=f.recon.start(f.a.scope,f.journal),db=new DatabaseSync(':memory:');try{const other=new SyntheticJournal(db,f.a.tenant,f.a.store);assert.throws(()=>f.recon.step(f.a.scope,run.id,other),/SOURCE_CHANGED/);}finally{db.close();}}));
test('M02-G14-PINNED-SOURCE-IDENTITY-READONLY',()=>useReliability(f=>{assert.throws(()=>{(f.journal as any).identity='journal_forged';},TypeError);assert.throws(()=>{(f.journal as any).store='store-b';},TypeError);}));

test('M02-G15-HTTP-OPERATIONS-WITHOUT-AGENT',()=>useReliability(async f=>{const {op,r}=f.executeOperation(),s=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,reads:f.reads});try{
 const h={Authorization:'Bearer '+f.a.bearer};let result=await fetch(s.url+'/v1/operations/'+op.id,{headers:h});assert.equal(result.status,200);assert.equal((await result.json()).state,'queued');
 result=await fetch(s.url+'/v1/operations/by-receipt',{method:'POST',headers:{...h,'Content-Type':'application/json'},body:JSON.stringify({receipt_id:r.id,idempotency_key:'http-request',expected_receipt_digest:contentDigest(r)})});assert.equal(result.status,200);assert.equal((await result.json()).id,op.id);
 result=await fetch(s.url+'/v1/resources/'+f.order().id+'/operations',{headers:h});assert.equal((await result.json()).length,1);
 result=await fetch(s.url+'/v1/operations/'+op.id+'/receipts',{headers:h});assert.equal((await result.json())[0].receipt.code,'queued');
 }finally{await s.close();}}));
test('M02-G15-HTTP-CROSS-STORE-DENIED',()=>useReliability(async f=>{const {op}=f.executeOperation(),s=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,reads:f.reads});try{const result=await fetch(s.url+'/v1/operations/'+op.id,{headers:{Authorization:'Bearer '+f.b.bearer}});assert.equal(result.status,404);}finally{await s.close();}}));
test('M02-G14-HTTP-NO-DISPATCH-OR-SOURCE-RESULT-WRITE',()=>useReliability(async f=>{const {op}=f.executeOperation(),s=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,reads:f.reads});try{for(const route of ['/v1/operations/'+op.id+'/dispatch','/v1/operations/'+op.id+'/finish']){const result=await fetch(s.url+route,{method:'POST',headers:{Authorization:'Bearer '+f.a.bearer,'Content-Type':'application/json'},body:'{}'});assert.equal(result.status,404);}assert.equal(f.journal.count(),0);}finally{await s.close();}}));
