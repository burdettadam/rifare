import test from 'node:test';
import assert from 'node:assert/strict';
import { randomBytes } from 'node:crypto';
import { commerceFixture } from './commerce-helpers.mts';
import { Capabilities,CONTRACT_VERSION } from '../../packages/commerce/capabilities.mts';
import { CustomerAccess } from '../../packages/commerce/customer-access.mts';
import { SecretVault } from '../../packages/commerce/secrets.mts';
import { StoreSimulator,FIXTURE_CLOCK } from '../../packages/commerce/simulator.mts';
import { startCommerceServer } from '../../apps/commerce-api/server.mts';

async function setup(){const f=commerceFixture(),caps=new Capabilities(f.kernel),simulator=new StoreSimulator(f.kernel,caps),outbox:any[]=[],logs:any[]=[];
 simulator.reset(f.a.scope);simulator.reset(f.b.scope,{profile:'fragile',clock:FIXTURE_CLOCK});const customers=new CustomerAccess(f.kernel,p=>{outbox.push(p);});
 const key=randomBytes(32),vault=new SecretVault(f.kernel,{activeId:'key-1',get:()=>key},{'local-probe':b=>b.length>0});
 const server=await startCommerceServer({kernel:f.kernel,caps,customers,simulator,vault,log:v=>{logs.push(v);}});
 const request=(path:string,bearer:string|undefined=f.a.bearer,value?:unknown,headers={})=>fetch(server.url+path,{method:value===undefined?'GET':'POST',headers:{...(bearer?{authorization:'Bearer '+bearer}:{}),...(value===undefined?{}:{'content-type':'application/json'}),...headers},body:value===undefined?undefined:JSON.stringify(value),signal:AbortSignal.timeout(3000)});
 return {...f,caps,simulator,customers,vault,outbox,logs,server,request,dispose:async()=>{await server.close();f.cleanup();}};
}
const use=async(fn:(f:Awaited<ReturnType<typeof setup>>)=>unknown)=>{const f=await setup();try{return await fn(f);}finally{await f.dispose();}};
test('M01-G01-HTTP-01',()=>use(async f=>{const a=await f.request('/v1/resources?kind=order'),b=await f.request('/v1/resources?kind=order',f.b.bearer);assert.equal(a.status,200);const aa=await a.json(),bb=await b.json();assert.equal(aa.resources.find((r:any)=>r.external_id==='ORD-1001').payload.total_minor,12500);assert.equal(bb.resources.find((r:any)=>r.external_id==='ORD-1001').payload.total_minor,6400);assert.equal(a.headers.get('cache-control'),'no-store');}));
test('M01-G01-HTTP-02',()=>use(async f=>{const b=f.simulator.read(f.b.scope,'order','ORD-1001');const foreign=await f.request('/v1/resources/'+b.id),missing=await f.request('/v1/resources/res_missing');assert.equal(foreign.status,404);assert.deepEqual(await foreign.json(),await missing.json());}));
test('M01-G01-HTTP-03',()=>use(async f=>{const response=await f.request('/v1/resources?kind=order','',undefined,{'x-tenant-id':'tenant-a','x-store-id':'store-a'});assert.equal(response.status,403);assert.deepEqual(await response.json(),{error:'ACCESS_DENIED'});assert.equal((await f.request('/v1/resources?kind=order',f.a.bearer,undefined,{origin:'https://foreign.invalid'})).status,403);}));
test('M01-G02-HTTP-01',()=>use(async f=>{const challenge=await f.request('/v1/customer/challenges','',{store_id:'store-a',order_number:'ORD-1001',email:'shopper-apparel@example.invalid'});assert.equal(challenge.status,202);const c=await challenge.json();assert.equal('proof'in c,false);const message=f.outbox[0];const verified=await f.request('/v1/customer/verify','',{store_id:'store-a',challenge_id:c.challenge_id,proof:message.proof});assert.equal(verified.status,200);const session=await verified.json();assert.equal((await f.request('/v1/resources/'+session.resource_id,session.token)).status,200);assert.equal((await f.request('/v1/resources?kind=order',session.token)).status,403);assert.equal((await f.request('/v1/session/logout',session.token,{})).status,200);assert.equal((await f.request('/v1/resources/'+session.resource_id,session.token)).status,403);assert.equal((await f.request('/v1/customer/verify','',{store_id:'store-a',challenge_id:c.challenge_id,proof:message.proof})).status,403);}));
test('M01-G02-HTTP-02',()=>use(async f=>{const absent=await f.request('/v1/customer/challenges','',{store_id:'store-a',order_number:'ORD-missing',email:'shopper-apparel@example.invalid'});assert.equal(absent.status,202);assert.equal(f.outbox.length,0);assert.deepEqual(Object.keys(await absent.json()).sort(),['accepted','challenge_id','expires_in']);}));
test('M01-G03-HTTP-01',()=>use(async f=>{const ref=f.vault.put(f.a.scope,{provider:'model',adapter:'local-probe',value:'SYNTHETIC-PRIVATE-VALUE'});const response=await f.request('/v1/secrets');assert.equal(response.status,200);const list=await response.text();assert.equal(list.includes(ref.ref),true);assert.equal(list.includes('SYNTHETIC-PRIVATE-VALUE'),false);const probe=await f.request('/v1/secrets/probe',f.a.bearer,{ref:ref.ref,adapter:'local-probe'});assert.deepEqual(await probe.json(),{adapter:'local-probe',configured:true,qualification:'synthetic_probe_only'});assert.equal((await f.request('/v1/secrets/probe',f.b.bearer,{ref:ref.ref,adapter:'local-probe'})).status,503);}));
test('M01-G03-HTTP-02',()=>use(async f=>{const ref=f.vault.put(f.a.scope,{provider:'model',adapter:'local-probe',value:'SYNTHETIC-LOG-CANARY'});await f.request('/v1/secrets/probe',f.a.bearer,{ref:ref.ref,adapter:'local-probe'});const logs=JSON.stringify(f.logs);assert.equal(logs.includes(f.a.bearer),false);assert.equal(logs.includes('SYNTHETIC-LOG-CANARY'),false);const page=await(await f.request('/')).text();assert.equal(page.includes(f.a.bearer),false);assert.equal(page.includes('SYNTHETIC-LOG-CANARY'),false);}));
test('M01-G04-HTTP-01',()=>use(async f=>{const discovery=await(await f.request('/v1/capabilities')).json();assert.deepEqual(discovery.capabilities,f.caps.list(f.a.scope));f.caps.configure(f.a.scope,{adapter:'simulator',contract_version:CONTRACT_VERSION,granted_scopes:[],qualification:'synthetic'});const response=await f.request('/v1/resources?kind=order');assert.equal(response.status,403);assert.equal((await response.json()).reason,'REQUIRED_SCOPE_MISSING');}));
test('M01-G04-HTTP-02',()=>use(async f=>{const order=f.simulator.read(f.a.scope,'order','ORD-1001');const before=f.kernel.get(f.a.scope,order.id);const response=await f.request('/v1/actions',f.a.bearer,{action:'order.refund',resource_id:order.id});assert.equal(response.status,403);assert.equal((await response.json()).reason,'READ_ONLY_PHASE');assert.deepEqual(f.kernel.get(f.a.scope,order.id),before);assert.equal((await f.request('/simulator/reset',f.a.bearer,{})).status,404);}));
test('M01-G04-HTTP-03',()=>use(async f=>{const order=f.simulator.read(f.a.scope,'order','ORD-1001');const response=await f.request('/v1/actions',f.a.bearer,{action:'history.read',resource_id:order.id});assert.equal(response.status,403);assert.equal((await response.json()).reason,'MESSAGE_HISTORY_UNAVAILABLE');const unknown=await f.request('/v1/actions',f.a.bearer,{action:'http.fetch',resource_id:order.id});assert.equal((await unknown.json()).reason,'UNKNOWN_ACTION');}));
test('M01-G05-HTTP-01',()=>use(async f=>{const result=await(await f.request('/v1/lookup?kind=shipment&external_id=SHIP-1001')).json();assert.equal(result.payload.status,'in_transit');f.simulator.armFault(f.a.scope,'before_accept');assert.equal((await f.request('/v1/lookup?kind=shipment&external_id=SHIP-1001')).status,503);assert.equal((await f.request('/v1/lookup?kind=shipment&external_id=SHIP-1001')).status,200);}));
test('M01-G05-HTTP-02',()=>use(async f=>{assert.equal((await f.request('/v1/lookup?kind=order&external_id=ORD-1001&url=https://live.invalid')).status,400);assert.equal((await f.request('/v1/resources?kind=order&kind=payment')).status,400);assert.equal((await f.request('/v1/capabilities?token=guess')).status,400);}));
