import test from 'node:test';import assert from 'node:assert/strict';
import { usingExecution } from './execution-helpers.mts';

test('CASE-M02-G09-01',()=>usingExecution(f=>{const first=f.release();f.releases.publish(f.owner.scope,{release_id:first.id,expected_revision:0,rollout_percent:100});f.changeSkill();const second=f.release(25);f.releases.publish(f.owner.scope,{release_id:second.id,expected_revision:1,rollout_percent:25});assert.equal(f.releases.active(f.b.scope,'order-status'),undefined);f.releases.rollback(f.owner.scope,{skill_id:'order-status',target_release_id:first.id,expected_revision:2});assert.equal(f.releases.active(f.a.scope,'order-status').release_id,first.id);assert.equal(f.cases.resume(f.a.scope,'case_one').pins.skill.digest,f.bundle.digest);}));
test('CASE-M02-G09-02',()=>usingExecution(f=>{const r=f.release(10);assert.throws(()=>f.releases.publish(f.agent.scope,{release_id:r.id,expected_revision:0,rollout_percent:10}),/ACCESS_DENIED/);assert.throws(()=>f.releases.publish(f.owner.scope,{release_id:r.id,expected_revision:0,rollout_percent:100}),/RELEASE_TRANSITION/);}));
test('CASE-M02-G09-03',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p),receipt=f.execute(p,a);f.releases.revoke(f.owner.scope,{skill_id:'order-status',bundle_digest:f.bundle.digest});assert.throws(()=>f.gateway.prepare(f.a.scope,f.proposal()),/SKILL_REVOKED/);assert.equal(f.gateway.receipt(f.a.scope,receipt.id).approval_consumed,true);}));
test('M02-G09-NO-SELF-REVIEW',()=>usingExecution(f=>{const r=f.releases.stage(f.owner.scope,{skill_id:'order-status',bundle_digest:f.bundle.digest,rollout_percent:100}),e=f.releases.evaluate(f.owner.scope,r.id);assert.throws(()=>f.releases.review(f.owner.scope,{release_id:r.id,test_digest:e.test_digest,rollout_percent:100}),/SELF_REVIEW_DENIED/);}));
test('M02-G09-REVIEW-REQUIRED',()=>usingExecution(f=>{const r=f.releases.stage(f.a.scope,{skill_id:'order-status',bundle_digest:f.bundle.digest,rollout_percent:100});assert.throws(()=>f.releases.publish(f.owner.scope,{release_id:r.id,expected_revision:0,rollout_percent:100}),/RELEASE_TRANSITION/);}));
test('M02-G09-EVALUATION-REQUIRED',()=>usingExecution(f=>{const r=f.releases.stage(f.a.scope,{skill_id:'order-status',bundle_digest:f.bundle.digest,rollout_percent:100});assert.throws(()=>f.releases.review(f.reviewer.scope,{release_id:r.id,test_digest:'f'.repeat(64),rollout_percent:100}),/RELEASE_TRANSITION/);}));
test('M02-G09-REVOKED-REVIEWER-BLOCKS',()=>usingExecution(f=>{const r=f.release();f.permissions.change(f.owner.scope,{actor_id:'reviewer',role:'reviewer',actions:['skill.read'],resource_ids:null,expected_revision:0});assert.throws(()=>f.releases.publish(f.owner.scope,{release_id:r.id,expected_revision:0,rollout_percent:100}),/REVIEW_AUTHORITY_CHANGED/);}));
test('M02-G09-CANARY-NEEDS-SAFE-FALLBACK',()=>usingExecution(f=>{const r=f.release(25);assert.throws(()=>f.releases.publish(f.owner.scope,{release_id:r.id,expected_revision:0,rollout_percent:25}),/CANARY_FALLBACK_REQUIRED/);}));
test('M02-G09-CANARY-DETERMINISTIC',()=>usingExecution(f=>{const first=f.release();f.releases.publish(f.owner.scope,{release_id:first.id,expected_revision:0,rollout_percent:100});const b=f.changeSkill(),r=f.release(50);f.releases.publish(f.owner.scope,{release_id:r.id,expected_revision:1,rollout_percent:50});const modes=new Set();for(let i=0;i<30;i++){const x=f.releases.select(f.a.scope,'order-status','case_'+i,b.digest),y=f.releases.select(f.a.scope,'order-status','case_'+i,b.digest);assert.deepEqual(x,y);modes.add(x.activation.mode);}assert.equal(modes.size,2);}));
test('M02-G09-ACTIVATION-CAS',()=>usingExecution(f=>{const r=f.release();assert.throws(()=>f.releases.publish(f.owner.scope,{release_id:r.id,expected_revision:4,rollout_percent:100}),/ACTIVATION_CHANGED/);}));
test('M02-G09-CROSS-STORE-RELEASE',()=>usingExecution(f=>{const r=f.release();assert.throws(()=>f.releases.get(f.c.scope,r.id),/NOT_FOUND/);}));
test('M02-G09-PINNED-SKILL-READ-REVOKED',()=>usingExecution(f=>{const cache=f.reads.skills.read(f.a.scope,'order-status','SKILL.md');f.releases.revoke(f.owner.scope,{skill_id:'order-status',bundle_digest:cache.bundle_digest});assert.throws(()=>f.reads.skills.read(f.a.scope,'order-status','SKILL.md'),/SKILL_REVOKED/);}));
test('M02-G09-REVOKED-ROLLBACK-TARGET',()=>usingExecution(f=>{const old=f.release();f.releases.publish(f.owner.scope,{release_id:old.id,expected_revision:0,rollout_percent:100});f.changeSkill();const next=f.release();f.releases.publish(f.owner.scope,{release_id:next.id,expected_revision:1,rollout_percent:100});f.releases.revoke(f.owner.scope,{skill_id:'order-status',bundle_digest:f.bundle.digest});assert.throws(()=>f.releases.rollback(f.owner.scope,{skill_id:'order-status',target_release_id:old.id,expected_revision:2}),/SKILL_REVOKED/);}));
test('M02-G09-ROLLBACK-AUDITED',()=>usingExecution(f=>{const old=f.release();f.releases.publish(f.owner.scope,{release_id:old.id,expected_revision:0,rollout_percent:100});f.changeSkill();const next=f.release();f.releases.publish(f.owner.scope,{release_id:next.id,expected_revision:1,rollout_percent:100});f.releases.rollback(f.owner.scope,{skill_id:'order-status',target_release_id:old.id,expected_revision:2});assert.deepEqual(f.db.prepare('SELECT revision,operation FROM commerce_skill_activation_log ORDER BY revision').all().map(r=>[r.revision,r.operation]),[[1,'publish'],[2,'publish'],[3,'rollback']]);}));
