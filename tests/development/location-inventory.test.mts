import test from 'node:test';
import assert from 'node:assert/strict';
import { mkdtempSync,readFileSync,rmSync,writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';
import { usingLocationInventory } from './location-inventory-helpers.mts';
import { Permissions } from '../../packages/commerce/authorization.mts';
import { ExecutionStops } from '../../packages/commerce/execution-stops.mts';
import { contentDigest } from '../../packages/commerce/configuration-values.mts';
import type { Row } from '../../packages/commerce/kernel.mts';

const values=(b:Row)=>({available:b.available,on_hand:b.on_hand,reserved:b.reserved,in_transit:b.in_transit});
const qty=(available:number,on_hand=available,reserved=0,in_transit=0)=>({available,on_hand,reserved,in_transit});
async function mutant(file:string,name:string,replace:(s:string)=>string,run:(Broken:any)=>unknown){const directory=mkdtempSync(join(tmpdir(),'rifare-inventory-mutant-'));try{const url=new URL(file,import.meta.url),source=readFileSync(url,'utf8'),changed=replace(source);assert.notEqual(changed,source);const target=join(directory,'mutant.mts');writeFileSync(target,changed.replace(/from '(\.[^']+)'/g,(_m,path)=>"from '"+new URL(path,url).href+"'"));await run((await import(pathToFileURL(target).href))[name]);}finally{rmSync(directory,{recursive:true,force:true});}}

test('CASE-M08-G08-01',()=>usingLocationInventory(f=>{f.movement('receipt-a',3,'location-a','receipt');f.movement('adjust-a',-2);f.movement('receipt-b',4,'location-b','receipt');f.inventory.sync(f.a.scope,{resource_id:f.order.id});assert.deepEqual(values(f.balance()),qty(11));assert.deepEqual(values(f.balance('location-b')),qty(4));assert.deepEqual(f.source.position({variant_id:'sku-a',location_id:'location-a'}),qty(11));assert.equal(f.inventory.history(f.a.scope,{resource_id:f.order.id}).movements.length,3);}));

test('CASE-M08-G08-02',()=>usingLocationInventory(f=>{const result=f.inventory.claim(f.owner,{resource_id:f.order.id,variant_id:'sku-a',location_id:'location-a',source_identity:'competing-fulfillment-source',fields:f.fields});assert.equal(result.state,'discrepancy');assert.deepEqual(values(f.balance()),qty(10));const d=f.inventory.discrepancies(f.a.scope,{resource_id:f.order.id});assert.equal(d[0].code,'FIELD_OWNER_CONFLICT');assert.equal(d[0].claimed_source_identity,'competing-fulfillment-source');}));

test('CASE-M08-G08-03',()=>usingLocationInventory(f=>{f.movement('adjust-once',2);f.inventory.importMovement(f.a.scope,'adjust-once');const r=f.restart();try{assert.equal(r.source.identity,f.source.identity);r.inventory.importMovement(r.scope,'adjust-once');assert.deepEqual(values(r.inventory.balance(r.scope,{resource_id:f.order.id,variant_id:'sku-a',location_id:'location-a'})),qty(12));assert.equal(r.inventory.history(r.scope,{resource_id:f.order.id}).movements.length,1);}finally{r.cleanup();}}));

test('M08-G08-ABSOLUTE-SNAPSHOT-FAULT',async()=>{await usingLocationInventory(f=>{const s=f.source.snapshot({observation_id:'repeat-absolute',resource_id:f.order.id,variant_id:'sku-a',location_id:'location-a'});f.inventory.importSnapshot(f.a.scope,s.observation_id);assert.deepEqual(values(f.balance()),qty(10));});await mutant('../../packages/commerce/location-inventory.mts','LocationInventory',source=>{const anchor='const base={...anchor.values}; // absolute snapshots establish one anchor only';assert.equal(source.split(anchor).length,2);return source.replace(anchor,anchor+'\n    for(const snapshot of snapshots.filter(x=>x.observation_id!==anchor.observation_id))for(const field of INVENTORY_FIELDS)base[field]+=snapshot.values[field];');},Broken=>usingLocationInventory(f=>{const s=f.source.snapshot({observation_id:'repeat-absolute',resource_id:f.order.id,variant_id:'sku-a',location_id:'location-a'});f.inventory.importSnapshot(f.a.scope,s.observation_id);const broken=new Broken(f.kernel,f.source);assert.throws(()=>assert.deepEqual(values(broken.balance(f.a.scope,{resource_id:f.order.id,variant_id:'sku-a',location_id:'location-a'})),qty(10)),assert.AssertionError);}));});

test('M08-G08-COVERED-LATE-ANCHOR',()=>usingLocationInventory(f=>{f.movement('before-anchor',2);const s=f.source.snapshot({observation_id:'late-anchor',resource_id:f.order.id,variant_id:'sku-a',location_id:'location-a'});assert.deepEqual(s.covered_movement_ids,['before-anchor']);f.inventory.importSnapshot(f.a.scope,s.observation_id);f.inventory.importMovement(f.a.scope,'before-anchor');assert.deepEqual(values(f.balance()),qty(12));assert.equal(f.inventory.history(f.a.scope,{resource_id:f.order.id}).movements[0].covered_by_anchor,true);},false));

test('M08-G08-SHARED-PHYSICAL-OWNER',()=>usingLocationInventory(f=>{const other=f.seed(f.a.scope,'beta','OTHER');f.inventory.claim(f.owner,{resource_id:other.id,variant_id:'sku-a',location_id:'location-a',source_identity:f.source.identity,fields:f.fields});const s=f.source.snapshot({observation_id:'other-order',resource_id:other.id,variant_id:'sku-a',location_id:'location-a'});f.inventory.importSnapshot(f.a.scope,s.observation_id);assert.deepEqual(values(f.inventory.balance(f.a.scope,{resource_id:other.id,variant_id:'sku-a',location_id:'location-a'})),qty(10));assert.equal(f.inventory.history(f.a.scope,{resource_id:f.order.id}).owners.filter((r:Row)=>r.location_id==='location-a').length,4);assert.deepEqual(values(f.balance()),qty(10));}));

test('M08-G08-CURRENT-DRIFT-REQUIRES-LINK',()=>usingLocationInventory(f=>{f.warehouseDb.prepare('UPDATE warehouse_stock SET available=9 WHERE location=?').run('location-a');const s=f.source.snapshot({observation_id:'drift',resource_id:f.order.id,variant_id:'sku-a',location_id:'location-a'});f.inventory.importSnapshot(f.a.scope,s.observation_id);assert.deepEqual(values(f.balance()),qty(10));assert.deepEqual(f.source.position({variant_id:'sku-a',location_id:'location-a'}),qty(9));assert.ok(f.inventory.discrepancies(f.a.scope,{resource_id:f.order.id}).some((d:Row)=>d.code==='ABSOLUTE_STOCK_DIFFERENCE'));}));

test('M08-G08-SCOPE-AND-SOURCE-INTEGRITY',()=>usingLocationInventory(f=>{assert.throws(()=>f.inventory.history(f.b.scope,{resource_id:f.order.id}),/SOURCE_SCOPE_MISMATCH/);assert.throws(()=>f.inventory.balance({}, {resource_id:f.order.id,variant_id:'sku-a',location_id:'location-a'}),/ACCESS_DENIED/);const m=f.movement('source-tamper',1);const altered={...m,resource_id:'another-resource'};delete altered.digest;f.warehouseDb.prepare('UPDATE warehouse_inventory_movements SET body=? WHERE movement_id=?').run(JSON.stringify(altered),'source-tamper');assert.throws(()=>f.inventory.importMovement(f.a.scope,'source-tamper'),/SOURCE_INTEGRITY/);}));

test('M08-G08-LEDGER-INTEGRITY',()=>usingLocationInventory(f=>{f.movement('ledger-tamper',1);f.inventory.importMovement(f.a.scope,'ledger-tamper');const row=f.db.prepare('SELECT * FROM commerce_inventory_movements').get() as Row,b=JSON.parse(row.body);b.delta.available=9;f.db.prepare('UPDATE commerce_inventory_movements SET body=?,digest=?').run(JSON.stringify(b),contentDigest(b));assert.throws(()=>f.balance(),/INVENTORY_INTEGRITY/);}));

test('CASE-M08-G09-01',()=>usingLocationInventory(async f=>{f.plan();assert.deepEqual(values(f.balance('location-b')),qty(0));await f.step('reserve',5);assert.deepEqual(values(f.balance()),qty(5,10,5,0));await f.step('dispatch',5);assert.deepEqual(values(f.balance()),qty(5,5,0,5));await f.step('receive',3);assert.deepEqual(values(f.balance()),qty(5,5,0,2));assert.deepEqual(values(f.balance('location-b')),qty(3));const t=f.transfers.read(f.a.scope,'transfer-a');assert.deepEqual([t.dispatched,t.received,t.in_transit,t.lost],[5,3,2,0]);assert.equal(t.received+t.in_transit+t.lost,5);}));

test('CASE-M08-G09-02',()=>usingLocationInventory(async f=>{f.plan();await f.step('reserve',5);await f.step('dispatch',5);assert.throws(()=>f.proposed('receive',6),/TRANSFER_QUANTITY_INVALID/);await f.step('receive',3);await f.transfers.dispatch(f.a.scope,'receive-operation');await f.transfers.reconcile(f.a.scope,'receive-operation');assert.deepEqual(values(f.balance('location-b')),qty(3));assert.equal(f.source.calls.apply,3);assert.throws(()=>f.proposed('receive',1,'receive-operation'),/OPERATION_CONFLICT/);}));

test('CASE-M08-G09-03',()=>usingLocationInventory(async f=>{f.plan();await f.step('reserve',5);await f.step('dispatch',5);await f.step('receive',3);await f.step('lose',2);let t=f.transfers.read(f.a.scope,'transfer-a');assert.deepEqual([t.received,t.in_transit,t.lost],[3,0,2]);await f.transfers.reconcile(f.a.scope,'receive-operation');await f.step('correct_loss',1);t=f.transfers.read(f.a.scope,'transfer-a');assert.deepEqual([t.received,t.in_transit,t.lost],[4,0,1]);assert.equal(t.received+t.in_transit+t.lost,5);assert.deepEqual(values(f.balance('location-b')),qty(4));}));

test('M08-G09-RESERVATION-FAULT',async()=>{await mutant('../../packages/adapters/warehouse-inventory-fixture-source.mts','WarehouseInventoryFixtureSource',source=>{const line="this.#stock(t.variant_id,t.from_location,-c.quantity); // reserve only at origin";assert.equal(source.split(line).length,2);return source.replace(line,"this.#stock(t.variant_id,t.to_location,c.quantity); // deliberate destination inflation");},Broken=>usingLocationInventory(async f=>{f.plan();const op=f.approved('reserve',5);const broken=new Broken(f.warehouse,{clock:f.now});await broken.apply(op.command);assert.throws(()=>assert.deepEqual(broken.position({variant_id:'sku-a',location_id:'location-b'}),qty(0)),assert.AssertionError);assert.equal(broken.position({variant_id:'sku-a',location_id:'location-a'}).available,10);}));});

test('M08-G09-APPROVAL-REQUIRED-AND-NO-SELF',()=>usingLocationInventory(async f=>{f.plan();const op=f.proposed('reserve',5);await assert.rejects(f.transfers.dispatch(f.a.scope,op.operation_id),/APPROVAL_REQUIRED/);assert.equal(f.source.calls.apply,0);assert.throws(()=>f.transfers.approve(f.a.scope,op.operation_id,{expected_digest:op.command_digest,expires_at:f.now()+60000}),/ACCESS_DENIED|SELF_APPROVAL_DENIED/);f.transfers.plan(f.owner,{transfer_id:'self-transfer',resource_id:f.order.id,variant_id:'sku-a',from_location:'location-a',to_location:'location-b',quantity:1});const self=f.transfers.propose(f.owner,'self-transfer',{operation_id:'self-op',kind:'reserve',quantity:1,expected_revision:1});assert.throws(()=>f.transfers.approve(f.owner,'self-op',{expected_digest:self.command_digest,expires_at:f.now()+60000}),/SELF_APPROVAL_DENIED/);assert.throws(()=>f.transfers.approve(f.reviewer,op.operation_id,{expected_digest:'a'.repeat(64),expires_at:f.now()+60000}),/PROPOSAL_CHANGED/);f.transfers.approve(f.reviewer,op.operation_id,{expected_digest:op.command_digest,expires_at:f.now()+60000});new Permissions(f.kernel).change(f.owner,{actor_id:'operator',role:'operator',expected_revision:0,actions:['resource.read','operation.read','action.propose','operation.dispatch','operation.reconcile','event.process'],resource_ids:null});await assert.rejects(f.transfers.dispatch(f.a.scope,op.operation_id),/ACCESS_DENIED/);assert.equal(f.source.calls.apply,0);}));

test('M08-G09-AUTHORITY-REVOCATION',()=>usingLocationInventory(async f=>{f.plan();f.approved('reserve',5);new Permissions(f.kernel).change(f.owner,{actor_id:'reviewer',role:'reviewer',expected_revision:0,actions:['operation.read','resource.read'],resource_ids:null});await assert.rejects(f.transfers.dispatch(f.a.scope,'reserve-operation'),/APPROVAL_AUTHORITY_CHANGED/);assert.equal(f.source.calls.apply,0);assert.deepEqual(values(f.balance()),qty(10));}));

test('M08-G09-STALE-SOURCE-AND-RESOURCE',()=>usingLocationInventory(async f=>{f.plan();f.approved('reserve',5);f.movement('external-change',-1);await assert.rejects(f.transfers.dispatch(f.a.scope,'reserve-operation'),/TRANSFER_SOURCE_CHANGED/);assert.equal(f.source.calls.apply,0);f.kernel.ingest(f.a.scope,{kind:'order',source_system:'synthetic',external_id:'ORD-1001',source_version:2,source_updated_at:f.now(),customer_id:'C-1001',payload:{status:'cancelled'}});assert.throws(()=>f.proposed('reserve',5,'new-proposal'),/RESOURCE_CHANGED|TRANSFER_PENDING/);}));

test('M08-G09-UNKNOWN-ORIGINAL-LOOKUP',()=>usingLocationInventory(async f=>{f.plan();f.approved('reserve',5);f.source.fault='after';assert.equal((await f.transfers.dispatch(f.a.scope,'reserve-operation')).state,'unknown');assert.equal(f.warehouse.stock('sku-a','location-a'),5);const r=f.restart();try{const result=await r.transfers.reconcile(r.scope,'reserve-operation');assert.equal(result.state,'applied');assert.equal(r.source.calls.apply,0);assert.equal(r.source.calls.lookup,1);await r.transfers.dispatch(r.scope,'reserve-operation');assert.equal(r.source.calls.apply,0);assert.equal(r.source.identity,f.source.identity);assert.equal(r.transfers.read(r.scope,'transfer-a').reserved,5);}finally{r.cleanup();}}));

test('M08-G09-BEFORE-AND-TIMEOUT-STAY-UNKNOWN',()=>usingLocationInventory(async f=>{f.plan('first',2);f.approved('reserve',2,'before','first');f.source.fault='before';assert.equal((await f.transfers.dispatch(f.a.scope,'before')).state,'unknown');await f.transfers.reconcile(f.a.scope,'before');await f.transfers.dispatch(f.a.scope,'before');assert.equal(f.source.calls.apply,1);f.plan('second',2);f.approved('reserve',2,'timeout','second');f.source.fault='hang';assert.equal((await f.transfers.dispatch(f.a.scope,'timeout')).state,'unknown');assert.equal(f.source.calls.apply,2);assert.equal(f.warehouse.stock('sku-a','location-a'),10);assert.throws(()=>f.proposed('reserve',2,'replacement','second'),/TRANSFER_PENDING/);}));

test('M08-G09-SOURCE-IDENTITY-AND-SCOPE',()=>usingLocationInventory(async f=>{f.plan();f.approved('reserve',5);await assert.rejects(f.transfers.dispatch(f.b.scope,'reserve-operation'),/SOURCE_SCOPE_MISMATCH/);assert.throws(()=>f.transfers.read(f.c.scope,'transfer-a'),/SOURCE_SCOPE_MISMATCH/);const row=f.db.prepare('SELECT * FROM commerce_inventory_transfer_operations').get() as Row,b=JSON.parse(row.body);b.command.source_identity='new-source';b.command_digest=contentDigest(b.command);f.db.prepare('UPDATE commerce_inventory_transfer_operations SET body=?,digest=?').run(JSON.stringify(b),contentDigest(b));await assert.rejects(f.transfers.dispatch(f.a.scope,'reserve-operation'),/SOURCE_IDENTITY_CHANGED|TRANSFER_INTEGRITY/);assert.equal(f.source.calls.apply,0);}));

test('M08-G09-STOP-AND-RESTORE-FENCE',()=>usingLocationInventory(async f=>{f.plan();f.approved('reserve',5);const stops=new ExecutionStops(f.kernel);stops.set(f.owner,{action:'diagnostic.warehouse.disposition',stopped:true,reason:'incident',expected_revision:0});await assert.rejects(f.transfers.dispatch(f.a.scope,'reserve-operation'),/EXECUTION_STOPPED/);stops.set(f.owner,{action:'diagnostic.warehouse.disposition',stopped:false,reason:'reviewed_resume',expected_revision:1});await assert.rejects(f.transfers.dispatch(f.a.scope,'reserve-operation'),/EXECUTION_REAUTHORIZATION_REQUIRED/);f.db.prepare("INSERT INTO commerce_recovery_state VALUES(1,'restore-inventory','quarantine',?,?,?)").run('a'.repeat(64),'b'.repeat(64),f.now());assert.throws(()=>f.plan('restore-plan'),/RESTORE_WRITE_BLOCKED/);f.movement('external-during-quarantine',1);assert.throws(()=>f.inventory.importMovement(f.a.scope,'external-during-quarantine'),/RESTORE_WRITE_BLOCKED/);assert.equal(f.source.calls.apply,0);}));

test('PORT-025-M08-G09-DUPLICATE-PARTIAL',()=>usingLocationInventory(async f=>{f.plan();await f.step('reserve',5);await f.step('dispatch',5);await f.step('receive',3,'scanner-event');for(let i=0;i<2;i++)await f.transfers.reconcile(f.a.scope,'scanner-event');const t=f.transfers.read(f.a.scope,'transfer-a');assert.deepEqual([t.received,t.in_transit],[3,2]);assert.deepEqual(values(f.balance('location-b')),qty(3));assert.equal(f.source.movements().filter((m:Row)=>m.origin.id==='scanner-event'&&m.location_id==='location-b').length,1);}));

test('M08-G09-RELEASE-AND-JOURNAL-CONSERVATION',()=>usingLocationInventory(async f=>{f.plan();await f.step('reserve',5);await f.step('release',2);await f.step('dispatch',3);await f.step('receive',3);const t=f.transfers.read(f.a.scope,'transfer-a');assert.deepEqual([t.reserved,t.released,t.dispatched,t.received,t.in_transit],[0,2,3,3,0]);assert.deepEqual(values(f.balance()),qty(7));assert.deepEqual(values(f.balance('location-b')),qty(3));assert.equal(f.warehouse.stock('sku-a','location-a')!+f.warehouse.stock('sku-a','location-b')!,10);const h=f.inventory.history(f.a.scope,{resource_id:f.order.id});assert.equal(h.movements.length,5);assert.ok(h.movements.every((m:Row)=>m.original_movement_digest&&m.source_identity===f.source.identity));}));
