import test from 'node:test';import assert from 'node:assert/strict';import {spawnSync} from 'node:child_process';import {DatabaseSync} from 'node:sqlite';
import {usingReturns} from './return-intake-helpers.mts';import {evaluateReturn,returnSettings} from '../../packages/commerce/return-eligibility.mts';
const calc=(f:any,extra:any={})=>evaluateReturn({order:f.order(),rules:f.cases.inspect(f.a.scope,'case_one').pins.policy.body.rules,settings:f.settings,selection:f.selection(),now:f.now(),...extra});
test('CASE-M03-G01-01',()=>usingReturns(f=>{const r=calc(f,{selection:f.selection({lines:[{line_id:'one',quantity:1},{line_id:'excluded',quantity:1},{line_id:'three',quantity:2}]})});assert.equal(r.decision,'deny');assert.deepEqual(r.lines.map(l=>[l.line_id,l.remaining,l.decision]),[['excluded',4,'deny'],['one',1,'allow'],['three',2,'allow']]);assert.deepEqual(r.lines[0].reasons,['PRODUCT_EXCLUDED']);}));
test('CASE-M03-G01-02',()=>usingReturns(f=>{assert.equal(calc(f,{selection:f.selection({lines:[{line_id:'one',quantity:2}]})}).decision,'deny');for(const quantity of [-1,0,1.5])assert.throws(()=>calc(f,{selection:f.selection({lines:[{line_id:'one',quantity}]})}),/INVALID_INPUT/);const cutoff=f.order().payload.delivered_at+30*86400000;assert.equal(calc(f,{now:cutoff+1}).decision,'review');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_receipts').get().n,0);}));
test('CASE-M03-G01-03',()=>usingReturns(f=>{const cutoff=f.order().payload.delivered_at+30*86400000;for(const offset of [-1,0,1])assert.equal(calc(f,{now:cutoff+offset}).decision,offset<=0?'allow':'review');for(const zone of ['UTC','America/Denver','Asia/Tokyo'])assert.equal(calc(f,{settings:{...f.settings,time_zone:zone},now:cutoff}).deadline,cutoff);assert.equal(calc(f,{reserved:{one:1}}).decision,'deny');}));
test('M03-G01-HOST-TIMEZONE-INDEPENDENT',()=>usingReturns(f=>{const input={order:f.order(),rules:f.cases.inspect(f.a.scope,'case_one').pins.policy.body.rules,settings:f.settings,selection:f.selection(),now:f.now()};const code="import {evaluateReturn} from './packages/commerce/return-eligibility.mts';console.log(JSON.stringify(evaluateReturn(JSON.parse(process.env.CASE))));";const values=['UTC','America/New_York','Pacific/Auckland'].map(TZ=>{const p=spawnSync(process.execPath,['--experimental-strip-types','--input-type=module','-e',code],{cwd:new URL('../../',import.meta.url),encoding:'utf8',env:{PATH:process.env.PATH,TZ,CASE:JSON.stringify(input)}});assert.equal(p.status,0,p.stderr);return p.stdout;});assert.equal(new Set(values).size,1);}));
test('M03-G01-FEES-EXACT-MINOR-UNITS',()=>usingReturns(f=>{const r=calc(f);assert.deepEqual(r.fees,{currency:'USD',gross_minor:'2000',restocking_minor:'200',shipping_minor:'100',net_minor:'1700',rounding:'restocking_floor_minor',estimated_only:true});}));
test('M03-G01-FEES-EXCEED-VALUE-DENIED',()=>usingReturns(f=>{const r=calc(f,{settings:{...f.settings,shipping_minor:'2001'}});assert.equal(r.decision,'deny');assert(r.reasons.includes('FEES_EXCEED_AMOUNT'));}));
test('M03-G01-DUPLICATE-SELECTION-DENIED',()=>usingReturns(f=>assert.throws(()=>calc(f,{selection:f.selection({lines:[{line_id:'one',quantity:1},{line_id:'one',quantity:1}]})}),/DUPLICATE_LINE/)));
test('M03-G01-UNKNOWN-LINE-DENIED',()=>usingReturns(f=>assert.throws(()=>calc(f,{selection:f.selection({lines:[{line_id:'absent',quantity:1}]})}),/UNKNOWN_RETURN_LINE/)));
test('M03-G01-CURRENCY-MISMATCH-DENIED',()=>usingReturns(f=>assert.throws(()=>calc(f,{settings:{...f.settings,currency:'EUR'}}),/RETURN_SOURCE_MISSING/)));
test('M03-G01-EVIDENCE-REQUIRES-CLEAN',()=>usingReturns(f=>{const rules={window_days:30,require_evidence:true,excluded_tags:[],outcomes:['refund']};assert.deepEqual(calc(f,{rules}).reasons,['EVIDENCE_REQUIRED']);assert.equal(calc(f,{rules,evidenceClean:true}).decision,'allow');}));
test('M03-G01-INVALID-TIMEZONE-DENIED',()=>usingReturns(f=>assert.throws(()=>returnSettings({...f.settings,time_zone:'invented/zone'}),/INVALID_TIME_ZONE/)));
test('M03-G01-INVALID-SOURCE-COUNTS-DENIED',()=>usingReturns(f=>{for(const patch of [{returned:3},{fulfilled:4},{ordered:-1}]){const order=f.order();order.payload.return_lines[0]={...order.payload.return_lines[0],...patch};assert.throws(()=>calc(f,{order}),/RETURN_SOURCE_MISSING|INVALID_INPUT/);}}));
test('M03-G01-SUBMITTED-QUANTITY-RESERVED',()=>usingReturns(f=>{f.submit();f.create('second_case');const q=f.quote({case_id:'second_case'});assert.equal(q.quote.decision.lines[0].remaining,0);assert(q.quote.decision.reasons.includes('QUANTITY_UNAVAILABLE'));}));
test('M03-G01-TWO-PREVIEWS-CANNOT-OVER-RETURN',()=>usingReturns(f=>{const first=f.prepare();f.create('second_case');const q=f.quote({case_id:'second_case'}),second=f.prepare(q,{request_key:'second-key'});const a=f.gateway.approve(f.reviewer.scope,{preview_id:second.preview_id,preview_digest:second.preview_digest});f.submit(first);assert.throws(()=>f.gateway.execute(f.a.scope,{preview_id:second.preview_id,preview_digest:second.preview_digest,approval_id:a.id}),/RETURN_QUOTE_CHANGED/);assert.equal(f.db.prepare("SELECT count(*) n FROM commerce_return_requests WHERE state='submitted'").get().n,1);}));
test('M03-G01-RESTART-RETAINS-RESERVATION',()=>usingReturns(f=>{f.submit();const db=new DatabaseSync(f.filename);try{const count=db.prepare("SELECT count(*) n FROM commerce_return_requests WHERE state='submitted'").get();assert.equal(count.n,1);}finally{db.close();}}));
test('M03-G01-NO-EXPLICIT-AUTHORITY-IN-SELECTION',()=>usingReturns(f=>{for(const extra of [{fees:{net_minor:'0'}},{policy:{window_days:999}},{approved:true},{tenant_id:'other'}])assert.throws(()=>f.quote(extra),/INVALID_INPUT/);}));
