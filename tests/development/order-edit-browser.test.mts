import test from 'node:test';import assert from 'node:assert/strict';import {spawn} from 'node:child_process';import {usingEdits,installEditSkill} from './order-edit-helpers.mts';import {startCommerceServer} from '../../apps/commerce-api/server.mts';
async function check(scenario:string){return usingEdits(async f=>{const {bundle}=installEditSkill(f),s=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,reads:f.reads,orderEditSource:f.native});try{const r=await new Promise<any>((resolve,reject)=>{const p=spawn('python3',['tests/browser/order_edit_component.py'],{env:{...process.env,RIFARE_TEST_INPUT:JSON.stringify({scenario,url:s.url,token:f.a.bearer,reviewer:f.reviewer.bearer,skill_digest:bundle.digest,screenshot:scenario==='keyboard'?process.env.RIFARE_EDIT_SCREENSHOT:undefined})},stdio:['ignore','pipe','pipe']});let out='',err='';p.stdout.on('data',d=>out+=d);p.stderr.on('data',d=>err+=d);p.on('error',reject);p.on('close',code=>resolve({code,out,err}));});assert.equal(r.code,0,r.err);assert.equal(JSON.parse(r.out).passed,true);assert.deepEqual(JSON.parse(r.out).direct_browser_network,[]);}finally{await s.close();}});}
test('M04-G11-BROWSER-01 keyboard mobile flow separates unpaid invoice and rejects hold release',()=>check('keyboard'));
test('M04-G11-BROWSER-02 changing intent prevents an old quote from enabling approval',()=>check('late_quote'));
test('M04-G11-BROWSER-03 late status response after sign-out cannot refill private records',()=>check('late_status'));
