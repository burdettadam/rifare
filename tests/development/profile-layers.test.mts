import test from 'node:test';import assert from 'node:assert/strict';
import { compileLayers,baseLayer } from '../../packages/commerce/profile-layers.mts';
import { contentDigest } from '../../packages/commerce/configuration-values.mts';
const context={tenant_id:'tenant-a',store_id:'store-a',platform:'shopify',capabilities:['order.read']};
const layer=(id='merchant',kind='merchant',values:any={'returns.window_days':14})=>({id,kind,revision:1,tenant_id:['base','platform','industry'].includes(kind)?null:context.tenant_id,store_id:['base','platform','industry'].includes(kind)?null:context.store_id,values,source:{uri:'https://merchant.example.invalid/profile',revision:'1',sha256:'b'.repeat(64)}});
test('CASE-M02-G05-01',()=>{const apparel=compileLayers([baseLayer(),layer('apparel','merchant',{'returns.window_days':30,'presentation.tone':'warm'})],context),fragile=compileLayers([baseLayer(),layer('fragile','merchant',{'returns.window_days':14,'returns.require_evidence':true,'presentation.locale':'fr-CA'})],context);assert.equal(apparel.effective['returns.window_days'],30);assert.equal(fragile.effective['returns.window_days'],14);assert.equal(fragile.effective['returns.require_evidence'],true);assert.equal(fragile.provenance['presentation.locale'].layer_id,'fragile');});
test('CASE-M02-G05-02',()=>{assert.throws(()=>compileLayers([baseLayer(),layer('a'),layer('b')],context));const c=compileLayers([baseLayer(),layer('platform','platform',{required_capabilities:['fulfillment.hold']})],context);assert.equal(c.readiness.ready,false);assert.deepEqual(c.readiness.missing_capabilities,['fulfillment.hold']);assert.equal(c.execution_authorized,false);});
test('CASE-M02-G05-03',()=>{const layers=[baseLayer(),layer('industry','industry',{'returns.window_days':60}),layer('third-merchant','merchant',{'returns.window_days':7}),layer('locale','locale',{'presentation.locale':'fr-CA'})];const a=compileLayers(layers,context),b=compileLayers([...layers].reverse(),context);assert.equal(a.effective['returns.window_days'],7);assert.equal(a.composition_digest,b.composition_digest);assert.equal(a.effective_digest,b.effective_digest);});
test('M02-G05-ALL-LAYER-PRECEDENCE',()=>{const all=[baseLayer(),layer('p','platform',{'data.max_age_seconds':60}),layer('i','industry',{'returns.window_days':45}),layer('m','merchant',{'returns.window_days':30}),layer('s','store',{'returns.window_days':25}),layer('g','segment',{'returns.window_days':20}),layer('l','locale',{'presentation.locale':'en-GB'})];const c=compileLayers(all,context);assert.equal(c.effective['returns.window_days'],20);assert.equal(c.effective['presentation.locale'],'en-GB');assert.equal(c.effective['data.max_age_seconds'],60);});
test('M02-G05-PROTECTED-AUTHORITY-FIELD',()=>{assert.throws(()=>compileLayers([baseLayer(),layer('m','merchant',{'approval_threshold':0})],context));});
test('M02-G05-PLATFORM-CANNOT-CLAIM-CAPABILITY',()=>{assert.throws(()=>compileLayers([baseLayer(),layer('m','merchant',{'capabilities':['fulfillment.hold']})],context));});
test('M02-G05-LOCALE-CANNOT-EDIT-RETURNS',()=>{assert.throws(()=>compileLayers([baseLayer(),layer('l','locale',{'returns.window_days':99})],context));});
test('M02-G05-CROSS-STORE-LAYER',()=>{assert.throws(()=>compileLayers([baseLayer(),{...layer(),store_id:'other'}],context));});
test('M02-G05-MANDATORY-BASE',()=>{assert.throws(()=>compileLayers([layer()],context));});
test('M02-G05-DUPLICATE-LAYER-ID',()=>{assert.throws(()=>compileLayers([baseLayer(),layer('same'),layer('same','store',{})],context));});
test('M02-G05-UNKNOWN-KIND',()=>{assert.throws(()=>compileLayers([baseLayer(),layer('x','custom')],context));});
test('M02-G05-STRING-NOT-BOOLEAN',()=>{assert.throws(()=>compileLayers([baseLayer(),layer('m','merchant',{'returns.require_evidence':'false'})],context));});
test('M02-G05-RETURN-RANGE',()=>{for(const v of [-1,366,30.1,'30'])assert.throws(()=>compileLayers([baseLayer(),layer('m','merchant',{'returns.window_days':v})],context));});
test('M02-G05-EXCLUSIONS-CANONICAL',()=>{const a=compileLayers([baseLayer(),layer('m','merchant',{'returns.excluded_tags':['z','a']})],context),b=compileLayers([baseLayer(),layer('m','merchant',{'returns.excluded_tags':['a','z']})],context);assert.equal(a.effective_digest,b.effective_digest);});
test('M02-G05-SERVER-APPROVAL-PROVENANCE',()=>{const l=layer(),c=compileLayers([baseLayer(),l],{...context,approvals:[{layer_digest:contentDigest(l),actor_id:'reviewer'}]});assert.equal(c.provenance['returns.window_days'].approved_by,'reviewer');});
test('M02-G05-STALE-APPROVAL-NOT-PROPAGATED',()=>{const l=layer(),hash=contentDigest(l);l.values['returns.window_days']=7;const c=compileLayers([baseLayer(),l],{...context,approvals:[{layer_digest:hash,actor_id:'reviewer'}]});assert.equal(c.provenance['returns.window_days'].approved_by,null);});
test('M02-G05-SELF-DECLARED-APPROVER-REJECTED',()=>{assert.throws(()=>compileLayers([baseLayer(),{...layer(),approved_by:'owner'}],context));});
test('M02-G05-INPUT-MUTATION-NO-OUTPUT-MUTATION',()=>{const l=layer(),c=compileLayers([baseLayer(),l],context);l.values['returns.window_days']=200;assert.equal(c.effective['returns.window_days'],14);});
