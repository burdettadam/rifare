import {Permissions} from '../../packages/commerce/authorization.mts';
import test from 'node:test';import assert from 'node:assert/strict';import {usingSupport} from './support-helpers.mts';import {SupportRules,nextRuleTime} from '../../packages/commerce/support-rules.mts';
function rule(f:any,extra:any={}){return {id:'route_one',expected_version:0,trigger:'message_received',conditions:{channel:'any',requires_verified_case:true},priority:5,wait_ms:1000,calendar:{timezone:'UTC',weekdays:[0,1,2,3,4,5,6],start_minute:0,end_minute:1440},action:'handoff_request',expires_at:f.now()+3600000,...extra};}
function event(f:any,extra:any={}){return {id:'message_one',case_id:'case_one',trigger:'message_received',channel:'email',at:f.now(),visited:[],depth:0,link_id:f.link.id,sender_id:'sender_one',...extra};}
function publish(f:any,r:SupportRules,extra:any={}){const d=r.draft(f.owner.scope,rule(f,extra));r.review(f.reviewer.scope,d.id,d.version,d.digest);r.publish(f.owner.scope,d.id,d.version);return d;}
test('CASE-M05-G07-01',()=>usingSupport(f=>{const r=new SupportRules(f.kernel,f.delivery),d=publish(f,r),s=r.simulate(f.a.scope,d.id,d.version,event(f));assert.equal(s.execution_authorized,false);const job=r.schedule(f.a.scope,event(f)).jobs[0];assert.throws(()=>r.execute(f.a.scope,job.id),/NOT_DUE/);f.advance(1000);const out=r.execute(f.a.scope,job.id);assert.equal(out.version,1);assert.equal(out.result.kind,'handoff_request');assert.equal(f.source.calls,0);}));
test('CASE-M05-G07-02',()=>usingSupport(f=>{const r=new SupportRules(f.kernel,f.delivery);assert.throws(()=>r.draft(f.owner.scope,rule(f,{action:'refund.now'})),/RULE_INVALID/);const d=r.draft(f.owner.scope,rule(f));assert.throws(()=>r.review(f.owner.scope,d.id,1,d.digest),/RULE_REVIEW_INVALID/);assert.equal(r.schedule(f.a.scope,event(f)).jobs.length,0);}));
test('CASE-M05-G07-03',()=>usingSupport(f=>{const r=new SupportRules(f.kernel,f.delivery);publish(f,r);const a=r.schedule(f.a.scope,event(f)),b=r.schedule(f.a.scope,event(f));assert.deepEqual(a,b);assert.equal(r.schedule(f.a.scope,event(f,{id:'loop',visited:['route_one'],depth:1})).jobs.length,0);assert.equal(r.schedule(f.a.scope,event(f,{id:'depth',depth:4})).loop_stopped,true);}));
test('M05-G07-04',()=>usingSupport(f=>{const r=new SupportRules(f.kernel,f.delivery);publish(f,r);const j=r.schedule(f.a.scope,event(f)).jobs[0];publish(f,r,{expected_version:1,action:'draft_return'});f.advance(1000);assert.equal(r.execute(f.a.scope,j.id).result.kind,'handoff_request');}));
test('M05-G07-05',()=>usingSupport(f=>{const r=new SupportRules(f.kernel,f.delivery);publish(f,r);const j=r.schedule(f.a.scope,event(f)).jobs[0];r.revoke(f.owner.scope,'route_one',1);f.advance(1000);assert.throws(()=>r.execute(f.a.scope,j.id),/CONFIGURATION_UNAVAILABLE/);assert.equal(f.source.calls,0);}));
test('M05-G07-06',()=>usingSupport(f=>{const c={timezone:'UTC',weekdays:[1,2,3,4,5],start_minute:540,end_minute:1020};assert.equal(nextRuleTime(Date.UTC(2026,0,16,18),c),Date.UTC(2026,0,19,9));const r=new SupportRules(f.kernel,f.delivery);assert.throws(()=>r.draft(f.owner.scope,rule(f,{calendar:{...c,timezone:'America/Denver'}})),/CALENDAR_UNSUPPORTED/);}));
test('M05-G07-07',()=>usingSupport(async f=>{const r=new SupportRules(f.kernel,f.delivery);publish(f,r,{action:'queue_tracking',wait_ms:0});const j=r.schedule(f.a.scope,event(f)).jobs[0],out=r.execute(f.a.scope,j.id);f.consent.record(f.customer,f.grant({purpose:'*',state:'withdrawn'}));await assert.rejects(()=>f.delivery.dispatch(f.a.scope,out.result.operation_id),/DELIVERY_SUPPRESSED/);assert.equal(f.source.calls,0);}));

test('M05-G07-08',()=>usingSupport(f=>{const r=new SupportRules(f.kernel,f.delivery),d=r.draft(f.owner.scope,rule(f));r.review(f.reviewer.scope,d.id,d.version,d.digest);new Permissions(f.kernel).change(f.owner.scope,{actor_id:f.reviewer.actor,role:'reviewer',actions:['case.read','support.read'],resource_ids:null,expected_revision:0});assert.throws(()=>r.publish(f.owner.scope,d.id,d.version),/RULE_REVIEW_INVALID/);assert.equal(r.schedule(f.a.scope,event(f)).jobs.length,0);}));
