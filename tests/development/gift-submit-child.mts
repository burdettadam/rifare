import {DatabaseSync} from 'node:sqlite';import {CommerceKernel} from '../../packages/commerce/kernel.mts';import {ActionGateway} from '../../packages/commerce/action-gateway.mts';
const cfg=JSON.parse(process.env.RIFARE_GIFT_SUBMIT??'{}'),db=new DatabaseSync(cfg.filename),kernel=new CommerceKernel(db,()=>cfg.now);
try{process.stdout.write(JSON.stringify({ready:true})+'\n');await new Promise<void>(resolve=>process.stdin.once('data',()=>resolve()));try{const scope=kernel.authenticate(cfg.bearer),receipt=new ActionGateway(kernel).execute(scope,cfg.input);process.stdout.write(JSON.stringify({result:'submitted',request_id:receipt.return_request_id})+'\n');}catch(error){process.stdout.write(JSON.stringify({result:'rejected',code:error instanceof Error?error.message:'UNKNOWN'})+'\n');}}finally{process.stdin.destroy();db.close();}
