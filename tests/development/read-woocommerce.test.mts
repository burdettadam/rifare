import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';
import {usingExecution} from './execution-helpers.mts';import {SecretVault} from '../../packages/commerce/secrets.mts';
import {WooOrders,wooCredentialReader,WOO_READER,normalizeWooOrder} from '../../packages/adapters/woocommerce/orders.mts';
import {ReadContext} from '../../packages/commerce/read-context.mts';
const read=(file:string)=>JSON.parse(readFileSync(new URL('../fixtures/woocommerce/'+file,import.meta.url),'utf8'));
function setup(f:any){let order=read('order.v1.json'),refunds=read('refunds.v1.json'),status=200,pages='1';const calls:any[]=[];
 const vault=new SecretVault(f.kernel,{activeId:'key',get:()=>Buffer.alloc(32,7)},{},{[WOO_READER]:wooCredentialReader({fixtureFetch:async(url,init)=>{calls.push({url,method:init.method});return new Response(JSON.stringify(url.includes('/refunds')?refunds:order),{status,headers:{'x-wp-totalpages':pages}});}})});
 const secret=vault.put(f.a.scope,{provider:'woocommerce',adapter:WOO_READER,value:JSON.stringify({consumer_key:'ck_synthetic',consumer_secret:'cs_synthetic'})});const adapter=new WooOrders(f.kernel,vault);
 const configuration={origin:'https://woo.example.invalid',secret_ref:secret.ref,granted_scopes:['read'],mode:'fixture'};adapter.configure(f.a.scope,configuration);
 return {adapter,vault,secret,configuration,calls,order,refunds,setStatus:(v:number)=>status=v,setPages:(v:string)=>pages=v};}
test('CASE-M02-G26-01',()=>usingExecution(async f=>{const x=setup(f),r=await x.adapter.refresh(f.a.scope,'17');assert.equal(r.status,'fresh');assert.equal(r.order.number,'W-17');assert.equal(r.order.totals.shop.amount,'45.67');assert.equal(r.order.refunds[0].payment_state,'manual_record_only');assert.equal(r.order.refunds[0].settlement_verified,false);assert(x.calls.every(c=>c.method==='GET'));}));
test('CASE-M02-G26-02',()=>usingExecution(async f=>{const x=setup(f);x.setStatus(403);const r=await x.adapter.refresh(f.a.scope,'17');assert.equal(r.status,'access_denied');assert.equal(r.order,null);assert.equal(x.adapter.gaps().writes,false);}));
test('CASE-M02-G26-03',()=>usingExecution(async f=>{const x=setup(f),r=await x.adapter.refresh(f.a.scope,'17');const reads=new ReadContext(f.kernel,f.caps,{readers:{woocommerce:x.adapter}});assert.equal(reads.orderStatus(f.a.scope,r.resource_id).source.system,'woocommerce');assert.equal(reads.orderStatus(f.a.scope,f.order().id).source.system,'synthetic');assert.equal(reads.orderStatus(f.a.scope,r.resource_id).order.refunds[0].settlement_verified,false);}));
test('M02-G26-API-REFUND-NOT-SETTLEMENT',()=>usingExecution(f=>{const x=setup(f);x.refunds[0].refunded_payment=true;const r=normalizeWooOrder(x.order,x.refunds,'17',f.now());assert.equal(r.payload.refunds[0].payment_state,'gateway_reported_refund');assert.equal(r.payload.refunds[0].settlement_verified,false);}));
test('M02-G26-COMPLETED-NOT-DELIVERED',()=>usingExecution(async f=>{const x=setup(f),r=await x.adapter.refresh(f.a.scope,'17');assert.equal(r.order.delivery_verified,false);assert.deepEqual(r.order.shipments,[]);}));
test('M02-G26-PERSONAL-EXTRANEOUS-FIELDS-OMITTED',()=>usingExecution(async f=>{const x=setup(f),r=await x.adapter.refresh(f.a.scope,'17');assert(!JSON.stringify(r).includes('synthetic-private'));assert(!JSON.stringify(r).includes('must-not-enter-read-context'));assert(!JSON.stringify(r).includes('customer note'));}));
test('M02-G26-MISSING-REFUND-DENIES-SNAPSHOT',()=>usingExecution(async f=>{const x=setup(f);x.refunds.length=0;const r=await x.adapter.refresh(f.a.scope,'17');assert.equal(r.order,null);assert.notEqual(r.status,'fresh');}));
test('M02-G26-REFUND-PAGINATION-NOT-TRUNCATED',()=>usingExecution(async f=>{const x=setup(f);x.setPages('2');const r=await x.adapter.refresh(f.a.scope,'17');assert.equal(r.status,'incomplete_source');assert.equal(r.order,null);}));
test('M02-G26-NO-LIVE-MODE',()=>usingExecution(f=>{const x=setup(f);assert.throws(()=>x.adapter.configure(f.a.scope,{...x.configuration,mode:'live_test'}),/INVALID_INPUT/);assert.equal(x.calls.length,0);}));
test('M02-G26-REDIRECT-DENIED',()=>usingExecution(async f=>{const x=setup(f);x.setStatus(302);const r=await x.adapter.refresh(f.a.scope,'17');assert.equal(r.order,null);assert.equal(x.calls.length,1);}));
test('M02-G26-FRESHNESS-EXPIRES',()=>usingExecution(async f=>{const x=setup(f),r=await x.adapter.refresh(f.a.scope,'17');f.advance(300001);assert.equal(x.adapter.cached(f.a.scope,r.resource_id).status,'stale');assert.equal(x.adapter.cached(f.a.scope,r.resource_id).order,null);}));
test('M02-G26-SECRET-REVOCATION',()=>usingExecution(async f=>{const x=setup(f),r=await x.adapter.refresh(f.a.scope,'17');x.vault.revoke(f.a.scope,x.secret.ref);assert.equal(x.adapter.cached(f.a.scope,r.resource_id).status,'access_denied');}));
test('M02-G26-OTHER-STORE-CANNOT-READ',()=>usingExecution(async f=>{const x=setup(f),r=await x.adapter.refresh(f.a.scope,'17');assert.throws(()=>x.adapter.cached(f.b.scope,r.resource_id),/ADAPTER_UNAVAILABLE|NOT_FOUND/);}));
test('M02-G26-NO-BINARY-MONEY',()=>usingExecution(f=>{const x=setup(f);x.order.total='9007199254740993.01';assert.equal(normalizeWooOrder(x.order,x.refunds,'17',f.now()).payload.totals.shop.amount,'9007199254740993.01');}));
test('M02-G26-INVALID-PRECISION-DENIED',()=>usingExecution(f=>{const x=setup(f);x.order.total='12.345';assert.throws(()=>normalizeWooOrder(x.order,x.refunds,'17',f.now()),/INVALID_PRECISION/);}));
test('M02-G26-DUPLICATE-REFUND-DENIED',()=>usingExecution(f=>{const x=setup(f);x.refunds.push(x.refunds[0]);assert.throws(()=>normalizeWooOrder(x.order,x.refunds,'17',f.now()),/INCOMPLETE_SOURCE/);}));
test('M02-G26-CONNECTION-CHANGE-DENIES-CACHE',()=>usingExecution(async f=>{const x=setup(f),r=await x.adapter.refresh(f.a.scope,'17');x.adapter.configure(f.a.scope,x.configuration);assert.equal(x.adapter.cached(f.a.scope,r.resource_id).status,'connection_changed');}));
test('M02-G26-REFUND-AMOUNT-SUMMARY-CONFLICT',()=>usingExecution(f=>{const x=setup(f);x.refunds[0].amount='12.49';assert.throws(()=>normalizeWooOrder(x.order,x.refunds,'17',f.now()),/INCONSISTENT_REFUND/);}));
test('M02-G26-INVALID-CALENDAR-DATE',()=>usingExecution(f=>{const x=setup(f);x.order.date_modified_gmt='2025-02-30T00:00:00';assert.throws(()=>normalizeWooOrder(x.order,x.refunds,'17',f.now()),/INVALID_SOURCE/);}));
test('M02-G26-PAYMENT-TIMESTAMP-NOT-TRUTHY-TEXT',()=>usingExecution(f=>{const x=setup(f);x.order.date_paid_gmt='not-a-date';assert.throws(()=>normalizeWooOrder(x.order,x.refunds,'17',f.now()),/INVALID_SOURCE/);}));
