import test from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';
import {usingResolution} from './resolution-helpers.mts';
import {ResolutionFixtureSource} from '../../packages/adapters/resolution-fixture-source.mts';
import {ResolutionExecution} from '../../packages/commerce/resolution-execution.mts';
import {unitComponents} from '../../packages/commerce/resolution-ledger.mts';
import {canonical,contentDigest} from '../../packages/commerce/configuration-values.mts';
test('M03-G08-REVIEW-SAME-LABEL-NEW-SOURCE-DENIED',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0])),db=new DatabaseSync(':memory:');try{const impostor=new ResolutionFixtureSource(db,{mode:'fixture',identity:'source-one',tenant:f.a.tenant,store:f.a.store});assert.notEqual(impostor.identity,f.source.identity);const e=new ResolutionExecution(f.kernel,impostor);await assert.rejects(()=>e.dispatch(f.a.scope,op.id),/RESOLUTION_SOURCE_MISMATCH/);}finally{db.close();}}));
test('M03-G06-REVIEW-PER-UNIT-DISCOUNTS-NEVER-NEGATIVE',()=>{const line={quantity:5,gross_minor:'3',discount_minor:'2',tax_minor:'0',shipping_minor:'0',duties_minor:'0'};const rows=[1,2,3,4,5].map(n=>unitComponents({currency:'USD'},line,[n]));assert.ok(rows.every(r=>BigInt(r.paid_minor)>=0n));assert.equal(rows.reduce((n,r)=>n+BigInt(r.paid_minor),0n),1n);});
test('M03-G07-REVIEW-EVIDENCE-REQUEST-BLOCKS-NEW-QUOTE',()=>usingResolution(f=>{const p=f.allocate();f.db.prepare('INSERT INTO commerce_return_review_events(tenant_id,store_id,case_id,actor_id,event,reason,observed_at) VALUES(?,?,?,?,?,?,?)').run(f.a.tenant,f.a.store,'resolution_case','reviewer','evidence_requested','photo_required',f.now());assert.throws(()=>f.quote(p.allocations[0]),/RETURN_REVIEW_REQUIRED/);}));
test('M03-G07-REVIEW-CANCELED-NATIVE-RETURN-BLOCKS',()=>usingResolution(f=>{const p=f.allocate(),row=f.db.prepare('SELECT * FROM commerce_native_return_operations WHERE request_id=?').get(f.request.id) as any;const b=JSON.parse(row.native_body);b.status='CANCELED';f.db.prepare('UPDATE commerce_native_return_operations SET native_body=?,native_digest=? WHERE request_id=?').run(canonical(b),contentDigest(b),f.request.id);assert.throws(()=>f.quote(p.allocations[0]),/NATIVE_RETURN_UNAVAILABLE/);}));
test('M03-G10-REVIEW-RETURN-FEES-IN-EXCHANGE-BALANCE',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog(),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.equal(q.quote.balance_minor,'133');assert.equal(q.quote.allowed,false);}));
test('M03-G10-REVIEW-NATIVE-RESOLUTION-INVALIDATES-EXCHANGE',()=>usingResolution(f=>{const p=f.allocate(),facts=structuredClone(f.facts);facts.paid_lines[2].resolved_units=[1];const lines=structuredClone(f.order().payload.return_lines);lines[2].returned=1;f.update({resolution_facts:facts,return_lines:lines});const c=f.catalog();assert.throws(()=>f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id}),/UNIT_ALREADY_RESOLVED/);}));

test('M03-G08-SOURCE-TIMEOUT-PRESERVES-UNKNOWN-AND-NO-RETRY',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0])),execute=new ResolutionExecution(f.kernel,f.source,{deadline_ms:5});const issue=f.source.issue.bind(f.source);let sends=0;f.source.issue=async command=>{sends++;await issue(command);return await new Promise(()=>{});};const before=Date.now();assert.equal((await execute.dispatch(f.a.scope,op.id)).state,'unknown');assert.ok(Date.now()-before<1000);assert.equal((await execute.dispatch(f.a.scope,op.id)).state,'unknown');assert.equal(sends,1);assert.equal((await execute.reconcile(f.a.scope,op.id)).state,'accepted');}));
test('M03-G08-RECONCILIATION-TIMEOUT-DOES-NOT-RESEND',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0])),execute=new ResolutionExecution(f.kernel,f.source,{deadline_ms:5});await execute.dispatch(f.a.scope,op.id);f.source.lookup=async()=>await new Promise(()=>{});const before=Date.now();assert.equal((await execute.reconcile(f.a.scope,op.id)).state,'accepted');assert.ok(Date.now()-before<1000);}));
test('M03-G07-UNSETTLED-ACCOUNTING-CANNOT-RELEASE-RESERVATION',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));await f.executor.dispatch(f.a.scope,op.id);f.update({resolution_facts:{...f.facts,accounted_operations:[op.id]}});assert.throws(()=>f.quote(p.allocations[1]),/REFUND_ACCOUNTING_UNVERIFIED/);}));
test('M03-G07-UNKNOWN-ACCOUNTING-REFERENCE-REJECTED',()=>usingResolution(f=>{const p=f.allocate();f.update({resolution_facts:{...f.facts,accounted_operations:['invented-op']}});assert.throws(()=>f.quote(p.allocations[0]),/REFUND_ACCOUNTING_UNVERIFIED/);}));
test('M03-G10-FEE-CHANGE-INVALIDATES-EXCHANGE-QUOTE',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog();const q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});f.intake.configure(f.owner.scope,{expected_revision:1,settings:{...f.settings,shipping_minor:'200'}});assert.throws(()=>f.exchanges.assertCurrent(f.a.scope,{quote_id:q.id,quote_digest:q.digest}),/REFUND_FEES_CHANGED/);}));
test('M03-G08-REVIEW-UNRELATED-RESERVATION-DOES-NOT-STALE',()=>usingResolution(async f=>{const p=f.allocate(),first=f.authorize(f.quote(p.allocations[0]));f.authorize(f.quote(p.allocations[1]));await assert.doesNotReject(()=>f.executor.dispatch(f.a.scope,first.id));assert.equal(f.executor.read(f.a.scope,first.id).state,'accepted');}));

test('M03-G09-REVIEW-INSTRUMENT-IDENTITY-CANNOT-CHANGE',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id));await f.executor.dispatch(f.a.scope,op.id);const previous=f.credit.instrument(f.a.scope,f.executor,op.id).instrument.account_id;const lookup=f.source.lookup.bind(f.source);f.source.lookup=async id=>{const r=await lookup(id);r.instrument.account_id='different-native-account';return r;};await assert.rejects(()=>f.executor.reconcile(f.a.scope,op.id),/CREDIT_INSTRUMENT_CHANGED/);assert.equal(f.credit.instrument(f.a.scope,f.executor,op.id).instrument.account_id,previous);}));
