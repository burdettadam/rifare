import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';
import {usingLineage} from './exchange-lineage-helpers.mts';
import {usingInstant,authorizeMandate,releaseReplacement,oracle} from './instant-helpers.mts';
import {usingMoney} from './exchange-money-helpers.mts';
import {usingPolicyPack} from './return-policy-pack-helpers.mts';
import {SupportMetrics} from '../../packages/commerce/support-metrics.mts';
import {ReturnEconomics} from '../../packages/commerce/return-economics.mts';
import {ReturnCancellation} from '../../packages/commerce/return-cancellation.mts';

export const depthOracle=JSON.parse(readFileSync(new URL('../fixtures/return-depth/milestone-values.v1.json',import.meta.url),'utf8'));
function cohort(f:any,caseIds=['resolution_case']){const metrics=new SupportMetrics(f.kernel);metrics.freeze(f.a.scope,{id:'m06_depth',case_ids:caseIds,starts_at:f.now(),ends_at:f.now()+60000});return metrics;}
function costs(f:any,metrics:SupportMetrics,omit:string|null=null){for(const [category,amount_minor] of Object.entries(depthOracle.declared_costs)){if(category===omit)continue;metrics.cost(f.a.scope,{id:'cost_'+category,case_id:'resolution_case',category,currency:'USD',amount_minor,source_ref:'synthetic_'+category,adjustment_of:null});}}
test('CASE-M06-G99-01 integrated mixed return keeps cash credit exchange and costs distinct',()=>usingLineage(async f=>{
 const metrics=cohort(f),refundAllocation=f.plan.allocations.find(a=>a.outcome==='refund')!,creditAllocation=f.plan.allocations.find(a=>a.outcome==='store_credit')!;
 const refund=f.authorize(f.quote(refundAllocation));await f.executor.dispatch(f.a.scope,refund.id);f.source.settle(refund.id);assert.equal((await f.executor.reconcile(f.a.scope,refund.id)).state,'settled');
 const credit=f.authorize(f.credit.quote(f.a.scope,creditAllocation.id));assert.equal((await f.executor.dispatch(f.a.scope,credit.id)).state,'issued');
 const exchange=await f.makeExchange(f.allocation,'1400'),child=f.lineage.materialize(f.a.scope,{operation_id:exchange.op.id});
 assert.equal(child.state,'imported');assert.equal(child.node.carried_minor,depthOracle.mixed.replacement_carried_minor);assert.equal(child.node.replacement_retail_minor,depthOracle.mixed.replacement_retail_minor);
 const nativeRefund=await f.source.lookup(refund.id),nativeCredit=await f.source.lookup(credit.id);assert.equal(nativeRefund!.amount_minor,depthOracle.mixed.new_cash_refund_minor);assert.equal(nativeRefund!.state,'settled');
 assert.equal(nativeCredit!.amount_minor,depthOracle.mixed.issued_credit_minor);assert.equal(nativeCredit!.state,'issued');
 assert.equal(f.executor.read(f.a.scope,exchange.financial.id).amount_minor,depthOracle.mixed.additional_payment_minor);
 costs(f,metrics);const report=new ReturnEconomics(f.kernel).report(f.a.scope,'m06_depth');
 assert.equal(report.denominator,1);assert.equal(report.declared_total_cost_minor,'1400');assert.equal(report.declared_contribution_minor,'2700');assert.equal(report.declared_retained_revenue_minor,'4100');assert.equal(report.observed_operations.length,4);assert.deepEqual(report.uncertain_operation_ids,[]);assert.equal(report.declared_costs_verified,false);assert.equal(report.profitability_established,false);assert.equal(report.external_settlement_qualified,false);
},{discount:true}));
test('CASE-M06-G99-02 missing connected and prerequisite evidence blocks formal M06 acceptance',()=>{
 const q=JSON.parse(readFileSync('work/qualification/M06.json','utf8'));assert.equal(q.full_milestone_accepted,false);assert.equal(q.state,'blocked');assert.equal(q.next_milestone_started,false);assert.equal(q.release_authorized,false);assert.equal(q.worker_goals.length,14);
 for(const missing of ['formal M03-G99, M04-G99 and M05-G99 acceptance','formal acceptance of M06-G01 through M06-G14','connected financial accounts, paired currency and final fee qualification','connected instant-exchange terms, consent and capture qualification','merchant-owned or contracted destination qualification','independent merchant policy and prevention intended-use evaluation','verified merchant total costs and retained contribution'])assert.ok(q.missing.includes(missing),missing);
});
test('M06-G99-OUT-OF-STOCK-FALLBACK-PRESERVES-ALLOCATION',()=>usingLineage(f=>{
 const catalog=f.catalog({available:0}),quote=f.exchanges.quote(f.a.scope,{allocation_id:f.allocation.id,catalog_id:catalog.id});assert.equal(quote.quote.allowed,false);assert.ok(quote.quote.reasons.includes('INSUFFICIENT_STOCK'));assert.deepEqual(quote.quote.alternatives,['refund','store_credit']);assert.throws(()=>f.exchanges.assertCurrent(f.a.scope,{quote_id:quote.id,quote_digest:quote.digest}),/EXCHANGE_UNAVAILABLE/);assert.equal(f.fulfillmentSource.effects().length,0);
 assert.equal(f.plan.allocations.find((a:any)=>a.id===f.allocation.id).outcome,'exchange');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_fulfillment_operations').get()!.n,0);
}));
test('M06-G99-NONRETURN-EXPIRED-MANDATE-REQUIRES-FRESH-CONSENT',()=>usingInstant(async f=>{
 await authorizeMandate(f);await releaseReplacement(f);f.advance(oracle.mandate_lifetime_ms+1);f.refreshSessions();assert.throws(()=>f.instant.quoteCapture(f.a.scope,{obligation_id:f.obligationId}),/INSTANT_REAUTHORIZATION_REQUIRED/);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_instant_captures').get()!.n,0);
 assert.throws(()=>new ReturnCancellation(f.kernel).quote(f.a.scope,{request_id:f.request.id,reason:'customer_cancelled'}),/INSTANT_OBLIGATIONS_UNRESOLVED|CUSTOMER_VERIFICATION_REQUIRED/);
}));
test('M06-G99-NONRETURN-UNKNOWN-CAPTURE-RETAINS-ORIGINAL-CEILING-AND-ID',()=>usingInstant(async f=>{
 await authorizeMandate(f);await releaseReplacement(f);f.advance(oracle.trial_ms);const op=f.authorize(f.instant.quoteCapture(f.a.scope,{obligation_id:f.obligationId}));f.source.fault='after';assert.equal((await f.instant.dispatch(f.a.scope,op.id)).state,'unknown');const final=await f.instant.reconcile(f.a.scope,op.id);assert.equal(final.state,'captured');assert.equal(final.source.captured_minor,depthOracle.unreturned_capture_ceiling_minor);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_instant_captures').get()!.n,1);
}));
test('M06-G99-FINAL-FEE-DISCREPANCY-STAYS-AN-OPEN-OBLIGATION',()=>usingMoney(async f=>{const op=f.authorize(f.moneyQuote());await f.executor.dispatch(f.a.scope,op.id);f.source.settle(op.id);await f.executor.reconcile(f.a.scope,op.id);f.recordFee('final');assert.throws(f.closeReturn,/FEE_DIFFERENCE_UNRESOLVED/);assert.equal(f.effects(),1);},{fees:true}));
test('M06-G99-MISSING-COST-IS-UNKNOWN-INSTEAD-OF-ZERO',()=>usingLineage(f=>{const metrics=cohort(f);costs(f,metrics,'operator_time');const r=new ReturnEconomics(f.kernel).report(f.a.scope,'m06_depth');assert.equal(r.denominator,1);assert.equal(r.costs_complete,false);assert.equal(r.declared_total_cost_minor,null);assert.equal(r.declared_contribution_minor,null);assert.deepEqual(r.incomplete_case_ids,['resolution_case']);}));
test('M06-G99-DUPLICATE-COST-EVENT-DOES-NOT-INFLATE-CONTRIBUTION',()=>usingLineage(f=>{const metrics=cohort(f);costs(f,metrics);costs(f,metrics);const r=new ReturnEconomics(f.kernel).report(f.a.scope,'m06_depth');assert.equal(r.declared_total_cost_minor,'1400');assert.equal(r.declared_contribution_minor,'2700');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_support_costs').get()!.n,5);}));
test('M06-G99-DUPLICATE-RESOURCE-COHORT-CANNOT-DOUBLE-COUNT-RETAINED-VALUE',()=>usingLineage(f=>{const metrics=cohort(f,['case_one','resolution_case']);costs(f,metrics);const r=new ReturnEconomics(f.kernel).report(f.a.scope,'m06_depth');assert.equal(r.denominator,2);assert.equal(r.duplicate_resource_cost_scope,1);assert.equal(r.declared_contribution_minor,null);assert.equal(r.profitability_established,false);}));
test('M06-G99-ECONOMICS-REQUIRES-ANALYTICS-SCOPE-AND-SAME-STORE',()=>usingLineage(f=>{cohort(f);const e=new ReturnEconomics(f.kernel);assert.throws(()=>e.report(f.customer,'m06_depth'),/ACCESS_DENIED/);assert.throws(()=>e.report(f.reviewer.scope,'m06_depth'),/ACCESS_DENIED/);assert.throws(()=>e.report(f.b.scope,'m06_depth'),/SUPPORT_CONFIGURATION_MISSING/);}));
test('M06-G99-ECONOMICS-RETAINS-UNKNOWN-OPERATION-AND-DECLARED-COST-LIMIT',()=>usingLineage(async f=>{const metrics=cohort(f),allocation=f.plan.allocations.find(a=>a.outcome==='refund')!,op=f.authorize(f.quote(allocation)),issue=f.source.issue.bind(f.source);f.source.issue=async command=>{await issue(command);throw new Error('FIXTURE_RESPONSE_LOST');};assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');costs(f,metrics);const r=new ReturnEconomics(f.kernel).report(f.a.scope,'m06_depth');assert.deepEqual(r.uncertain_operation_ids,[op.id]);assert.equal(r.observed_operations[0].state,'unknown');assert.equal(r.declared_contribution_minor,'2700');assert.equal(r.profitability_established,false);assert.equal(r.external_settlement_qualified,false);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get()!.n,1);}));
test('M06-G99-ECONOMICS-REJECTS-ALTERED-LEDGER-AMOUNTS',()=>usingLineage(f=>{cohort(f);const allocation=f.plan.allocations.find(a=>a.outcome==='refund')!,op=f.authorize(f.quote(allocation));f.db.prepare('UPDATE commerce_resolution_operations SET amount_minor=? WHERE id=?').run('1',op.id);assert.throws(()=>new ReturnEconomics(f.kernel).report(f.a.scope,'m06_depth'),/ECONOMICS_OPERATION_INTEGRITY/);}));
test('M06-G99-PACK-EVALUATION-DOES-NOT-SELF-ACCEPT-A-MERCHANT',()=>usingPolicyPack(f=>{const p=f.evaluate();assert.equal(p.readiness.ready,true);assert.equal(p.activation,'none');assert.equal(p.execution_authorized,false);assert.equal(p.production_qualified,false);assert.equal(JSON.parse(readFileSync('work/qualification/M06.json','utf8')).full_milestone_accepted,false);}));
