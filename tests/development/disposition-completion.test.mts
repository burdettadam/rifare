import test from 'node:test';import assert from 'node:assert/strict';
import {usingCompletion} from './completion-helpers.mts';
import {ReturnDisposition} from '../../packages/commerce/return-disposition.mts';
function input(r:any,kind='restock'){return {session_id:r.session_id,unit_ids:[r.units.find((u:any)=>u.line_id==='alpha').id],disposition:kind};}
test('CASE-M03-G17-01',()=>usingCompletion(async f=>{const r=f.full(),op=f.authorizeLife(f.disposition.quote(f.a.scope,input(r)));assert.equal(f.warehouse.stock('shirt-small','warehouse-one'),0);const done=await f.disposition.dispatch(f.a.scope,op.id);assert.equal(done.state,'applied');assert.equal(f.warehouse.stock('shirt-small','warehouse-one'),1);assert.equal((await f.disposition.dispatch(f.a.scope,op.id)).native_id,done.native_id);assert.equal(f.warehouse.stock('shirt-small','warehouse-one'),1);}));
test('CASE-M03-G17-02',()=>usingCompletion(f=>{const r=f.full(true),u=r.units.find(x=>x.line_id==='beta');assert.throws(()=>f.disposition.quote(f.a.scope,{session_id:r.session_id,unit_ids:[u.id],disposition:'restock'}),/DISPOSITION_DENIED/);assert.equal(f.warehouse.stock('hat-small','warehouse-one'),0);}));
test('CASE-M03-G17-03',()=>usingCompletion(async f=>{const r=f.full(),op=f.authorizeLife(f.disposition.quote(f.a.scope,input(r)));f.warehouse.fault='after';assert.equal((await f.disposition.dispatch(f.a.scope,op.id)).state,'unknown');assert.equal(f.warehouse.stock('shirt-small','warehouse-one'),1);await f.disposition.dispatch(f.a.scope,op.id);assert.equal(f.warehouse.calls.apply,1);assert.equal((await f.disposition.reconcile(f.a.scope,op.id)).state,'applied');assert.equal(f.warehouse.calls.apply,1);}));
for(const kind of ['quarantine','dispose','supplier_return'])test('M03-G17-'+kind.toUpperCase()+'-PRESERVES-SELLABLE-INVENTORY',()=>usingCompletion(async f=>{const r=f.full(),op=f.authorizeLife(f.disposition.quote(f.a.scope,input(r,kind)));assert.equal((await f.disposition.dispatch(f.a.scope,op.id)).state,'applied');assert.equal(f.warehouse.stock('shirt-small','warehouse-one'),0);}));
test('DISPOSITION-COMPLETION-A-UNIT-CANNOT-RECEIVE-A-SECOND-DISPOSITION',()=>usingCompletion(async f=>{const r=f.full(),op=f.authorizeLife(f.disposition.quote(f.a.scope,input(r)));await f.disposition.dispatch(f.a.scope,op.id);assert.throws(()=>f.disposition.quote(f.a.scope,input(r,'dispose')),/UNIT_ALREADY_DISPOSED/);}));
test('DISPOSITION-COMPLETION-A-QUOTE-IS-NOT-A-WAREHOUSE-ADJUSTMENT',()=>usingCompletion(f=>{const r=f.full();f.disposition.quote(f.a.scope,input(r));assert.equal(f.warehouse.effects().length,0);assert.equal(f.db.prepare('SELECT COUNT(*) n FROM commerce_disposition_operations').get().n,0);}));
test('DISPOSITION-COMPLETION-MISSING-ADAPTER-CANNOT-IMPLY-STOCK-MOVEMENT',()=>usingCompletion(async f=>{const r=f.full(),op=f.authorizeLife(f.disposition.quote(f.a.scope,input(r)));await assert.rejects(new ReturnDisposition(f.kernel).dispatch(f.a.scope,op.id),/ADAPTER_UNAVAILABLE/);assert.equal(f.warehouse.stock('shirt-small','warehouse-one'),0);}));
test('DISPOSITION-COMPLETION-CLOSED-WORKFLOW-INVALIDATES-AN-UNDISPATCHED-APPROVAL',()=>usingCompletion(async f=>{const r=f.full(),op=f.authorizeLife(f.disposition.quote(f.a.scope,input(r)));f.authorizeLife(f.cancellation.quote(f.a.scope,{request_id:f.request.id,reason:'customer_cancelled'}));await assert.rejects(f.disposition.dispatch(f.a.scope,op.id),/RETURN_CLOSED|APPROVAL/);assert.equal(f.warehouse.stock('shirt-small','warehouse-one'),0);}));
