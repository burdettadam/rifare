import test from 'node:test';
import assert from 'node:assert/strict';
import {DatabaseSync} from 'node:sqlite';
import {usingWooReturns,wooSourceFixtureInput} from './woocommerce-return-helpers.mts';
import {usingReturns} from './return-intake-helpers.mts';
import {WooReturnFixtureSource,WooReturnSources} from '../../packages/adapters/woocommerce/return-source.mts';
import {wooReturnAuthority,assertWooReturnFacts} from '../../packages/adapters/woocommerce/return-contract.mts';
import {contentDigest} from '../../packages/commerce/configuration-values.mts';
import {CommerceKernel} from '../../packages/commerce/kernel.mts';
import {ReturnIntake} from '../../packages/commerce/return-intake.mts';
import {ReadContext} from '../../packages/commerce/read-context.mts';
import {NativeReturns} from '../../packages/commerce/native-returns.mts';
import {ShopifyReturnFixtureAdapter} from '../../packages/adapters/shopify-return-fixture.mts';

test('CASE-M07-G01-01',()=>usingWooReturns(f=>{const p=f.prepare(),receipt=f.submit(p),request=f.intake.read(f.a.scope,f.caseId),authority=wooReturnAuthority(f.kernel,f.kernel.require(f.a.scope),p.id);
 assert.equal(f.order().source_system,'woocommerce');assert.equal(request.return_semantics,'composed_local_rma');assert.equal(request.native_return_id,null);assert.equal(request.receipt_id,receipt.id);assert.equal(authority.native_return_id,null);assert.equal(authority.native_order_id,'17');assert.equal(authority.customer_id,'woo_customer_7');assert.deepEqual(authority.selection.lines,[{line_id:'71',quantity:1}]);assert.equal(authority.configuration_digest,f.cases.inspect(f.a.scope,f.caseId).configuration_digest);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_native_return_operations').get().n,0);assert.equal(f.source.records().native_return_create_effects,0);}));
test('CASE-M07-G01-02',()=>usingWooReturns(async f=>{assert.throws(()=>f.quote({outcome:'exchange'}),/WOO_OUTCOME_UNSUPPORTED/);assert.throws(()=>f.quote({outcome:'store_credit'}),/WOO_OUTCOME_UNSUPPORTED/);const caps=f.woo.capabilities(f.a.scope,f.binding.resource_id);assert.equal(caps.actions.find(x=>x.action==='return.native').available,false);assert.deepEqual(f.intake.form(f.customer,f.caseId).outcomes,['refund']);
 const p=f.prepare();f.submit(p);let calls=0;const native=new NativeReturns(f.kernel,new ShopifyReturnFixtureAdapter({mode:'fixture',identity:'wrong-platform',tenant:f.a.tenant,store:f.a.store,transport:async()=>{calls++;throw new Error();}}));await assert.rejects(()=>native.create(f.a.scope,p.id),/NATIVE_RETURN_INVALID/);assert.equal(calls,0);}));
test('CASE-M07-G01-03',()=>usingWooReturns(f=>{const old=f.cases.inspect(f.a.scope,'case_one'),woo=f.cases.inspect(f.a.scope,f.caseId);assert.deepEqual(woo.pins.skill,old.pins.skill);assert.equal(woo.pins.skill.id,'handle-return');assert.equal(woo.pins.composition.effective['returns.window_days'],old.pins.composition.effective['returns.window_days']);const p=f.prepare();f.submit(p);assert.equal(f.intake.read(f.a.scope,f.caseId).native_return_id,null);assert(!JSON.stringify(woo.order).includes('gid://shopify'));assert.equal(wooReturnAuthority(f.kernel,f.kernel.require(f.a.scope),p.id).kind,'composed_local_rma');}));
test('M07-G01-EXISTING-SHOPIFY-INTAKE-RETAINED',()=>usingReturns(f=>{const p=f.prepare(),receipt=f.submit(p);assert.equal(receipt.effect,'local_return_request_only');assert.equal(f.intake.read(f.a.scope,'case_one').state,'submitted');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_woo_rma_bindings').get().n,0);}));
test('M07-G01-COMPLETE-READ-USES-ORIGINAL-WOO-LINEAGE',()=>usingWooReturns(f=>{const reads=new ReadContext(f.kernel,f.caps,{readers:{woocommerce:f.woo}}),r=reads.orderStatus(f.customer,f.binding.resource_id);assert.equal(r.source.system,'woocommerce');assert.equal(r.source.native_id,'17');assert.equal(r.order.financial_status,'payment_date_recorded');assert.equal(r.source.evidence_kind,'complete_synthetic_wire_fixture');assert.equal(r.production_qualified,false);}));
test('M07-G01-UNBOUND-WOO-ORDER-REJECTED',()=>usingWooReturns(f=>{f.db.prepare('DELETE FROM commerce_woo_return_sources').run();assert.throws(()=>f.quote(),/WOO_SOURCE_UNQUALIFIED/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_woo_rma_bindings').get().n,0);}));
test('M07-G01-CHANGED-CANONICAL-SNAPSHOT-REJECTED',()=>usingWooReturns(f=>{const o=f.order();f.kernel.ingest(f.a.scope,{kind:o.kind,source_system:o.source_system,external_id:o.external_id,source_version:o.source_version+1,source_updated_at:f.now(),customer_id:o.customer_id,payload:{...o.payload,delivered_at:0}});assert.throws(()=>f.quote(),/WOO_SOURCE_INTEGRITY/);}));
test('M07-G01-NATIVE-CHANGE-BEFORE-APPROVAL-NO-RMA',()=>usingWooReturns(f=>{const p=f.prepare(),a=f.gateway.approve(f.reviewer.scope,{preview_id:p.preview_id,preview_digest:p.preview_digest});f.publish();assert.throws(()=>f.gateway.execute(f.a.scope,{preview_id:p.preview_id,preview_digest:p.preview_digest,approval_id:a.id}),/WOO_SOURCE_CHANGED/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_woo_rma_bindings').get().n,0);assert.equal(f.db.prepare('SELECT uses FROM commerce_action_approvals WHERE id=?').get(a.id).uses,0);}));
test('M07-G01-REFRESH-RETAINS-CASE-CONFIGURATION',()=>usingWooReturns(f=>{const pins=f.cases.inspect(f.a.scope,f.caseId).configuration_digest;f.publish();f.woo.refresh(f.a.scope,'17');assert.equal(f.cases.resume(f.a.scope,f.caseId).configuration_digest,pins);assert.equal(f.quote().quote.source_version,2);}));
test('M07-G01-REVOKED-APPROVAL-NO-RMA',()=>usingWooReturns(f=>{const p=f.prepare(),a=f.gateway.approve(f.reviewer.scope,{preview_id:p.preview_id,preview_digest:p.preview_digest});f.gateway.revokeApproval(f.reviewer.scope,a.id);assert.throws(()=>f.gateway.execute(f.a.scope,{preview_id:p.preview_id,preview_digest:p.preview_digest,approval_id:a.id}),/APPROVAL_UNAVAILABLE/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_woo_rma_bindings').get().n,0);}));
test('M07-G01-CROSS-TENANT-READ-AND-BIND-DENIED',()=>usingWooReturns(f=>{assert.throws(()=>f.woo.bind(f.b.scope,{native_order_id:'17',expected_revision:0}),/WOO_SOURCE_TENANT_MISMATCH/);assert.throws(()=>f.intake.read(f.b.scope,f.caseId),/NOT_FOUND/);assert.throws(()=>assertWooReturnFacts(f.kernel,f.kernel.require(f.b.scope),f.order()),/WOO_SOURCE_UNQUALIFIED/);}));
test('M07-G01-LOCAL-RMA-RESERVES-QUANTITY',()=>usingWooReturns(f=>{f.submit();const q=f.quote({lines:[{line_id:'71',quantity:2}]});assert.equal(q.quote.decision.decision,'deny');assert(q.quote.decision.reasons.includes('QUANTITY_UNAVAILABLE'));assert.equal(f.source.records().native_return_create_effects,0);}));
test('M07-G01-REPLAY-REQUEST-REUSES-CANONICAL-RECEIPT',()=>usingWooReturns(f=>{const q=f.quote(),p=f.prepare(q),receipt=f.submit(p),again=f.prepare(q);assert.equal(again.id,p.id);assert.equal(again.receipt_id,receipt.id);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_woo_rma_bindings').get().n,1);}));
test('M07-G01-RESTART-RETAINS-LOCAL-RMA-WITHOUT-NATIVE-ID',()=>usingWooReturns(f=>{const p=f.prepare();f.submit(p);const db=new DatabaseSync(f.filename);try{const k=new CommerceKernel(db,f.now),woo=new WooReturnSources(k,f.source),scope=k.authenticate(f.a.bearer),read=new ReturnIntake(k).read(scope,f.caseId);assert.equal(read.id,p.id);assert.equal(read.native_return_id,null);assert.equal(woo.cached(scope,f.binding.resource_id).source.system,'woocommerce');}finally{db.close();}}));
test('M07-G01-TAMPERED-RMA-CANNOT-PROVIDE-NATIVE-AUTHORITY',()=>usingWooReturns(f=>{const p=f.prepare();f.submit(p);const row=f.db.prepare('SELECT * FROM commerce_woo_rma_bindings').get(),body=JSON.parse(row.body);body.native_return_id='17';f.db.prepare('UPDATE commerce_woo_rma_bindings SET body=?,digest=?').run(JSON.stringify(body),contentDigest(body));assert.throws(()=>wooReturnAuthority(f.kernel,f.kernel.require(f.a.scope),p.id),/WOO_RMA_INTEGRITY/);}));
test('M07-G01-MISSING-DELIVERY-IS-NOT-ORDER-COMPLETION',()=>usingWooReturns(f=>{const p=wooSourceFixtureInput(f.now());p.fulfillment.complete=false;assert.throws(()=>f.source.seed(p),/WOO_FULFILLMENT_UNVERIFIED/);}));
test('M07-G01-MISSING-PAID-HISTORY-REJECTED',()=>usingWooReturns(f=>{const p=wooSourceFixtureInput(f.now());p.financial_contract.history_complete=false;assert.throws(()=>f.source.seed(p),/WOO_PAYMENT_HISTORY_UNVERIFIED/);}));
test('M07-G01-PARTIAL-ITEM-HISTORY-REJECTED',()=>usingWooReturns(f=>{const p=wooSourceFixtureInput(f.now());p.fulfillment.lines=[];assert.throws(()=>f.source.seed(p),/WOO_FULFILLMENT_UNVERIFIED/);}));
test('M07-G01-FOREIGN-PAYMENT-AND-OVERFULFILLMENT-REJECTED',()=>usingWooReturns(f=>{let p=wooSourceFixtureInput(f.now());p.financial_contract.transaction_id='another_transaction';assert.throws(()=>f.source.seed(p),/WOO_PAYMENT_HISTORY_UNVERIFIED/);p=wooSourceFixtureInput(f.now());p.fulfillment.lines[0].fulfilled=3;assert.throws(()=>f.source.seed(p),/WOO_QUANTITY_HISTORY_UNVERIFIED/);}));
test('M07-G01-NATIVE-SOURCE-BYTES-ARE-INDEPENDENT-ORACLE',()=>usingWooReturns(f=>{const before=f.source.records();f.submit();assert.deepEqual(f.source.records(),before);f.sourceDb.prepare("UPDATE woo_fixture_order_versions SET body='{}'").run();assert.throws(()=>f.quote(),/WOO_NATIVE_SOURCE_INTEGRITY/);}));
test('M07-G01-RESTORED-WRITES-REQUIRE-REATTACHED-SOURCE',()=>usingWooReturns(f=>{const db=new DatabaseSync(f.filename);try{const k=new CommerceKernel(db,f.now);assert.throws(()=>new ReturnIntake(k).evaluate(k.authenticate(f.customerBearer),f.selection()),/WOO_SOURCE_UNAVAILABLE/);}finally{db.close();}}));
test('M07-G01-NO-LIVE-SOURCE-OR-SHARED-DATABASE',()=>usingWooReturns(f=>{assert.throws(()=>new WooReturnSources(f.kernel,new WooReturnFixtureSource(f.db,{mode:'fixture',identity:'bad',tenant:f.a.tenant,store:f.a.store,account_id:'same',origin:'https://same.example.invalid'},f.now)),/SEPARATE_WOO_SOURCE_REQUIRED/);assert.throws(()=>new WooReturnFixtureSource(f.sourceDb,{mode:'live' as any,identity:'bad',tenant:f.a.tenant,store:f.a.store,account_id:'same',origin:'https://real.example.com'},f.now),/WOO_SOURCE_UNQUALIFIED/);}));
