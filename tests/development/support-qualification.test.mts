import test from 'node:test';import assert from 'node:assert/strict';import {usingSupport} from './support-helpers.mts';import {SupportQualification} from '../../packages/commerce/support-qualification.mts';
export function evidence(f:any,action='diagnostic.resolution.set'){const c=f.cases.inspect(f.a.scope,'case_one'),pins={skill_digest:c.pins.skill.digest,profile_digest:c.pins.profile.sha256,policy_digest:c.pins.policy.digest,adapter_digest:c.pins.adapter.sha256,model_id:'model_one',runtime_id:'runtime_one',prompt_digest:'a'.repeat(64),configuration_digest:'b'.repeat(64),action},suite=Array.from({length:10},(_,i)=>({id:'scenario_'+i,action,expected_facts:{amount:'0'},expected_handling:i===9?'handoff':'draft',critical:i<3})),results=suite.map(c=>({id:c.id,facts:c.expected_facts,handling:c.expected_handling,unauthorized_action:false,configuration_digest:pins.configuration_digest}));return {pins,suite,results};}
export function qualified(f:any,action='diagnostic.resolution.set'){const q=new SupportQualification(f.kernel),e=evidence(f,action),frozen=q.freeze(f.owner.scope,{id:'suite_one',expected_version:0,pins:e.pins,suite:e.suite,expires_at:f.now()+3600000});f.advance(1);const r=q.register(f.owner.scope,{id:'qual_one',expected_version:0,suite_id:'suite_one',suite_version:1,suite_digest:frozen.digest,results:e.results,evidence_kind:'synthetic_fixture'});q.review(f.reviewer.scope,r.id,1,r.digest);return {q,e,r,frozen};}
function mode(f:any,q:SupportQualification,e:any,extra:any={}){return q.configureMode(f.owner.scope,{case_id:'case_one',expected_version:0,mode:'bounded',pins:e.pins,qualification_id:'qual_one',qualification_version:1,maximum_minor:'15000',currency:'USD',require_inspection:false,expires_at:f.now()+60000,...extra});}
test('CASE-M05-G08-01',()=>usingSupport(f=>{const {q,e}=qualified(f);mode(f,q,e);f.ownership.assign(f.owner.scope,{case_id:'case_one',expected_generation:1,actor_id:'agent'});const p=f.gateway.prepare(f.agent.scope,f.proposal());assert.throws(()=>f.gateway.execute(f.agent.scope,{preview_id:p.id,preview_digest:p.digest,approval_id:'invented'}),/APPROVAL_UNAVAILABLE/);const a=f.approve(p),r=f.execute(p,a);assert.equal(r.financial_effect,false);assert.equal(r.amount.minor,'12500');}));
test('CASE-M05-G08-02',()=>usingSupport(f=>{const {q,e}=qualified(f);mode(f,q,e,{require_inspection:true});assert.throws(()=>q.check(f.a.scope,'case_one','diagnostic.resolution.set','execute',{minor:'12500',currency:'USD'}),/INSPECTION_REQUIRED/);}));
test('CASE-M05-G08-03',()=>usingSupport(f=>{const {q,e}=qualified(f);mode(f,q,e);f.ownership.assign(f.owner.scope,{case_id:'case_one',expected_generation:1,actor_id:'agent'});const p=f.gateway.prepare(f.agent.scope,f.proposal()),a=f.approve(p);q.revoke(f.owner.scope,'qual_one',1);assert.throws(()=>f.execute(p,a),/CONFIGURATION_UNAVAILABLE/);assert.equal(f.gateway.state(f.a.scope,'case_one').revision,0);}));
test('CASE-M05-G16-01',()=>usingSupport(f=>{const {q,e,r}=qualified(f);const proof=q.inspect(f.a.scope,r.id,1,e.pins);assert.equal(proof.scoring.total,10);assert.equal(proof.diagnostic_qualified,true);assert.equal(proof.production_qualified,false);}));
test('CASE-M05-G16-02',()=>usingSupport(f=>{const {q,e}=qualified(f,'order.status');assert.throws(()=>q.inspect(f.a.scope,'qual_one',1,{...e.pins,action:'diagnostic.resolution.set'}),/QUALIFICATION_CHANGED/);assert.throws(()=>q.inspect(f.a.scope,'qual_one',1,{...e.pins,model_id:'another_model'}),/QUALIFICATION_CHANGED/);assert.throws(()=>q.inspect(f.a.scope,'qual_one',1,{...e.pins,prompt_digest:'c'.repeat(64)}),/QUALIFICATION_CHANGED/);}));
test('CASE-M05-G16-03',()=>usingSupport(f=>{const q=new SupportQualification(f.kernel),e=evidence(f),frozen=q.freeze(f.owner.scope,{id:'suite_one',expected_version:0,pins:e.pins,suite:e.suite,expires_at:f.now()+60000});f.advance(1);const p={id:'q',expected_version:0,suite_id:'suite_one',suite_version:1,suite_digest:frozen.digest,results:e.results,evidence_kind:'synthetic_fixture'};assert.throws(()=>q.register(f.owner.scope,{...p,results:e.results.slice(1)}),/EVIDENCE_INVALID/);assert.throws(()=>q.register(f.owner.scope,{...p,results:[e.results[0],...e.results.slice(0,9)]}),/RESULTS_INVALID/);}));
test('M05-G16-07',()=>usingSupport(f=>{const {q,e,frozen}=qualified(f);assert.throws(()=>q.register(f.owner.scope,{id:'q2',expected_version:0,suite_id:'suite_one',suite_version:1,suite_digest:frozen.digest,results:e.results,evidence_kind:'synthetic_fixture',suite:[]}));}));
test('M05-G16-08',()=>usingSupport(f=>{const q=new SupportQualification(f.kernel),e=evidence(f),frozen=q.freeze(f.owner.scope,{id:'suite_one',expected_version:0,pins:e.pins,suite:e.suite,expires_at:f.now()+60000});f.advance(1);e.results[0].facts={amount:'999'};const r=q.register(f.owner.scope,{id:'q',expected_version:0,suite_id:'suite_one',suite_version:1,suite_digest:frozen.digest,results:e.results,evidence_kind:'synthetic_fixture'});assert.throws(()=>q.review(f.owner.scope,r.id,1,r.digest),/REVIEW_INVALID/);assert.throws(()=>q.review(f.reviewer.scope,r.id,1,r.digest),/REVIEW_INVALID/);}));
test('M05-G08-04',()=>usingSupport(f=>{const {q,e}=qualified(f);mode(f,q,e,{maximum_minor:'100'});assert.throws(()=>q.check(f.a.scope,'case_one','diagnostic.resolution.set','execute',{minor:'12500',currency:'USD'}),/AUTOMATION_LIMIT/);mode(f,q,e,{expected_version:1,mode:'read_only'});assert.throws(()=>q.check(f.a.scope,'case_one','diagnostic.resolution.set','propose'),/MODE_DENIED/);}));
