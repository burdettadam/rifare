import test from 'node:test';
import assert from 'node:assert/strict';
import { CommerceKernel } from '../../packages/commerce/kernel.mts';
import { Capabilities } from '../../packages/commerce/capabilities.mts';
import { StoreSimulator,FIXTURE_CLOCK } from '../../packages/commerce/simulator.mts';
import { commerceFixture } from './commerce-helpers.mts';

function setup(){const f=commerceFixture(),caps=new Capabilities(f.kernel),sim=new StoreSimulator(f.kernel,caps);sim.reset(f.a.scope);sim.reset(f.b.scope,{profile:'fragile',clock:FIXTURE_CLOCK});return {...f,caps,sim};}
const use=(fn:(f:ReturnType<typeof setup>)=>unknown)=>{const f=setup();try{return fn(f);}finally{f.cleanup();}};
const movement={operation_id:'op-1',shipment:'SHIP-1001',expected_version:1,to:'delivered'};
test('M01-G05-01',()=>use(f=>{const order=f.sim.read(f.a.scope,'order','ORD-1001');assert.equal(order.payload.total_minor,12500);const ship=f.sim.advanceShipment(f.a.scope,movement);assert.equal(ship.payload.status,'delivered');assert.equal(ship.source_version,2);assert.equal(ship.source_updated_at,FIXTURE_CLOCK+1000);}));
test('M01-G05-02',()=>use(f=>{let network=0;const fetch=globalThis.fetch;globalThis.fetch=(async()=>{network++;throw new Error('network forbidden');}) as any;try{assert.throws(()=>f.sim.replay(f.a.scope,{profile:'apparel',operations:[],endpoint:'https://live.invalid',api_key:'synthetic-live-key'}),/INVALID_INPUT/);assert.throws(()=>f.sim.reset(f.a.scope,{profile:'apparel',clock:FIXTURE_CLOCK,url:'https://live.invalid'}),/INVALID_INPUT/);assert.equal(network,0);}finally{globalThis.fetch=fetch;}}));
test('M01-G05-03',()=>use(f=>{const before=f.sim.read(f.a.scope,'shipment','SHIP-1001');f.sim.advanceShipment(f.a.scope,movement);f.sim.reset(f.a.scope);f.sim.read(f.a.scope,'catalog','SKU-1');const after=f.sim.read(f.a.scope,'shipment','SHIP-1001');assert.deepEqual(after,before);assert.equal(f.sim.receipt(f.a.scope,'op-1').status,'unknown');}));
test('M01-G05-04',()=>use(f=>{assert.equal(f.sim.read(f.b.scope,'order','ORD-1001').payload.total_minor,6400);f.sim.reset(f.a.scope);assert.equal(f.sim.read(f.b.scope,'order','ORD-1001').payload.total_minor,6400);}));
test('M01-G05-05',()=>use(f=>{f.sim.armFault(f.a.scope,'after_accept');assert.throws(()=>f.sim.advanceShipment(f.a.scope,movement),/OUTCOME_UNKNOWN/);assert.equal(f.sim.receipt(f.a.scope,'op-1').status,'simulated_state_changed');assert.equal(f.sim.advanceShipment(f.a.scope,movement).source_version,2);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_simulator_receipts').get().n,1);}));
test('M01-G05-06',()=>use(f=>{f.sim.armFault(f.a.scope,'before_accept');assert.throws(()=>f.sim.advanceShipment(f.a.scope,movement),/PROVIDER_UNAVAILABLE/);assert.equal(f.sim.receipt(f.a.scope,'op-1').status,'unknown');assert.equal(f.sim.read(f.a.scope,'shipment','SHIP-1001').source_version,1);assert.equal(f.sim.advanceShipment(f.a.scope,movement).source_version,2);}));
test('M01-G05-07',()=>use(f=>{f.sim.armFault(f.a.scope,'reject');assert.throws(()=>f.sim.advanceShipment(f.a.scope,movement),/PROVIDER_REJECTED/);assert.equal(f.sim.receipt(f.a.scope,'op-1').status,'unknown');}));
test('M01-G05-08',()=>use(f=>{f.sim.advanceShipment(f.a.scope,movement);assert.throws(()=>f.sim.advanceShipment(f.a.scope,{...movement,to:'in_transit'}),/IDEMPOTENCY_CONFLICT/);assert.throws(()=>f.sim.advanceShipment(f.a.scope,{...movement,operation_id:'op-2'}),/SOURCE_VERSION_CONFLICT/);}));
test('M01-G05-09',()=>use(f=>{f.sim.advanceShipment(f.a.scope,movement);assert.throws(()=>f.sim.advanceShipment(f.a.scope,{...movement,operation_id:'op-2',expected_version:2,to:'in_transit'}),/INVALID_TRANSITION/);}));
test('M01-G05-10',()=>use(f=>{f.sim.armFault(f.a.scope,'reject');assert.equal(f.sim.read(f.b.scope,'order','ORD-1001').payload.total_minor,6400);assert.throws(()=>f.sim.read(f.a.scope,'order','ORD-1001'),/PROVIDER_REJECTED/);assert.equal(f.sim.read(f.a.scope,'order','ORD-1001').payload.total_minor,12500);}));
test('M01-G05-11',()=>use(f=>{const a=f.sim.read(f.a.scope,'order','ORD-1001');a.payload.total_minor=0;assert.equal(f.sim.read(f.a.scope,'order','ORD-1001').payload.total_minor,12500);const p=f.sim.read(f.a.scope,'payment','PAY-1001');assert.equal(p.payload.simulated,true);assert.equal(p.payload.state,'simulated_captured');}));
test('M01-G05-12',()=>use(f=>{f.sim.armFault(f.a.scope,'after_accept');assert.throws(()=>f.sim.advanceShipment(f.a.scope,movement),/OUTCOME_UNKNOWN/);const k=new CommerceKernel(f.db,f.now),s=new StoreSimulator(k,new Capabilities(k));assert.equal(s.receipt(k.authenticate(f.a.bearer),'op-1').status,'simulated_state_changed');}));
test('M01-G05-13',()=>use(f=>{assert.throws(()=>f.sim.reset(f.a.worker),/ACCESS_DENIED/);assert.throws(()=>f.sim.advanceShipment(f.a.worker,movement),/ACCESS_DENIED/);f.sim.advanceShipment(f.a.scope,movement);assert.deepEqual(f.sim.receipt(f.b.scope,'op-1'),{status:'unknown',simulated:true});}));
test('M01-G05-14',()=>use(f=>{const rows=f.sim.replay(f.a.scope,{profile:'apparel',operations:[{kind:'order',external_id:'ORD-1001'},{kind:'catalog',external_id:'SKU-1'}]});const again=f.sim.replay(f.a.scope,{profile:'apparel',operations:[{kind:'catalog',external_id:'SKU-1'},{kind:'order',external_id:'ORD-1001'}]});assert.deepEqual(rows,[again[1],again[0]]);}));
test('M01-G05-15',()=>use(f=>{f.sim.advanceShipment(f.a.scope,movement);assert.throws(()=>f.sim.replay(f.a.scope,{profile:'apparel',operations:[{kind:'order',external_id:'ORD-1001'},{kind:'http',external_id:'secret',url:'https://live.invalid'}]}),/INVALID_INPUT/);assert.equal(f.sim.read(f.a.scope,'shipment','SHIP-1001').source_version,2);}));
test('M01-G05-16',()=>use(f=>{const r=f.sim.read(f.a.scope,'order','ORD-1001');f.kernel.attach(f.a.scope,r.id,{fixture:'old'});f.kernel.enqueueRead(f.a.scope,r.id);f.sim.reset(f.a.scope);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_attachments').get().n,0);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_read_jobs').get().n,0);}));
