import test from 'node:test';import assert from 'node:assert/strict';import {spawn} from 'node:child_process';import {usingEdits} from './order-edit-helpers.mts';
async function processRun(f:any,e:string,mode:string){const code=`import{DatabaseSync}from'node:sqlite';import{CommerceKernel}from'./packages/commerce/kernel.mts';import{OrderEditFixtureSource}from'./packages/adapters/order-edit-fixture-source.mts';import{OrderEdits}from'./packages/commerce/order-edit-execution.mts';let raw='';for await(const d of process.stdin)raw+=d;const p=JSON.parse(raw),db=new DatabaseSync(p.file),sourceDb=new DatabaseSync(p.source),k=new CommerceKernel(db,()=>p.at),src=new OrderEditFixtureSource(sourceDb,{mode:'fixture',identity:'edit-fixture',tenant:p.tenant,store:p.store},()=>p.at),edits=new OrderEdits(k,src);if(p.mode==='crash'){const apply=src.perform.bind(src);src.perform=async c=>{const r=await apply(c);if(c.stage==='commit')process.exit(29);return r;};}try{const r=await edits.dispatch(k.authenticate(p.bearer),p.edit);console.log(JSON.stringify({state:r.state}));}finally{db.close();sourceDb.close();}`;
 return new Promise<any>((resolve,reject)=>{const p=spawn(process.execPath,['--experimental-strip-types','--input-type=module','-e',code],{stdio:['pipe','pipe','pipe']});let out='',err='';p.stdout.on('data',v=>out+=v);p.stderr.on('data',v=>err+=v);p.on('error',reject);p.on('close',code=>resolve({code,out,err}));p.stdin.end(JSON.stringify({file:f.filename,source:f.sourceFile,at:f.now(),tenant:f.a.tenant,store:f.a.store,bearer:f.a.bearer,edit:e,mode}));});}
const commits=(f:any)=>f.sourceDb.prepare("SELECT count(*) n FROM edit_source_effects WHERE json_extract(result,'$.stage')='commit'").get().n;
test('M04-G05-PROCESS-01 concurrent dispatchers produce one native commit and one stock decrement',()=>usingEdits(async f=>{const e=f.authorize().order_edit_id,results=await Promise.all([processRun(f,e,'normal'),processRun(f,e,'normal')]);for(const r of results)assert.equal(r.code,0,r.err);f.edits.reconcile(f.a.scope,e);await f.edits.dispatch(f.a.scope,e);assert.equal(commits(f),1);assert.equal(f.native.catalog('equal').stock,9);assert.equal((await f.edits.release(f.a.scope,e)).state,'released');}));
test('M04-G05-PROCESS-02 source commit and process termination reconcile without another native edit',()=>usingEdits(async f=>{const e=f.authorize().order_edit_id,r=await processRun(f,e,'crash');assert.equal(r.code,29);assert.equal(f.edits.status(f.a.scope,e).state,'unknown');assert.equal(commits(f),1);assert.equal(f.native.order(f.original.id).version,2);assert.equal((await f.edits.dispatch(f.a.scope,e)).state,'unknown');f.edits.reconcile(f.a.scope,e);await f.edits.dispatch(f.a.scope,e);assert.equal(commits(f),1);assert.equal(f.native.catalog('equal').stock,9);assert.equal((await f.edits.release(f.a.scope,e)).state,'released');}));
test('M04-G09-MULTI-01 cancellation holds and acknowledges two actual synthetic warehouses',()=>usingEdits(async f=>{const e=f.authorize(f.quote({kind:'cancel',line_id:null,variant_id:null})).order_edit_id;const r=await f.edits.dispatch(f.a.scope,e);assert.equal(r.source.warehouses.length,2);for(const w of ['warehouse_one','warehouse_two']){assert.equal(f.native.warehouse(f.original.id,w).cancelled,true);assert.equal(f.native.canPick(f.original.id,w),false);}f.native.settle(e);await f.edits.dispatch(f.a.scope,e);assert.equal((await f.edits.release(f.a.scope,e)).state,'cancelled');},{order:{lines:[{id:'line_one',variant_id:'basic',product_id:'shirt',warehouse_id:'warehouse_one',quantity:1,unit_minor:'2000',discount_minor:'0',tax_minor:'0',tax_bps:0,status:'unfulfilled',subscription:false},{id:'line_two',variant_id:'basic',product_id:'shirt',warehouse_id:'warehouse_two',quantity:1,unit_minor:'2000',discount_minor:'0',tax_minor:'0',tax_bps:0,status:'unfulfilled',subscription:false}],total_minor:'4000',net_paid_minor:'4000'}}));
test('M04-G02-REVIEW-09 initially shipped warehouse is not pickable merely because source was seeded',()=>usingEdits(f=>{assert.equal(f.native.canPick(f.original.id,'warehouse_two'),false);},{order:{lines:[{id:'line_one',variant_id:'basic',product_id:'shirt',warehouse_id:'warehouse_one',quantity:1,unit_minor:'2000',discount_minor:'0',tax_minor:'0',tax_bps:0,status:'unfulfilled',subscription:false},{id:'line_two',variant_id:'basic',product_id:'shirt',warehouse_id:'warehouse_two',quantity:1,unit_minor:'2000',discount_minor:'0',tax_minor:'0',tax_bps:0,status:'shipped',subscription:false}],total_minor:'4000',net_paid_minor:'4000'}}));
