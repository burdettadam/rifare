import test from 'node:test';import assert from 'node:assert/strict';
import { createHmac } from 'node:crypto';import { DatabaseSync } from 'node:sqlite';
import { usingExecution,syntheticHeaders } from './execution-helpers.mts';
import { CommerceKernel } from '../../packages/commerce/kernel.mts';
import { WebhookInbox,WEBHOOK_MAX_BYTES } from '../../packages/commerce/webhook-inbox.mts';
import { startCommerceServer } from '../../apps/commerce-api/server.mts';
const key=Buffer.alloc(32,83),raw=Buffer.from('{ "id":"ORD-1001", "status":"shipped" }');
function setup(f:any,provider='synthetic'){const inbox=new WebhookInbox(f.kernel,ref=>ref==='test-key'?key:undefined),route=inbox.register(f.owner.scope,{provider,topic:'orders/updated',shop_domain:provider==='synthetic'?'store-a.example.invalid':'store-a.myshopify.com',api_version:'2026-10',key_ref:'test-key'});return {inbox,route,headers:syntheticHeaders(route,raw,key,f.now())};}

test('CASE-M02-G12-01',()=>usingExecution(f=>{const x=setup(f),result=x.inbox.receive(x.route.id,x.headers,raw);assert.equal(result.acknowledged,true);const db=new DatabaseSync(f.filename);try{const k=new CommerceKernel(db,f.now),i=new WebhookInbox(k,()=>key),r=i.read(k.authenticate(f.a.bearer),result.id);assert.equal(r.status,'pending');assert.equal(r.metadata.routing_verified,true);assert.equal(r.payload.id,'ORD-1001');}finally{db.close();}}));
test('CASE-M02-G12-02',()=>usingExecution(f=>{const x=setup(f);assert.throws(()=>x.inbox.receive(x.route.id,x.headers,Buffer.from('{"id":"ORD-1001","status":"shipped"}')),/WEBHOOK_SIGNATURE_INVALID/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_webhook_inbox').get().n,0);}));
test('CASE-M02-G12-03',()=>usingExecution(f=>{const x=setup(f);f.db.exec("CREATE TRIGGER inbox_failure BEFORE INSERT ON commerce_webhook_inbox BEGIN SELECT RAISE(ABORT,'fixture'); END;");assert.throws(()=>x.inbox.receive(x.route.id,x.headers,raw),/WEBHOOK_PERSISTENCE_FAILED/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_webhook_inbox').get().n,0);f.db.exec('DROP TRIGGER inbox_failure');assert.equal(x.inbox.receive(x.route.id,x.headers,raw).http_status,202);}));
test('M02-G12-EXACT-RAW-BYTES-PRESERVED',()=>usingExecution(f=>{const x=setup(f),r=x.inbox.receive(x.route.id,x.headers,raw);assert.deepEqual(Buffer.from(f.db.prepare('SELECT body FROM commerce_webhook_inbox WHERE id=?').get(r.id).body),raw);}));
test('M02-G12-DUPLICATE-DELIVERY',()=>usingExecution(f=>{const x=setup(f),a=x.inbox.receive(x.route.id,x.headers,raw),b=x.inbox.receive(x.route.id,x.headers,raw);assert.equal(b.id,a.id);assert.equal(b.duplicate,true);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_webhook_inbox').get().n,1);}));
test('M02-G12-SAME-ID-DIFFERENT-BODY',()=>usingExecution(f=>{const x=setup(f);x.inbox.receive(x.route.id,x.headers,raw);const changed=Buffer.from('{"changed":true}');assert.throws(()=>x.inbox.receive(x.route.id,syntheticHeaders(x.route,changed,key,f.now()),changed),/WEBHOOK_DELIVERY_CONFLICT/);}));
test('M02-G12-SYNTHETIC-ROUTE-BOUND-SIGNATURE',()=>usingExecution(f=>{const x=setup(f),other=x.inbox.register(f.owner.scope,{provider:'synthetic',topic:'orders/updated',shop_domain:'store-a.example.invalid',api_version:'2026-10',key_ref:'test-key'});assert.throws(()=>x.inbox.receive(other.id,x.headers,raw),/WEBHOOK_SIGNATURE_INVALID/);}));
test('M02-G12-HEADER-TENANT-CANNOT-ROUTE',()=>usingExecution(f=>{const x=setup(f),headers=[...x.headers,'X-Tenant-Id',f.b.tenant];const r=x.inbox.receive(x.route.id,headers,raw);assert.throws(()=>x.inbox.read(f.b.scope,r.id),/NOT_FOUND/);assert.equal(f.db.prepare('SELECT tenant_id FROM commerce_webhook_inbox').get().tenant_id,f.a.tenant);}));
test('M02-G12-DUPLICATE-HEADER-CASE',()=>usingExecution(f=>{const x=setup(f);assert.throws(()=>x.inbox.receive(x.route.id,[...x.headers,'x-Rifare-Signature',x.headers.at(-1)],raw),/WEBHOOK_HEADERS_INVALID/);}));
test('M02-G12-INVALID-BASE64',()=>usingExecution(f=>{const x=setup(f),h=[...x.headers];h[h.length-1]='!'.repeat(44);assert.throws(()=>x.inbox.receive(x.route.id,h,raw),/WEBHOOK_SIGNATURE_INVALID/);}));
test('M02-G12-EXPIRED-SIGNED-TIMESTAMP',()=>usingExecution(f=>{const x=setup(f);f.advance(300001);assert.throws(()=>x.inbox.receive(x.route.id,x.headers,raw),/WEBHOOK_EXPIRED/);}));
test('M02-G12-PAYLOAD-SIZE-BOUND',()=>usingExecution(f=>{const x=setup(f);assert.throws(()=>x.inbox.receive(x.route.id,x.headers,Buffer.alloc(WEBHOOK_MAX_BYTES+1)),/WEBHOOK_BODY_LIMIT/);}));
test('M02-G12-BAD-JSON-VERIFIED-THEN-REJECTED',()=>usingExecution(f=>{const x=setup(f),bad=Buffer.from('{bad');assert.throws(()=>x.inbox.receive(x.route.id,syntheticHeaders(x.route,bad,key,f.now()),bad),/WEBHOOK_PAYLOAD_INVALID/);}));
test('M02-G12-COMPRESSED-BODY-REJECTED',()=>usingExecution(f=>{const x=setup(f);assert.throws(()=>x.inbox.receive(x.route.id,[...x.headers,'Content-Encoding','gzip'],raw),/WEBHOOK_CONTENT_TYPE/);}));
test('M02-G12-DISABLED-ROUTE',()=>usingExecution(f=>{const x=setup(f);x.inbox.disable(f.owner.scope,x.route.id);assert.throws(()=>x.inbox.receive(x.route.id,x.headers,raw),/WEBHOOK_ROUTE_UNAVAILABLE/);}));
test('M02-G12-MISSING-KEY',()=>usingExecution(f=>{const x=setup(f),other=new WebhookInbox(f.kernel,()=>undefined);assert.throws(()=>other.receive(x.route.id,x.headers,raw),/WEBHOOK_KEY_UNAVAILABLE/);}));
test('M02-G12-KEY-REFERENCE-SUBSTITUTION',()=>usingExecution(f=>{const x=setup(f),other=new WebhookInbox(f.kernel,()=>Buffer.alloc(32,44));assert.throws(()=>other.receive(x.route.id,x.headers,raw),/WEBHOOK_KEY_UNAVAILABLE/);}));
test('M02-G12-SHARED-KEY-STORE-CONFLICT',()=>usingExecution(f=>{const x=setup(f);f.kernel.provisionMember(f.c.tenant,f.c.store,'owner','owner');const s=f.kernel.authenticate(f.kernel.issueSession(f.c.tenant,f.c.store,'owner'));assert.throws(()=>x.inbox.register(s,{provider:'synthetic',topic:'orders/updated',shop_domain:'store-c.example.invalid',api_version:'2026-10',key_ref:'test-key'}),/WEBHOOK_KEY_SCOPE_CONFLICT/);}));
test('M02-G12-SHOPIFY-UNSIGNED-TENANCY-QUARANTINED',()=>usingExecution(f=>{const x=setup(f,'shopify'),h=['Content-Type','application/json','X-Shopify-Hmac-Sha256',createHmac('sha256',key).update(raw).digest('base64'),'X-Shopify-Shop-Domain',x.route.shop_domain,'X-Shopify-Topic','orders/updated','X-Shopify-Api-Version','2026-10','X-Shopify-Webhook-Id','delivery-1'];const r=x.inbox.receive(x.route.id,h,raw),saved=x.inbox.read(f.a.scope,r.id);assert.equal(r.status,'quarantined');assert.equal(saved.metadata.routing_verified,false);assert.equal(saved.processing_authorized,false);}));
test('M02-G12-SHOPIFY-DOMAIN-MISMATCH',()=>usingExecution(f=>{const x=setup(f,'shopify'),h=['Content-Type','application/json','X-Shopify-Hmac-Sha256',createHmac('sha256',key).update(raw).digest('base64'),'X-Shopify-Shop-Domain','different.myshopify.com','X-Shopify-Topic','orders/updated','X-Shopify-Api-Version','2026-10','X-Shopify-Webhook-Id','delivery-1'];assert.throws(()=>x.inbox.receive(x.route.id,h,raw),/WEBHOOK_ROUTE_MISMATCH/);}));
test('M02-G12-INBOX-TAMPER',()=>usingExecution(f=>{const x=setup(f),r=x.inbox.receive(x.route.id,x.headers,raw);f.db.prepare('UPDATE commerce_webhook_inbox SET body=?').run(Buffer.from('{}'));assert.throws(()=>x.inbox.read(f.a.scope,r.id),/WEBHOOK_INTEGRITY/);}));
test('M02-G12-HTTP-DOES-NOT-ACK-PERSISTENCE-FAILURE',()=>usingExecution(async f=>{const x=setup(f),s=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,inbox:x.inbox});try{const headers=Object.fromEntries(Array.from({length:x.headers.length/2},(_,i)=>[x.headers[i*2],x.headers[i*2+1]]));f.db.exec("CREATE TRIGGER fail_inbox BEFORE INSERT ON commerce_webhook_inbox BEGIN SELECT RAISE(ABORT,'fixture'); END;");const failed=await fetch(s.url+'/webhooks/'+x.route.id,{method:'POST',headers,body:raw});assert.equal(failed.status,503);assert.equal((await failed.json()).error,'WEBHOOK_PERSISTENCE_FAILED');f.db.exec('DROP TRIGGER fail_inbox');const ok=await fetch(s.url+'/webhooks/'+x.route.id,{method:'POST',headers,body:raw});assert.equal(ok.status,202);assert.equal((await ok.json()).acknowledged,true);}finally{await s.close();}}));
test('M02-G12-STORE-DISABLED-AFTER-VERIFY-NO-ACK',()=>usingExecution(f=>{const x=setup(f),transaction=f.kernel.transaction.bind(f.kernel);let armed=true;f.kernel.transaction=(fn:any)=>{if(armed){armed=false;f.db.prepare('UPDATE commerce_stores SET active=0 WHERE tenant_id=? AND store_id=?').run(f.a.tenant,f.a.store);}return transaction(fn);};assert.throws(()=>x.inbox.receive(x.route.id,x.headers,raw),/WEBHOOK_ROUTE_UNAVAILABLE/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_webhook_inbox').get().n,0);}));
test('M02-G12-ACK-THEN-PROCESS-EXIT-AND-REOPEN',()=>usingExecution(async f=>{const x=setup(f),{spawn}=await import('node:child_process');
 const run=(mode:string,eventId:string|null=null)=>new Promise<any>((resolve,reject)=>{const program=`import {DatabaseSync} from 'node:sqlite';import {CommerceKernel} from './packages/commerce/kernel.mts';import {WebhookInbox} from './packages/commerce/webhook-inbox.mts';let data='';for await(const chunk of process.stdin)data+=chunk;const x=JSON.parse(data),db=new DatabaseSync(x.file),k=new CommerceKernel(db,()=>x.now),i=new WebhookInbox(k,()=>Buffer.alloc(32,83));const result=x.mode==='write'?i.receive(x.route,x.headers,Buffer.from(x.body,'base64')):i.read(k.authenticate(x.bearer),x.event);process.stdout.write(JSON.stringify(result),()=>process.exit(0));`;
 const child=spawn(process.execPath,['--experimental-strip-types','--input-type=module','--eval',program],{cwd:process.cwd(),stdio:['pipe','pipe','pipe']});let out='',err='';child.stdout.on('data',c=>out+=c);child.stderr.on('data',c=>err+=c);child.on('error',reject);child.on('close',code=>{try{assert.equal(code,0,err);resolve(JSON.parse(out));}catch(e){reject(e);}});child.stdin.end(JSON.stringify({mode,file:f.filename,now:f.now(),route:x.route.id,headers:x.headers,body:raw.toString('base64'),bearer:f.a.bearer,event:eventId}));});
 const ack=await run('write');assert.equal(ack.acknowledged,true);const saved=await run('read',ack.id);assert.equal(saved.id,ack.id);assert.equal(saved.metadata.routing_verified,true);assert.equal(saved.payload.id,'ORD-1001');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_webhook_inbox').get().n,1);
}));
