import test from 'node:test';import assert from 'node:assert/strict';
import { usingFinance,oracle,mixedFacts } from './exchange-finance-helpers.mts';
import { availableValue } from '../../packages/commerce/refund-quotes.mts';
import { usingResolution } from './resolution-helpers.mts';
const mixed={mixed:true,price:'600'};
test('CASE-M06-G03-01',()=>usingFinance(async f=>{const q=f.financeQuote('refund');assert.equal(q.quote.amount_minor,oracle.mixed.residual_minor);assert.deepEqual(q.quote.routes,oracle.mixed.routes);assert.deepEqual(q.quote.value_routes,oracle.mixed.value_routes);const op=f.authorize(q);assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'accepted');assert.throws(f.settlement,/EXCHANGE_PAYMENT_OUTSTANDING/);f.source.settle(op.id);assert.equal((await f.executor.reconcile(f.a.scope,op.id)).state,'settled');assert.equal(f.settlement().exchange_finance.operation_id,op.id);const remaining=availableValue(f.kernel,f.kernel.require(f.a.scope),f.order().id,f.facts);assert.equal(remaining.toString(),oracle.mixed.remaining_original_minor);},mixed));
test('CASE-M06-G03-02',()=>usingFinance(f=>{assert.throws(()=>f.finance.quote(f.a.scope,{exchange_quote_id:f.exchange.id,exchange_quote_digest:f.exchange.digest,outcome:'refund',payment_id:'different_card'}),/INVALID_INPUT/);const facts=structuredClone(f.facts);facts.instrument_allocations.instruments[1].supported=false;f.update({resolution_facts:facts});assert.throws(()=>f.financeQuote('refund'),/PAID_ALLOCATION_CHANGED|INSTRUMENT_ROUTING_UNSUPPORTED/);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);},mixed));
test('CASE-M06-G03-03',()=>usingFinance(async f=>{const op=f.authorize(f.financeQuote('store_credit'));await f.executor.dispatch(f.a.scope,op.id);f.source.redeemCredit(op.id,'150');await f.executor.reconcile(f.a.scope,op.id);for(let n=0;n<3;n++){await f.executor.dispatch(f.a.scope,op.id);await f.executor.reconcile(f.a.scope,op.id);}const read=f.executor.read(f.a.scope,op.id);assert.equal(read.amount_minor,'400');assert.equal(read.observations.at(-1).body.instrument.balance_minor,'250');assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,1);assert.equal(f.sourceDb.prepare('SELECT balance_minor FROM fixture_credit_accounts').get().balance_minor,'250');},mixed));
test('M06-TEST-014-MIXED-INSTRUMENT-RESIDUAL',()=>usingFinance(async f=>{const q=f.financeQuote('refund'),op=f.authorize(q);await f.executor.dispatch(f.a.scope,op.id);const native=await f.source.lookup(op.id);assert.deepEqual(native.routes,oracle.mixed.routes);assert.equal(native.routes.reduce((n:any,r:any)=>n+BigInt(r.amount_minor),0n),400n);assert.equal(native.payment_id,'payment-one');},mixed));
test('M06-G03-UNKNOWN-RESIDUAL-RESERVES-FULL-EXCHANGE-VALUE',()=>usingFinance(async f=>{const op=f.authorize(f.financeQuote('refund'));f.source.issue=async()=>{throw new Error('lost before reply');};await f.executor.dispatch(f.a.scope,op.id);await f.executor.reconcile(f.a.scope,op.id);const remaining=availableValue(f.kernel,f.kernel.require(f.a.scope),f.order().id,f.facts);assert.equal(remaining.toString(),'5800');assert.throws(f.settlement,/EXCHANGE_PAYMENT_OUTSTANDING/);},mixed));
test('M06-G03-DIRECT-REFUNDS-SHARE-RESIDUAL-CEILING',()=>usingFinance(async f=>{const direct=f.authorize(f.quote(f.plan.allocations[0]));await f.executor.dispatch(f.a.scope,direct.id);const residual=f.authorize(f.financeQuote('refund'));await f.executor.dispatch(f.a.scope,residual.id);assert.equal(availableValue(f.kernel,f.kernel.require(f.a.scope),f.order().id,f.facts).toString(),'3860');assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,2);},mixed));
test('M06-G03-FALSEY-ROUTING-EXTENSIONS-ARE-NOT-LEGACY',()=>usingResolution(f=>{for(const value of [null,false,0,'']){f.update({resolution_facts:{...f.facts,instrument_allocations:value}});assert.throws(f.allocate,/INVALID_INPUT/);}}));
test('M06-G03-MISSING-UNIT-ROUTING-FAILS-CLOSED',()=>usingResolution(f=>{const facts=mixedFacts(f);facts.instrument_allocations.units.pop();f.update({resolution_facts:facts});assert.throws(f.allocate,/INSTRUMENT_UNIT_MISSING/);}));
test('M06-G03-REFUND-REFRESH-PRESERVES-OTHER-ORIGINAL-ALLOCATIONS',()=>usingFinance(async f=>{const direct=f.authorize(f.quote(f.plan.allocations[0]));await f.executor.dispatch(f.a.scope,direct.id);f.source.settle(direct.id);await f.executor.reconcile(f.a.scope,direct.id);const facts=structuredClone(f.facts);facts.revision++;facts.prior_refunded_minor='3880';facts.accounted_operations=[direct.id];facts.instrument_allocations.instruments[0].prior_refunded_minor='2328';facts.instrument_allocations.instruments[1].prior_refunded_minor='1552';facts.paid_lines[0].resolved_units=[1,2];const lines=structuredClone(f.order().payload.return_lines);lines[0].returned=2;f.update({resolution_facts:facts,return_lines:lines});const q=f.quote(f.plan.allocations[1]);assert.equal(q.quote.amount_minor,'960');assert.equal(q.quote.remaining_before_minor,'4860');},mixed));
test('M06-G03-NATIVE-INSTRUMENT-MISSING-CANNOT-REROUTE',()=>usingFinance(async f=>{f.sourceDb.prepare('DELETE FROM fixture_resolution_instruments').run();const op=f.authorize(f.financeQuote('refund'));assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);},mixed));
test('M06-G03-NATIVE-SOURCE-REJECTS-ALL-TO-LAST-INSTRUMENT',()=>usingFinance(async f=>{const op=f.authorize(f.financeQuote('refund')),row=f.db.prepare('SELECT command FROM commerce_resolution_operations WHERE id=?').get(op.id) as any,command=JSON.parse(row.command);command.routes=[{instrument_id:'card-original',type:'card',amount_minor:'400'}];await assert.rejects(f.source.issue(command),/INSTRUMENT_ROUTING_UNSUPPORTED/);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);},mixed));
test('M06-G03-NATIVE-LEGACY-AMOUNT-CANNOT-OVERRIDE-PAID-CEILING',()=>usingFinance(async f=>{const op=f.authorize(f.quote(f.plan.allocations[0])),row=f.db.prepare('SELECT command FROM commerce_resolution_operations WHERE id=?').get(op.id) as any,command=JSON.parse(row.command);command.amount_minor='100000';command.original_value_minor='0';await assert.rejects(f.source.issue(command),/EXCHANGE_FINANCE_MISMATCH/);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);}));
test('M06-G03-NATIVE-RESIDUAL-CANNOT-EXCEED-ORIGINAL-VALUE',()=>usingFinance(async f=>{const op=f.authorize(f.financeQuote('refund')),row=f.db.prepare('SELECT command FROM commerce_resolution_operations WHERE id=?').get(op.id) as any,command=JSON.parse(row.command);command.amount_minor='1001';await assert.rejects(f.source.issue(command),/EXCHANGE_FINANCE_MISMATCH/);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);},mixed));
