import test from 'node:test';import assert from 'node:assert/strict';import { usingFulfillment } from './fulfillment-helpers.mts';
import { canonical,contentDigest } from '../../packages/commerce/configuration-values.mts';
test('CASE-M03-G14-01',()=>usingFulfillment(async f=>{const b=await f.buy(),v=await f.voidLabel(b.labelId);assert.equal(v.result.state,'void_requested');f.fulfillmentSource.confirmVoid(b.labelId,true);await f.execution.reconcile(f.a.scope,v.id);const next=await f.buy(b.labelId),old=f.labels.inspect(f.a.scope,b.labelId);assert.equal(old.reimbursement.state,'pending');assert.equal(old.reimbursement_counted,false);assert.equal(old.replaced_by,next.labelId);assert.equal(f.labels.inspect(f.a.scope,next.labelId).replaces,b.labelId);}));
test('CASE-M03-G14-02',()=>usingFulfillment(async f=>{const b=await f.buy();f.fulfillmentSource.carrierEvent(b.labelId,{id:'transit-one',sequence:1,status:'in_transit',at:f.now()});await f.tracking.refresh(f.a.scope,b.labelId);assert.throws(()=>f.labels.quoteVoid(f.a.scope,{label_id:b.labelId}),/VOID_UNAVAILABLE/);assert.throws(()=>f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:b.labelId}),/LABEL_REPLACEMENT_BLOCKED/);}));
test('CASE-M03-G14-03',()=>usingFulfillment(async f=>{const b=await f.buy(),v=await f.voidLabel(b.labelId);f.fulfillmentSource.confirmVoid(b.labelId,true);await f.execution.reconcile(f.a.scope,v.id);const next=await f.buy(b.labelId);f.fulfillmentSource.reimburse(b.labelId);await f.execution.reconcile(f.a.scope,v.id);await f.execution.reconcile(f.a.scope,v.id);assert.equal(f.labels.inspect(f.a.scope,next.labelId).is_current,true);const old=f.labels.inspect(f.a.scope,b.labelId);assert.equal(old.is_current,false);assert.equal(old.reimbursement.amount_minor,'500');assert.equal(f.execution.read(f.a.scope,v.id).observations.filter(x=>x.body.reimbursement?.state==='refunded').length,1);}));
test('M03-G14-VOID-REQUEST-IS-NOT-REIMBURSEMENT',()=>usingFulfillment(async f=>{const b=await f.buy();await f.voidLabel(b.labelId);const l=f.labels.inspect(f.a.scope,b.labelId);assert.equal(l.void_state,'requested');assert.equal(l.reimbursement_counted,false);assert.equal(l.reimbursement.amount_minor,'0');}));
test('M03-G14-UNKNOWN-VOID-CANNOT-REPLACE',()=>usingFulfillment(async f=>{const b=await f.buy();f.fulfillmentSource.fault='before';const v=await f.voidLabel(b.labelId);assert.equal(v.result.state,'unknown');assert.throws(()=>f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:b.labelId}),/LABEL_REPLACEMENT_BLOCKED/);assert.equal(f.fulfillmentSource.calls.buy,1);}));
test('M03-G14-REJECTED-VOID-CANNOT-REPLACE',()=>usingFulfillment(async f=>{const b=await f.buy(),v=await f.voidLabel(b.labelId);f.fulfillmentSource.confirmVoid(b.labelId,false);await f.execution.reconcile(f.a.scope,v.id);assert.equal(f.labels.inspect(f.a.scope,b.labelId).void_state,'rejected');assert.throws(()=>f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:b.labelId}),/LABEL_REPLACEMENT_BLOCKED/);}));
test('M03-G14-REPLACEMENT-REQUIRES-SEPARATE-APPROVAL',()=>usingFulfillment(async f=>{const b=await f.buy(),v=await f.voidLabel(b.labelId);f.fulfillmentSource.confirmVoid(b.labelId,true);await f.execution.reconcile(f.a.scope,v.id);const q=f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:b.labelId}),p=f.gateway.prepare(f.a.scope,q.proposal);assert.throws(()=>f.gateway.execute(f.a.scope,{preview_id:p.id,preview_digest:p.digest,approval_id:b.approval.id}),/APPROVAL_UNAVAILABLE/);assert.equal(f.fulfillmentSource.calls.buy,1);}));
test('M03-G14-WRONG-PREVIOUS-LABEL-DENIED',()=>usingFulfillment(async f=>{await f.buy();assert.throws(()=>f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:'other-label'}),/LABEL_REPLACEMENT_REQUIRED/);}));
test('M03-G14-CURRENT-LABEL-REQUIRED',()=>usingFulfillment(async f=>{await f.buy();assert.throws(()=>f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:null}),/LABEL_REPLACEMENT_REQUIRED/);}));
test('M03-G14-EXPIRY-ALONE-DOES-NOT-REFUND',()=>usingFulfillment(async f=>{const b=await f.buy();const row=f.fulfillmentDb.prepare('SELECT * FROM fixture_labels WHERE id=?').get(b.labelId) as any,body=JSON.parse(row.body);body.valid_until=f.now();f.fulfillmentDb.prepare('UPDATE fixture_labels SET body=?,digest=? WHERE id=?').run(canonical(body),contentDigest(body),b.labelId);assert.throws(()=>f.fulfillmentSource.reimburse(b.labelId),/VOID_NOT_CONFIRMED/);assert.equal(f.labels.inspect(f.a.scope,b.labelId).reimbursement_counted,false);}));
test('M03-G14-CARRIER-VALIDITY-CANNOT-CHANGE',()=>usingFulfillment(async f=>{const b=await f.buy(),read=f.fulfillmentSource.label.bind(f.fulfillmentSource);f.fulfillmentSource.label=async id=>({...await read(id),valid_until:f.now()+1,source_version:2});await assert.rejects(()=>f.execution.refreshLabel(f.a.scope,b.labelId),/LABEL_IDENTITY_CHANGED/);}));
test('M03-G14-LATE-REFUND-IDENTITY-CANNOT-CHANGE',()=>usingFulfillment(async f=>{const b=await f.buy(),v=await f.voidLabel(b.labelId);f.fulfillmentSource.confirmVoid(b.labelId,true);f.fulfillmentSource.reimburse(b.labelId);await f.execution.reconcile(f.a.scope,v.id);const read=f.fulfillmentSource.label.bind(f.fulfillmentSource);f.fulfillmentSource.label=async id=>{const value=await read(id);return {...value,source_version:value.source_version+1,reimbursement:{...value.reimbursement,reference:'other-refund'}};};await assert.rejects(()=>f.execution.refreshLabel(f.a.scope,b.labelId),/REIMBURSEMENT_REGRESSION/);}));
test('M03-G14-WRONG-REFUND-AMOUNT-REJECTED',()=>usingFulfillment(async f=>{const b=await f.buy(),v=await f.voidLabel(b.labelId);f.fulfillmentSource.confirmVoid(b.labelId,true);await f.execution.reconcile(f.a.scope,v.id);const read=f.fulfillmentSource.label.bind(f.fulfillmentSource);f.fulfillmentSource.label=async id=>{const value=await read(id);return {...value,source_version:value.source_version+1,reimbursement:{state:'refunded',amount_minor:'501',reference:'refund-one'}};};await assert.rejects(()=>f.execution.refreshLabel(f.a.scope,b.labelId),/REIMBURSEMENT_INVALID/);}));
test('M03-G14-VOID-SOURCE-RECHECKS-TRANSIT',()=>usingFulfillment(async f=>{const b=await f.buy(),q=f.labels.quoteVoid(f.a.scope,{label_id:b.labelId}),v=f.authorizeFulfillment(q);f.fulfillmentSource.carrierEvent(b.labelId,{id:'transit-race',sequence:1,status:'in_transit',at:f.now()});assert.equal((await f.execution.dispatch(f.a.scope,v.id)).state,'unknown');assert.equal(f.labels.inspect(f.a.scope,b.labelId).void_state,'not_requested');assert.equal(f.fulfillmentSource.effects().filter(x=>x.kind==='void').length,0);}));
test('M03-G14-VOID-RESPONSE-LOSS-ONE-REQUEST',()=>usingFulfillment(async f=>{const b=await f.buy();f.fulfillmentSource.fault='after';const v=await f.voidLabel(b.labelId);assert.equal(v.result.state,'unknown');await f.execution.dispatch(f.a.scope,v.id);await f.execution.reconcile(f.a.scope,v.id);assert.equal(f.fulfillmentSource.calls.void,1);}));
test('M03-G14-REIMBURSEMENT-NO-DOUBLE-COUNT',()=>usingFulfillment(async f=>{const b=await f.buy(),v=await f.voidLabel(b.labelId);f.fulfillmentSource.confirmVoid(b.labelId,true);f.fulfillmentSource.reimburse(b.labelId);f.fulfillmentSource.reimburse(b.labelId);await f.execution.reconcile(f.a.scope,v.id);await f.execution.reconcile(f.a.scope,v.id);assert.equal(f.execution.read(f.a.scope,v.id).observations.filter(x=>x.body.reimbursement?.state==='refunded').length,1);}));
test('M03-G14-CROSS-TENANT-VOID-DENIED',()=>usingFulfillment(async f=>{const b=await f.buy();assert.throws(()=>f.labels.quoteVoid(f.b.scope,{label_id:b.labelId}),/NOT_FOUND/);}));
