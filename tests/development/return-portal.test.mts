import test from 'node:test';import assert from 'node:assert/strict';import {usingReturns} from './return-intake-helpers.mts';import {startCommerceServer} from '../../apps/commerce-api/server.mts';import {readFileSync} from 'node:fs';import {PrivacyLifecycle} from '../../packages/commerce/privacy-lifecycle.mts';
async function server(f:any,fn:(url:string,post:any)=>unknown){const s=await startCommerceServer({kernel:f.kernel,caps:f.caps,reads:f.reads,simulator:f.simulator,customers:f.customers});try{const post=async(path:string,value:any,bearer=f.customerBearer)=>{const response=await fetch(s.url+path,{method:'POST',headers:{'content-type':'application/json',authorization:'Bearer '+bearer},body:JSON.stringify(value)});return {status:response.status,body:await response.json()};};return await fn(s.url,post);}finally{await s.close();}}
test('CASE-M03-G03-02',()=>usingReturns(async f=>{await server(f,async(_,post)=>{for(const extra of [{fees:{net_minor:'1'}},{policy:{window_days:999}},{approved:true},{actor:'owner'}]){const r=await post('/v1/returns/quote',f.selection(extra));assert.equal(r.status,400);assert.equal(r.body.error,'INVALID_INPUT');}const denied=await post('/v1/returns/quote',f.selection({lines:[{line_id:'one',quantity:2}]}));assert.equal(denied.body.quote.decision.decision,'deny');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_return_requests').get().n,0);});}));
test('CASE-M03-G03-03',()=>usingReturns(async f=>{await server(f,async(_,post)=>{const q=(await post('/v1/returns/quote',f.selection())).body;const input={quote_id:q.id,quote_digest:q.digest,request_key:'one-request',override_id:null};const [a,b]=await Promise.all([post('/v1/returns/prepare',input),post('/v1/returns/prepare',input)]);assert.equal(a.status,200);assert.equal(a.body.id,b.body.id);const resumed=await post('/v1/returns/status',{case_id:'case_one'});assert.equal(resumed.body.id,a.body.id);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_previews').get().n,1);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_return_requests').get().n,1);});}));
test('M03-G03-UNAUTHENTICATED-PORTAL-FACTS-DENIED',()=>usingReturns(async f=>{await server(f,async(url)=>{const r=await fetch(url+'/v1/returns/form',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({case_id:'case_one'})});assert.equal(r.status,403);});}));
test('M03-G03-CROSS-STORE-PORTAL-DENIED',()=>usingReturns(async f=>{await server(f,async(_,post)=>assert.equal((await post('/v1/returns/form',{case_id:'case_one'},f.b.bearer)).status,404));}));
test('M03-G03-STALE-FEES-REQUIRE-NEW-QUOTE',()=>usingReturns(f=>{const q=f.quote();f.intake.configure(f.owner.scope,{expected_revision:1,settings:{...f.settings,shipping_minor:'101'}});assert.throws(()=>f.prepare(q),/RETURN_QUOTE_CHANGED/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_return_requests').get().n,0);}));
test('M03-G03-NO-CUSTOMER-EXECUTION-AUTHORITY',()=>usingReturns(async f=>{await server(f,async(_,post)=>{const p=f.prepare(),a=f.gateway.approve(f.reviewer.scope,{preview_id:p.preview_id,preview_digest:p.preview_digest});const r=await post('/v1/execution/execute',{preview_id:p.preview_id,preview_digest:p.preview_digest,approval_id:a.id});assert.equal(r.status,403);assert.equal(f.db.prepare('SELECT uses FROM commerce_action_approvals').get().uses,0);});}));
test('M03-G03-EXPIRED-QUOTE-REJECTED',()=>usingReturns(f=>{const q=f.quote();f.advance(300000);assert.throws(()=>f.prepare(q),/RETURN_QUOTE_EXPIRED/);}));
test('M03-G03-PRIVACY-REDACTS-DRAFT-NOTE',()=>usingReturns(f=>{const q=f.quote({note:'Synthetic private note'});f.prepare(q);const id=f.order().customer_id;new PrivacyLifecycle(f.kernel).erase(f.owner.scope,id);assert(!f.db.prepare('SELECT body FROM commerce_return_quotes').get().body.includes('Synthetic private note'));assert(!f.db.prepare('SELECT body FROM commerce_return_requests').get().body.includes('Synthetic private note'));assert.throws(()=>f.intake.read(f.customer,'case_one'),/ACCESS_DENIED/);}));
test('M03-G03-PRIVATE-FIELDS-NOT-CLIENT-STORAGE',()=>{const js=readFileSync(new URL('../../apps/commerce-api/returns-client.js',import.meta.url),'utf8');assert(!/localStorage|sessionStorage|innerHTML|document.cookie|eval\(/.test(js));assert(!js.includes('/v1/execution/execute'));});
test('M03-G03-CONTENT-SECURITY-HEADERS',()=>usingReturns(async f=>{await server(f,async(url)=>{const r=await fetch(url+'/returns');assert.equal(r.status,200);assert.equal(r.headers.get('x-content-type-options'),'nosniff');assert(r.headers.get('content-security-policy')?.includes("frame-ancestors 'none'"));const html=await r.text();assert(html.includes('role="status"'));assert(html.includes('for="outcome"'));});}));
test('M03-G03-ORIGIN-DENIED',()=>usingReturns(async f=>{await server(f,async(url)=>{const r=await fetch(url+'/v1/returns/form',{method:'POST',headers:{'content-type':'application/json',authorization:'Bearer '+f.customerBearer,origin:'https://attacker.invalid'},body:JSON.stringify({case_id:'case_one'})});assert.equal(r.status,403);});}));
test('M03-G03-EVIDENCE-QUARANTINE-VISIBLE',()=>usingReturns(async f=>{const p=JSON.parse(readFileSync(new URL('../fixtures/return-intake/photo.v1.json',import.meta.url),'utf8'));await server(f,async(_,post)=>{const r=await post('/v1/return-evidence/upload',{case_id:'case_one',mime:'image/png',base64:p.base64,note:''});assert.equal(r.status,201);assert.equal(r.body.status,'quarantined');assert.equal((await post('/v1/return-evidence/sign',{id:r.body.id})).body.error,'EVIDENCE_UNAVAILABLE');});}));
