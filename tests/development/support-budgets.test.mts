import test from 'node:test';import assert from 'node:assert/strict';import {usingSupport} from './support-helpers.mts';import {ModelBudgets} from '../../packages/commerce/model-budgets.mts';
const request={model:'fixture',max_output_tokens:64,instruction:'read current facts',context:{case_id:'case_one'},turns:[]};
function setup(f:any,extra:any={}){const b=new ModelBudgets(f.kernel);b.configure(f.owner.scope,{provider_id:'fixture',period_id:'period_one',starts_at:f.now(),ends_at:f.now()+3600000,limit_micro:'1000',input_micro:'1',output_micro:'2',max_input_bytes:10000,max_output_tokens:128,expected_revision:0,...extra});return b;}
test('CASE-M05-G09-01',()=>usingSupport(f=>{const b=setup(f),r=b.reserve(f.a.scope,'fixture','request_one',request);assert.equal(r.state,'reserved');assert.equal(b.settle(f.a.scope,r.id,{input_tokens:10,output_tokens:5}).charged_micro,'20');assert.equal(b.settle(f.a.scope,r.id,{input_tokens:10,output_tokens:5}).duplicate,true);assert.equal(b.inspect(f.a.scope,'fixture','period_one').remaining_micro,'980');}));
test('CASE-M05-G09-02',()=>usingSupport(f=>{const b=setup(f);b.reserve(f.a.scope,'fixture','one',request);assert.throws(()=>b.reserve(f.a.scope,'fixture','two',request),/BUDGET_EXHAUSTED/);assert.equal(b.inspect(f.a.scope,'fixture','period_one').reservation_count,1);}));
test('CASE-M05-G09-03',()=>usingSupport(f=>{const b=setup(f),r=b.reserve(f.a.scope,'fixture','one',request);b.settle(f.a.scope,r.id,null);const v=b.inspect(f.a.scope,'fixture','period_one');assert.equal(v.unknown_usage_count,1);assert.equal(v.held_micro,r.maximum_micro);assert.equal(b.reserve(f.a.scope,'fixture','one',request).duplicate,true);assert.throws(()=>b.reserve(f.a.scope,'fixture','one',{...request,instruction:'changed'}),/IDEMPOTENCY_CONFLICT/);}));
test('M05-G09-04',()=>usingSupport(f=>{const b=setup(f),r=b.reserve(f.a.scope,'fixture','one',request);assert.throws(()=>b.settle(f.owner.scope,r.id,{input_tokens:0,output_tokens:0}),/NOT_FOUND/);assert.throws(()=>b.settle(f.b.scope,r.id,null),/NOT_FOUND/);assert.equal(b.inspect(f.a.scope,'fixture','period_one').charged_micro,'0');}));
test('M05-G09-05',()=>usingSupport(f=>{const b=setup(f),r=b.reserve(f.a.scope,'fixture','one',request);for(const usage of [{input_tokens:-1,output_tokens:2},{input_tokens:1.1,output_tokens:2},{input_tokens:1}])assert.throws(()=>b.settle(f.a.scope,r.id,usage));assert.equal(b.inspect(f.a.scope,'fixture','period_one').held_micro,r.maximum_micro);}));
test('M05-G09-06',()=>usingSupport(f=>{const b=setup(f);b.reserve(f.a.scope,'fixture','one',request);assert.throws(()=>b.configure(f.owner.scope,{provider_id:'fixture',period_id:'period_one',starts_at:f.now(),ends_at:f.now()+3600000,limit_micro:'1',input_micro:'1',output_micro:'2',max_input_bytes:10000,max_output_tokens:128,expected_revision:1}),/BELOW_COMMITTED/);}));
test('M05-G09-07',()=>usingSupport(f=>{const b=setup(f),r=b.reserve(f.a.scope,'fixture','one',request),settled=b.settle(f.a.scope,r.id,{input_tokens:2000,output_tokens:100});assert.equal(settled.exceeded_reserved_bound,true);assert.equal(b.inspect(f.a.scope,'fixture','period_one').remaining_micro,'-1200');assert.throws(()=>b.reserve(f.a.scope,'fixture','two',request),/BUDGET_EXHAUSTED/);}));

test('M05-G09-08',()=>usingSupport(f=>{const b=setup(f,{limit_micro:'100000'});b.configure(f.owner.scope,{provider_id:'other',period_id:'period_one',starts_at:f.now(),ends_at:f.now()+3600000,limit_micro:'100000',input_micro:'1',output_micro:'2',max_input_bytes:10000,max_output_tokens:128,expected_revision:0});b.configureMerchant(f.owner.scope,{period_id:'all',starts_at:f.now(),ends_at:f.now()+3600000,limit_micro:'1000',expected_revision:0});b.reserve(f.a.scope,'fixture','one',request);assert.throws(()=>b.reserve(f.a.scope,'other','two',request),/BUDGET_EXHAUSTED/);assert.equal(b.inspect(f.a.scope,'other','period_one').reservation_count,0);}));
test('M05-G09-09',()=>usingSupport(f=>{const b=setup(f),r=b.reserve(f.a.scope,'fixture','one',request);b.settle(f.a.scope,r.id,null);assert.throws(()=>b.configureMerchant(f.owner.scope,{period_id:'all',starts_at:f.now(),ends_at:f.now()+3600000,limit_micro:'1',expected_revision:0}),/BELOW_COMMITTED/);}));
