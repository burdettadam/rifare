import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';
import {usingReturns} from './return-intake-helpers.mts';import {PrivacyLifecycle} from '../../packages/commerce/privacy-lifecycle.mts';
const photo=JSON.parse(readFileSync(new URL('../fixtures/return-intake/photo.v1.json',import.meta.url),'utf8')).base64;
function setup(f:any){const e=f.evidence.upload(f.customer,{case_id:'case_one',mime:'image/png',base64:photo,note:'retained for investigation'});const privacy=new PrivacyLifecycle(f.kernel);privacy.hold(f.owner.scope,{customer_id:f.order().customer_id,reason:'investigation',authority_ref:'retention-1',expires_at:f.now()+60*86400000});return {e,privacy,customer_id:f.order().customer_id};}
const owner=(f:any)=>f.kernel.authenticate(f.kernel.issueSession(f.a.tenant,f.a.store,'owner'));
test('M03-G02-REVIEW-HELD-EVIDENCE-NOT-ERASED',()=>usingReturns(f=>{const {e}=setup(f);const result=f.evidence.erase(f.customer,e.id);assert.equal(result.erased,false);assert.equal(result.held,true);assert(f.db.prepare('SELECT bytes FROM commerce_return_evidence WHERE id=?').get(e.id).bytes);}));
test('M03-G02-REVIEW-HELD-EXPIRY-NOT-PURGED',()=>usingReturns(f=>{const {e}=setup(f);f.advance(31*86400000);const result=f.evidence.purgeExpired(owner(f));assert.equal(result.erased,0);assert.equal(result.held,1);assert(f.db.prepare('SELECT bytes FROM commerce_return_evidence WHERE id=?').get(e.id).bytes);}));
test('M03-G02-REVIEW-RELEASED-HOLD-PURGE',()=>usingReturns(f=>{const {e,privacy,customer_id}=setup(f);f.advance(31*86400000);const s=owner(f);assert.equal(f.evidence.purgeExpired(s).erased,0);privacy.releaseHold(s,customer_id,'retention-1');assert.equal(f.evidence.purgeExpired(s).erased,1);assert.equal(f.db.prepare('SELECT bytes FROM commerce_return_evidence WHERE id=?').get(e.id).bytes,null);}));
test('M03-G02-REVIEW-EXPIRED-HOLD-PURGE',()=>usingReturns(f=>{const {e}=setup(f);f.advance(61*86400000);assert.equal(f.evidence.purgeExpired(owner(f)).erased,1);assert.equal(f.db.prepare('SELECT bytes FROM commerce_return_evidence WHERE id=?').get(e.id).bytes,null);}));
