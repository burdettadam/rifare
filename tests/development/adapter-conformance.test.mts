import test from 'node:test';import assert from 'node:assert/strict';
import {DatabaseSync} from 'node:sqlite';
import {SupportFixtureSource} from '../../packages/adapters/support-fixture-source.mts';
import {contentDigest} from '../../packages/commerce/configuration-values.mts';
import {runAdapterFixture,assertAdapterBinding} from '../../packages/conformance/adapter-fixtures.mts';

function fixture(){
 const db=new DatabaseSync(':memory:'),source=new SupportFixtureSource(db,'tenant','store','mail',()=>1000);
 const descriptor={id:'support_fixture',version:'support_fixture_v1',api_version:'local_v1',granted_scopes:['email.send'],semantics:'native',qualification:'sandbox-only'};
 const spec={schema_version:1,id:'fixture_email_accepted',adapter:{id:descriptor.id,version:descriptor.version,api_version:descriptor.api_version,required_scopes:['email.send'],semantics:'native',qualification:'sandbox-only'},action:'customer.message',resource_state:'verified_contact',source_ledger:'independent_mail',before_count:0,after_count:1,response_status:200,response_fields:{state:'accepted',customer_delivered:false},source_fields:{'records.0.body.operation_id':'operation_one','records.0.body.stage':'accepted','records.0.body.customer_delivered':false,'records.0.body.account_id':'mail'},correlations:[{response:'native_reference',source:'records.0.body.native_id'}]};
 const payload={kind:'email',account_id:'mail',from:'support@example.invalid',to:'shopper@example.invalid',purpose:'transactional',text:'Source-backed fixture message'};
 const binding={descriptor:()=>structuredClone(descriptor),observe:()=>({ledger_id:'independent_mail',evidence_kind:'separate_fixture_source',records:db.prepare('SELECT operation_id id,body FROM support_source_effects ORDER BY operation_id').all().map((r:any)=>({id:r.id,body:JSON.parse(r.body)}))}),invoke:()=>{const r=source.send({tenant_id:'tenant',store_id:'store',operation_id:'operation_one',payload_hash:contentDigest(payload),payload});return {status:200,body:{state:r.stage,native_reference:r.native_id,customer_delivered:r.customer_delivered}};}};
 return{db,source,descriptor,spec,binding,cleanup:()=>db.close()};
}
async function using(fn:(f:ReturnType<typeof fixture>)=>unknown){const f=fixture();try{return await fn(f);}finally{f.cleanup();}}
test('M07-G05-SOURCE-EFFECT-01',()=>using(async f=>{const r=await runAdapterFixture(f.spec,f.binding);assert.equal(r.outcome,'passed');assert.equal(r.source_record_count,1);assert.equal(r.adapter.qualification,'sandbox-only');assert.equal(r.external_qualification,false);assert.equal(f.source.calls,1);}));
test('CASE-M07-G05-02',()=>using(async f=>{f.binding.invoke=()=>({status:200,body:{state:'accepted',native_reference:'invented',customer_delivered:false}});await assert.rejects(()=>runAdapterFixture(f.spec,f.binding),/CONFORMANCE_SOURCE_EFFECT_MISSING/);assert.equal(f.source.calls,0);assert.equal(f.db.prepare('SELECT count(*) n FROM support_source_effects').get()!.n,0);}));
test('CASE-M07-G05-03',()=>using(async f=>{f.descriptor.api_version='local_v2';await assert.rejects(()=>runAdapterFixture(f.spec,f.binding),/CONFORMANCE_VERSION_CHANGED/);assert.equal(f.source.calls,0);}));
test('M07-G05-SCOPE-01',()=>using(f=>{f.descriptor.granted_scopes=[];assert.throws(()=>assertAdapterBinding(f.spec,f.binding.descriptor()),/CONFORMANCE_SCOPE_MISSING/);assert.equal(f.source.calls,0);}));
test('M07-G05-CAPABILITY-01',()=>using(f=>{f.descriptor.semantics='composed';assert.throws(()=>assertAdapterBinding(f.spec,f.binding.descriptor()),/CONFORMANCE_CAPABILITY_CHANGED/);}));
test('M07-G05-CAPABILITY-02',()=>using(f=>{f.descriptor.qualification='native';assert.throws(()=>assertAdapterBinding(f.spec,f.binding.descriptor()),/CONFORMANCE_CAPABILITY_CHANGED/);}));
test('M07-G05-REFERENCE-01',()=>using(async f=>{const call=f.binding.invoke;f.binding.invoke=()=>{const r=call();r.body.native_reference='fabricated';return r;};await assert.rejects(()=>runAdapterFixture(f.spec,f.binding),/CONFORMANCE_SOURCE_REFERENCE_MISMATCH/);}));
test('M07-G05-SOURCE-SCOPE-01',()=>using(async f=>{f.spec.source_fields['records.0.body.account_id']='another_mail';await assert.rejects(()=>runAdapterFixture(f.spec,f.binding),/CONFORMANCE_SOURCE_OR_RESPONSE_MISMATCH/);}));
test('M07-G05-RESPONSE-01',()=>using(async f=>{const call=f.binding.invoke;f.binding.invoke=()=>{const r=call();r.body.customer_delivered=true;return r;};await assert.rejects(()=>runAdapterFixture(f.spec,f.binding),/CONFORMANCE_SOURCE_OR_RESPONSE_MISMATCH/);}));
test('M07-G05-BINDING-01',()=>using(async f=>{const call=f.binding.invoke;f.binding.invoke=()=>{const r=call();f.descriptor.version='support_fixture_v2';return r;};await assert.rejects(()=>runAdapterFixture(f.spec,f.binding),/CONFORMANCE_VERSION_CHANGED/);}));
test('M07-G05-INDEPENDENT-01',()=>using(async f=>{f.binding.observe=()=>({ledger_id:'independent_mail',evidence_kind:'http_response',records:[]});await assert.rejects(()=>runAdapterFixture(f.spec,f.binding),/CONFORMANCE_SOURCE_NOT_INDEPENDENT/);assert.equal(f.source.calls,0);}));
test('M07-G05-UNAVAILABLE-01',()=>using(async f=>{const s={...f.spec,adapter:{...f.spec.adapter,semantics:'unavailable',qualification:'unavailable'},after_count:0,response_status:400,response_fields:{error:'CAPABILITY_UNAVAILABLE'},source_fields:{},correlations:[]};f.descriptor.semantics='unavailable';f.descriptor.qualification='unavailable';f.binding.invoke=()=>({status:400,body:{error:'CAPABILITY_UNAVAILABLE'}} as any);const r=await runAdapterFixture(s,f.binding);assert.equal(r.source_record_count,0);assert.equal(f.source.calls,0);}));
test('M07-G05-UNAVAILABLE-02',()=>using(async f=>{const s={...f.spec,adapter:{...f.spec.adapter,semantics:'unavailable',qualification:'unavailable'},after_count:0,response_status:400,response_fields:{error:'CAPABILITY_UNAVAILABLE'},source_fields:{},correlations:[]};f.descriptor.semantics='unavailable';f.descriptor.qualification='unavailable';const call=f.binding.invoke;f.binding.invoke=()=>{call();return{status:400,body:{error:'CAPABILITY_UNAVAILABLE'}} as any;};await assert.rejects(()=>runAdapterFixture(s,f.binding),/CONFORMANCE_SOURCE_EFFECT_MISSING/);}));
