import test from 'node:test';import assert from 'node:assert/strict';import { spawn } from 'node:child_process';
import { usingFulfillment } from './fulfillment-helpers.mts';
import { FulfillmentExecution } from '../../packages/commerce/fulfillment-execution.mts';
import { ExecutionStops } from '../../packages/commerce/execution-stops.mts';
const child=(code:string)=>new Promise<string>((resolve,reject)=>{const p=spawn(process.execPath,['--experimental-strip-types','--input-type=module','-e',code],{cwd:process.cwd()});let out='',err='';p.stdout.on('data',x=>out+=x);p.stderr.on('data',x=>err+=x);p.on('error',reject);p.on('exit',n=>n===0?resolve(out):reject(Error(err)));});
const processCode=(f:any,op:string,crash=false)=>`import {DatabaseSync} from 'node:sqlite';import {CommerceKernel} from './packages/commerce/kernel.mts';import {FulfillmentFixtureSource} from './packages/adapters/fulfillment-fixture-source.mts';import {FulfillmentExecution} from './packages/commerce/fulfillment-execution.mts';const db=new DatabaseSync(${JSON.stringify(f.filename)}),src=new DatabaseSync(${JSON.stringify(f.sourceFile)}),now=()=>${f.now()},k=new CommerceKernel(db,now),source=new FulfillmentFixtureSource(src,{mode:'fixture',identity:'fulfillment-one',tenant:${JSON.stringify(f.a.tenant)},store:${JSON.stringify(f.a.store)},clock:now});${crash?"const send=source.replace.bind(source);source.replace=async c=>{await send(c);process.exit(0);};":""}console.log(JSON.stringify(await new FulfillmentExecution(k,source).dispatch(k.authenticate(${JSON.stringify(f.a.bearer)}),${JSON.stringify(op)})));db.close();src.close();`;
test('CASE-M03-G12-01',()=>usingFulfillment(async f=>{const op=f.replacement(),r=await f.execution.dispatch(f.a.scope,op.id);assert.equal(r.state,'created');assert.equal(r.replacement.fulfillable,true);assert.equal(r.replacement.fulfillment_state,'unfulfilled');assert.equal(r.replacement.native_return_id,'gid://shopify/Return/900');assert.equal(r.replacement.original_order_id,f.order().id);assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).available,2);}));
test('CASE-M03-G12-02',()=>usingFulfillment(async f=>{const op=f.replacement();f.fulfillmentSource.replace=async()=>({success:true,amount_minor:'0'});const r=await f.execution.dispatch(f.a.scope,op.id);assert.equal(r.state,'unknown');assert.equal(r.replacement,null);await f.execution.dispatch(f.a.scope,op.id);assert.equal(f.fulfillmentSource.effects().length,0);}));
test('CASE-M03-G12-03',()=>usingFulfillment(async f=>{const op=f.replacement(),a=await f.execution.dispatch(f.a.scope,op.id);await f.execution.dispatch(f.a.scope,op.id);f.fulfillmentSource.fulfillReplacement(a.native_id,'shipment-one');const b=await f.execution.reconcile(f.a.scope,op.id);await f.execution.reconcile(f.a.scope,op.id);assert.equal(b.replacement.fulfillment_state,'shipped');assert.equal(f.fulfillmentSource.effects().length,1);assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).available,2);}));
test('M03-G12-EXPIRED-HOLD-REJECTS-LATE-COMMIT',()=>usingFulfillment(async f=>{const op=f.replacement();f.advance(50000);await assert.rejects(()=>f.execution.dispatch(f.a.scope,op.id),/APPROVAL_AUTHORITY_CHANGED/);assert.equal(f.fulfillmentSource.calls.replace,0);assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).available,3);}));
test('M03-G12-REVIEWER-VALIDATES-WITHOUT-PROPOSE-POWER',()=>usingFulfillment(f=>{const r=f.reserve(),q=f.orders.quote(f.a.scope,{reservation_id:r.id}),p=f.gateway.prepare(f.a.scope,q.proposal);assert.throws(()=>f.kernel.authorize(f.reviewer.scope,'action.propose',f.order().id),/ACCESS_DENIED/);assert.equal(f.gateway.approve(f.reviewer.scope,{preview_id:p.id,preview_digest:p.digest}).max_uses,1);}));
test('M03-G12-DUPLICATE-OBLIGATION-CANNOT-AUTHORIZE',()=>usingFulfillment(f=>{const op=f.replacement(),q=f.orders.quote(f.a.scope,{reservation_id:op.reservation.id}),p=f.gateway.prepare(f.a.scope,q.proposal),a=f.gateway.approve(f.reviewer.scope,{preview_id:p.id,preview_digest:p.digest});assert.throws(()=>f.gateway.execute(f.a.scope,{preview_id:p.id,preview_digest:p.digest,approval_id:a.id}),/OBLIGATION_ALREADY_AUTHORIZED/);assert.equal(f.db.prepare('SELECT uses FROM commerce_action_approvals WHERE id=?').get(a.id).uses,0);}));
test('M03-G12-WRONG-RETURN-RESPONSE-UNKNOWN',()=>usingFulfillment(async f=>{const op=f.replacement(),send=f.fulfillmentSource.replace.bind(f.fulfillmentSource);f.fulfillmentSource.replace=async c=>({...await send(c),native_return_id:'wrong-return'});assert.equal((await f.execution.dispatch(f.a.scope,op.id)).state,'unknown');assert.equal((await f.execution.reconcile(f.a.scope,op.id)).state,'created');}));
test('M03-G12-WRONG-VARIANT-RESPONSE-UNKNOWN',()=>usingFulfillment(async f=>{const op=f.replacement(),send=f.fulfillmentSource.replace.bind(f.fulfillmentSource);f.fulfillmentSource.replace=async c=>({...await send(c),variant_id:'wrong'});assert.equal((await f.execution.dispatch(f.a.scope,op.id)).state,'unknown');}));
test('M03-G12-LOST-RESPONSE-RECONCILES-NO-SEND',()=>usingFulfillment(async f=>{const op=f.replacement();f.fulfillmentSource.fault='after';assert.equal((await f.execution.dispatch(f.a.scope,op.id)).state,'unknown');await f.execution.dispatch(f.a.scope,op.id);assert.equal((await f.execution.reconcile(f.a.scope,op.id)).state,'created');assert.equal(f.fulfillmentSource.calls.replace,1);}));
test('M03-G12-REAL-PROCESS-CRASH-AFTER-COMMIT',()=>usingFulfillment(async f=>{const op=f.replacement();await child(processCode(f,op.id,true));assert.equal(f.execution.read(f.a.scope,op.id).state,'unknown');assert.equal((await f.execution.reconcile(f.a.scope,op.id)).state,'created');assert.equal(f.fulfillmentSource.effects().length,1);}));
test('M03-G12-TWO-PROCESSES-ONE-REPLACEMENT',()=>usingFulfillment(async f=>{const op=f.replacement();await Promise.all([child(processCode(f,op.id)),child(processCode(f,op.id))]);await f.execution.reconcile(f.a.scope,op.id);assert.equal(f.fulfillmentSource.effects().length,1);assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).available,2);}));
test('M03-G12-HANG-IS-BOUNDED-UNKNOWN',()=>usingFulfillment(async f=>{const op=f.replacement();f.fulfillmentSource.fault='hang';assert.equal((await new FulfillmentExecution(f.kernel,f.fulfillmentSource,{deadline_ms:10}).dispatch(f.a.scope,op.id)).state,'unknown');assert.equal(f.fulfillmentSource.effects().length,0);}));
test('M03-G12-CROSS-TENANT-RESULT-DENIED',()=>usingFulfillment(f=>{const op=f.replacement();assert.throws(()=>f.execution.read(f.b.scope,op.id),/NOT_FOUND/);}));
test('M03-G12-APPROVAL-REVOKED-BEFORE-DISPATCH',()=>usingFulfillment(async f=>{const op=f.replacement();f.gateway.revokeApproval(f.reviewer.scope,op.approval.id);await assert.rejects(()=>f.execution.dispatch(f.a.scope,op.id),/APPROVAL_AUTHORITY_CHANGED/);assert.equal(f.fulfillmentSource.effects().length,0);}));
test('M03-G12-STOP-PERMITS-READ-RECONCILIATION',()=>usingFulfillment(async f=>{const op=f.replacement();f.fulfillmentSource.fault='after';await f.execution.dispatch(f.a.scope,op.id);new ExecutionStops(f.kernel).set(f.owner.scope,{action:'diagnostic.exchange.create',stopped:true,reason:'incident',expected_revision:0});assert.equal((await f.execution.reconcile(f.a.scope,op.id)).state,'created');assert.equal(f.fulfillmentSource.calls.replace,1);}));
test('M03-G12-NO-SHIPMENT-FROM-CREATION',()=>usingFulfillment(async f=>{const op=f.replacement(),r=await f.execution.dispatch(f.a.scope,op.id);assert.equal(r.replacement.shipment_id,null);assert.equal(r.replacement.fulfillment_state,'unfulfilled');}));
test('M03-G12-FULFILLMENT-REGRESSION-REJECTED',()=>usingFulfillment(async f=>{const op=f.replacement(),r=await f.execution.dispatch(f.a.scope,op.id);f.fulfillmentSource.fulfillReplacement(r.native_id,'shipment-one');await f.execution.reconcile(f.a.scope,op.id);const lookup=f.fulfillmentSource.lookup.bind(f.fulfillmentSource);f.fulfillmentSource.lookup=async id=>({...await lookup(id),source_version:3,fulfillment_state:'unfulfilled',shipment_id:null});await assert.rejects(()=>f.execution.reconcile(f.a.scope,op.id),/FULFILLMENT_STATE_REGRESSION/);assert.equal(f.execution.read(f.a.scope,op.id).replacement.shipment_id,'shipment-one');}));
test('M03-G12-CONFIGURATION-CHANGE-NEEDS-APPROVAL',()=>usingFulfillment(async f=>{const op=f.replacement();f.config.configure(f.owner.scope,{...f.configInput,expected_revision:1,account_id:'carrier-two'});await assert.rejects(()=>f.execution.dispatch(f.a.scope,op.id),/FULFILLMENT_SETTINGS_CHANGED/);assert.equal(f.fulfillmentSource.calls.replace,0);}));
test('M03-G12-ZERO-VALUE-WITHOUT-FULFILLABILITY-REMAINS-UNKNOWN',()=>usingFulfillment(async f=>{const op=f.replacement(),send=f.fulfillmentSource.replace.bind(f.fulfillmentSource);f.fulfillmentSource.replace=async command=>({...await send(command),fulfillable:false});const result=await f.execution.dispatch(f.a.scope,op.id);assert.equal(result.state,'unknown');assert.equal(result.replacement,null);const actual=await f.execution.reconcile(f.a.scope,op.id);assert.equal(actual.replacement.fulfillable,true);assert.equal(f.fulfillmentSource.calls.replace,1);}));
