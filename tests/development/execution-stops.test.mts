import test from 'node:test';import assert from 'node:assert/strict';
import { usingControls } from './worker-controls-helpers.mts';import { ExecutionStops,assertExecution } from '../../packages/commerce/execution-stops.mts';

test('CASE-M02-G21-01',()=>usingControls(f=>{const p=f.preview(),a=f.approve(p);f.stops.set(f.owner.scope,{action:'diagnostic.resolution.set',stopped:true,expected_revision:0,reason:'incident'});assert.throws(()=>f.execute(p,a),/EXECUTION_STOPPED/);assert.equal(f.gateway.state(f.owner.scope,'case_one').revision,0);}));
test('CASE-M02-G21-02',()=>usingControls(async f=>{const {op}=f.executeOperation();f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,op.id,f.journal);f.stops.setGlobal({stopped:true,expected_revision:0,reason:'incident'});const result=await f.recon.one(f.a.scope,op.id,f.journal);assert.equal(result.operation.state,'succeeded');assert.equal(f.journal.count(),1);assert.throws(()=>assertExecution(f.kernel,f.kernel.require(f.owner.scope),'customer.message'),/EXECUTION_STOPPED/);}));
test('CASE-M02-G21-03',()=>usingControls(async f=>{const {op}=f.executeOperation();f.stops.set(f.owner.scope,{action:'*',stopped:true,expected_revision:0,reason:'maintenance'});f.stops.set(f.owner.scope,{action:'*',stopped:false,expected_revision:1,reason:'reviewed_resume'});await assert.rejects(f.work.dispatch(f.a.scope,op.id,f.journal),/EXECUTION_REAUTHORIZATION_REQUIRED/);f.stops.reauthorize(f.owner.scope,op.id,op.revision);assert.equal((await f.work.dispatch(f.a.scope,op.id,f.journal)).state,'succeeded');assert.equal(f.journal.count(),1);}));
test('M02-G21-STORE-STOPS-DO-NOT-CROSS-TENANTS',()=>usingControls(f=>{f.stops.set(f.owner.scope,{action:'*',stopped:true,expected_revision:0,reason:'incident'});assert.equal(f.stops.status(f.b.scope,'model.run').stopped,false);assert.equal(f.stops.status(f.a.scope,'model.run').stopped,true);}));
test('M02-G21-GLOBAL-CONTROL-IS-NOT-TENANT-OPERATION',()=>usingControls(f=>{assert.throws(()=>f.stops.set(f.a.scope,{action:'*',stopped:true,expected_revision:0,reason:'incident'}),/ACCESS_DENIED/);f.stops.setGlobal({stopped:true,expected_revision:0,reason:'incident'});assert.equal(f.stops.status(f.b.scope,'model.run').stopped,true);}));
test('M02-G21-NARROW-ACTION-STOP-LEAVES-READS',()=>usingControls(f=>{f.stops.set(f.owner.scope,{action:'diagnostic.resolution.set',stopped:true,expected_revision:0,reason:'incident'});assert.equal(f.stops.status(f.a.scope,'model.run').stopped,false);assert.equal(f.kernel.get(f.a.scope,f.order().id).id,f.order().id);}));
test('M02-G21-MODEL-CHECK-IS-EXECUTION-TIME',()=>usingControls(f=>{f.kernel.authorize(f.agent.scope,'model.run');f.stops.set(f.owner.scope,{action:'model.run',stopped:true,expected_revision:0,reason:'incident'});assert.throws(()=>f.kernel.authorize(f.agent.scope,'model.run'),/EXECUTION_STOPPED/);}));
test('M02-G21-STOP-BETWEEN-CLAIM-AND-SEND',()=>usingControls(f=>{const {op}=f.executeOperation(),claim=f.work.claim(f.a.scope,op.id)!;f.stops.set(f.owner.scope,{action:'*',stopped:true,expected_revision:0,reason:'incident'});assert.throws(()=>f.work.beginSend(f.a.scope,op.id,claim.lease_token),/EXECUTION_STOPPED/);assert.equal(f.journal.count(),0);}));
test('M02-G21-STOP-CHECK-JUST-BEFORE-ADAPTER',()=>usingControls(async f=>{const {op}=f.executeOperation();const run=f.work.dispatch(f.a.scope,op.id,f.journal);f.stops.setGlobal({stopped:true,expected_revision:0,reason:'incident'});assert.equal((await run).state,'unknown');assert.equal(f.journal.count(),0);}));
test('M02-G21-IN-FLIGHT-SUCCESS-CAN-BE-RECORDED',()=>usingControls(async f=>{const {op}=f.executeOperation(),claim=f.work.claim(f.a.scope,op.id)!,cmd=f.work.beginSend(f.a.scope,op.id,claim.lease_token),answer=await f.journal.send(cmd);f.stops.setGlobal({stopped:true,expected_revision:0,reason:'incident'});assert.equal(f.work.finish(f.a.scope,op.id,claim.lease_token,answer).state,'succeeded');}));
test('M02-G21-UNKNOWN-CANNOT-BE-REAUTHORIZED',()=>usingControls(async f=>{const {op}=f.executeOperation();f.journal.arm('after_accept');const r=await f.work.dispatch(f.a.scope,op.id,f.journal);assert.throws(()=>f.stops.reauthorize(f.owner.scope,op.id,r.revision),/RECONCILIATION_REQUIRED/);}));
test('M02-G21-STALE-OPERATION-REVISION-REJECTED',()=>usingControls(f=>{const {op}=f.executeOperation();assert.throws(()=>f.stops.reauthorize(f.owner.scope,op.id,99),/OPERATION_CHANGED/);}));
test('M02-G21-OLD-PREVIEW-DOES-NOT-REVIVE-AFTER-RESUME',()=>usingControls(f=>{const p=f.preview(),a=f.approve(p);f.stops.set(f.owner.scope,{action:'*',stopped:true,expected_revision:0,reason:'incident'});f.stops.set(f.owner.scope,{action:'*',stopped:false,expected_revision:1,reason:'reviewed_resume'});assert.throws(()=>f.execute(p,a),/PREVIEW_STALE/);}));
test('M02-G21-STOP-SURVIVES-PROCESS-REOPEN',()=>usingControls(f=>{f.stops.setGlobal({stopped:true,expected_revision:0,reason:'incident'});const r=f.reopen();try{assert.equal(new ExecutionStops(r.kernel).status(r.scope,'model.run').stopped,true);}finally{r.db.close();}}));
test('M02-G21-STALE-CONTROL-REVISION-REJECTED',()=>usingControls(f=>{f.stops.setGlobal({stopped:true,expected_revision:0,reason:'incident'});assert.throws(()=>f.stops.setGlobal({stopped:false,expected_revision:0,reason:'reviewed_resume'}),/CONTROL_CHANGED/);}));
test('M02-G21-EXPIRED-WORKER-DOES-NOT-GAIN-RESUME-AUTHORITY',()=>usingControls(f=>{const w=f.claim();f.stops.set(f.owner.scope,{action:'*',stopped:true,expected_revision:0,reason:'incident'});f.stops.set(f.owner.scope,{action:'*',stopped:false,expected_revision:1,reason:'reviewed_resume'});assert.throws(()=>f.api.submit(w.g.token,f.audience,f.submission(w)),/EXECUTION_REAUTHORIZATION_REQUIRED/);f.api.leases.release(f.owner.scope,'case_one');const next=f.claim();assert.ok(f.api.submit(next.g.token,f.audience,f.submission(next)));}));
