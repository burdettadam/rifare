import test from 'node:test';import assert from 'node:assert/strict';import {usingSupport} from './support-helpers.mts';
test('CASE-M05-G05-01',()=>usingSupport(f=>{f.consent.record(f.customer,f.grant());assert.equal(f.consent.eligibility(f.a.scope,'case_one','sender_one','email','marketing').allowed,true);assert.equal(f.consent.eligibility(f.a.scope,'case_one','sender_one','sms','marketing').allowed,false);assert.throws(()=>f.consent.eligibility(f.b.scope,'case_one','sender_one','email','marketing'));}));
test('CASE-M05-G05-02',()=>usingSupport(f=>{assert.equal(f.consent.eligibility(f.a.scope,'case_one','sender_one','email','marketing').allowed,false);assert.throws(()=>f.consent.record(f.owner.scope,f.grant()),/CUSTOMER_CONSENT_REQUIRED/);assert.throws(()=>f.consent.record(f.agent.scope,f.grant()),/ACCESS_DENIED/);}));
test('CASE-M05-G05-03',()=>usingSupport(f=>{f.consent.record(f.customer,f.grant());f.advance(10);f.consent.record(f.customer,f.grant({state:'withdrawn',event_id:'stop',source_version:2}));const r=f.consent.record(f.customer,f.grant({event_id:'older',effective_at:f.now()-10}));assert.equal(r.ignored_stale,true);assert.equal(f.consent.eligibility(f.a.scope,'case_one','sender_one','email','marketing').allowed,false);}));
test('M05-G05-04',()=>usingSupport(f=>{f.consent.record(f.customer,f.grant({state:'withdrawn',purpose:'*'}));assert.equal(f.consent.eligibility(f.a.scope,'case_one','sender_one','email','transactional').allowed,false);f.advance(1);f.consent.record(f.customer,f.grant({purpose:'transactional',event_id:'reconsent'}));assert.equal(f.consent.eligibility(f.a.scope,'case_one','sender_one','email','transactional').allowed,true);assert.equal(f.consent.eligibility(f.a.scope,'case_one','sender_one','email','marketing').allowed,false);}));
test('M05-G05-05',()=>usingSupport(f=>{assert.throws(()=>f.consent.verifyContact(f.a.scope,f.customer,{link_id:f.link.id,address:'attacker@example.invalid'}),/VERIFICATION_REQUIRED/);const c=f.kernel.lookup(f.a.scope,'customer','synthetic','C-1001');f.kernel.ingest(f.a.scope,{kind:'customer',source_system:'synthetic',external_id:c.external_id,source_version:c.source_version+1,source_updated_at:f.now(),customer_id:null,payload:{...c.payload,email:'changed@example.invalid'}});assert.throws(()=>f.consent.verifyContact(f.a.scope,f.customer,{link_id:f.link.id,address:'changed@example.invalid'}),/VERIFICATION_REQUIRED/);}));
test('M05-G05-06',()=>usingSupport(f=>{f.consent.record(f.customer,f.grant());assert.equal(f.consent.record(f.customer,f.grant()).duplicate,true);assert.throws(()=>f.consent.record(f.customer,f.grant({state:'withdrawn'})),/CONSENT_EVENT_CONFLICT/);}));
