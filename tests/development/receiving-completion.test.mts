import test from 'node:test';import assert from 'node:assert/strict';
import {usingCompletion} from './completion-helpers.mts';
import {ReturnReceiving} from '../../packages/commerce/return-receiving.mts';
import {CommerceKernel} from '../../packages/commerce/kernel.mts';
import {DatabaseSync} from 'node:sqlite';

test('CASE-M03-G16-01',()=>usingCompletion(f=>{const r=f.scan([f.item('alpha','damaged')]);assert.equal(r.total_actual,1);assert.equal(r.expected_received,1);assert.equal(r.lines.find(x=>x.line_id==='beta').missing,1);assert.equal(r.units[0].grade,'damaged');assert.equal(r.requires_review,true);}));
test('CASE-M03-G16-02',()=>usingCompletion(f=>{let r=f.scan([]);assert.equal(r.total_actual,0);assert.ok(r.discrepancies.includes('empty_parcel'));r=f.scan([{...f.item(),observed_variant:'other-product'}],'wrong');assert.equal(r.total_actual,1);assert.equal(r.expected_received,0);assert.equal(r.requires_review,true);assert.throws(()=>f.quotes.quote(f.a.scope,{allocation_id:f.plan.allocations.find(a=>a.outcome==='refund').id}),/RECEIVING_REVIEW_REQUIRED/);}));
test('CASE-M03-G16-03',()=>usingCompletion(f=>{const first=f.scan([f.item()]);const db=new DatabaseSync(f.filename);try{const k=new CommerceKernel(db,f.now),s=k.authenticate(f.a.bearer),r=new ReturnReceiving(k).scan(s,{session_id:first.session_id,scan_id:'scan_one',expected_revision:0,items:[f.item()]});assert.equal(r.total_actual,1);assert.equal(r.revision,first.revision);}finally{db.close();}}));
test('RECEIVING-COMPLETION-OVERAGE-IS-PHYSICAL-EVIDENCE-NOT-ELIGIBLE-RETURNED-STOCK',()=>usingCompletion(f=>{const r=f.scan([f.item('alpha','sellable',2)]);assert.equal(r.total_actual,2);assert.equal(r.expected_received,1);assert.equal(r.units.filter(u=>u.line_id===null).length,1);}));
test('RECEIVING-COMPLETION-DUPLICATE-SCAN-ID-CANNOT-SUBSTITUTE-CONTENT',()=>usingCompletion(f=>{f.scan([f.item()]);assert.throws(()=>f.scan([f.item('beta')]),/RECEIPT_KEY_CONFLICT/);}));
test('RECEIVING-COMPLETION-STALE-SESSION-REVISION-CANNOT-APPEND-ANOTHER-SCAN',()=>usingCompletion(f=>{f.scan([f.item()]);assert.throws(()=>f.scan([f.item('beta')],'later',0),/RECEIVING_CHANGED/);}));
test('RECEIVING-COMPLETION-CLOSE-IS-NOT-AUTOMATIC-RESOLUTION-AND-PREVENTS-LATER-SCAN',()=>usingCompletion(f=>{const r=f.full();assert.equal(r.inspection,'complete');assert.equal(r.requires_review,false);assert.equal(f.db.prepare('SELECT COUNT(*) n FROM commerce_resolution_operations').get().n,0);assert.throws(()=>f.scan([f.item()],'late'),/RECEIVING_CHANGED/);}));
test('RECEIVING-COMPLETION-A-DAMAGED-COMPLETE-RECEIPT-NEEDS-A-DIFFERENT-AUTHORIZED-REVIEWER',()=>usingCompletion(f=>{const r=f.full(true);assert.equal(r.requires_review,true);assert.throws(()=>f.receiving.review(f.a.scope,{session_id:r.session_id,revision:r.revision,decision:'accept',reason:'observed_condition'}),/ACCESS_DENIED|SELF_REVIEW_DENIED/);const reviewed=f.receiving.review(f.reviewer.scope,{session_id:r.session_id,revision:r.revision,decision:'accept',reason:'observed_condition'});assert.equal(reviewed.requires_review,false);}));
test('RECEIVING-COMPLETION-MISSING-AND-WRONG-UNITS-CANNOT-BE-REVIEWER-APPROVED-AS-COMPLETE',()=>usingCompletion(f=>{const r=f.scan([{...f.item(),observed_variant:'other'}]);const c=f.receiving.close(f.a.scope,{session_id:r.session_id,expected_revision:r.revision});assert.throws(()=>f.receiving.review(f.reviewer.scope,{session_id:c.session_id,revision:c.revision,decision:'accept',reason:'observed_condition'}),/DISCREPANCY_REQUIRES_FOLLOWUP/);}));
test('RECEIVING-COMPLETION-CROSS-STORE-SESSION-LOOKUP-IS-DENIED',()=>usingCompletion(f=>{const r=f.open();assert.throws(()=>f.receiving.read(f.b.scope,r.session_id),/NOT_FOUND/);}));
test('RECEIVING-COMPLETION-CUSTOMERS-CANNOT-CLAIM-WAREHOUSE-RECEIPT',()=>usingCompletion(f=>{assert.throws(()=>f.receiving.open(f.customer,{request_id:f.request.id,location_id:'warehouse-one'}),/ACCESS_DENIED/);}));
test('RECEIVING-COMPLETION-IMMUTABLE-PHYSICAL-UNITS-CANNOT-BE-EDITED-OR-DELETED',()=>usingCompletion(f=>{f.scan([f.item()]);assert.throws(()=>f.db.exec('DELETE FROM commerce_received_units'),/IMMUTABLE/);assert.throws(()=>f.db.exec("UPDATE commerce_receiving_scans SET digest='bad'"),/IMMUTABLE/);}));
