import test from 'node:test';import assert from 'node:assert/strict';
import { useCustomization } from './customization-helpers.mts';
import { useAgent } from './agent-helpers.mts';

test('CASE-M02-G06-01',()=>useCustomization(f=>{const a=f.editor.start(f.a.scope,'returns'),b=f.editor.edit(f.a.scope,'returns',{expected_revision:a.revision,changes:{'returns.window_days':14}}),sim=f.editor.simulate(f.a.scope,'returns',b.revision);assert.deepEqual(b.diff,[{path:'returns.window_days',before:30,after:14}]);assert.deepEqual(sim.results.slice(0,2).map(r=>r.eligible),[true,false]);assert.equal(sim.results[0].facts.requested_at,14*86400000);}));
test('CASE-M02-G06-02',()=>useCustomization(f=>{f.editor.start(f.a.scope,'returns');assert.throws(()=>f.editor.edit(f.a.scope,'returns',{expected_revision:1,changes:{approval_threshold:0}}),(e:any)=>e.issues[0].code==='PROTECTED_FIELD');assert.equal(f.editor.get(f.a.scope,'returns').revision,1);}));
test('CASE-M02-G06-03',()=>useCustomization(f=>{const a=f.editor.start(f.a.scope,'returns');const first=f.editor.simulate(f.a.scope,'returns',1);f.editor.edit(f.a.scope,'returns',{expected_revision:1,changes:{'returns.window_days':7}});const restored=f.editor.restore(f.a.scope,'returns',{expected_revision:2,restore_revision:1}),last=f.editor.simulate(f.a.scope,'returns',3);assert.equal(a.effective_digest,restored.effective_digest);assert.deepEqual(first.results,last.results);assert.deepEqual(restored.diff,[]);}));
test('M02-G06-REQUEST-IS-NOT-PUBLICATION',()=>useCustomization(f=>{f.editor.start(f.a.scope,'returns');const sim=f.editor.simulate(f.a.scope,'returns',1),r=f.editor.requestReview(f.a.scope,'returns',{expected_revision:1,simulation_digest:sim.simulation_digest});assert.equal(r.state,'review_requested');assert.equal(r.activation,'none');assert.equal(r.execution_authorized,false);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_policy_versions').get().n,0);}));
test('M02-G06-NO-SIMULATION-NO-REQUEST',()=>useCustomization(f=>{f.editor.start(f.a.scope,'returns');assert.throws(()=>f.editor.requestReview(f.a.scope,'returns',{expected_revision:1,simulation_digest:'a'.repeat(64)}),/SIMULATION_REQUIRED/);}));
test('M02-G06-CAS-REJECTS-STALE-EDIT',()=>useCustomization(f=>{f.editor.start(f.a.scope,'returns');f.editor.edit(f.a.scope,'returns',{expected_revision:1,changes:{'returns.window_days':14}});assert.throws(()=>f.editor.edit(f.a.scope,'returns',{expected_revision:1,changes:{'returns.window_days':1}}),/PROFILE_CHANGED/);}));
test('M02-G06-EDIT-INVALIDATES-SIMULATION',()=>useCustomization(f=>{f.editor.start(f.a.scope,'returns');const sim=f.editor.simulate(f.a.scope,'returns',1);f.editor.edit(f.a.scope,'returns',{expected_revision:1,changes:{'returns.window_days':7}});assert.throws(()=>f.editor.requestReview(f.a.scope,'returns',{expected_revision:2,simulation_digest:sim.simulation_digest}),/SIMULATION_REQUIRED/);}));
test('M02-G06-CONNECTION-CHANGE-INVALIDATES-SIMULATION',()=>useCustomization(f=>{f.editor.start(f.a.scope,'returns');const sim=f.editor.simulate(f.a.scope,'returns',1);f.simulator.reset(f.a.scope);assert.throws(()=>f.editor.requestReview(f.a.scope,'returns',{expected_revision:1,simulation_digest:sim.simulation_digest}),/SIMULATION_STALE/);}));
test('M02-G06-CROSS-TENANT-DRAFT-READ',()=>useCustomization(f=>{f.editor.start(f.a.scope,'returns');assert.throws(()=>f.editor.get(f.b.scope,'returns'),/NOT_FOUND/);assert.throws(()=>f.editor.get(f.c.scope,'returns'),/NOT_FOUND/);}));
test('M02-G06-AGENT-CANNOT-EDIT',()=>useCustomization(f=>{f.editor.start(f.a.scope,'returns');assert.throws(()=>f.editor.edit(f.agent.scope,'returns',{expected_revision:1,changes:{'returns.window_days':365}}),/ACCESS_DENIED/);}));
test('M02-G06-REVIEWER-CANNOT-EDIT',()=>useCustomization(f=>{assert.throws(()=>f.editor.start(f.reviewer.scope,'returns'),/ACCESS_DENIED/);}));
test('M02-G06-REVOKED-PERMISSIONS-APPLY-NOW',()=>useCustomization(f=>{f.editor.start(f.a.scope,'returns');f.permissions.change(f.owner.scope,{actor_id:'operator',role:'operator',actions:['profile.read','capability.read'],resource_ids:null,expected_revision:0});assert.throws(()=>f.editor.edit(f.a.scope,'returns',{expected_revision:1,changes:{'returns.window_days':7}}),/ACCESS_DENIED/);}));
test('M02-G06-UNDO-RETains-HISTORY',()=>useCustomization(f=>{f.editor.start(f.a.scope,'returns');f.editor.edit(f.a.scope,'returns',{expected_revision:1,changes:{'returns.window_days':7}});const x=f.editor.restore(f.a.scope,'returns',{expected_revision:2,restore_revision:1});assert.deepEqual(x.history.map((h:any)=>h.revision),[1,2,3]);}));
test('M02-G06-LIVE-PROFILE-UNCHANGED',()=>useCustomization(f=>{f.reads.profiles.put(f.a.scope,f.profile());const before=f.reads.profiles.get(f.a.scope,'default');f.editor.start(f.a.scope,'returns');f.editor.edit(f.a.scope,'returns',{expected_revision:1,changes:{'presentation.tone':'formal'}});assert.deepEqual(f.reads.profiles.get(f.a.scope,'default'),before);}));
test('M02-G06-HTTP-HIDDEN-FIELD-REJECTED',()=>useAgent(async f=>{assert.equal((await f.request('/v1/configuration/start',{id:'returns'})).status,201);const r=await f.request('/v1/configuration/returns/edit',{expected_revision:1,changes:{'returns.window_days':7,approval_threshold:0}});assert.equal(r.status,400);const json=await r.json();assert.equal(json.error,'CONFIGURATION_INVALID');assert.equal(json.issues[0].path,'approval_threshold');}));
test('M02-G06-HTTP-COMPLETE-DRAFT-JOURNEY',()=>useAgent(async f=>{const started=await(await f.request('/v1/configuration/start',{id:'returns'})).json();const b=await(await f.request('/v1/configuration/returns/edit',{expected_revision:started.revision,changes:{'returns.window_days':14}})).json();const sim=await(await f.request('/v1/configuration/returns/simulate',{expected_revision:b.revision})).json();const request=await f.request('/v1/configuration/returns/request',{expected_revision:b.revision,simulation_digest:sim.simulation_digest});assert.equal(request.status,200);assert.equal((await request.json()).activation,'none');assert.equal((await f.request('/v1/configuration/returns/publish',{})).status,404);}));
test('M02-G06-HTTP-OTHER-STORE-ISOLATED',()=>useAgent(async f=>{await f.request('/v1/configuration/start',{id:'returns'});const r=await f.request('/v1/configuration/returns',undefined,f.b.bearer);assert.equal(r.status,404);}));
test('M02-G06-HTTP-POLICY-PUBLICATION-DENIED',()=>useAgent(async f=>{const r=await f.request('/v1/policies/publish',{});assert.equal(r.status,403);}));
test('M02-G06-HTTP-EDITOR-CSP',()=>useAgent(async f=>{const r=await fetch(f.server.url+'/configuration');assert.equal(r.status,200);assert.match(r.headers.get('content-security-policy')! ,/script-src 'self'/);const html=await r.text();assert.match(html,/aria-live="polite"/);assert.doesNotMatch(html,/<script[^>]*>[^<]+/);assert.equal((await f.request('/v1/skill-manifest-schema')).status,200);}));
