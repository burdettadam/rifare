import test from 'node:test';import assert from 'node:assert/strict';
import { usingInstant,authorizeMandate,releaseReplacement,oracle } from './instant-helpers.mts';
import { usingLineage } from './exchange-lineage-helpers.mts';
import { usingMoney } from './exchange-money-helpers.mts';
import { FulfillmentConfiguration } from '../../packages/commerce/return-fulfillment-core.mts';
import { ReplacementInventory } from '../../packages/commerce/replacement-inventory.mts';
import { ReplacementOrders } from '../../packages/commerce/replacement-orders.mts';
import { FulfillmentExecution } from '../../packages/commerce/fulfillment-execution.mts';
import { ReturnCancellation } from '../../packages/commerce/return-cancellation.mts';
import { PrivacyLifecycle,storageInventory } from '../../packages/commerce/privacy-lifecycle.mts';
import { availableValue } from '../../packages/commerce/refund-quotes.mts';
import { instantHistory } from '../../packages/commerce/instant-exchanges.mts';
import { canonical,contentDigest } from '../../packages/commerce/configuration-values.mts';

async function physical(f:any){await authorizeMandate(f);f.fulfillmentSource.release('instant_stock_hold',1);new FulfillmentConfiguration(f.kernel).configure(f.owner.scope,{expected_revision:0,enabled:true,source_identity:f.fulfillmentSource.identity,account_id:'warehouse_one',expires_at:f.now()+300000,resolution_trigger:'manual'});
 const inventory=new ReplacementInventory(f.kernel,f.fulfillmentSource),orders=new ReplacementOrders(f.kernel),execution=new FulfillmentExecution(f.kernel,f.fulfillmentSource),reservation=inventory.reserve(f.a.scope,{quote_id:f.exchange.id,quote_digest:f.exchange.digest,location_id:'warehouse_one',ttl_ms:50000});
 const q=orders.quote(f.a.scope,{reservation_id:reservation.id}),p=f.gateway.prepare(f.a.scope,q.proposal),a=f.gateway.approve(f.reviewer.scope,{preview_id:p.id,preview_digest:p.digest}),receipt=f.gateway.execute(f.a.scope,{preview_id:p.id,preview_digest:p.digest,approval_id:a.id}),command=JSON.parse(f.db.prepare('SELECT command FROM commerce_fulfillment_operations WHERE id=?').get(receipt.fulfillment_operation_id).command);
 return {inventory,orders,execution,reservation,receipt,command,id:receipt.fulfillment_operation_id};}
test('M06-G09-CORE-HOLD-PERSISTS-NATIVE-MANDATE',()=>usingInstant(async f=>{const p=await physical(f),hold=f.fulfillmentSource.reservation(p.reservation.id);assert.equal(hold.instant_exchange.mandate_id,p.command.instant_exchange.mandate_id);assert.equal(hold.instant_exchange.maximum_minor,'3000');const result=await p.execution.dispatch(f.a.scope,p.id);assert.equal(result.state,'created');assert.equal(f.source.obligation(f.obligationId).release.state,'confirmed');assert.equal(f.fulfillmentSource.stock(p.command.catalog_id).available,7);}));
test('M06-G09-CORE-HOLD-CANNOT-DROP-MANDATE-IN-TRANSPORT',()=>usingInstant(async f=>{const p=await physical(f),replace=f.fulfillmentSource.replace.bind(f.fulfillmentSource);f.fulfillmentSource.replace=async command=>{const changed={...command};delete changed.instant_exchange;return replace(changed);};assert.equal((await p.execution.dispatch(f.a.scope,p.id)).state,'unknown');assert.equal(f.fulfillmentSource.effects().length,0);assert.equal(f.source.obligation(f.obligationId).release.state,'none');}));
test('M06-G09-FABRICATED-PHYSICAL-SUCCESS-CANNOT-CONFIRM-RELEASE',()=>usingInstant(async f=>{await authorizeMandate(f);const binding=f.instant.binding(f.a.scope,f.exchange.id).instant_exchange,command=f.replacementCommand(binding);f.source.reserveReplacement(command,binding);const fake={...command,id:'forged_replacement',state:'created',fulfillable:true,inventory_committed:true};assert.throws(()=>f.source.confirmReplacement(command,binding,fake),/INSTANT_RELEASE_UNCONFIRMED/);assert.equal(f.source.obligation(f.obligationId).release.state,'reserved');f.advance(oracle.trial_ms);assert.throws(()=>f.instant.quoteCapture(f.a.scope,{obligation_id:f.obligationId}),/INSTANT_RELEASE_UNCONFIRMED/);assert.equal(f.fulfillmentSource.effects().length,0);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_instant_captures').get().n,0);}));
test('M06-G10-ORDINARY-CANCEL-REQUIRES-INSTANT-MANDATE-CANCELLATION',()=>usingInstant(async f=>{await authorizeMandate(f);const cancellation=new ReturnCancellation(f.kernel);assert.throws(()=>cancellation.quote(f.a.scope,{request_id:f.request.id,reason:'customer_cancelled'}),/INSTANT_OBLIGATIONS_UNRESOLVED/);const op=f.authorize(f.instant.quoteCancel(f.a.scope,{obligation_id:f.obligationId}));assert.equal((await f.instant.dispatch(f.a.scope,op.id)).state,'canceled');const q=cancellation.quote(f.a.scope,{request_id:f.request.id,reason:'customer_cancelled'});assert.equal(q.quote.retained_history.instant.unresolved_count,0);assert.equal(q.quote.retained_history.instant.obligations[0].state,'canceled');}));
test('M06-G10-RESERVED-RELEASE-BLOCKS-ORDINARY-CLOSURE',()=>usingInstant(async f=>{await authorizeMandate(f);const proof=f.instant.binding(f.a.scope,f.exchange.id).instant_exchange;f.source.reserveReplacement(f.replacementCommand(proof),proof);assert.throws(()=>new ReturnCancellation(f.kernel).quote(f.a.scope,{request_id:f.request.id,reason:'customer_cancelled'}),/INSTANT_OBLIGATIONS_UNRESOLVED/);assert.equal(instantHistory(f.kernel,f.kernel.require(f.a.scope),'instant_case').obligations[0].release_state,'reserved');}));
test('M06-G10-LATE-RECEIPT-COMPENSATION-BLOCKS-ORDINARY-CLOSURE',()=>usingInstant(async f=>{await authorizeMandate(f);await releaseReplacement(f);f.advance(oracle.trial_ms);const op=f.authorize(f.instant.quoteCapture(f.a.scope,{obligation_id:f.obligationId}));assert.equal((await f.instant.dispatch(f.a.scope,op.id)).state,'captured');f.source.confirmReceived(f.received('late_one',[1]));const cancellation=new ReturnCancellation(f.kernel),status=cancellation.read(f.a.scope,f.request.id);assert.equal(status.instant.obligations[0].captured_minor,'3000');assert.equal(status.instant.obligations[0].compensation_required_minor,'1000');assert.equal(status.instant.unresolved_count,1);assert.throws(()=>cancellation.quote(f.a.scope,{request_id:f.request.id,reason:'customer_cancelled'}),/INSTANT_OBLIGATIONS_UNRESOLVED/);}));
test('M06-G10-UNKNOWN-CAPTURE-CANNOT-BE-CLOSED-AS-SETTLED',()=>usingInstant(async f=>{await authorizeMandate(f);await releaseReplacement(f);f.advance(oracle.trial_ms);const op=f.authorize(f.instant.quoteCapture(f.a.scope,{obligation_id:f.obligationId}));f.source.fault='after';assert.equal((await f.instant.dispatch(f.a.scope,op.id)).state,'unknown');assert.throws(()=>new ReturnCancellation(f.kernel).quote(f.a.scope,{request_id:f.request.id,reason:'customer_cancelled'}),/INSTANT_OBLIGATIONS_UNRESOLVED/);assert.equal((await f.instant.reconcile(f.a.scope,op.id)).state,'captured');assert.equal(instantHistory(f.kernel,f.kernel.require(f.a.scope),'instant_case').unresolved_count,0);}));
test('M06-G06-UNKNOWN-TRANSFER-REMAINS-A-CLOSURE-OBLIGATION',()=>usingLineage(async f=>{const p=await f.makeExchange(f.allocation,'1000');f.lineageSource.fault='after';f.lineage.materialize(f.a.scope,{operation_id:p.op.id});assert.throws(()=>new ReturnCancellation(f.kernel).quote(f.a.scope,{request_id:f.request.id,reason:'customer_cancelled'}),/LINEAGE_TRANSFER_UNRESOLVED/);assert.equal(f.lineage.materialize(f.a.scope,{operation_id:p.op.id}).state,'imported');assert.equal(new ReturnCancellation(f.kernel).read(f.a.scope,f.request.id).lineage.unresolved_count,0);}));
test('M06-G06-CORE-REMAINDER-EXCLUDES-RETAINED-FEES',()=>usingLineage(async f=>{const p=await f.makeExchange(f.allocation,'900');f.lineage.materialize(f.a.scope,{operation_id:p.op.id});assert.equal(availableValue(f.kernel,f.kernel.require(f.a.scope),f.order().id,f.facts).toString(),'5800');},{fees:true}));
test('M06-G08-LATE-FEE-DISCREPANCY-BLOCKS-CLOSURE',()=>usingMoney(async f=>{const op=f.authorize(f.moneyQuote());await f.executor.dispatch(f.a.scope,op.id);f.source.settle(op.id);await f.executor.reconcile(f.a.scope,op.id);f.recordFee('final');assert.throws(f.closeReturn,/FEE_DIFFERENCE_UNRESOLVED/);assert.equal(new ReturnCancellation(f.kernel).read(f.a.scope,f.request.id).fees.unresolved_count,1);},{fees:true}));
test('M06-G07-RESOURCE-CURRENCY-BOUNDARY-COVERS-SIBLING-EXCHANGES',()=>usingMoney(f=>{const exchange=f.plan.allocations.find(a=>a.outcome==='exchange')!,catalog=f.catalog();assert.throws(()=>f.exchanges.quote(f.a.scope,{allocation_id:exchange.id,catalog_id:catalog.id}),/EXCHANGE_CURRENCY_UNQUALIFIED/);}));
test('M06-G06-REGISTERED-SOURCE-PRESERVES-UNENROLLED-ORIGINALS',()=>usingLineage(async f=>{const p=await f.makeExchange(f.allocation,'1000');assert.equal(p.result.state,'created');assert.equal(f.fulfillmentSource.reservation(p.reservation.id).exchange_lineage,undefined);assert.equal(f.lineageSource.registered(f.order().id),false);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_exchange_lineage_nodes').get().n,0);},{registerOriginal:false}));
test('M06-G06-LINEAGE-EXPORT-AND-ERASURE-KEEP-MINIMIZED-AUDIT',()=>usingLineage(async f=>{const p=await f.makeExchange(f.allocation,'1000'),one=f.lineage.materialize(f.a.scope,{operation_id:p.op.id}),privacy=new PrivacyLifecycle(f.kernel);const exp=privacy.export(f.owner.scope,f.order().customer_id);assert.equal(exp.exchange_history_records.commerce_exchange_lineage_nodes.length,1);assert.equal(storageInventory(f.kernel).tables.some((t:any)=>t.name==='commerce_exchange_lineage_nodes'),true);privacy.erase(f.owner.scope,f.order().customer_id);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_exchange_lineage_nodes').get().n,1);assert.throws(()=>f.lineage.read(f.a.scope,one.node.id),/SUBJECT_ERASED|NOT_FOUND/);}));
test('M06-G09-INSTANT-EXPORT-AND-ERASURE-RETAIN-OPERATION-AUDIT',()=>usingInstant(async f=>{const op=await authorizeMandate(f),privacy=new PrivacyLifecycle(f.kernel),customer=f.order().customer_id,exp=privacy.export(f.owner.scope,customer);assert.equal(exp.exchange_history_records.commerce_instant_operations.length,1);privacy.erase(f.owner.scope,customer);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_instant_operations').get().n,1);assert.throws(()=>f.instant.read(f.a.scope,op.id),/SUBJECT_ERASED|NOT_FOUND/);}));
