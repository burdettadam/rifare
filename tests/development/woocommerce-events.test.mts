import test from 'node:test';
import assert from 'node:assert/strict';
import {usingWooReturns} from './woocommerce-return-helpers.mts';
import {wooEventFixture} from './woocommerce-event-helpers.mts';
test('M07-G03-WOO-EVENT-CORROBORATES-NATIVE-UPDATE',()=>usingWooReturns(f=>{const x=wooEventFixture(f),before=f.order().source_version;f.publish(p=>p.order.status='processing');const receipt=x.receive();assert.equal(receipt.status,'quarantined');const result=x.events.process(f.a.scope,receipt.id);assert.equal(result.source_revision,2);assert.equal(result.canonical_source_version,before+1);assert.equal(f.order().payload.status,'processing');assert.equal(result.financial_authority,false);assert.equal(result.new_write_authorized,false);}));
test('M07-G03-WOO-DUPLICATE-EVENT-AND-NEW-DELIVERY-NO-REPLAY',()=>usingWooReturns(f=>{const p=f.prepare(),receipt=f.submit(p),x=wooEventFixture(f),event=x.receive();const one=x.events.process(f.a.scope,event.id),two=x.events.process(f.a.scope,x.receive().id);assert.equal(two.duplicate,true);assert.equal(one.source_digest,two.source_digest);assert.equal(x.receive().duplicate,true);const different=x.events.process(f.a.scope,x.receive('woo_delivery_2').id);assert.equal(different.canonical_source_version,one.canonical_source_version);assert.equal(f.intake.read(f.a.scope,f.caseId).receipt_id,receipt.id);assert.equal(f.source.records().native_return_create_effects,0);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_woo_rma_bindings').get().n,1);}));
test('M07-G03-WOO-UNSIGNED-BODY-REJECTED-BEFORE-ACK',()=>usingWooReturns(f=>{const x=wooEventFixture(f),raw=Buffer.from(JSON.stringify(f.initial.order)),headers=x.headers(raw);headers[headers.length-1]='A'.repeat(43)+'=';assert.throws(()=>x.inbox.receive(x.route.id,headers,raw),/WEBHOOK_SIGNATURE_INVALID/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_webhook_inbox').get().n,0);}));
test('M07-G03-WOO-HEADERS-CANNOT-AUTHORIZE-FOREIGN-STATE',()=>usingWooReturns(f=>{const x=wooEventFixture(f),payload={...f.initial.order,total:'0.00'},event=x.receive('header_forged',payload);assert.equal(event.status,'quarantined');assert.throws(()=>x.events.process(f.a.scope,event.id),/WOO_EVENT_SOURCE_CONFLICT/);assert.equal(f.order().payload.total_minor,'2000');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_woo_event_observations').get().n,0);}));
test('M07-G03-WOO-CROSS-TENANT-EVENT-REJECTED',()=>usingWooReturns(f=>{const x=wooEventFixture(f),event=x.receive();assert.throws(()=>x.events.process(f.b.scope,event.id),/NOT_FOUND/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_woo_event_observations').get().n,0);}));
test('M07-G03-WOO-CONFLICTING-DELIVERY-DOES-NOT-ACK',()=>usingWooReturns(f=>{const x=wooEventFixture(f);x.receive();assert.throws(()=>x.receive('woo_delivery_1',{...f.initial.order,status:'processing'}),/WEBHOOK_DELIVERY_CONFLICT/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_webhook_inbox').get().n,1);}));
test('M07-G03-WOO-DUPLICATE-HEADER-IS-REJECTED',()=>usingWooReturns(f=>{const x=wooEventFixture(f),raw=Buffer.from(JSON.stringify(f.initial.order)),h=x.headers(raw);h.push('x-wc-webhook-source','https://another.example.invalid/');assert.throws(()=>x.inbox.receive(x.route.id,h,raw),/WEBHOOK_HEADERS_INVALID/);}));
test('M07-G03-WOO-WRONG-TOPIC-OR-ORIGIN-REJECTED',()=>usingWooReturns(f=>{const x=wooEventFixture(f),raw=Buffer.from(JSON.stringify(f.initial.order));for(const [header,value] of [['X-WC-Webhook-Source','https://other.example.invalid/'],['X-WC-Webhook-Topic','order.deleted'],['X-WC-Webhook-Resource','customer']]){const h=x.headers(raw);h[h.indexOf(header)+1]=value;assert.throws(()=>x.inbox.receive(x.route.id,h,raw),/WEBHOOK_ROUTE_MISMATCH/);}}));
test('M07-G03-WOO-API-AND-PRODUCTION-ORIGIN-UNQUALIFIED',()=>usingWooReturns(f=>{const x=wooEventFixture(f);assert.throws(()=>x.inbox.register(f.owner.scope,{provider:'woocommerce',topic:'order.updated',shop_domain:'woo.example.invalid',api_version:'wc/v4',key_ref:'woo_webhook_key'}),/INVALID_INPUT/);assert.throws(()=>x.inbox.register(f.owner.scope,{provider:'woocommerce',topic:'order.updated',shop_domain:'real.example.com',api_version:'wc/v3',key_ref:'woo_webhook_key'}),/INVALID_INPUT/);}));
test('M07-G03-WOO-OLD-EVENT-CANNOT-REGRESS-SOURCE',()=>usingWooReturns(f=>{const x=wooEventFixture(f),event=x.receive();f.publish(p=>p.order.status='processing');f.woo.refresh(f.a.scope,'17');assert.throws(()=>x.events.process(f.a.scope,event.id),/WOO_EVENT_SOURCE_CONFLICT/);assert.equal(f.order().source_version,2);}));
test('M07-G03-WOO-DISABLED-ROUTE-NO-ACK',()=>usingWooReturns(f=>{const x=wooEventFixture(f);x.inbox.disable(f.owner.scope,x.route.id);assert.throws(()=>x.receive(),/WEBHOOK_ROUTE_UNAVAILABLE/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_webhook_inbox').get().n,0);}));
