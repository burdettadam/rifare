import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import type {DatabaseSync} from 'node:sqlite';
import {canonical,contentDigest} from '../../packages/commerce/configuration-values.mts';
import {digest} from '../../packages/commerce/kernel.mts';
import {InternationalHandoffs} from '../../packages/commerce/international-handoffs.mts';
import {DropoffHandoffFixtureSource} from '../../packages/adapters/dropoff-handoff-fixture-source.mts';
import {databaseState} from './dropoff-eligibility-helpers.mts';
import {fixture as credentialFixture,authorize,original,documentRows,backup,restore as restoreCredential,target as credentialTarget,merchant,suppression,transfer} from './dropoff-credentials-helpers.mts';

export type Value=Record<string,any>;
export const E=JSON.parse(readFileSync(new URL('../fixtures/dropoff-handoffs/independent-values.json',import.meta.url),'utf8'));
export const ACTION='diagnostic.dropoff.handoff',PREFIX='dropoff_event_';
export const EVENT_FIELDS=['schema_version','contract','event_id','kind','sequence','tenant_id','store_id','source_identity','credential_source_identity','source_account_id','directory_identity','family_ref','subject_ref','resource_id','issue_operation_id','command_digest','credential_id','generation','items_digest','method_digest','site_id','destination_id','method_id','credential_kind','credential_expires_at','admitted_at','observed_at','parent_event_id','units','qualification','physical_handoff_qualified','warehouse_effect','financial_effect','digest'].sort();
export const BODY_FIELDS=['schema_version','kind','tenant_id','store_id','id','resource_id','subject_ref','issue_operation_id','quote_id','quote_digest','command_digest','event','expected_units','personal','imported_by','imported_at','authority_revoked','minimized'].sort();
export const VIEW_FIELDS=['schema_version','issue_operation_id','family_ref','resource_id','source_identity','authority_revoked','minimized','totals','items','units','history','stage','qualification','physical_handoff_qualified','warehouse_received','inspection_complete','stock_effects','financial_effect'].sort();
export const UNIT_FIELDS=['unit_ref','line_id','ordinal','state','reason','site_id','last_accepted_site_id','original_event_id','current_event_id','custody_uncertain'].sort();
export const family=(f:any)=>contentDigest([f.a.tenant,f.a.store,f.request.id]);
export const unitRef=(f:any,line:string,ordinal:number)=>contentDigest(['rifare-dropoff-unit-v1',family(f),line,ordinal]);
export const expectedRefs=(f:any)=>E.units.map((u:Value)=>unitRef(f,u.line_id,u.ordinal)).sort();
export const eventUnits=(f:any,units:Value[])=>units.map(u=>({unit_ref:unitRef(f,u.line_id,u.ordinal),disposition:u.disposition,reason:u.reason})).sort((a:Value,b:Value)=>a.unit_ref.localeCompare(b.unit_ref));
export function attach(f:any){const handoffSource=new DropoffHandoffFixtureSource(f.credentialSource);return {...f,handoffSource,handoffs:new InternationalHandoffs(f.kernel,f.partner,{dropoff:handoffSource})};}
export async function fixture(){const base=await credentialFixture();try{const f=attach(base);f.reopen=()=>attach(base.reopen());return f;}catch(error){base.cleanup();throw error;}}
export async function usingFixture(fn:(f:any)=>unknown){const f=await fixture();try{return await fn(f);}finally{f.cleanup();}}
export function issue(f:any,replaces:string|null=null){const x=authorize(f,replaces);assert.equal(f.credentials.dispatch(f.a.scope,x.id).state,'issued');const delivered=f.credentials.deliver(f.a.scope,x.id);return {...x,delivered,issued:original(f,x)};}
export const intent=(x:Value,eventId:string,units:Value[])=>({event_id:eventId,issue_operation_id:x.id,payload:x.delivered.payload,items:structuredClone(E.items),units:structuredClone(units)});
export const acceptance=(f:any,x:Value,eventId='first-acceptance',units=E.alpha_both)=>f.handoffSource.recordAcceptance(intent(x,eventId,units));
export const importEvent=(f:any,x:Value,event:Value,scope=f.a.scope)=>f.handoffs.importDropoff(scope,{issue_operation_id:x.id,event_id:event.event_id});
export const read=(f:any,x:Value,scope=f.a.scope)=>f.handoffs.readDropoff(scope,x.id);
export const sourceRows=(f:any)=>f.partnerDb.prepare('SELECT * FROM fixture_dropoff_handoff_events ORDER BY family_ref,sequence').all() as Value[];
export const nativeRows=(f:any)=>f.db.prepare("SELECT * FROM commerce_international_handoffs WHERE tenant_id=? AND store_id=? AND id LIKE 'dropoff_event_%' ORDER BY id").all(f.a.tenant,f.a.store) as Value[];
export const nativeId=(event:Value)=>PREFIX+contentDigest([event.source_identity,event.event_id]).slice(0,40);
export const nativeRow=(f:any,event:Value)=>f.db.prepare('SELECT * FROM commerce_international_handoffs WHERE tenant_id=? AND store_id=? AND id=?').get(f.a.tenant,f.a.store,nativeId(event)) as Value;
export function sourceEvent(f:any,x:Value,event:Value,units:Value[],sequence=1,parent:Value|null=null){
  assert.deepEqual(Object.keys(event).sort(),EVENT_FIELDS);assert.equal(event.schema_version,1);assert.equal(event.contract,E.contract);assert.equal(event.kind,parent?'correction':'acceptance');assert.equal(event.sequence,sequence);
  for(const [key,value] of Object.entries({tenant_id:f.a.tenant,store_id:f.a.store,credential_source_identity:f.credentialSource.identity,source_account_id:x.issued.command.source_account_id,directory_identity:f.source.identity,family_ref:family(f),subject_ref:x.issued.command.subject_ref,resource_id:f.resourceId,issue_operation_id:x.id,command_digest:x.issued.row.command_digest,credential_id:x.delivered.credential_id,generation:x.delivered.generation,items_digest:contentDigest(E.items),method_digest:x.issued.command.method_digest,site_id:E.site_id,destination_id:E.destination_id,method_id:E.method_id,credential_kind:'qr',credential_expires_at:x.delivered.expires_at,parent_event_id:parent?.event_id??null}))assert.equal(event[key],value,key);
  assert.match(event.source_identity,/^[a-f0-9]{64}$/);assert.equal(event.qualification,'synthetic_only');for(const key of ['physical_handoff_qualified','warehouse_effect','financial_effect'])assert.equal(event[key],false);
  assert.equal(event.admitted_at,parent?.admitted_at??event.observed_at);assert.ok(event.admitted_at>=x.issued.result.observed_at);assert.ok(event.admitted_at<x.delivered.expires_at);assert.ok(event.observed_at<=f.now());assert.deepEqual(event.units,units);
  for(const u of event.units)assert.deepEqual(Object.keys(u).sort(),['disposition','reason','unit_ref']);const {digest:hash,...body}=event;assert.equal(hash,contentDigest(body));
  const row=sourceRows(f).find(r=>r.event_id===event.event_id);assert.ok(row);assert.equal(row.family_ref,event.family_ref);assert.equal(row.sequence,event.sequence);assert.equal(row.body,canonical(event));assert.equal(row.digest,event.digest);assert.deepEqual(f.handoffSource.event(event.event_id),event);return event;
}
export function nativeEvent(f:any,x:Value,event:Value,minimized=false,revoked=minimized){
  const row=nativeRow(f,event);assert.ok(row,'original source event must be materialized in native custody storage');const b=JSON.parse(row.body);assert.deepEqual(Object.keys(b).sort(),BODY_FIELDS);assert.equal(row.body,canonical(b));assert.equal(row.digest,contentDigest(b));
  assert.equal(row.id,nativeId(event));assert.equal(row.state,revoked?'revoked':'observed');assert.equal(row.resource_id,f.resourceId);assert.equal(row.subject_hash,x.issued.command.subject_ref);
  for(const [key,value] of Object.entries({schema_version:1,kind:'dropoff_event',tenant_id:f.a.tenant,store_id:f.a.store,id:row.id,resource_id:f.resourceId,subject_ref:x.issued.command.subject_ref,issue_operation_id:x.id,quote_id:x.q.id,quote_digest:x.q.digest,command_digest:x.issued.row.command_digest,authority_revoked:revoked,minimized}))assert.equal(b[key],value,key);
  assert.deepEqual(b.event,event);assert.deepEqual(b.expected_units,expectedRefs(f));if(minimized)assert.equal(b.personal,null);else assert.deepEqual(b.personal,{request_id:f.request.id,case_id:E.case_id,native_return_id:E.native_return_id,items:E.items});assert.equal(typeof b.imported_by,'string');assert.ok(Number.isSafeInteger(b.imported_at));return b;
}
export function projection(f:any,x:Value,value:Value,scenario:string,history:Value[],minimized=false,revoked=minimized){
  assert.deepEqual(Object.keys(value).sort(),VIEW_FIELDS);assert.equal(value.schema_version,1);assert.equal(value.issue_operation_id,x.id);assert.equal(value.family_ref,family(f));assert.equal(value.resource_id,f.resourceId);assert.match(value.source_identity,/^[a-f0-9]{64}$/);if(history.length)assert.equal(value.source_identity,history[0].source_identity);
  assert.equal(value.authority_revoked,revoked);assert.equal(value.minimized,minimized);assert.equal(value.stage,'dropoff_acceptance');assert.equal(value.qualification,'synthetic_only');for(const field of ['physical_handoff_qualified','warehouse_received','inspection_complete','financial_effect'])assert.equal(value[field],false);assert.equal(value.stock_effects,0);
  assert.deepEqual(value.totals,E.scenarios[scenario].totals);assert.deepEqual([...value.items].sort((a:Value,b:Value)=>a.line_id.localeCompare(b.line_id)),minimized?[]:E.scenarios[scenario].items);assert.deepEqual(value.history,history);assert.equal(value.units.length,3);assert.deepEqual(value.units.map((u:Value)=>u.unit_ref).sort(),expectedRefs(f));
  for(const u of value.units){assert.deepEqual(Object.keys(u).sort(),UNIT_FIELDS);const original=E.units.find((v:Value)=>unitRef(f,v.line_id,v.ordinal)===u.unit_ref);assert.ok(original);assert.equal(u.line_id,minimized?null:original.line_id);assert.equal(u.ordinal,minimized?null:original.ordinal);}return value;
}
export function unit(f:any,value:Value,line:string,ordinal:number,state:string,reason:string|null,first:string|null,current=first){const u=value.units.find((v:Value)=>v.unit_ref===unitRef(f,line,ordinal));assert.ok(u);assert.equal(u.state,state);assert.equal(u.reason,reason);assert.equal(u.original_event_id,first);assert.equal(u.current_event_id,current);assert.equal(u.site_id,['accepted','disputed'].includes(state)?E.site_id:null);assert.equal(u.last_accepted_site_id,['accepted','disputed'].includes(state)?E.site_id:null);assert.equal(u.custody_uncertain,state==='disputed');return u;}
export function downstream(f:any){const core=databaseState(f.db),pattern=/^commerce_(case_effects|resolution_|payment_|fulfillment_|warehouse_|inventory_|receiv|received_|return_(requests|lines|closures|labels)|native_return_|native_completed_|credit_|instant_|disposition_|custody_)/;return {core:Object.fromEntries(Object.entries(core).filter(([name])=>pattern.test(name))),warehouse:databaseState(f.warehouseDb),fulfillment:databaseState(f.fulfillmentDb),receipt:f.hubs.receiving.read(f.a.scope,f.request.id).receipt};}
export function noDownstream(f:any,before:Value){assert.deepEqual(downstream(f),before);const receipt=f.hubs.receiving.read(f.a.scope,f.request.id).receipt;assert.equal(receipt.state,E.downstream.warehouse_state);assert.equal(receipt.total_actual,0);assert.equal(receipt.inspection,'pending');for(const table of ['commerce_received_units','commerce_receiving_sessions','commerce_resolution_operations','commerce_disposition_operations'])assert.equal(f.db.prepare('SELECT count(*) n FROM '+table).get().n,0);}
export function secretless(f:any,x:Value,extra:unknown=[]){const provider=sourceRows(f),native=nativeRows(f),all=[provider,native,extra];for(const secret of [x.delivered.payload,f.customerBearer,f.a.bearer,f.key.toString('base64')])assert.equal(JSON.stringify(all).includes(secret),false);for(const value of [provider,native]){const raw=JSON.stringify(value);assert.equal(raw.includes(E.customer_id),false);assert.equal(raw.includes(digest(f.customerBearer)),false);assert.equal(raw.includes('proof_hash'),false);}}
export function restore(f:any,saved:any,label='handoff-restored'){const value=restoreCredential(f,saved,label);try{return attach(value);}catch(error){value.close();throw error;}}
export function target(f:any){const value=credentialTarget(f);try{return attach(value);}catch(error){value.close();throw error;}}
export const coreOnly=(f:any)=>new InternationalHandoffs(f.kernel,f.partner);
export function writeNative(f:any,row:Value,body:Value,state=row.state){f.db.prepare('UPDATE commerce_international_handoffs SET body=?,digest=?,state=? WHERE tenant_id=? AND store_id=? AND id=?').run(canonical(body),contentDigest(body),state,row.tenant_id,row.store_id,row.id);}
export function restoreNative(f:any,row:Value){f.db.prepare('UPDATE commerce_international_handoffs SET body=?,digest=?,state=?,subject_hash=? WHERE tenant_id=? AND store_id=? AND id=?').run(row.body,row.digest,row.state,row.subject_hash,row.tenant_id,row.store_id,row.id);}
export function preservedCredentialCopies(f:any){return documentRows(f.db);}
export {backup,merchant,suppression,transfer};
