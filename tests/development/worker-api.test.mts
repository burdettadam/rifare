import test from 'node:test';import assert from 'node:assert/strict';import { spawn } from 'node:child_process';
import { usingControls } from './worker-controls-helpers.mts';import { startCommerceServer } from '../../apps/commerce-api/server.mts';

test('CASE-M02-G19-01',()=>usingControls(async f=>{const s=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator});try{
  const g=f.api.leases.issue(f.agent.scope,{case_id:'case_one',lifetime_ms:100000},s.url+'/v1/worker');
  const result=await new Promise<any>((resolve,reject)=>{const child=spawn('python3',['-I','clients/case_worker.py'],{stdio:['pipe','pipe','pipe']});let out='',err='';child.stdout.on('data',b=>out+=b);child.stderr.on('data',b=>err+=b);child.on('error',reject);child.on('close',c=>{if(c!==0)reject(new Error(err));else resolve(JSON.parse(out));});child.stdin.end(JSON.stringify({base_url:s.url,grant_token:g.token}));});
  assert.equal(result.decision,'approval_required');assert.equal(result.execution_performed,false);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_previews').get().n,1);
}finally{await s.close();}}));
test('CASE-M02-G19-02',()=>usingControls(f=>{const w=f.claim(),p=f.submission(w);for(const field of ['tenant_id','store_id','case_id','audience','configuration_digest'])assert.throws(()=>f.api.submit(w.g.token,f.audience,{...p,envelope:{...p.envelope,[field]:'forged'}}),/WORK_ENVELOPE_REJECTED/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_previews').get().n,0);assert.equal(f.permissions.events(f.owner.scope).filter(e=>e.operation==='worker_submission').length,5);}));
test('CASE-M02-G19-03',()=>usingControls(f=>{const w=f.claim(),p=f.submission(w),r=f.api.submit(w.g.token,f.audience,p);assert.deepEqual(f.api.submit(w.g.token,f.audience,p),r);assert.deepEqual(f.api.result(w.g.token,f.audience,r.id).submission,r);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_previews').get().n,1);}));
test('M02-G19-CROSS-AUDIENCE-REJECTED',()=>usingControls(f=>{const w=f.claim();assert.throws(()=>f.api.context(w.g.token,'http://127.0.0.1:9912/v1/worker',1),/WORK_ACCESS_DENIED/);assert.throws(()=>f.api.leases.authenticate(f.agent.bearer,f.audience),/WORK_ACCESS_DENIED/);}));
test('M02-G19-WORK-TOKEN-NOT-PARENT-SESSION',()=>usingControls(f=>{const w=f.claim();assert.throws(()=>f.kernel.authenticate(w.g.token),/ACCESS_DENIED/);}));
test('M02-G19-RESULT-IS-GRANT-SCOPED',()=>usingControls(f=>{const w=f.claim(),r=f.api.submit(w.g.token,f.audience,f.submission(w)),g=f.grant(f.a.worker);assert.throws(()=>f.api.result(g.token,f.audience,r.id),/NOT_FOUND/);}));
test('M02-G19-NO-APPROVAL-IN-PROPOSAL',()=>usingControls(f=>{const w=f.claim(),p=f.submission(w);assert.throws(()=>f.api.submit(w.g.token,f.audience,{...p,approval_id:'made-up'}),/INVALID_INPUT/);assert.throws(()=>f.api.submit(w.g.token,f.audience,{...p,proposal:{...p.proposal,approval_id:'made-up'}}),/INVALID_INPUT/);}));
test('M02-G19-CHANGED-IDEMPOTENCY-PAYLOAD-REJECTED',()=>usingControls(f=>{const w=f.claim(),p=f.submission(w);f.api.submit(w.g.token,f.audience,p);assert.throws(()=>f.api.submit(w.g.token,f.audience,{...p,proposal:{action:'diagnostic.resolution.set',arguments:{resolution:'none'}}}),/WORK_IDEMPOTENCY_CONFLICT/);}));
test('M02-G19-EXACT-APPROVAL-EXECUTES-ONCE',()=>usingControls(f=>{const w=f.claim(),r=f.api.submit(w.g.token,f.audience,f.submission(w)),a=f.approve(r.preview),p={generation:1,envelope:w.context().envelope,submission_id:r.id,approval_id:a.id};const result=f.api.execute(w.g.token,f.audience,p);assert.deepEqual(f.api.execute(w.g.token,f.audience,p),result);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_receipts').get().n,1);assert.equal(f.api.result(w.g.token,f.audience,r.id).execution.receipt.id,result.receipt.id);}));
test('M02-G19-FOREIGN-APPROVAL-REJECTED',()=>usingControls(f=>{const w=f.claim(),r=f.api.submit(w.g.token,f.audience,f.submission(w));assert.throws(()=>f.api.execute(w.g.token,f.audience,{generation:1,envelope:w.context().envelope,submission_id:r.id,approval_id:'foreign'}),/APPROVAL_UNAVAILABLE/);assert.equal(f.gateway.state(f.a.scope,'case_one').revision,0);}));
test('M02-G19-STALE-GENERATION-CANNOT-EXECUTE',()=>usingControls(f=>{const w=f.claim(),r=f.api.submit(w.g.token,f.audience,f.submission(w)),a=f.approve(r.preview),envelope=w.context().envelope;f.advance(1001);f.claim(f.a.worker);assert.throws(()=>f.api.execute(w.g.token,f.audience,{generation:1,envelope,submission_id:r.id,approval_id:a.id}),/WORK_FENCE_REJECTED/);}));
test('M02-G19-PORTABLE-CONTEXT-MINIMIZED',()=>usingControls(f=>{const w=f.claim(),c=w.context(),raw=JSON.stringify(c);assert.ok(c.effective_skill.files['SKILL.md']);assert.equal(raw.includes('email'),false);assert.equal(raw.includes(f.agent.bearer),false);assert.equal(raw.includes('parent_session_hash'),false);assert.equal(raw.includes('provider_thread'),false);}));
test('M02-G19-TRANSACTION-ROLLS-BACK-UNRECORDED-PREVIEW',()=>usingControls(f=>{const w=f.claim();f.db.exec("CREATE TRIGGER reject_submission BEFORE INSERT ON commerce_worker_submissions BEGIN SELECT RAISE(ABORT,'FORCED_SUBMISSION_FAILURE');END");assert.throws(()=>f.api.submit(w.g.token,f.audience,f.submission(w)),/FORCED_SUBMISSION_FAILURE/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_previews').get().n,0);}));
test('M02-G19-RESULT-INTEGRITY-CHECKED',()=>usingControls(f=>{const w=f.claim(),r=f.api.submit(w.g.token,f.audience,f.submission(w));f.db.prepare("UPDATE commerce_worker_submissions SET body='{}' WHERE id=?").run(r.id);assert.throws(()=>f.api.result(w.g.token,f.audience,r.id),/WORK_RESULT_INTEGRITY/);}));
test('M02-G19-HTTP-REJECTS-WORK-TOKEN-ON-ORDINARY-API',()=>usingControls(async f=>{const s=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator});try{const g=f.api.leases.issue(f.agent.scope,{case_id:'case_one',lifetime_ms:10000},s.url+'/v1/worker');const r=await fetch(s.url+'/v1/secrets',{headers:{authorization:'Bearer '+g.token}});assert.equal(r.status,403);const c=await fetch(s.url+'/v1/worker-contract',{headers:{authorization:'Bearer '+f.a.bearer}});assert.equal((await c.json()).identity_owner,'server');}finally{await s.close();}}));
