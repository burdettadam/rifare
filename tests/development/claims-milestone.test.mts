test('CASE-M10-G02-01',()=>usingClaims(f=>{const r=f.register();assert.equal(r.product_id,claimsOracle.warranty.product_id);assert.equal(r.line_id,claimsOracle.warranty.line_id);assert.equal(r.unit_index,2);assert.equal(r.terms.version,1);assert.equal(r.terms.warranty_days,365);assert.equal(r.proof.purchase_id,'purchase-shirt');assert.equal(r.proof.order_version,f.order().source_version);assert.equal(r.registration_consent,true);assert.equal(JSON.stringify(r).includes('shopper-apparel@'),false);assert.equal(JSON.stringify(r).includes('session_hash'),false);assert.throws(()=>f.registrations.read(f.b.scope,r.id),/NOT_FOUND|SOURCE_SCOPE/);}));
test('CASE-M10-G02-02',()=>usingClaims(f=>{f.register();assert.throws(()=>f.register('shirt',{registration_id:'duplicate'}),/SERIAL_ALREADY_REGISTERED/);const purchase=f.claimsSource.purchase('purchase-shirt');f.claimsSource.seedPurchase({...purchase,purchase_id:'aliased-purchase',serial_number:'ALTERED-SERIAL'});assert.throws(()=>f.register('shirt',{registration_id:'aliased-unit',purchase_id:'aliased-purchase'}),/WARRANTY_UNIT_ALREADY_REGISTERED/);assert.throws(()=>f.register('shirt',{registration_id:'unknown',purchase_id:'unknown'}),/PURCHASE_UNVERIFIED/);assert.throws(()=>f.register('shirt',{registration_id:'terms',terms_version:9}),/WARRANTY_TERMS_UNSUPPORTED/);assert.throws(()=>f.register('hat',{consent:false}),/REGISTRATION_CONSENT_REQUIRED/);changeClaimCustomer(f);assert.throws(()=>f.register('shoe'),/CUSTOMER_VERIFICATION_REQUIRED/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_warranty_registrations').get().n,1);}));
test('CASE-M10-G02-03',async()=>{await usingClaims(f=>{const r=f.register();const terms=f.claimsSource.terms('shirt',1);f.claimsSource.publishTerms({...terms,version:2,warranty_days:30});f.registrations.publish(f.owner.scope,{product_id:'shirt',version:2});assert.equal(f.registrations.read(f.a.scope,r.id).terms.version,1);assert.equal(f.registrations.read(f.a.scope,r.id).terms.warranty_days,365);});await claimsMutant('../../packages/commerce/warranty-registration.mts','WarrantyRegistration','const terms = body.terms;','const terms = this.source.latestTerms(body.product_id);',Broken=>usingClaims(f=>{const r=f.register();f.claimsSource.publishTerms({...f.claimsSource.terms('shirt',1),version:2,warranty_days:30});const observed=new Broken(f.kernel,f.claimsSource).read(f.a.scope,r.id);assert.equal(observed.terms.version,2);assert.throws(()=>assert.equal(observed.terms.version,claimsOracle.warranty.terms_version),assert.AssertionError);}));});

test('M10-G03-PREP-01',()=>usingClaims(async f=>{const claim=f.claim();f.approveClaim(claim);const accepted=await f.warranty.dispatch(f.a.scope,claim.id);assert.equal(accepted.operation_id,claim.operation_id);assert.equal(accepted.stage,'accepted');assert.equal(accepted.cash_settled,false);assert.equal(f.resolutionEffects().length,1);assert.equal(f.resolutionEffects()[0].amount_minor,claimsOracle.warranty.refund_minor);f.source.settle(claim.operation_id);assert.equal((await f.warranty.reconcile(f.a.scope,claim.id)).cash_settled,true);const replacement=f.claim('replacement');f.approveClaim(replacement);const replaced=await f.warranty.dispatch(f.a.scope,replacement.id);assert.equal(replaced.stage,'created');assert.equal(replaced.replacement_fulfillable,true);assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).available,2);const repair=f.claim('repair');f.approveClaim(repair);const requested=await f.warranty.dispatch(f.a.scope,repair.id);assert.equal(requested.stage,'submitted');assert.equal(requested.repair_completed,false);f.claimsSource.advance(repair.operation_id,{stage:'accepted',decision:null,recovered_minor:'0',payout_ref:null});f.claimsSource.advance(repair.operation_id,{stage:'completed',decision:null,recovered_minor:'0',payout_ref:null});assert.equal((await f.warranty.reconcile(f.a.scope,repair.id)).repair_completed,true);assert.equal(f.resolutionEffects().length,1);}));
test('M10-G03-PREP-02',async()=>{await usingClaims(async f=>{const claim=f.claim();assert.throws(()=>f.warranty.approve(f.agent.scope,{claim_id:claim.id,expected_digest:claim.digest,expires_at:f.now()+50000}),/ACCESS_DENIED|SELF_APPROVAL/);f.approveClaim(claim);assert.throws(()=>f.warranty.draft(f.a.scope,f.customer,{claim_id:'duplicate-claim',registration_id:claim.registration_id,case_id:'resolution_case',outcome:'refund',operation_id:claim.operation_id,evidence_ids:[]}),/WARRANTY_ENTITLEMENT_RESERVED/);const issue=f.source.issue.bind(f.source);f.source.issue=async(command:unknown)=>{changeClaimCustomer(f);return issue(command);};const result=await f.warranty.dispatch(f.a.scope,claim.id);assert.equal(result.stage,'unknown');assert.equal(f.resolutionEffects().length,0);const freshDb=new DatabaseSync(f.sourceFilename);try{const fresh=new ResolutionFixtureSource(freshDb,{mode:'fixture',identity:'source-one',tenant:f.a.tenant,store:f.a.store});const nativeCommand=JSON.parse(f.db.prepare('SELECT command FROM commerce_resolution_operations WHERE id=?').get(claim.operation_id).command);await assert.rejects(fresh.issue(nativeCommand),/CLAIM_GUARD/);assert.equal(f.resolutionEffects().length,0);}finally{freshDb.close();}});await usingClaims(async f=>{const c=f.claim();f.approveClaim(c);new Permissions(f.kernel).change(f.owner.scope,{actor_id:'reviewer',role:'reviewer',expected_revision:0,actions:['resource.read','operation.read'],resource_ids:null});await assert.rejects(f.warranty.dispatch(f.a.scope,c.id),/APPROVAL_AUTHORITY_CHANGED/);assert.equal(f.resolutionEffects().length,0);});await usingClaims(async f=>{const c=f.claim();f.approveClaim(c);const original=f.gateway.receipt(f.a.scope,c.original_receipt_id),issue=f.source.issue.bind(f.source);f.source.issue=async(command:unknown)=>{f.gateway.revokeApproval(f.reviewer.scope,original.approval_id);return issue(command);};assert.equal((await f.warranty.dispatch(f.a.scope,c.id)).stage,'unknown');assert.equal(f.resolutionEffects().length,0);});});
test('M10-G03-PREP-03',async()=>{await usingClaims(async f=>{const c=f.claim();f.approveClaim(c);const issue=f.source.issue.bind(f.source);f.source.issue=async(command:unknown)=>{await issue(command);throw new Error('RESPONSE_LOST');};assert.equal((await f.warranty.dispatch(f.a.scope,c.id)).stage,'unknown');assert.equal(f.resolutionEffects().length,1);assert.equal((await f.warranty.reconcile(f.a.scope,c.id)).stage,'accepted');await f.warranty.reconcile(f.a.scope,c.id);assert.equal(f.resolutionEffects().length,1);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_warranty_entitlements').get().n,1);});await claimsMutant('../../packages/commerce/warranty-claims.mts','WarrantyClaims','const entitlementId = registration.id;','const entitlementId = p.claim_id;',Broken=>usingClaims(async f=>{const reg=f.register(),broken=new Broken(f.kernel,f.claimsSource,f.readiness,{resolution:f.executor,fulfillment:f.execution}),input={registration_id:reg.id,case_id:'resolution_case',outcome:'repair',operation_id:null,evidence_ids:[]};const one=broken.draft(f.a.scope,f.customer,{claim_id:'benefit-one',...input}),two=broken.draft(f.a.scope,f.customer,{claim_id:'benefit-two',...input});for(const claim of [one,two]){broken.approve(f.reviewer.scope,{claim_id:claim.id,expected_digest:claim.digest,expires_at:f.now()+50000});await broken.dispatch(f.a.scope,claim.id);}const consumed=f.db.prepare('SELECT count(*) n FROM commerce_warranty_entitlements').get().n;assert.equal(consumed,2);assert.equal(claimsNativeCount(f,'repair'),2);assert.throws(()=>assert.equal(claimsNativeCount(f,'repair'),claimsOracle.warranty.maximum_entitlements_per_registration),assert.AssertionError);}));});

test('M10-G04-PREP-01',()=>usingClaims(async f=>{const attachment=await f.attach(),draft=f.shippingDraft({evidence_ids:[attachment.id]});assert.equal(draft.coverage,'insured');assert.equal(draft.carrier,claimsOracle.shipping.carrier);assert.equal(draft.evidence[0].sha256,attachment.sha256);assert.equal(draft.compensation_guaranteed,false);f.approveShipping(draft);const submitted=await f.shipping.submit(f.a.scope,{claim_id:draft.id,operation_id:'shipping-submit'});const native=await f.claimsSource.lookup('shipping-submit');assert.equal(submitted.native_id,native.native_id);assert.equal(submitted.stage,'submitted');assert.equal(submitted.compensation_paid,false);assert.equal(native.evidence_hash,contentDigest(draft.evidence));assert.equal(claimsNativeCount(f,'shipping'),1);}));
test('M10-G04-PREP-02',async()=>{await usingClaims(async f=>{const old=f.claimsSource.shipment('shipment-one');f.claimsSource.seedShipment({...old,version:2,coverage:'uninsured',eligible:false});const draft=f.shippingDraft();assert.equal(draft.route,'merchant_review');assert.equal(draft.compensation_guaranteed,false);assert.throws(()=>f.approveShipping(draft),/SHIPPING_COVERAGE_UNCONFIRMED/);assert.equal(claimsNativeCount(f),0);});await usingClaims(async f=>{const c=f.shippingDraft();f.approveShipping(c);f.readiness.outage(f.owner.scope,{service:'shipping_claims',account_id:'claims-account',unavailable:true});await assert.rejects(f.shipping.submit(f.a.scope,{claim_id:c.id,operation_id:'unqualified'}),/PARTNER_/);assert.equal(claimsNativeCount(f),0);});});
test('M10-G04-PREP-03',async()=>{await usingClaims(async f=>{const c=f.shippingDraft();f.approveShipping(c);f.claimsSource.fault='after';assert.equal((await f.shipping.submit(f.a.scope,{claim_id:c.id,operation_id:'shipping-original'})).stage,'unknown');await assert.rejects(f.shipping.submit(f.a.scope,{claim_id:c.id,operation_id:'shipping-new'}),/ORIGINAL_SUBMISSION_REQUIRED/);assert.equal((await f.shipping.reconcile(f.a.scope,c.id)).stage,'submitted');f.claimsSource.advance('shipping-original',{stage:'approved',decision:null,recovered_minor:'0',payout_ref:null});f.claimsSource.advance('shipping-original',{stage:'paid',decision:null,recovered_minor:'1940',payout_ref:'payout-one'});await f.shipping.reconcile(f.a.scope,c.id);await f.shipping.reconcile(f.a.scope,c.id);assert.equal(f.shipping.read(f.a.scope,c.id).paid_minor,'1940');assert.equal(claimsNativeCount(f),1);assert.equal(f.db.prepare("SELECT count(*) n FROM commerce_claim_observations WHERE json_extract(body,'$.result.stage')='paid'").get().n,1);});await claimsMutant('../../packages/commerce/shipping-claims.mts','ShippingClaims',"compensation_paid: stage==='paid'","compensation_paid: ['submitted','approved','paid'].includes(stage)",Broken=>usingClaims(async f=>{const c=f.shippingDraft();f.approveShipping(c);const broken=new Broken(f.kernel,f.claimsSource,f.readiness),result=await broken.submit(f.a.scope,{claim_id:c.id,operation_id:'false-reimbursement'});assert.equal(result.compensation_paid,true);assert.equal((await f.claimsSource.lookup('false-reimbursement')).recovered_minor,'0');assert.throws(()=>assert.equal(result.compensation_paid,claimsOracle.shipping.paid_on_submission),assert.AssertionError);}));});

test('CASE-M10-G05-01',()=>usingClaims(async f=>{const attachment=await f.attach(),packet=f.packet({evidence_ids:[attachment.id]});const facts=Object.fromEntries(packet.assertions.map((a:any)=>[a.key,a.value]));assert.equal(facts.order_number,claimsOracle.dispute.order_number);assert.equal(facts.original_paid_minor,claimsOracle.dispute.original_paid_minor);assert.equal(facts.currency,'USD');assert.deepEqual(packet.missing,claimsOracle.dispute.missing);assert.ok(packet.assertions.every((a:any)=>a.source_ref&&a.source_version>=1&&a.source_digest.length===64));assert.equal(packet.attachments[0].sha256,attachment.sha256);assert.equal(packet.evidence_hash,contentDigest({assertions:packet.assertions,missing:packet.missing,attachments:packet.attachments}));assert.equal(packet.redacted,true);assert.equal(JSON.stringify(packet).includes('shopper-apparel@'),false);}));
test('CASE-M10-G05-02',()=>usingClaims(async f=>{const packet=f.packet();assert.ok(packet.missing.includes('customer_acknowledgement'));assert.equal(packet.assertions.some((a:any)=>a.key==='customer_acknowledgement'),false);assert.equal(JSON.stringify(packet.assertions).includes('Invent'),false);assert.throws(()=>f.evidence.upload(f.customer,{case_id:'resolution_case',mime:'image/png',base64:Buffer.from('invalid').toString('base64'),note:''}),/EVIDENCE_TYPE_REJECTED/);const e=await f.attach();f.evidence.erase(f.customer,e.id);assert.throws(()=>f.packet({packet_id:'erased-evidence',evidence_ids:[e.id]}),/EVIDENCE_UNAVAILABLE/);assert.throws(()=>f.packets.read(f.b.scope,packet.id),/NOT_FOUND|SOURCE_SCOPE/);}));
test('CASE-M10-G05-03',async()=>{await usingClaims(f=>{const packet=f.packet(),order=f.order();f.kernel.ingest(f.a.scope,{kind:'order',source_system:'synthetic',external_id:order.external_id,source_version:order.source_version+1,source_updated_at:f.now(),customer_id:order.customer_id,payload:{...order.payload,tags:['changed']}});assert.throws(()=>f.approvePacket(packet),/EVIDENCE_SOURCE_CHANGED/);const next=f.packet({expected_revision:1});assert.equal(next.revision,2);assert.notEqual(next.digest,packet.digest);f.approvePacket(next);});await claimsMutant('../../packages/commerce/dispute-evidence.mts','DisputeEvidence',"if (dispute.acknowledgement === null) missing.push('customer_acknowledgement');","if (dispute.acknowledgement === null) assertions.push({key:'customer_acknowledgement',value:true,source_ref:'generated',source_version:1,source_digest:'0'.repeat(64)});",Broken=>usingClaims(f=>{const broken=new Broken(f.kernel,f.claimsSource),p=broken.draft(f.a.scope,{packet_id:'fabricated',expected_revision:0,case_id:'resolution_case',dispute_id:'dispute-one',evidence_ids:[]});assert.equal(p.assertions.some((a:any)=>a.key==='customer_acknowledgement'&&a.value===true),true);assert.throws(()=>assert.ok(p.missing.includes('customer_acknowledgement')),assert.AssertionError);}));});
test('PORT-029',()=>usingClaims(async f=>{const packet=f.packet();assert.deepEqual(packet.missing,claimsOracle.dispute.missing);assert.equal(packet.assertions.some((fact:any)=>fact.key==='customer_acknowledgement'||fact.key==='purchase_consent'),false);await assert.rejects(f.disputes.submit(f.agent.scope,{packet_id:packet.id,operation_id:'injected-submit'}),/APPROVAL_REQUIRED|ACCESS_DENIED/);assert.equal(claimsNativeCount(f),0);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_claim_approvals').get().n,0);}));

test('M10-G06-PREP-01',()=>usingClaims(async f=>{const p=f.packet();f.approvePacket(p);const r=await f.disputes.submit(f.a.scope,{packet_id:p.id,operation_id:'dispute-submit'}),native=await f.claimsSource.lookup('dispute-submit');assert.equal(r.native_id,native.native_id);assert.equal(native.evidence_hash,p.evidence_hash);assert.equal(native.target_digest,p.digest);assert.equal(r.stage,'submitted');assert.equal(r.won,false);assert.equal(r.recovered_minor,'0');f.claimsSource.advance('dispute-submit',{stage:'accepted',decision:null,recovered_minor:'0',payout_ref:null});assert.equal((await f.disputes.reconcile(f.a.scope,p.id)).won,false);f.claimsSource.advance('dispute-submit',{stage:'decided',decision:'won',recovered_minor:'0',payout_ref:null});const decision=await f.disputes.reconcile(f.a.scope,p.id);assert.equal(decision.won,true);assert.equal(decision.recovered_minor,'0');f.claimsSource.advance('dispute-submit',{stage:'recovered',decision:'won',recovered_minor:'1940',payout_ref:'recovery-one'});assert.equal((await f.disputes.reconcile(f.a.scope,p.id)).recovered_minor,'1940');}));
test('M10-G06-PREP-02',async()=>{await usingClaims(async f=>{const p=f.packet();f.approvePacket(p);f.advance(60000);await assert.rejects(f.disputes.submit(f.a.scope,{packet_id:p.id,operation_id:'late'}),/DEADLINE|APPROVAL_EXPIRED|PARTNER_/);assert.equal(claimsNativeCount(f),0);});await usingClaims(async f=>{const p=f.packet();f.approvePacket(p);const current=f.claimsSource.dispute('dispute-one');f.claimsSource.seedDispute({...current,version:2,amount_minor:'1900'});await assert.rejects(f.disputes.submit(f.a.scope,{packet_id:p.id,operation_id:'changed'}),/EVIDENCE_SOURCE_CHANGED/);assert.equal(claimsNativeCount(f),0);});await usingClaims(async f=>{const p=f.packet();f.approvePacket(p);f.claimsSource.setInterface('unsupported-v2');await assert.rejects(f.disputes.submit(f.a.scope,{packet_id:p.id,operation_id:'unsupported'}),/INTERFACE_UNSUPPORTED|PARTNER_/);assert.equal(claimsNativeCount(f),0);});});
test('M10-G06-PREP-03',async()=>{await usingClaims(async f=>{const p=f.packet();f.approvePacket(p);f.claimsSource.fault='after';assert.equal((await f.disputes.submit(f.a.scope,{packet_id:p.id,operation_id:'dispute-original'})).stage,'unknown');await assert.rejects(f.disputes.submit(f.a.scope,{packet_id:p.id,operation_id:'different-key'}),/ORIGINAL_SUBMISSION_REQUIRED/);assert.throws(()=>f.packet({packet_id:'conflicting-packet'}),/ORIGINAL_SUBMISSION_REQUIRED/);f.readiness.outage(f.owner.scope,{service:'dispute_submission',account_id:'claims-account',unavailable:true});assert.equal((await f.disputes.reconcile(f.a.scope,p.id)).stage,'submitted');assert.equal(claimsNativeCount(f),1);assert.equal(f.claimsSource.calls.submit,1);});await claimsMutant('../../packages/commerce/dispute-submissions.mts','DisputeSubmissions',"won: ['decided','recovered'].includes(stage)&&result?.decision==='won'","won: ['submitted','accepted','decided','recovered'].includes(stage)",Broken=>usingClaims(async f=>{const p=f.packet();f.approvePacket(p);const broken=new Broken(f.kernel,f.claimsSource,f.readiness,f.packets),r=await broken.submit(f.a.scope,{packet_id:p.id,operation_id:'false-win'});assert.equal(r.won,true);assert.equal((await f.claimsSource.lookup('false-win')).decision,null);assert.throws(()=>assert.equal(r.won,claimsOracle.dispute.won_on_submission),assert.AssertionError);}));});
