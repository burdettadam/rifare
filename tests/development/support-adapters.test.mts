import test from 'node:test';import assert from 'node:assert/strict';import {randomBytes}from'node:crypto';
import {usingSupport} from './support-helpers.mts';import {SecretVault} from '../../packages/commerce/secrets.mts';import{supportReader}from'../../packages/adapters/support/transport.mts';
import {ChatwootSupportSource}from'../../packages/adapters/support/chatwoot.mts';import{ResendSupportSource}from'../../packages/adapters/support/resend.mts';import{SupportDelivery}from'../../packages/commerce/support-delivery.mts';import{SupportHelpdesk}from'../../packages/commerce/support-helpdesk.mts';
function wire(f:any,provider='chatwoot'){const calls:any[]=[],native:any[]=[],key=randomBytes(32);let fault='none',mutation:(r:any)=>any=r=>r;
 const http=async(url:string,init:any)=>{const u=new URL(url),body=init.body?JSON.parse(init.body):null;calls.push({path:u.pathname,method:init.method,body,headers:init.headers});let r:any;
  if(provider==='chatwoot'){if(init.method==='GET')r={payload:native};else if(u.pathname.endsWith('/assignments'))r={id:body.assignee_id};else{r={id:50+native.length,account_id:7,conversation_id:12,private:body.private,content:body.content,message_type:1,created_at:Math.floor(f.now()/1000)};native.push(r);}}
  else if(init.method==='POST'){r={id:'email_one'};native.push({...body,id:r.id,last_event:'sent'});}else r=native[0];
  if(fault==='lost'&&init.method==='POST')throw new Error('WIRE_RESPONSE_LOST');r=mutation(r);return {status:200,text:async()=>JSON.stringify(r)};};
 const reader=provider+'_reader',vault=new SecretVault(f.kernel,{activeId:'test_key',get:()=>Buffer.from(key)},{},{[reader]:supportReader(provider,provider==='chatwoot'?'https://helpdesk.example.invalid':'https://api.resend.com','7',http)}),secret=vault.put(f.a.scope,{provider,adapter:reader,value:'synthetic-service-secret'});
 const source=provider==='chatwoot'?new ChatwootSupportSource(f.kernel,vault,f.a.scope,{account:'7',origin:'https://helpdesk.example.invalid',secret_ref:secret.ref,reader}):new ResendSupportSource(f.kernel,vault,f.a.scope,{account:'7',secret_ref:secret.ref,reader,from:'support@example.invalid'});
 const link=f.conversations.link(f.a.scope,f.customer,{case_id:'case_one',channel:provider==='chatwoot'?'helpdesk':'email',account_id:'7',external_id:'12',history:'partial',source_revision:1});f.consent.configureSender(f.owner.scope,{...f.senderInput,id:provider+'_sender',account_id:'7',source_identity:source.identity,source_contract:source.contract});
 if(provider==='resend')f.consent.verifyContact(f.a.scope,f.customer,{link_id:link.id,address:'shopper-apparel@example.invalid'});
 return {source,calls,native,vault,secret,link,delivery:new SupportDelivery(f.kernel,f.tracking,[source]),fault:(x:string)=>fault=x,mutate:(fn:(r:any)=>any)=>mutation=fn,note:(extra:any={})=>({case_id:'case_one',link_id:link.id,sender_id:provider+'_sender',kind:'note',event_id:'note_one',expected_generation:1,assignee_id:null,...extra})};}
test('CASE-M05-G02-01',()=>usingSupport(async f=>{const w=wire(f),q=w.delivery.queueHelpdesk(f.a.scope,w.note()),out=await w.delivery.dispatch(f.a.scope,q.operation_id);assert.equal(out.source_stage,'internal_note');assert.equal(w.calls[0].body.private,true);assert.equal(w.calls[0].headers.Authorization,'Bearer synthetic-service-secret');const sync=await new SupportHelpdesk(f.kernel,w.source as ChatwootSupportSource).synchronize(f.a.scope,w.link.id);assert.equal(sync.history_complete,false);assert.equal(f.conversations.history(f.customer,'case_one').messages.length,0);assert.equal(f.conversations.history(f.a.scope,'case_one').messages.length,1);}));
test('CASE-M05-G02-02',()=>usingSupport(async f=>{const w=wire(f);w.native.push({id:1,account_id:8,conversation_id:12,private:false,content:'other account',message_type:0,created_at:Math.floor(f.now()/1000)});await assert.rejects(()=>new SupportHelpdesk(f.kernel,w.source as ChatwootSupportSource).synchronize(f.a.scope,w.link.id),/MESSAGE_INVALID/);assert.equal(f.conversations.history(f.a.scope,'case_one').messages.length,0);}));
test('CASE-M05-G02-03',()=>usingSupport(async f=>{const w=wire(f),q=w.delivery.queueHelpdesk(f.a.scope,w.note());w.fault('lost');assert.equal((await w.delivery.dispatch(f.a.scope,q.operation_id)).state,'unknown');await w.delivery.dispatch(f.a.scope,q.operation_id);assert.equal(w.calls.filter(c=>c.method==='POST').length,1);assert.equal((await w.delivery.reconcile(f.a.scope,q.operation_id)).state,'internal_note');assert.equal(w.native.length,1);}));
test('M05-G02-04',()=>usingSupport(async f=>{const w=wire(f),q=w.delivery.queueHelpdesk(f.a.scope,w.note({kind:'handoff',assignee_id:'33'}));w.fault('lost');assert.equal((await w.delivery.dispatch(f.a.scope,q.operation_id)).state,'unknown');assert.equal((await w.delivery.reconcile(f.a.scope,q.operation_id)).state,'unknown');await w.delivery.dispatch(f.a.scope,q.operation_id);assert.equal(w.calls.length,1);}));
test('M05-G02-05',()=>usingSupport(async f=>{const w=wire(f);w.mutate(r=>({...r,private:false}));const q=w.delivery.queueHelpdesk(f.a.scope,w.note());assert.equal((await w.delivery.dispatch(f.a.scope,q.operation_id)).state,'unknown');assert.equal(f.conversations.history(f.customer,'case_one').messages.length,0);}));
test('M05-G04-09',()=>usingSupport(async f=>{const w=wire(f,'resend'),q=w.delivery.queue(f.a.scope,f.message({link_id:w.link.id,sender_id:'resend_sender'}));assert.equal((await w.delivery.dispatch(f.a.scope,q.operation_id)).customer_delivered,false);assert.equal(w.calls[0].headers['Idempotency-Key'],q.operation_id);w.native[0].last_event='delivered';const result=await w.delivery.reconcile(f.a.scope,q.operation_id);assert.equal(result.customer_delivered,true);assert.equal(w.calls.filter(c=>c.method==='POST').length,1);}));
test('M05-G04-10',()=>usingSupport(async f=>{const w=wire(f,'resend'),q=w.delivery.queue(f.a.scope,f.message({link_id:w.link.id,sender_id:'resend_sender'}));w.fault('lost');await w.delivery.dispatch(f.a.scope,q.operation_id);assert.equal((await w.delivery.reconcile(f.a.scope,q.operation_id)).state,'unknown');assert.equal(w.calls.length,1);assert.equal((w.source as ResendSupportSource).limitations().idempotency_window_hours,24);}));
test('M05-G02-06',async()=>{const r=supportReader('chatwoot','https://helpdesk.example.invalid','7');await assert.rejects(()=>r.execute(Buffer.from('secret'),{method:'GET',path:'/api/v1/accounts/8/conversations/12/messages',body:null,operation_id:null}),/HTTP_INVALID/);await assert.rejects(()=>r.execute(Buffer.from('secret'),{method:'GET',path:'/api/v1/accounts/7/conversations/12/messages',body:null,operation_id:null}),/TRANSPORT_NOT_CONFIGURED/);});
test('M05-G02-07',()=>usingSupport(async f=>{const w=wire(f);w.native.push({id:77,account_id:7,conversation_id:12,private:false,content:'verified account question',message_type:0,created_at:Math.floor(f.now()/1000)});const h=new SupportHelpdesk(f.kernel,w.source as ChatwootSupportSource);await h.synchronize(f.a.scope,w.link.id);await h.synchronize(f.a.scope,w.link.id);assert.equal(f.conversations.history(f.a.scope,'case_one').messages.length,1);}));

test('M05-G02-08',async()=>{const reader=supportReader('chatwoot','https://helpdesk.example.invalid','7',async()=>new Promise(()=>{}),30);const start=Date.now();await assert.rejects(()=>reader.execute(Buffer.from('synthetic-secret'),{method:'GET',path:'/api/v1/accounts/7/conversations/12/messages',body:null,operation_id:null}),/SUPPORT_TRANSPORT_TIMEOUT/);assert.ok(Date.now()-start<2000);});
test('M05-G02-09',async()=>{const reader=supportReader('chatwoot','https://helpdesk.example.invalid','7',async()=>({status:200,text:()=>new Promise(()=>{})}),30);const start=Date.now();await assert.rejects(()=>reader.execute(Buffer.from('synthetic-secret'),{method:'GET',path:'/api/v1/accounts/7/conversations/12/messages',body:null,operation_id:null}),/SUPPORT_TRANSPORT_TIMEOUT/);assert.ok(Date.now()-start<2000);});
