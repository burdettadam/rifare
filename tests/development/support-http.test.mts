import test from'node:test';import assert from'node:assert/strict';import{spawn}from'node:child_process';import{createSupportDemo}from'../../packages/development/support-demo.mts';import{startCommerceServer}from'../../apps/commerce-api/server.mts';
async function using(fn:(f:any,s:any,post:(action:string,data:any,token?:string)=>Promise<any>)=>any){const f=createSupportDemo(),s=await startCommerceServer({kernel:f.kernel,caps:f.caps,simulator:f.simulator,customers:f.customers,reads:f.reads,support:f.support});const post=async(action:string,data:any,token=f.operator.token)=>{const r=await fetch(s.url+'/v1/support/'+action,{method:'POST',headers:{Authorization:'Bearer '+token,'Content-Type':'application/json'},body:JSON.stringify(data)});return{status:r.status,value:await r.json()};};try{return await fn(f,s,post);}finally{await s.close();f.cleanup();}}
test('M05-HTTP-01',()=>using(async(f,s,post)=>{const html=await(await fetch(s.url+'/support')).text();assert.match(html,/Rifare/);assert.ok(!html.includes(f.operator.token));assert.equal((await post('context',{case_id:'support_case'},'invalid')).status,403);const value=(await post('context',{case_id:'support_case'})).value;assert.equal(value.tracking.shipments.length,2);assert.equal(value.tracking.all_delivered,false);assert.equal(value.history.history_complete,false);}));
test('M05-HTTP-02',()=>using(async(f,s,post)=>{const r=await post('context',{case_id:'support_case'},f.customer.token);assert.equal(r.status,200);assert.equal(r.value.history.messages.length,1);assert.ok(!JSON.stringify(r.value).includes('Internal: investigate'));assert.equal((await post('takeover',{case_id:'support_case',expected_generation:1,reason:'operator_requested'},f.customer.token)).status,403);}));
test('M05-HTTP-03',()=>using(async(f,s,post)=>{assert.equal((await post('queue',{...f.message(),purpose:'transactional'})).status,400);assert.equal((await post('queue',f.message(),f.customer.token)).status,400);assert.equal((await post('dispatch',{operation_id:'missing',source_identity:f.source.identity})).status,400);assert.equal(f.source.calls,0);}));
test('M05-HTTP-04',()=>using(async(f,s,post)=>{const q=(await post('queue',f.message())).value;f.advance(1);const stop=await post('consent',{case_id:'support_case',sender_id:'sender_one',channel:'email',purpose:'*',state:'withdrawn',event_id:'stop',source_version:1,effective_at:f.at(),source_ref:'customer_stop'},f.customer.token);assert.equal(stop.status,200);const out=await post('dispatch',{operation_id:q.operation_id});assert.equal(out.status,400);assert.equal(out.value.error,'DELIVERY_SUPPRESSED');assert.equal(f.source.calls,0);}));
test('M05-HTTP-05',()=>using(async(f,s,post)=>{f.stopModel();const r=await post('model-read',{case_id:'support_case',task_id:'missing',route_id:'missing',untrusted_input:null});assert.equal(r.status,400);assert.equal((await post('context',{case_id:'support_case'})).status,200);assert.equal(f.source.calls,0);}));
test('M05-HTTP-06',()=>using(async(f,s)=>{const out=await new Promise<any>((resolve,reject)=>{const p=spawn('python3',['clients/support_case.py'],{stdio:['pipe','pipe','pipe']});let stdout='',stderr='';p.stdout.on('data',d=>stdout+=d);p.stderr.on('data',d=>stderr+=d);p.on('error',reject);p.on('close',code=>resolve({code,stdout,stderr}));p.stdin.end(JSON.stringify({url:s.url,token:f.operator.token,case_id:'support_case',workflow:'shipment-assistance',skill_digest:f.skills['shipment-assistance'],request_id:'external_demo'}));});assert.equal(out.code,0,out.stderr);const r=JSON.parse(out.stdout);assert.equal(r.status,'answered');assert.equal(r.customer_resolved,false);assert.equal(r.facts.length,2);assert.equal(r.execution_authorized,false);assert.equal(f.source.calls,0);}));
test('M05-G99-INTEGRATED',()=>using(async(f,s,post)=>{const w=f.support.workflows.complete(f.operator.scope,'support_case','shipment-assistance',f.skills['shipment-assistance'],'first');assert.equal(w.status,'answered');const approved=f.approvedReturn();assert.ok(approved.receipt.return_request_id);const mail=(await post('queue',f.message())).value;f.source.fault='after';assert.equal((await post('dispatch',{operation_id:mail.operation_id})).value.state,'unknown');f.source.fault='none';assert.equal((await post('reconcile',{operation_id:mail.operation_id})).value.state,'accepted');f.support.ownership.assign(f.owner.scope,{case_id:'support_case',expected_generation:1,actor_id:'agent'});f.support.ownership.takeover(f.operator.scope,{case_id:'support_case',expected_generation:2,reason:'provider_unavailable'});f.stopModel();assert.equal((await post('context',{case_id:'support_case'})).status,200);assert.equal(f.support.workflows.complete(f.operator.scope,'support_case','support-reply',f.skills['support-reply'],'manual').status,'answered');assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM support_source_effects').get().n,1);}));
