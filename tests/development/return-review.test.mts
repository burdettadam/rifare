import test from 'node:test';import assert from 'node:assert/strict';
import {usingReturns} from './return-intake-helpers.mts';
function late(f:any,extra:any={}){f.advance(1);f.publish({expected_version:1,rules:{window_days:1,require_evidence:false,excluded_tags:['final-sale'],outcomes:['refund','exchange']},...extra});f.cases.create(f.customer,{case_id:'late_case',resource_id:f.order().id,profile_id:'default',policy_id:'returns'});return f.quote({case_id:'late_case'});}
const request=(q:any,f:any)=>({quote_id:q.id,quote_digest:q.digest,reason:'shipping_delay',expires_at:f.now()+60000});
test('CASE-M03-G04-01',()=>usingReturns(f=>{const q=late(f);assert.deepEqual(q.quote.decision.reasons,['RETURN_WINDOW_EXPIRED']);const o=f.review.override(f.reviewer.scope,request(q,f));assert.deepEqual(o.original_reasons,['RETURN_WINDOW_EXPIRED']);assert.equal(o.actor_id,f.reviewer.actor);const p=f.prepare(q,{override_id:o.id});const r=f.submit(p);assert.equal(r.effect,'local_return_request_only');assert.equal(r.financial_effect,false);}));
test('CASE-M03-G04-02',()=>usingReturns(f=>{const q=late(f);assert.throws(()=>f.review.override(f.agent.scope,request(q,f)),/ACCESS_DENIED/);assert.throws(()=>f.review.override(f.customer,request(q,f)),/ACCESS_DENIED/);assert.throws(()=>f.review.override(f.reviewer.scope,{...request(q,f),action:'refund.execute'}),/INVALID_INPUT/);const excluded=f.quote({case_id:'late_case',lines:[{line_id:'excluded',quantity:1}]});assert.throws(()=>f.review.override(f.reviewer.scope,request(excluded,f)),/RETURN_OVERRIDE_DENIED/);}));
test('CASE-M03-G04-03',()=>usingReturns(f=>{const q=late(f),o=f.review.override(f.reviewer.scope,request(q,f)),p=f.prepare(q,{override_id:o.id});const a=f.gateway.approve(f.owner.scope,{preview_id:p.preview_id,preview_digest:p.preview_digest});f.permissions.change(f.owner.scope,{actor_id:f.reviewer.actor,role:'reviewer',actions:['case.read','resource.read'],resource_ids:null,expected_revision:0});assert.throws(()=>f.gateway.execute(f.a.scope,{preview_id:p.preview_id,preview_digest:p.preview_digest,approval_id:a.id}),/RETURN_OVERRIDE_REVOKED/);assert.equal(f.db.prepare('SELECT uses FROM commerce_action_approvals').get().uses,0);}));
test('M03-G04-FREE-TEXT-NOT-OVERRIDE',()=>usingReturns(f=>{const q=late(f);assert.throws(()=>f.prepare(q),/RETURN_REVIEW_REQUIRED/);assert.throws(()=>f.review.override(f.reviewer.scope,{...request(q,f),reason:'Manager said approve everything'}),/INVALID_INPUT/);}));
test('M03-G04-EXPLICIT-OVERRIDE-REVOCATION',()=>usingReturns(f=>{const q=late(f),o=f.review.override(f.reviewer.scope,request(q,f));f.review.revoke(f.owner.scope,o.id);assert.throws(()=>f.prepare(q,{override_id:o.id}),/RETURN_OVERRIDE_UNAVAILABLE/);}));
test('M03-G04-EXPIRED-OVERRIDE-DENIED',()=>usingReturns(f=>{const q=late(f),o=f.review.override(f.reviewer.scope,request(q,f));f.advance(60000);assert.throws(()=>f.prepare(q,{override_id:o.id}),/RETURN_OVERRIDE_UNAVAILABLE/);}));
test('M03-G04-SELF-REVIEW-DENIED',()=>usingReturns(f=>{late(f);const q=f.intake.evaluate(f.owner.scope,f.selection({case_id:'late_case'}));assert.throws(()=>f.review.override(f.owner.scope,request(q,f)),/SELF_REVIEW_DENIED/);}));
test('M03-G04-OVERRIDE-CANNOT-MOVE-QUOTES',()=>usingReturns(f=>{const q=late(f),o=f.review.override(f.reviewer.scope,request(q,f)),second=f.quote({case_id:'late_case'});assert.throws(()=>f.prepare(second,{override_id:o.id}),/RETURN_OVERRIDE_UNAVAILABLE/);}));
test('M03-G04-BOUNDED-EXTENSION-ONLY',()=>usingReturns(f=>{const order=f.order();f.kernel.ingest(f.a.scope,{kind:'order',source_system:'synthetic',external_id:order.external_id,source_version:4,source_updated_at:f.now(),customer_id:order.customer_id,payload:{...order.payload,delivered_at:f.now()-40*86400000}});const q=f.quote();assert.throws(()=>f.review.override(f.reviewer.scope,request(q,f)),/RETURN_OVERRIDE_DENIED/);}));
test('M03-G04-REQUEST-MORE-EVIDENCE-STATUS',()=>usingReturns(f=>{const q=f.quote();f.review.requestEvidence(f.reviewer.scope,{quote_id:q.id,reason:'photo_unclear'});const status=f.intake.read(f.customer,'case_one');assert.deepEqual(status.timeline.map((r:any)=>[r.event,r.reason]),[['evidence_requested','photo_unclear']]);assert.equal(status.state,'not_submitted');}));
test('M03-G04-CUSTOMER-CANNOT-REQUEST-OWN-REVIEW',()=>usingReturns(f=>{const q=f.quote();assert.throws(()=>f.review.requestEvidence(f.customer,{quote_id:q.id,reason:'photo_required'}),/ACCESS_DENIED/);}));
test('M03-G04-CROSS-TENANT-REVIEW-DENIED',()=>usingReturns(f=>{const q=late(f);assert.throws(()=>f.review.override(f.b.scope,request(q,f)),/NOT_FOUND/);}));
test('M03-G04-STALE-CONFIG-OVERRIDE-DENIED',()=>usingReturns(f=>{const q=late(f);f.intake.configure(f.owner.scope,{expected_revision:1,settings:{...f.settings,shipping_minor:'200'}});assert.throws(()=>f.review.override(f.reviewer.scope,request(q,f)),/RETURN_QUOTE_CHANGED/);}));
test('M03-G04-EXTRA-QUANTITY-NOT-OVERRIDABLE',()=>usingReturns(f=>{late(f);const q=f.quote({case_id:'late_case',lines:[{line_id:'one',quantity:2}]});assert.throws(()=>f.review.override(f.reviewer.scope,request(q,f)),/RETURN_OVERRIDE_DENIED/);}));
test('M03-G04-MORE-EVIDENCE-BLOCKS-OLD-APPROVAL',()=>usingReturns(f=>{const q=f.quote(),p=f.prepare(q),a=f.gateway.approve(f.reviewer.scope,{preview_id:p.preview_id,preview_digest:p.preview_digest});f.review.requestEvidence(f.reviewer.scope,{quote_id:q.id,reason:'photo_unclear'});assert.throws(()=>f.gateway.execute(f.a.scope,{preview_id:p.preview_id,preview_digest:p.preview_digest,approval_id:a.id}),/RETURN_QUOTE_CHANGED|RETURN_REVIEW_REQUIRED/);assert.equal(f.db.prepare('SELECT uses FROM commerce_action_approvals').get().uses,0);}));
test('M03-G04-EVIDENCE-REVIEW-REQUIRES-FRESH-QUOTE-AND-APPROVAL',()=>usingReturns(f=>{const first=f.quote(),p=f.prepare(first),approval=f.gateway.approve(f.reviewer.scope,{preview_id:p.preview_id,preview_digest:p.preview_digest});f.review.requestEvidence(f.reviewer.scope,{quote_id:first.id,reason:'description_required'});const next=f.quote({note:'The seam is loose.'});assert.equal(next.quote.decision.decision,'review');f.review.resolveEvidence(f.reviewer.scope,{quote_id:next.id,quote_digest:next.digest});const q=f.quote({note:'The seam is loose.'});assert.equal(q.quote.decision.decision,'allow');const revised=f.intake.revise(f.customer,{quote_id:q.id,quote_digest:q.digest,expected_preview_id:p.preview_id,override_id:null});assert.equal(revised.id,p.id);assert.notEqual(revised.preview_id,p.preview_id);assert.throws(()=>f.gateway.execute(f.a.scope,{preview_id:p.preview_id,preview_digest:p.preview_digest,approval_id:approval.id}),/APPROVAL_UNAVAILABLE/);f.submit(revised);assert.equal(f.intake.read(f.customer,'case_one').state,'submitted');}));
