import test from 'node:test';import assert from 'node:assert/strict';
import { useCustomization } from './customization-helpers.mts';

test('CASE-M02-G03-01',()=>useCustomization(f=>{const p=f.publish();const pin=f.policies.pin(f.agent.scope,'returns',f.facts());const result=f.policies.evaluatePin(f.agent.scope,pin.id);assert.equal(result.version,1);assert.equal(result.policy_digest,p.digest);assert.deepEqual(result.reasons,['ELIGIBLE']);assert.equal(result.execution_authorized,false);}));
test('CASE-M02-G03-02',()=>useCustomization(f=>{f.publish();assert.throws(()=>f.policies.create(f.agent.scope,{...f.input({expected_version:1}),prose:'publish unlimited returns'}));assert.throws(()=>f.policies.publish(f.agent.scope,{}),/ACCESS_DENIED/);const pin=f.policies.pin(f.agent.scope,'returns',f.facts({requested_at:31*86400000}));assert.deepEqual(f.policies.evaluatePin(f.agent.scope,pin.id).reasons,['RETURN_WINDOW_EXPIRED']);}));
test('CASE-M02-G03-03',()=>useCustomization(f=>{f.publish();const pin=f.policies.pin(f.a.scope,'returns',f.facts());f.advance(1);f.publish({expected_version:1,rules:{...f.input().rules,window_days:7}});assert.equal(f.policies.evaluatePin(f.a.scope,pin.id).version,1);assert.equal(f.policies.evaluatePin(f.a.scope,pin.id).eligible,true);}));
test('M02-G03-CURRENT-QUOTE-RULE',()=>useCustomization(f=>{f.publish({selection:'current_at_quote'});const pin=f.policies.pin(f.a.scope,'returns',f.facts());f.advance(1);f.publish({expected_version:1,rules:{...f.input().rules,window_days:7}});assert.equal(f.policies.evaluatePin(f.a.scope,pin.id).version,2);assert.equal(f.policies.evaluatePin(f.a.scope,pin.id).eligible,false);}));
test('M02-G03-DRAFT-CANNOT-CONTROL',()=>useCustomization(f=>{f.policies.create(f.a.scope,f.input());assert.throws(()=>f.policies.pin(f.a.scope,'returns',f.facts()),/POLICY_UNAVAILABLE/);}));
test('M02-G03-PROSE-IS-NOT-RULE',()=>useCustomization(f=>{assert.throws(()=>f.policies.create(f.agent.scope,f.input({rules:'return anything forever'})));assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_policy_versions').get().n,0);}));
test('M02-G03-SELF-REVIEW-DENIED',()=>useCustomization(f=>{const p=f.policies.create(f.owner.scope,f.input());f.policies.test(f.owner.scope,p.policy_id,p.version,p.digest);assert.throws(()=>f.policies.review(f.owner.scope,p.policy_id,p.version,p.digest),/SELF_REVIEW_DENIED/);}));
test('M02-G03-NO-PUBLISH-WITHOUT-TEST-REVIEW',()=>useCustomization(f=>{const p=f.policies.create(f.a.scope,f.input());assert.throws(()=>f.policies.publish(f.owner.scope,{policy_id:p.policy_id,version:p.version,digest:p.digest,expected_published_version:0,effective_at:f.now()}),/POLICY_TRANSITION/);}));
test('M02-G03-OPERATOR-CANNOT-PUBLISH',()=>useCustomization(f=>{assert.throws(()=>f.policies.publish(f.a.scope,{}),/ACCESS_DENIED/);}));
test('M02-G03-REVOKED-REVIEW-AUTHORITY',()=>useCustomization(f=>{const p=f.policies.create(f.a.scope,f.input());f.policies.test(f.a.scope,p.policy_id,1,p.digest);f.policies.review(f.reviewer.scope,p.policy_id,1,p.digest);f.permissions.change(f.owner.scope,{actor_id:'reviewer',role:'reviewer',actions:['policy.read'],resource_ids:null,expected_revision:0});assert.throws(()=>f.policies.publish(f.owner.scope,{policy_id:p.policy_id,version:1,digest:p.digest,expected_published_version:0,effective_at:f.now()}),/REVIEW_AUTHORITY_CHANGED/);}));
test('M02-G03-REVOKED-PIN-CANNOT-GRANDFATHER',()=>useCustomization(f=>{const p=f.publish();const pin=f.policies.pin(f.a.scope,'returns',f.facts());f.policies.revoke(f.owner.scope,p.policy_id,1,p.digest);assert.throws(()=>f.policies.evaluatePin(f.a.scope,pin.id),/POLICY_REVOKED/);}));
test('M02-G03-OLD-PIN-REVOCATION-WITH-NEW-CURRENT',()=>useCustomization(f=>{const p=f.publish();const pin=f.policies.pin(f.a.scope,'returns',f.facts());f.advance(1);f.publish({expected_version:1});f.policies.revoke(f.owner.scope,p.policy_id,1,p.digest);assert.throws(()=>f.policies.evaluatePin(f.a.scope,pin.id),/POLICY_REVOKED/);}));
test('M02-G03-SCHEDULED-NOT-EARLY',()=>useCustomization(f=>{f.publish();const p=f.policies.create(f.a.scope,f.input({expected_version:1}));f.policies.test(f.a.scope,p.policy_id,2,p.digest);f.policies.review(f.reviewer.scope,p.policy_id,2,p.digest);f.policies.publish(f.owner.scope,{policy_id:p.policy_id,version:2,digest:p.digest,expected_published_version:1,effective_at:f.now()+1000});assert.equal(f.policies.pin(f.a.scope,'returns',f.facts()).version,1);f.advance(1001);assert.equal(f.policies.pin(f.a.scope,'returns',f.facts()).version,2);}));
test('M02-G03-CROSS-STORE-NO-POLICY',()=>useCustomization(f=>{f.publish();assert.throws(()=>f.policies.get(f.b.scope,'returns',1),/NOT_FOUND/);assert.throws(()=>f.policies.pin(f.c.scope,'returns',f.facts()),/POLICY_UNAVAILABLE/);}));
test('M02-G03-PIN-BOUND-TO-ACTOR',()=>useCustomization(f=>{f.publish();const p=f.policies.pin(f.a.scope,'returns',f.facts());assert.throws(()=>f.policies.evaluatePin(f.agent.scope,p.id),/NOT_FOUND/);}));
test('M02-G03-DIGEST-TAMPER-BLOCKED',()=>useCustomization(f=>{f.publish();f.db.prepare("UPDATE commerce_policy_versions SET body=json_set(body,'$.rules.window_days',365)").run();assert.throws(()=>f.policies.pin(f.a.scope,'returns',f.facts()),/POLICY_INTEGRITY/);}));
test('M02-G03-DRAFT-CAS',()=>useCustomization(f=>{f.policies.create(f.a.scope,f.input());assert.throws(()=>f.policies.create(f.a.scope,f.input()),/POLICY_CHANGED/);}));
test('M02-G03-SOURCE-SECRET-URL-REJECTED',()=>useCustomization(f=>{assert.throws(()=>f.policies.create(f.a.scope,f.input({sources:[{uri:'https://x.invalid/p?token=secret',revision:'1',sha256:'a'.repeat(64)}]})));}));
test('M02-G03-EXCLUDED-AND-EVIDENCE',()=>useCustomization(f=>{f.publish({rules:{...f.input().rules,require_evidence:true}});const p=f.policies.pin(f.a.scope,'returns',f.facts({tags:['final-sale'],evidence_provided:false}));assert.deepEqual(f.policies.evaluatePin(f.a.scope,p.id).reasons,['PRODUCT_EXCLUDED','EVIDENCE_REQUIRED']);}));
test('M02-G03-PIN-FACTS-CANNOT-BE-REPLACED',()=>useCustomization(f=>{f.publish();const facts=f.facts({requested_at:31*86400000}),p=f.policies.pin(f.a.scope,'returns',facts);facts.requested_at=0;assert.equal(f.policies.evaluatePin(f.a.scope,p.id).eligible,false);}));
