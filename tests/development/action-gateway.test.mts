import test from 'node:test';import assert from 'node:assert/strict';
import { usingExecution } from './execution-helpers.mts';
import { ActionMcp } from '../../packages/agent/action-mcp.mts';
import { MCP_VERSION } from '../../packages/agent/mcp.mts';
import { startCommerceServer } from '../../apps/commerce-api/server.mts';

const initialize={jsonrpc:'2.0',id:1,method:'initialize',params:{protocolVersion:MCP_VERSION,capabilities:{},clientInfo:{name:'synthetic',version:'1'}}};
function mcpSetup(f:any,tools=['preview_resolution','execute_resolution','resolution_state']){const mcp=new ActionMcp(f.kernel,f.gateway),audience='http://127.0.0.1:9000/execution-mcp',grant=mcp.issue(f.agent.scope,{case_id:'case_one',tools},audience);mcp.dispatch(grant.token,audience,initialize);const call=(name:string,args:any)=>mcp.dispatch(grant.token,audience,{jsonrpc:'2.0',id:2,method:'tools/call',params:{name,arguments:args}},MCP_VERSION);return {mcp,audience,grant,call};}
async function server(f:any){return startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,reads:f.reads});}
function post(url:string,path:string,bearer:string,value:any){return fetch(url+path,{method:'POST',headers:{authorization:'Bearer '+bearer,'content-type':'application/json'},body:JSON.stringify(value)});}

test('CASE-M02-G10-01',()=>usingExecution(async f=>{const s=await server(f);try{const direct=f.gateway.prepare(f.agent.scope,f.proposal());const rest=await(await post(s.url,'/v1/execution/preview',f.agent.bearer,f.proposal())).json();const m=mcpSetup(f),rpc=m.call('preview_resolution',{case_id:'case_one',resolution:'refund'}) as any;assert.equal(rest.digest,direct.digest);assert.equal(rpc.result.structuredContent.digest,direct.digest);assert.equal(direct.preview.financial_effect,false);}finally{await s.close();}}));
test('CASE-M02-G10-02',()=>usingExecution(async f=>{const s=await server(f);try{for(const path of ['/v1/adapter/write','/v1/refunds','/v1/sql','/v1/execution/adapter']){assert.equal((await post(s.url,path,f.agent.bearer,{})).status,404);}assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_case_effects').get().n,0);}finally{await s.close();}}));
test('CASE-M02-G10-03',()=>usingExecution(f=>{assert.throws(()=>f.gateway.prepare(f.agent.scope,{...f.proposal(),action:'order.refund'}),/UNSUPPORTED_ACTION/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_case_effects').get().n,0);}));
test('M02-G10-CUSTOMER-CANNOT-EXECUTE-WITH-READ-PROOF',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);assert.throws(()=>f.execute(p,a,f.customer),/ACCESS_DENIED/);}));
test('M02-G10-UNVERIFIED-CASE-DENIED',()=>usingExecution(f=>{f.create('staff',f.a.scope);assert.throws(()=>f.gateway.prepare(f.a.scope,f.proposal('staff')),/CUSTOMER_VERIFICATION_REQUIRED/);}));
test('M02-G10-REVOKED-CUSTOMER-PROOF',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.kernel.revoke(f.customer);assert.throws(()=>f.execute(p,a),/CUSTOMER_VERIFICATION_REQUIRED/);}));
test('M02-G10-POLICY-EXCLUSION',()=>usingExecution(f=>{f.db.prepare("UPDATE commerce_resources SET payload=json_set(payload,'$.tags',json('[\"final-sale\"]')) WHERE id=?").run(f.order().id);assert.throws(()=>f.preview(),/POLICY_DENIED/);}));
test('M02-G10-DISABLED-CAPABILITY',()=>usingExecution(f=>{f.gateway.configure(f.owner.scope,{enabled:false,expected_revision:1,profile_id:'default',policy_id:'returns'});assert.throws(()=>f.preview(),/CAPABILITY_UNAVAILABLE/);}));
test('M02-G10-REVOKED-EXECUTION-PERMISSION',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.permissions.change(f.owner.scope,{actor_id:'agent',role:'agent',actions:['case.read','resource.read'],resource_ids:null,expected_revision:0});assert.throws(()=>f.execute(p,a),/ACCESS_DENIED/);}));
test('M02-G10-RESTRICTED-RESOURCE',()=>usingExecution(f=>{f.permissions.change(f.owner.scope,{actor_id:'agent',role:'agent',actions:null,resource_ids:[],expected_revision:0});assert.throws(()=>f.gateway.prepare(f.agent.scope,f.proposal()),/ACCESS_DENIED/);}));
test('M02-G10-MCP-WRITE-MISMATCH',()=>usingExecution(f=>{const m=mcpSetup(f);const result=m.call('refund',{case_id:'case_one',amount:'12500'}) as any;assert.equal(result.error.code,-32602);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_case_effects').get().n,0);}));
test('M02-G10-MCP-NO-APPROVAL-TOOL',()=>usingExecution(f=>{const m=mcpSetup(f);const result=m.mcp.dispatch(m.grant.token,m.audience,{jsonrpc:'2.0',id:9,method:'tools/list'},MCP_VERSION) as any;assert.equal(result.result.tools.some((t:any)=>t.name.includes('approv')),false);}));
test('M02-G10-MCP-GRANT-CASE-BOUND',()=>usingExecution(f=>{f.create('other');const m=mcpSetup(f);const result=m.call('preview_resolution',{case_id:'other',resolution:'refund'}) as any;assert.equal(result.error.code,-32602);}));
test('M02-G10-MCP-PREVIEW-CASE-BOUND',()=>usingExecution(f=>{f.create('other');const p=f.gateway.prepare(f.a.scope,f.proposal('other')),a=f.approve(p),m=mcpSetup(f);const result=m.call('execute_resolution',{case_id:'case_one',preview_id:p.id,preview_digest:p.digest,approval_id:a.id}) as any;assert.equal(result.result.isError,true);assert.equal(f.gateway.state(f.a.scope,'other').revision,0);}));
test('M02-G10-MCP-AUDIENCE-BOUND',()=>usingExecution(f=>{const m=mcpSetup(f);assert.throws(()=>m.mcp.authenticate(m.grant.token,'http://127.0.0.1:9001/execution-mcp'),/ACCESS_DENIED/);}));
test('M02-G10-MCP-REVOKED-PARENT',()=>usingExecution(f=>{const m=mcpSetup(f);f.kernel.revoke(f.agent.scope);assert.throws(()=>m.call('resolution_state',{case_id:'case_one'}),/ACCESS_DENIED/);}));
test('M02-G10-MCP-EXPIRED-GRANT',()=>usingExecution(f=>{const m=mcpSetup(f);f.advance(300001);assert.throws(()=>m.call('resolution_state',{case_id:'case_one'}),/ACCESS_DENIED/);}));
test('M02-G10-MCP-NO-GRANT-EXPANSION',()=>usingExecution(f=>{const m=mcpSetup(f,['resolution_state']);assert.equal((m.call('preview_resolution',{case_id:'case_one',resolution:'refund'}) as any).error.code,-32602);}));
test('M02-G10-REVERSIBLE-MARKER-NO-ORDER-MUTATION',()=>usingExecution(f=>{const order=f.order(),p=f.preview(),a=f.approve(p);f.execute(p,a);const undo=f.gateway.prepare(f.a.scope,f.proposal('case_one','none')),b=f.approve(undo);f.execute(undo,b);assert.deepEqual(f.order(),order);assert.equal(f.gateway.state(f.a.scope,'case_one').resolution,'none');assert.equal(f.gateway.state(f.a.scope,'case_one').revision,2);}));
test('M02-G10-HTTP-APPROVE-AND-EXECUTE',()=>usingExecution(async f=>{const s=await server(f);try{const p=await(await post(s.url,'/v1/execution/preview',f.a.bearer,f.proposal())).json();const a=await(await post(s.url,'/v1/execution/approve',f.reviewer.bearer,{preview_id:p.id,preview_digest:p.digest})).json();const response=await post(s.url,'/v1/execution/execute',f.agent.bearer,{preview_id:p.id,preview_digest:p.digest,approval_id:a.id});assert.equal(response.status,200);assert.equal((await response.json()).financial_effect,false);assert.equal((await post(s.url,'/v1/execution/execute',f.agent.bearer,{preview_id:p.id,preview_digest:p.digest,approval_id:a.id})).status,400);}finally{await s.close();}}));
test('M02-G10-MCP-HTTP-SYNTHETIC-EXECUTION',()=>usingExecution(async f=>{const s=await server(f);try{const grant=await(await post(s.url,'/v1/execution/grants',f.agent.bearer,{case_id:'case_one',tools:['preview_resolution','execute_resolution']})).json();const rpc=async(message:any)=>await(await fetch(s.url+'/execution-mcp',{method:'POST',headers:{authorization:'Bearer '+grant.token,'content-type':'application/json',accept:'application/json, text/event-stream','mcp-protocol-version':MCP_VERSION},body:JSON.stringify(message)})).json();await rpc(initialize);const p=(await rpc({jsonrpc:'2.0',id:2,method:'tools/call',params:{name:'preview_resolution',arguments:{case_id:'case_one',resolution:'refund'}}})).result.structuredContent,a=f.approve(p);const done=await rpc({jsonrpc:'2.0',id:3,method:'tools/call',params:{name:'execute_resolution',arguments:{case_id:'case_one',preview_id:p.id,preview_digest:p.digest,approval_id:a.id}}});assert.equal(done.result.isError,false);assert.equal(done.result.structuredContent.financial_effect,false);}finally{await s.close();}}));
