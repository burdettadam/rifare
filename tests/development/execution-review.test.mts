import test from 'node:test';import assert from 'node:assert/strict';
import { spawn } from 'node:child_process';import { join } from 'node:path';
import { usingExecution } from './execution-helpers.mts';
import { checkedBundle } from '../../packages/commerce/skills.mts';

test('M02-G09-REVIEWED-CANARY-PLAN-INTEGRITY',()=>usingExecution(f=>{const first=f.release();f.releases.publish(f.owner.scope,{release_id:first.id,expected_revision:0,rollout_percent:100});const next=f.release(10);f.db.prepare('UPDATE commerce_skill_releases SET rollout_percent=100 WHERE id=?').run(next.id);assert.throws(()=>f.releases.publish(f.owner.scope,{release_id:next.id,expected_revision:1,rollout_percent:100}),/RELEASE_INTEGRITY/);assert.equal(f.releases.active(f.a.scope,'order-status').revision,1);}));
test('M02-G09-REVOKED-INSTALL-CANNOT-REPLACE-VALID-CURRENT',()=>usingExecution(f=>{f.releases.revoke(f.owner.scope,{skill_id:'order-status',bundle_digest:f.bundle.digest});const current=f.changeSkill();assert.throws(()=>f.reads.skills.install(f.a.scope,f.bundle),/SKILL_REVOKED/);assert.equal(f.db.prepare("SELECT bundle_digest FROM commerce_skills WHERE tenant_id=? AND store_id=? AND id='order-status'").get(f.a.tenant,f.a.store).bundle_digest,current.digest);}));
test('M02-G10-PERMISSION-RECHECK-AFTER-TRANSACTION-LOCK',()=>usingExecution(f=>{const original=f.kernel.transaction.bind(f.kernel);let armed=true;f.kernel.transaction=(fn:any)=>{if(armed){armed=false;f.db.prepare('INSERT INTO commerce_permissions VALUES(?,?,?,?,?,?)').run(f.a.tenant,f.a.store,'operator',1,JSON.stringify(['resource.read','case.read','policy.read','skill.read','capability.read']),null);}return original(fn);};assert.throws(()=>f.preview(),/ACCESS_DENIED/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_previews').get().n,0);}));
test('M02-G10-SETTINGS-RECHECK-AFTER-TRANSACTION-LOCK',()=>usingExecution(f=>{const original=f.kernel.transaction.bind(f.kernel);let armed=true;f.kernel.transaction=(fn:any)=>{if(armed){armed=false;f.db.prepare("UPDATE commerce_members SET role='operator' WHERE actor_id='owner'").run();}return original(fn);};assert.throws(()=>f.gateway.configure(f.owner.scope,{enabled:false,expected_revision:1,profile_id:'default',policy_id:'returns'}),/ACCESS_DENIED/);assert.equal(f.db.prepare('SELECT enabled FROM commerce_execution_settings').get().enabled,1);}));
test('M02-G08-MIGRATE-RECHECK-AFTER-TRANSACTION-LOCK',()=>usingExecution(f=>{const original=f.kernel.transaction.bind(f.kernel);let armed=true;f.kernel.transaction=(fn:any)=>{if(armed){armed=false;f.db.prepare('INSERT INTO commerce_permissions VALUES(?,?,?,?,?,?)').run(f.a.tenant,f.a.store,'operator',1,JSON.stringify(['resource.read','case.read','policy.read','skill.read','capability.read','profile.read']),null);}return original(fn);};assert.throws(()=>f.cases.migrate(f.a.scope,'case_one',{expected_revision:1,profile_id:'default',policy_id:'returns',reason:'approved_update'}),/ACCESS_DENIED/);assert.equal(f.db.prepare('SELECT revision FROM commerce_cases').get().revision,1);}));
test('M02-G10-SERVER-POLICY-SELECTION-BOUND',()=>usingExecution(f=>{f.publish({policy_id:'permissive'});f.cases.migrate(f.a.scope,'case_one',{expected_revision:1,profile_id:'default',policy_id:'permissive',reason:'approved_update'});assert.throws(()=>f.preview(),/CONFIGURATION_NOT_APPROVED/);}));
test('M02-G11-COMPETING-PROCESSES-ONE-CONSUMPTION',()=>usingExecution(async f=>{
  const p=f.preview(),a=f.approve(p),code=`import {DatabaseSync} from 'node:sqlite';import {CommerceKernel} from './packages/commerce/kernel.mts';import {ActionGateway} from './packages/commerce/action-gateway.mts';let t='';for await(const x of process.stdin)t+=x;const x=JSON.parse(t),db=new DatabaseSync(x.file),k=new CommerceKernel(db,()=>x.now);try{new ActionGateway(k).execute(k.authenticate(x.bearer),x.request);console.log('accepted');}catch(e){console.log(e.message);}finally{db.close();}`;
  const run=()=>new Promise<string>((resolve,reject)=>{const child=spawn(process.execPath,['--experimental-strip-types','--input-type=module','-e',code],{cwd:process.cwd(),stdio:['pipe','pipe','pipe']});let output='',error='';child.stdout.on('data',b=>output+=b);child.stderr.on('data',b=>error+=b);child.on('error',reject);child.on('close',code=>code===0?resolve(output.trim()):reject(new Error(error)));child.stdin.end(JSON.stringify({file:f.filename,now:f.now(),bearer:f.agent.bearer,request:{preview_id:p.id,preview_digest:p.digest,approval_id:a.id}}));});
  const outcomes=await Promise.all([run(),run()]);assert.deepEqual(outcomes.sort(),['APPROVAL_UNAVAILABLE','accepted'].sort());assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_receipts').get().n,1);assert.equal(f.db.prepare('SELECT revision FROM commerce_case_effects').get().revision,1);
}));
test('M02-G11-CUSTOMER-CANNOT-APPROVE-OWN-REQUEST',()=>usingExecution(f=>{const p=f.preview();assert.throws(()=>f.gateway.approve(f.customer,{preview_id:p.id,preview_digest:p.digest}),/ACCESS_DENIED/);}));
test('M02-G11-PROCESS-RESTART-RECEIPT-RECONCILIATION',()=>usingExecution(async f=>{const p=f.preview(),a=f.approve(p),r=f.execute(p,a);const {DatabaseSync}=await import('node:sqlite'),{CommerceKernel}=await import('../../packages/commerce/kernel.mts'),{ActionGateway}=await import('../../packages/commerce/action-gateway.mts');const db=new DatabaseSync(f.filename);try{const k=new CommerceKernel(db,f.now),g=new ActionGateway(k),s=k.authenticate(f.a.bearer);assert.deepEqual(g.receipt(s,r.id),r);assert.throws(()=>g.execute(s,{preview_id:p.id,preview_digest:p.digest,approval_id:a.id}),/APPROVAL_UNAVAILABLE/);}finally{db.close();}}));
