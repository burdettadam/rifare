import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';
import {usingGift} from './gift-helpers.mts';import {ReturnEvidence} from '../../packages/commerce/return-evidence.mts';import {PrivacyLifecycle} from '../../packages/commerce/privacy-lifecycle.mts';
const photo=JSON.parse(readFileSync(new URL('../fixtures/return-intake/photo.v1.json',import.meta.url),'utf8')).base64;
function retained(f:any,customer='recipient-one'){f.createGift();const evidence=new ReturnEvidence(f.kernel),upload=evidence.upload(f.a.scope,{case_id:'gift_case',mime:'image/png',base64:photo,note:'recipient evidence under investigation'}),privacy=new PrivacyLifecycle(f.kernel);privacy.hold(f.owner.scope,{customer_id:customer,reason:'investigation',authority_ref:'gift-hold',expires_at:f.now()+60*86400000});return {evidence,upload,privacy};}
test('M06-G05-RECIPIENT-ONLY-HOLD-PREVENTS-ERASURE',()=>usingGift(f=>{const {privacy,upload}=retained(f);assert.equal(privacy.erase(f.owner.scope,'recipient-one').status,'held');assert.notEqual(f.db.prepare('SELECT bytes FROM commerce_return_evidence WHERE id=?').get(upload.id).bytes,null);assert.equal(f.gifts.choices(f.accessInput).lines[0].remaining,1);}));
test('M06-G05-RECIPIENT-HOLD-PREVENTS-MANUAL-EVIDENCE-ERASURE',()=>usingGift(f=>{const {evidence,upload}=retained(f);assert.equal(evidence.erase(f.owner.scope,upload.id).held,true);assert.notEqual(f.db.prepare('SELECT bytes FROM commerce_return_evidence WHERE id=?').get(upload.id).bytes,null);}));
test('M06-G05-RECIPIENT-HOLD-PREVENTS-PURGE',()=>usingGift(f=>{const {evidence,upload}=retained(f);f.advance(31*86400000);const owner=f.kernel.authenticate(f.kernel.issueSession(f.a.tenant,f.a.store,'owner'));const result=evidence.purgeExpired(owner);assert.equal(result.held,1);assert.equal(result.erased,0);assert.notEqual(f.db.prepare('SELECT bytes FROM commerce_return_evidence WHERE id=?').get(upload.id).bytes,null);}));
test('M06-G05-HOLD-RELEASE-ALLOWS-RECIPIENT-ERASURE',()=>usingGift(f=>{const {privacy,upload}=retained(f);privacy.releaseHold(f.owner.scope,'recipient-one','gift-hold');assert.equal(privacy.erase(f.owner.scope,'recipient-one').status,'logically_erased');assert.equal(f.db.prepare('SELECT bytes FROM commerce_return_evidence WHERE id=?').get(upload.id).bytes,null);assert.equal(f.giftOrderNow().customer_id,f.giftOrder.customer_id);}));
test('M06-G05-PURCHASER-ERASURE-RESPECTS-RECIPIENT-HOLD',()=>usingGift(f=>{const {privacy,upload}=retained(f);assert.equal(privacy.erase(f.owner.scope,f.giftOrder.customer_id).status,'held');assert.notEqual(f.db.prepare('SELECT bytes FROM commerce_return_evidence WHERE id=?').get(upload.id).bytes,null);}));
test('M06-G05-RECIPIENT-ERASURE-RESPECTS-PURCHASER-HOLD',()=>usingGift(f=>{const {privacy,evidence,upload}=retained(f,f.giftOrder.customer_id);assert.equal(privacy.erase(f.owner.scope,'recipient-one').status,'held');assert.equal(evidence.erase(f.owner.scope,upload.id).held,true);}));
test('M06-G05-HISTORICAL-RECIPIENT-CAN-RETAIN-EVIDENCE',()=>usingGift(f=>{const {privacy,upload}=retained(f);f.updateGift({gift_facts:{...f.giftFacts,revision:2,recipient_customer_id:'new-recipient',recipient_email:'new@example.invalid'}});privacy.releaseHold(f.owner.scope,'recipient-one','gift-hold');privacy.hold(f.owner.scope,{customer_id:'recipient-one',reason:'investigation',authority_ref:'historical-hold',expires_at:f.now()+600000});assert.equal(privacy.erase(f.owner.scope,f.giftOrder.customer_id).status,'held');assert.notEqual(f.db.prepare('SELECT bytes FROM commerce_return_evidence WHERE id=?').get(upload.id).bytes,null);}));
