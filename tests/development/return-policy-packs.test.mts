import test from 'node:test';import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';import {contentDigest} from '../../packages/commerce/configuration-values.mts';
import {usingPolicyPack,packOracle} from './return-policy-pack-helpers.mts';

test('CASE-M06-G14-01 three policy packs run the declared matrix through one return engine',async()=>{
 const code=contentDigest(['return-eligibility.mts','return-intake-core.mts','case-configurations.mts','action-gateway.mts'].map(p=>readFileSync(new URL('../../packages/commerce/'+p,import.meta.url),'utf8'))),skills=new Set<string>();
 for(const spec of packOracle.profiles)await usingPolicyPack(f=>{skills.add(f.installed.pack.skill.digest);for(const scenario of packOracle.scenarios){f.facts(scenario.days,scenario.tags);const r=f.evaluate(),expected=scenario.expected[spec.id];assert.equal(r.eligibility.decision,expected.decision,spec.id+'/'+scenario.id);assert.deepEqual(r.eligibility.reasons,expected.reasons,spec.id+'/'+scenario.id);assert.equal(r.presentation.locale,spec.locale);assert.equal(r.review.mode,spec.review_mode);assert.deepEqual(r.routing.allowed_destination_ids,spec.destination_ids);assert.equal(r.action_approval,'separate_reviewer_required');assert.equal(r.execution_authorized,false);assert.equal(r.financial_effect,false);assert.equal(r.policy_digest,f.installed.pack.policy.digest);}},spec.id);
 assert.equal(skills.size,1);assert.equal(contentDigest(['return-eligibility.mts','return-intake-core.mts','case-configurations.mts','action-gateway.mts'].map(p=>readFileSync(new URL('../../packages/commerce/'+p,import.meta.url),'utf8'))),code);
});
test('CASE-M06-G14-02 requested financial and warehouse capabilities cannot grant server readiness',()=>usingPolicyPack(f=>{
 f.packs.put(f.owner.scope,{...f.packInput,expected_revision:1,required_capabilities:['order.read','instant.capture','warehouse.receive']});const r=f.evaluate();assert.equal(r.readiness.ready,false);assert.deepEqual(r.readiness.missing_capabilities,['instant.capture','warehouse.receive']);assert.equal(r.eligibility.decision,'allow');assert.equal(r.execution_authorized,false);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_receipts').get()!.n,0);
}));
test('CASE-M06-G14-03 a fourth merchant identity uses the identical policy and core behavior',async()=>{
 let expected:any;await usingPolicyPack(f=>{f.facts(15);const r=f.evaluate();expected={decision:r.eligibility.decision,reasons:r.eligibility.reasons,policy:r.policy_digest,skill:r.skill_digest,effective:r.effective_digest};},'apparel');
 await usingPolicyPack(f=>{f.facts(15);const r=f.evaluate();assert.equal(f.a.store,'store-c');assert.deepEqual({decision:r.eligibility.decision,reasons:r.eligibility.reasons,policy:r.policy_digest,skill:r.skill_digest,effective:r.effective_digest},expected);assert.equal(r.pack_id,'fourth_merchant');},'apparel','fourth_merchant',true);
});
test('PORT-017 apparel fragile and final-sale choices keep one shared skill bundle',async()=>{
 const skill=new Set<string>();for(const spec of packOracle.profiles)await usingPolicyPack(f=>{skill.add(f.evaluate().skill_digest);f.facts(3,['final-sale']);assert.equal(f.evaluate().eligibility.decision,'deny');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_fulfillment_operations').get()!.n,0);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_resolution_operations').get()!.n,0);},spec.id);assert.equal(skill.size,1);
});
test('M06-G14-PACK-WRITE-REQUIRES-CONFIGURATION-AUTHORITY',()=>usingPolicyPack(f=>{for(const scope of [f.a.scope,f.reviewer.scope,f.agent.scope,f.customer])assert.throws(()=>f.packs.put(scope,{...f.packInput,expected_revision:1}),/ACCESS_DENIED/);}));
test('M06-G14-PACK-READ-DENIES-OTHER-STORE-AND-CUSTOMER',()=>usingPolicyPack(f=>{assert.throws(()=>f.packs.get(f.b.scope,f.packId),/NOT_FOUND/);assert.throws(()=>f.packs.get(f.customer,f.packId),/ACCESS_DENIED/);assert.throws(()=>f.evaluate({},f.b.scope),/NOT_FOUND/);}));
test('M06-G14-PACK-STRICT-FIELDS-CANNOT-DISABLE-SEPARATE-APPROVAL',()=>usingPolicyPack(f=>{assert.throws(()=>f.packs.put(f.owner.scope,{...f.packInput,expected_revision:1,approved:true}),/INVALID_INPUT/);assert.throws(()=>f.packs.put(f.owner.scope,{...f.packInput,expected_revision:1,review:{...f.packInput.review,approval_required:false}}),/INVALID_INPUT/);assert.throws(()=>f.packs.put(f.owner.scope,{...f.packInput,expected_revision:1,routing:{required:true,allowed_destination_ids:[]}}),/PACK_ROUTING_INVALID/);}));
test('M06-G14-PACK-REVISION-CONFLICT-PRESERVES-HISTORY',()=>usingPolicyPack(f=>{const old=f.packs.get(f.a.scope,f.packId);f.packs.put(f.owner.scope,{...f.packInput,expected_revision:1,review:{mode:'specialist',always_review:true}});assert.throws(()=>f.packs.put(f.owner.scope,{...f.packInput,expected_revision:1}),/PACK_CHANGED/);assert.equal(f.packs.get(f.a.scope,f.packId,1).digest,old.digest);assert.equal(f.packs.get(f.a.scope,f.packId).revision,2);}));
test('M06-G14-PACK-PROFILE-UPDATE-REQUIRES-REFRESH-AND-CASE-REPREVIEW',()=>usingPolicyPack(f=>{f.reads.profiles.put(f.a.scope,f.profile(f.a,{id:'pack_profile',revision:2,tone:'formal'}));assert.throws(()=>f.evaluate(),/PACK_PROFILE_CHANGED/);f.packs.put(f.owner.scope,{...f.packInput,expected_revision:1});assert.throws(()=>f.evaluate(),/PACK_CASE_MISMATCH/);}));
test('M06-G14-PACK-REVOKED-POLICY-CANNOT-BE-EVALUATED',()=>usingPolicyPack(f=>{f.policies.revoke(f.owner.scope,'pack_policy',1,f.installed.pack.policy.digest);assert.throws(()=>f.evaluate(),/POLICY_REVOKED/);}));
test('M06-G14-PACK-REQUIRES-CURRENT-REAL-DESTINATION-READINESS',()=>usingPolicyPack(f=>{f.packs.put(f.owner.scope,{...f.packInput,expected_revision:1,routing:{required:true,allowed_destination_ids:['apparel-hub']},required_capabilities:['order.read','return.destination']});const r=f.evaluate();assert.equal(r.readiness.ready,false);assert.deepEqual(r.readiness.missing_capabilities,['return.destination']);assert.equal(r.routing.state,'return_request_required');assert.equal(r.execution_authorized,false);}));
test('M06-G14-PACK-TAMPERED-BODY-IS-REJECTED',()=>usingPolicyPack(f=>{f.db.prepare("UPDATE commerce_return_policy_packs SET body='{}' WHERE id=?").run(f.packId);assert.throws(()=>f.packs.get(f.a.scope,f.packId),/PACK_INTEGRITY/);}));
test('M06-G14-PACK-EVALUATION-KEEPS-POLICY-RIGHTS-AND-NO-EFFECTS',()=>usingPolicyPack(f=>{const before=JSON.stringify(f.order());f.packs.put(f.owner.scope,{...f.packInput,expected_revision:1,review:{mode:'policy_exception',always_review:true}});const r=f.evaluate();assert.equal(r.eligibility.decision,'allow');assert.equal(r.review.reviewer_recommended,true);assert.equal(r.action_approval,'separate_reviewer_required');assert.equal(JSON.stringify(f.order()),before);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_receipts').get()!.n,0);}));
