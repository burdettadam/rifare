import test from 'node:test';import assert from 'node:assert/strict';
import { usingResolution as usingBase } from './resolution-helpers.mts';
const usingResolution=(fn:Parameters<typeof usingBase>[0])=>usingBase(fn,{zeroFees:true});
test('CASE-M03-G10-01',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog(),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.equal(q.quote.allowed,true);assert.equal(q.quote.balance_minor,'0');assert.equal(q.quote.source_stock,5);assert.equal(q.quote.stock_reserved,false);assert.equal(f.exchanges.assertCurrent(f.a.scope,{quote_id:q.id,quote_digest:q.digest}).commit_authorized,false);}));
function changed(f:any,c:any,patch:any){return f.kernel.ingest(f.a.scope,{kind:'catalog',source_system:'synthetic',external_id:c.external_id,source_version:c.source_version+1,source_updated_at:f.now(),customer_id:null,payload:{...c.payload,...patch}});}
test('CASE-M03-G10-02',()=>usingResolution(f=>{const p=f.allocate();for(const patch of [{excluded:true},{available:2},{unit_price_minor:'1200'}]){const c=f.catalog(patch),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.equal(q.quote.allowed,false);assert.deepEqual(q.quote.alternatives,['exchange','refund','store_credit'].filter(x=>x!=='exchange'));f.db.prepare('DELETE FROM commerce_resources WHERE id=?').run(c.id);}}));
test('CASE-M03-G10-03',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog(),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});changed(f,c,{available:2});assert.throws(()=>f.exchanges.assertCurrent(f.a.scope,{quote_id:q.id,quote_digest:q.digest}),/EXCHANGE_QUOTE_CHANGED/);}));
test('M03-G10-STOCK-BUFFER-BOUNDARY',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog({available:3}),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.equal(q.quote.allowed,true);changed(f,c,{available:2});const next=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.deepEqual(next.quote.reasons,['INSUFFICIENT_STOCK']);}));
test('M03-G10-HIGHER-PRICE-NOT-AUTHORIZED',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog({unit_price_minor:'1001'}),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.equal(q.quote.balance_minor,'1');assert.equal(q.quote.allowed,false);}));
test('M03-G10-LOWER-PRICE-NOT-SILENT-REFUND',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog({unit_price_minor:'999'}),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.equal(q.quote.balance_minor,'-1');assert.deepEqual(q.quote.reasons,['PRICE_DIFFERENCE_UNSUPPORTED']);}));
test('M03-G10-DIFFERENT-PRODUCT-NOT-VARIANT',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog({product_id:'another'}),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.ok(q.quote.reasons.includes('CATALOG_EXCHANGE_UNQUALIFIED'));}));
test('M03-G10-PRICE-UPDATE-INVALIDATES-QUOTE',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog(),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});changed(f,c,{unit_price_minor:'1001'});assert.throws(()=>f.exchanges.assertCurrent(f.a.scope,{quote_id:q.id,quote_digest:q.digest}),/EXCHANGE_QUOTE_CHANGED/);}));
test('M03-G10-CURRENCY-MISMATCH-UNSUPPORTED',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog({currency:'EUR'}),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.ok(q.quote.reasons.includes('CURRENCY_UNSUPPORTED'));}));
test('M03-G10-SHIPPING-CHARGE-INCLUDED-IN-BALANCE',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog({shipping_minor:'100'}),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.equal(q.quote.balance_minor,'100');assert.equal(q.quote.allowed,false);}));
test('M03-G10-TAX-INCLUDED-IN-BALANCE',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog({tax_per_unit_minor:'50'}),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.equal(q.quote.balance_minor,'50');}));
test('M03-G10-EXPIRED-QUOTE-CANNOT-BIND',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog(),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});f.advance(300001);assert.throws(()=>f.exchanges.assertCurrent(f.a.scope,{quote_id:q.id,quote_digest:q.digest}),/EXCHANGE_QUOTE_CHANGED/);}));
test('M03-G10-DISCOUNT-EXPIRY-REQUIRES-REQUOTE',()=>usingResolution(f=>{const input=f.intent();input.lines[0].outcome='exchange';const p=f.allocate(input),a=p.allocations.find(x=>x.line_id==='alpha')!,c=f.catalog({variant_id:'shirt-large',product_id:'shirt',unit_price_minor:'2000',tax_per_unit_minor:'100',shipping_minor:'30',duties_per_unit_minor:'10',promotion_expires_at:f.now()+1000}),q=f.exchanges.quote(f.a.scope,{allocation_id:a.id,catalog_id:c.id});assert.equal(q.quote.allowed,true);assert.equal(q.quote.retained_discount_minor,'200');f.advance(1001);assert.throws(()=>f.exchanges.assertCurrent(f.a.scope,{quote_id:q.id,quote_digest:q.digest}),/EXCHANGE_QUOTE_CHANGED/);}));
test('M03-G10-EXCLUDED-ORIGINAL-DISCOUNT-NOT-INVENTED',()=>usingResolution(f=>{const input=f.intent();input.lines[0].outcome='exchange';const p=f.allocate(input),a=p.allocations.find(x=>x.line_id==='alpha')!,c=f.catalog({variant_id:'shirt-large',product_id:'shirt',unit_price_minor:'2000',tax_per_unit_minor:'100',shipping_minor:'30',duties_per_unit_minor:'10',discount_eligible:false}),q=f.exchanges.quote(f.a.scope,{allocation_id:a.id,catalog_id:c.id});assert.equal(q.quote.allowed,false);assert.ok(q.quote.reasons.includes('DISCOUNT_UNAVAILABLE'));}));
test('M03-G10-INVALID-STOCK-NOT-ZERO-COERCED',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog({available:'5'});assert.throws(()=>f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id}),/INVALID_INPUT/);}));
test('M03-G10-CROSS-STORE-QUOTE-HIDDEN',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog(),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.throws(()=>f.exchanges.assertCurrent(f.b.scope,{quote_id:q.id,quote_digest:q.digest}),/NOT_FOUND/);}));
test('M03-G10-NO-INVENTORY-MUTATION-FOR-QUOTE',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog();for(let i=0;i<3;i++)f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.equal(f.kernel.get(f.a.scope,c.id).payload.available,5);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);}));
test('M03-G10-UNSUPPORTED-COMMIT-STAYS-DISABLED',()=>usingResolution(f=>{const p=f.allocate(),c=f.catalog(),q=f.exchanges.quote(f.a.scope,{allocation_id:p.allocations[2].id,catalog_id:c.id});assert.throws(()=>f.gateway.prepare(f.a.scope,{case_id:'resolution_case',action:'exchange.commit',arguments:{quote_id:q.id}}),/UNSUPPORTED_ACTION/);}));
