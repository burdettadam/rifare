import test from 'node:test';
import assert from 'node:assert/strict';
import { writeFileSync, readFileSync, readdirSync, unlinkSync, symlinkSync } from 'node:fs';
import { join } from 'node:path';
import { SmokeStore, validateMarker } from '../../packages/development/store.mts';
import { configuration } from '../../packages/development/config.mts';
import { fixture } from './helpers.mts';

function setup() { const f=fixture(); const config=configuration(f.root,{});const store=new SmokeStore(config,true);return {...f,config,store,close(){store.close();f.cleanup();}}; }
test('DB-01 migrations run once and survive store reopen',()=>{const f=setup();try{assert.equal(f.store.state().migrations.length,1);const second=new SmokeStore(f.config,true);assert.equal(second.state().migrations.length,1);second.close();}finally{f.close();}});
test('DB-02 changed applied migration is rejected without updating its checksum',()=>{const f=setup();try{const path=join(f.root,'migrations/smoke/001_development.sql');writeFileSync(path,readFileSync(path,'utf8')+'\n-- changed\n');assert.throws(()=>new SmokeStore(f.config,true),/MIGRATION_CHECKSUM_MISMATCH/);assert.equal(f.store.state().migrations.length,1);}finally{f.close();}});
test('DB-03 unknown future migration is not silently ignored',()=>{const f=setup();try{f.store.db.prepare('INSERT INTO schema_migrations VALUES(?,?)').run('999_future.sql','x');assert.throws(()=>new SmokeStore(f.config,true),/UNKNOWN_APPLIED_MIGRATION/);}finally{f.close();}});
test('DB-04 a broken migration rolls back its schema and ledger changes',()=>{const f=setup();try{writeFileSync(join(f.root,'migrations/smoke/002_broken.sql'),'CREATE TABLE partial(id INTEGER); NOT VALID SQL;');assert.throws(()=>new SmokeStore(f.config,true));assert.equal(f.store.db.prepare("SELECT name FROM sqlite_master WHERE name='partial'").get(),undefined);assert.equal(f.store.state().migrations.length,1);}finally{f.close();}});
test('DB-05 startup requires the current migration before serving',()=>{const f=setup();try{writeFileSync(join(f.root,'migrations/smoke/002_next.sql'),'CREATE TABLE next(id INTEGER);');assert.throws(()=>new SmokeStore(f.config),/MIGRATION_REQUIRED/);}finally{f.close();}});
test('DB-06 a database cannot be reused under a different worktree identity',()=>{const f=setup();try{assert.throws(()=>new SmokeStore({...f.config,instanceId:'rifare_other'},true),/DATABASE_OWNER_MISMATCH/);}finally{f.close();}});
test('DB-07 marker retries retain one record and conflicting replay fails',()=>{const f=setup();try{f.store.marker({id:'m',value:'one'});f.store.marker({id:'m',value:'one'});assert.equal(f.store.state().markers.length,1);assert.throws(()=>f.store.marker({id:'m',value:'two'}),/IDEMPOTENCY_CONFLICT/);}finally{f.close();}});
test('DB-08 marker text is parameterized rather than SQL',()=>{const f=setup();try{const value="'); DROP TABLE dev_markers; --";f.store.marker({id:'injection',value});assert.equal(f.store.state().markers[0].value,value);}finally{f.close();}});
test('DB-09 unsafe marker identities, oversized values and extra fields fail',()=>{for(const item of [{id:'../escape',value:'x'},{id:'',value:'x'},{id:'x',value:''},{id:'x',value:'a'.repeat(257)},{id:'x',value:'x',url:'https://example.invalid'},null,[]])assert.throws(()=>validateMarker(item),/INVALID_MARKER/);});
test('DB-10 durable queued job survives reopening',()=>{const f=setup();try{f.store.enqueue({id:'j',value:'persist'});const other=new SmokeStore(f.config);assert.equal(other.state().jobs[0].state,'pending');other.close();}finally{f.close();}});
test('DB-11 two independent connections cannot claim the same unexpired job',()=>{const f=setup();const other=new SmokeStore(f.config);try{f.store.enqueue({id:'j',value:'one'});assert.ok(f.store.claim(100,1000));assert.equal(other.claim(101,1000),undefined);}finally{other.close();f.close();}});
test('DB-12 expired lease can be reclaimed but stale owner cannot complete',()=>{const f=setup();try{f.store.enqueue({id:'j',value:'one'});const a=f.store.claim(100,10)!;const b=f.store.claim(111,1000)!;assert.notEqual(a.lease_owner,b.lease_owner);assert.throws(()=>f.store.finish(a,112),/STALE_JOB_LEASE/);f.store.finish(b,112);assert.equal(f.store.state().jobs[0].attempts,2);}finally{f.close();}});
test('DB-13 attachment receipt is idempotent across effect-before-commit recovery',()=>{const f=setup();try{f.store.enqueue({id:'j',value:'recover'});const job=f.store.claim()!;writeFileSync(f.store.attachmentPath('j'),JSON.stringify({instance_id:f.config.instanceId,id:'j',value:'recover'})+'\n');f.store.finish(job);assert.equal(f.store.state().jobs[0].state,'completed');assert.equal(readdirSync(f.config.attachments).length,1);assert.equal(JSON.parse(f.store.readAttachment('j')).value,'recover');}finally{f.close();}});
test('DB-14 different preexisting attachment is a conflict, never overwritten',()=>{const f=setup();try{f.store.enqueue({id:'j',value:'expected'});const job=f.store.claim()!;const path=f.store.attachmentPath('j');writeFileSync(path,'different');assert.throws(()=>f.store.finish(job),/ATTACHMENT_CONFLICT/);assert.equal(readFileSync(path,'utf8'),'different');assert.equal(f.store.state().jobs[0].state,'running');}finally{f.close();}});
test('DB-15 attachment symlink cannot overwrite a different local file',()=>{const f=setup();try{f.store.enqueue({id:'j',value:'expected'});const job=f.store.claim()!;const target=join(f.root,'innocent');writeFileSync(target,'unchanged');symlinkSync(target,f.store.attachmentPath('j'));assert.throws(()=>f.store.finish(job),/UNSAFE_RUNTIME_FILE/);assert.equal(readFileSync(target,'utf8'),'unchanged');}finally{f.close();}});
test('DB-16 pending jobs are not reported as completed attachments',()=>{const f=setup();try{f.store.enqueue({id:'j',value:'pending'});assert.throws(()=>f.store.readAttachment('j'),/ATTACHMENT_NOT_READY/);}finally{f.close();}});
test('DB-17 file extension loading remains disabled',()=>{const f=setup();try{assert.throws(()=>f.store.db.exec("SELECT load_extension('/nonexistent')"),/not authorized/);}finally{f.close();}});
test('DB-18 duplicate job request does not enqueue a second obligation',()=>{const f=setup();try{f.store.enqueue({id:'j',value:'one'});f.store.enqueue({id:'j',value:'one'});assert.equal(f.store.state().jobs.length,1);assert.throws(()=>f.store.enqueue({id:'j',value:'two'}),/IDEMPOTENCY_CONFLICT/);}finally{f.close();}});
test('DB-19 schema migration numbering must remain contiguous',()=>{const f=setup();try{writeFileSync(join(f.root,'migrations/smoke/003_gap.sql'),'CREATE TABLE gap(id INTEGER);');assert.throws(()=>new SmokeStore(f.config,true),/MIGRATION_SEQUENCE/);}finally{f.close();}});
