import test from 'node:test';import assert from 'node:assert/strict';import {spawn} from 'node:child_process';
import {usingReturns} from './return-intake-helpers.mts';import {usingPrevention} from './prevention-helpers.mts';import {usingQualifiedDestinations} from './qualified-destinations-helpers.mts';import {usingPolicyPack} from './return-policy-pack-helpers.mts';
import {withDepthServer} from './return-depth-test-helpers.mts';import {SupportMetrics} from '../../packages/commerce/support-metrics.mts';
async function component(f:any,sources:any,config:any){await withDepthServer(f,sources,async(_post,app)=>{
 const input={url:app.url,staff_token:f.a.bearer,customer_token:f.customerBearer,...config,screenshot:process.env.RIFARE_ASSISTANCE_CAPTURE_DIR?process.env.RIFARE_ASSISTANCE_CAPTURE_DIR+'/'+config.scenario+'.png':null};
 const result=await new Promise<any>((resolve,reject)=>{const p=spawn('python3',['tests/browser/return_assistance_component.py'],{env:{...process.env,RIFARE_TEST_INPUT:JSON.stringify(input)},stdio:['ignore','pipe','pipe']});let out='',err='';p.stdout.on('data',v=>out+=v);p.stderr.on('data',v=>err+=v);p.on('error',reject);p.on('close',code=>resolve({code,out,err}));});
 assert.equal(result.code,0,result.err);const r=JSON.parse(result.out);assert.equal(r.passed,true);assert.deepEqual(r.direct_browser_network,[]);
 });}
test('M06-G11-BROWSER-SOURCE-UNCERTAINTY-AND-AUTHENTICATED-APPEAL',()=>usingReturns(async f=>{const q=f.quote();await component(f,{}, {scenario:'risk',case_id:'case_one',quote_id:q.id});assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_risk_reviews WHERE kind=\'appeal\'').get()!.n,1);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_receipts').get()!.n,0);}));
test('M06-G12-BROWSER-ELIGIBLE-DESTINATIONS-AND-SEPARATE-HANDLING-ESTIMATE',()=>usingQualifiedDestinations(async f=>{await component(f,{fulfillmentSource:f.fulfillmentSource},{scenario:'route',request_id:f.request.id,staff_token:f.owner.bearer});assert.equal(f.fulfillmentDb.prepare('SELECT count(*) n FROM fixture_effects').get()!.n,0);assert.equal(f.routing.read(f.a.scope,{request_id:f.request.id}).selection!.revision,1);}));
test('M06-G13-BROWSER-EXACT-TOTALS-AND-CUSTOMER-CONFIRMATION',()=>usingPrevention(async f=>{f.analyze();await component(f,{orderEditSource:f.native},{scenario:'prevention',case_id:'case_one',line_id:'line_one',variant_id:'equal'});assert.equal(f.native.order(f.original.id).total_minor,'4000');assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM edit_source_effects').get()!.n,0);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_prevention_confirmations').get()!.n,1);}));
test('M06-G14-BROWSER-EXACT-PUBLISHED-PACK-AND-SHARED-SKILL',()=>usingPolicyPack(f=>component(f,{}, {scenario:'pack',pack_id:f.packId})));
test('M06-G14-BROWSER-INPUT-CHANGE-INVALIDATES-LATE-PACK-RESPONSE',()=>usingPolicyPack(f=>component(f,{}, {scenario:'late',pack_id:f.packId})));
test('M06-G99-BROWSER-MISSING-COSTS-ARE-UNKNOWN-AND-PROFITABILITY-UNVERIFIED',()=>usingReturns(f=>{new SupportMetrics(f.kernel).freeze(f.a.scope,{id:'browser_costs',case_ids:['case_one'],starts_at:f.now(),ends_at:f.now()+60000});return component(f,{}, {scenario:'economics',cohort_id:'browser_costs'});}));
