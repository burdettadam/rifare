import test from 'node:test';import assert from 'node:assert/strict';
import { DatabaseSync } from 'node:sqlite';
import { resolutionFixture,usingResolution } from './resolution-helpers.mts';
import { oracle } from './exchange-finance-helpers.mts';
import { availableValue } from '../../packages/commerce/refund-quotes.mts';
import { canonical,contentDigest } from '../../packages/commerce/configuration-values.mts';
import { FulfillmentFixtureSource } from '../../packages/adapters/fulfillment-fixture-source.mts';
import { FulfillmentConfiguration } from '../../packages/commerce/return-fulfillment-core.mts';
import { ReplacementInventory } from '../../packages/commerce/replacement-inventory.mts';
import { ReplacementOrders } from '../../packages/commerce/replacement-orders.mts';
import { FulfillmentExecution } from '../../packages/commerce/fulfillment-execution.mts';

async function bundleFixture(){const f=await resolutionFixture({zeroFees:true}),facts=structuredClone(f.facts);facts.original_paid_minor='5000';facts.prior_refunded_minor='1000';
 for(const line of facts.paid_lines){line.tax_minor='0';line.shipping_minor='0';line.duties_minor='0';if(line.id==='alpha'){line.gross_minor='6000';line.discount_minor='3000';}if(line.id==='beta'){line.gross_minor='4000';line.discount_minor='2000';}if(line.id==='gamma'){line.gross_minor='1500';line.discount_minor='1500';}}
 facts.bundle_allocations={treatment:'preserve_original_paid',promotion_rule:'retain_remaining_components',groups:[{id:'bundle-one',promotion_id:'original-bundle-discount',original_paid_minor:'5000',components:[{line_id:'alpha',fulfillment_line_id:'gid://shopify/FulfillmentLineItem/101',paid_minor:'3000',retail_minor:'6000',promotion_role:'paid_component'},{line_id:'beta',fulfillment_line_id:'gid://shopify/FulfillmentLineItem/102',paid_minor:'2000',retail_minor:'4000',promotion_role:'paid_component'},{line_id:'gamma',fulfillment_line_id:'gid://shopify/FulfillmentLineItem/103',paid_minor:'0',retail_minor:'1500',promotion_role:'zero_price_gift'}]}]};
 f.update({resolution_facts:facts,total_minor:'5000'});f.sourceDb.prepare('UPDATE fixture_resolution_accounts SET available_minor=? WHERE resource_id=?').run('4000',f.order().id);
 f.ledger.configure(f.owner.scope,{expected_revision:1,enabled:true,source_identity:f.source.identity,credit_instrument:'native_store_credit',expires_at:f.now()+300000,inventory_buffer:2,bundle_policy:'preserve_original_paid'});
 const plan=f.allocate();return {...f,facts,plan};}
async function usingBundle(fn:(f:Awaited<ReturnType<typeof bundleFixture>>)=>unknown){const f=await bundleFixture();try{return await fn(f);}finally{f.cleanup();}}
async function freeReplacement(f:any){const db=new DatabaseSync(':memory:');try{const source=new FulfillmentFixtureSource(db,{mode:'fixture',identity:'bundle-fulfillment',tenant:f.a.tenant,store:f.a.store,clock:f.now}),configuration=new FulfillmentConfiguration(f.kernel);configuration.configure(f.owner.scope,{expected_revision:0,enabled:true,source_identity:source.identity,account_id:'bundle-warehouse',expires_at:f.now()+300000,resolution_trigger:'manual'});
 const allocation=f.plan.allocations.find((a:any)=>a.line_id==='gamma'),catalog=f.catalog({unit_price_minor:'1500',available:3}),quote=f.exchanges.quote(f.a.scope,{allocation_id:allocation.id,catalog_id:catalog.id});assert.equal(quote.quote.replacement_minor,'0');
 source.seedStock({catalog_id:catalog.id,variant_id:'shoe-large',location_id:'warehouse-one',version:1,available:3});const inventory=new ReplacementInventory(f.kernel,source),reservation=inventory.reserve(f.a.scope,{quote_id:quote.id,quote_digest:quote.digest,location_id:'warehouse-one',ttl_ms:50000});
 const replacement=new ReplacementOrders(f.kernel).quote(f.a.scope,{reservation_id:reservation.id}),preview=f.gateway.prepare(f.a.scope,replacement.proposal),approval=f.gateway.approve(f.reviewer.scope,{preview_id:preview.id,preview_digest:preview.digest}),receipt=f.gateway.execute(f.a.scope,{preview_id:preview.id,preview_digest:preview.digest,approval_id:approval.id}),execution=new FulfillmentExecution(f.kernel,source),result=await execution.dispatch(f.a.scope,receipt.fulfillment_operation_id);
 assert.equal(result.state,'created');assert.equal(result.replacement.quantity,1);assert.equal(result.replacement.allocation_id,allocation.id);assert.equal(source.stock(catalog.id).available,2);return result;
 }finally{db.close();}}

test('CASE-M06-G04-01',()=>usingBundle(async f=>{const alpha=f.plan.allocations.find(a=>a.line_id==='alpha')!,q=f.quote(alpha);assert.equal(q.quote.amount_minor,oracle.bundle.alpha_refund_minor);assert.equal(alpha.bundle_component.paid_minor,'3000');assert.equal(alpha.bundle_component.promotion_rule,'retain_remaining_components');const op=f.authorize(q);await f.executor.dispatch(f.a.scope,op.id);f.source.settle(op.id);await f.executor.reconcile(f.a.scope,op.id);assert.equal(availableValue(f.kernel,f.kernel.require(f.a.scope),f.order().id,f.facts).toString(),'3000');}));
test('CASE-M06-G04-02',()=>usingBundle(async f=>{for(const allocation of f.plan.allocations.filter(a=>a.outcome!=='exchange')){const op=f.authorize(f.quote(allocation));await f.executor.dispatch(f.a.scope,op.id);if(allocation.outcome==='refund'){f.source.settle(op.id);await f.executor.reconcile(f.a.scope,op.id);}}assert.throws(()=>f.quote(f.plan.allocations[0]),/ALLOCATION_ALREADY_AUTHORIZED/);const changed=structuredClone(f.facts);changed.prior_refunded_minor='4001';f.update({resolution_facts:changed});assert.throws(()=>availableValue(f.kernel,f.kernel.require(f.a.scope),f.order().id,changed),/REFUND_BALANCE_CONFLICT/);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,2);}));
test('CASE-M06-G04-03',async()=>{const endings=[];for(const order of [[0,1,2],[2,1,0],[1,0,2],[1,2,0],[2,0,1],[0,2,1]])await usingBundle(async f=>{for(const i of order){if(i===2){await freeReplacement(f);continue;}const op=f.authorize(f.quote(f.plan.allocations[i]));await f.executor.dispatch(f.a.scope,op.id);if(i===0){f.source.settle(op.id);await f.executor.reconcile(f.a.scope,op.id);}}const promo=f.plan.allocations.find(a=>a.line_id==='gamma')!;assert.equal(promo.components.paid_minor,oracle.bundle.gamma_paid_minor);assert.equal(promo.bundle_component.fulfillment_line_id,oracle.bundle.promo_fulfillment_line_id);endings.push(availableValue(f.kernel,f.kernel.require(f.a.scope),f.order().id,f.facts).toString());});assert.deepEqual(endings,Array(6).fill(oracle.bundle.remaining_original_minor));});
test('M06-TEST-013-BUNDLE-PAID-ALLOCATION',()=>usingBundle(f=>{assert.deepEqual(f.plan.allocations.map(a=>a.components.paid_minor),['1000','1000','0']);assert.equal(f.plan.allocated_value_minor,'2000');assert.equal(f.quote(f.plan.allocations[0]).quote.amount_minor,'1000');}));
test('M06-G04-UNAPPROVED-BUNDLE-TREATMENT-BLOCKED',()=>usingBundle(f=>{f.ledger.configure(f.owner.scope,{expected_revision:2,enabled:true,source_identity:f.source.identity,credit_instrument:'native_store_credit',expires_at:f.now()+60000,inventory_buffer:2});assert.throws(()=>f.quote(f.plan.allocations[0]),/BUNDLE_POLICY_UNAPPROVED/);}));
test('M06-G04-RETAIL-PRICE-CANNOT-REPLACE-PAID-SOURCE',()=>usingBundle(f=>{const facts=structuredClone(f.facts);facts.paid_lines[0].discount_minor='0';facts.original_paid_minor='8000';f.update({resolution_facts:facts});assert.throws(()=>f.quote(f.plan.allocations[0]),/BUNDLE_PAID_ALLOCATION_CHANGED/);}));
test('M06-G04-ZERO-PROMOTION-LINEAGE-CANNOT-BE-INVENTED',()=>usingBundle(f=>{const facts=structuredClone(f.facts);facts.bundle_allocations.groups[0].components[2].fulfillment_line_id='gid://shopify/FulfillmentLineItem/999';f.update({resolution_facts:facts});assert.throws(()=>f.quote(f.plan.allocations[0]),/BUNDLE_LINEAGE_INVALID/);}));
test('M06-G04-BUNDLE-SOURCE-EDIT-INVALIDATES-ALLOCATION',()=>usingBundle(f=>{const facts=structuredClone(f.facts);facts.bundle_allocations.groups[0].promotion_id='different-promotion';f.update({resolution_facts:facts});assert.throws(()=>f.quote(f.plan.allocations[0]),/PAID_ALLOCATION_CHANGED/);}));
test('M06-G04-FALSEY-BUNDLE-FACTS-FAIL-CLOSED',()=>usingResolution(f=>{for(const value of [null,false,0,'']){f.update({resolution_facts:{...f.facts,bundle_allocations:value}});assert.throws(f.allocate,/INVALID_INPUT/);}}));
test('M06-G04-COMPONENT-MEMBERSHIP-CANNOT-OVERLAP',()=>usingBundle(f=>{const facts=structuredClone(f.facts),another=structuredClone(facts.bundle_allocations.groups[0]);another.id='another-bundle';facts.bundle_allocations.groups.push(another);f.update({resolution_facts:facts});assert.throws(()=>f.quote(f.plan.allocations[0]),/BUNDLE_LINEAGE_INVALID/);}));
