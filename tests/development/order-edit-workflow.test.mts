import test from 'node:test';import assert from 'node:assert/strict';import {spawn} from 'node:child_process';
import {usingEdits,installEditSkill} from './order-edit-helpers.mts';import {startCommerceServer} from '../../apps/commerce-api/server.mts';
import {createOrderEditDemo} from '../../packages/development/order-edit-demo.mts';
import {contentDigest} from '../../packages/commerce/configuration-values.mts';
async function post(url:string,path:string,body:unknown,token:string){const r=await fetch(url+path,{method:'POST',headers:{authorization:'Bearer '+token,'content-type':'application/json'},body:JSON.stringify(body)});return {status:r.status,body:await r.json()};}
async function serving(f:any,fn:(url:string)=>Promise<void>){const s=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,reads:f.reads,orderEditSource:f.native});try{await fn(s.url);}finally{await s.close();}}
test('CASE-M04-G11-01 same instruction content supports different merchant action windows',async()=>{const a=createOrderEditDemo({store:'merchant_a',item_window_ms:120000}),b=createOrderEditDemo({store:'merchant_b',item_window_ms:500});try{assert.equal(a.skill_digest,b.skill_digest);assert.equal(a.edits.quote(a.operator.scope,a.intent('equal')).quote.amount_minor,'0');assert.throws(()=>b.edits.quote(b.operator.scope,b.intent('equal')),/WINDOW_CLOSED/);assert.equal(b.sourceDb.prepare('SELECT count(*) n FROM edit_source_effects').get().n,0);}finally{a.cleanup();b.cleanup();}});
test('CASE-M04-G11-02 unpaid receipt never becomes paid from optimistic caller text',()=>usingEdits(async f=>{const {workflow}=installEditSkill(f),e=f.authorize(f.quote({variant_id:'upgrade'})).order_edit_id;await f.edits.dispatch(f.a.scope,e);const p=workflow.status(f.a.scope,{case_id:'case_one'});assert.equal(p.operations[0].source.finance.state,'unpaid');assert.equal(p.operations[0].completed,false);assert.equal(p.execution_authorized,false);assert.throws(()=>workflow.quote(f.a.scope,{case_id:'case_one',intent:{kind:'cancel',line_id:null,variant_id:null,address:null,paid:true}}),/INVALID_INPUT/);}));
test('CASE-M04-G11-03 replaced runtime resumes same pinned content and uncertain edit',()=>usingEdits(async f=>{const {workflow,bundle}=installEditSkill(f),e=f.authorize().order_edit_id;f.native.fault='after';f.native.faultStage='commit';await f.edits.dispatch(f.a.scope,e);const before=workflow.status(f.a.scope,{case_id:'case_one'});assert.equal(before.handoff_required,true);const resumed=workflow.open(f.agent.scope,{case_id:'case_one',skill_digest:bundle.digest});assert.equal(resumed.operations[0].id,e);assert.equal(resumed.pin.skill_digest,bundle.digest);assert.equal(resumed.source_digest,before.source_digest);assert.equal(f.sourceDb.prepare("SELECT count(*) n FROM edit_source_effects WHERE json_extract(result,'$.stage')='commit'").get().n,1);}));
test('M04-G11-04 workflow rejects changed skill pin',()=>usingEdits(f=>{const {workflow}=installEditSkill(f);assert.throws(()=>workflow.open(f.a.scope,{case_id:'case_one',skill_digest:'0'.repeat(64)}),/WORKFLOW_PIN_CHANGED/);}));
test('M04-G11-05 cross-store caller cannot inspect an existing edit case',()=>usingEdits(f=>{const {workflow}=installEditSkill(f);assert.throws(()=>workflow.status(f.b.scope,{case_id:'case_one'}),/NOT_FOUND|ACCESS_DENIED/);}));
test('M04-G11-06 REST quote and approval create same canonical obligation with no direct write route',()=>usingEdits(async f=>{installEditSkill(f);await serving(f,async url=>{const q=await post(url,'/v1/order-edits/quote',f.intent(),f.a.bearer);assert.equal(q.status,200);const p=await post(url,'/v1/order-edits/prepare',{quote_id:q.body.id,quote_digest:q.body.digest},f.a.bearer);assert.equal(p.status,200);const a=await post(url,'/v1/execution/approve',{preview_id:p.body.id,preview_digest:p.body.digest},f.reviewer.bearer);assert.equal(a.status,200);const e=await post(url,'/v1/execution/execute',{preview_id:p.body.id,preview_digest:p.body.digest,approval_id:a.body.id},f.a.bearer);assert.equal(e.status,200);assert.ok(e.body.order_edit_id);assert.equal((await post(url,'/v1/order-edits/settle',{edit_id:e.body.order_edit_id},f.owner.bearer)).status,404);const done=await post(url,'/v1/order-edits/dispatch',{edit_id:e.body.order_edit_id},f.a.bearer);assert.equal(done.status,200);assert.equal(done.body.state,'ready_for_release');assert.equal(f.native.canPick(f.original.id,'warehouse_one'),false);});}));
test('M04-G11-07 REST rejects client tenant source and amount assertions',()=>usingEdits(async f=>{installEditSkill(f);await serving(f,async url=>{for(const extra of [{amount_minor:'0'},{source_identity:f.native.identity},{tenant_id:f.a.tenant},{approval:true}])assert.equal((await post(url,'/v1/order-edits/quote',{...f.intent(),...extra},f.a.bearer)).status,400);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM edit_source_effects').get().n,0);});}));
test('M04-G11-08 REST access disappears immediately after logout',()=>usingEdits(async f=>{installEditSkill(f);await serving(f,async url=>{assert.equal((await post(url,'/v1/edit-workflows/status',{case_id:'case_one'},f.a.bearer)).status,200);await post(url,'/v1/session/logout',{},f.a.bearer);assert.equal((await post(url,'/v1/edit-workflows/status',{case_id:'case_one'},f.a.bearer)).status,403);});}));
test('M04-G11-09 external standard-library client reads actual API without built-in runner imports',()=>usingEdits(async f=>{const {bundle}=installEditSkill(f);await serving(f,async url=>{const input={url,token:f.a.bearer,case_id:'case_one',skill_digest:bundle.digest},r=await new Promise<any>((resolve,reject)=>{const p=spawn('python3',['clients/order_edit.py'],{stdio:['pipe','pipe','pipe']});let out='',err='';p.stdout.on('data',d=>out+=d);p.stderr.on('data',d=>err+=d);p.on('error',reject);p.on('close',code=>resolve({code,out,err}));p.stdin.end(JSON.stringify(input));});assert.equal(r.code,0,r.err);const value=JSON.parse(r.out);assert.equal(value.case_id,'case_one');assert.equal(value.skill_digest,bundle.digest);assert.equal(value.model_calls,0);assert.equal(value.execution_authorized,false);});}));
test('M04-G11-10 no-source startup exposes reads but refuses to claim a qualified adapter',()=>usingEdits(async f=>{installEditSkill(f);const s=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator});try{const r=await post(s.url,'/v1/order-edits/refresh',{case_id:'case_one'},f.a.bearer);assert.equal(r.status,400);assert.equal(r.body.error,'EDIT_SOURCE_UNQUALIFIED');}finally{await s.close();}}));
test('M04-G11-11 source-backed digest changes on actual payment observation not prose',()=>usingEdits(async f=>{const {workflow}=installEditSkill(f),e=f.authorize(f.quote({variant_id:'upgrade'})).order_edit_id;await f.edits.dispatch(f.a.scope,e);const before=workflow.status(f.a.scope,{case_id:'case_one'});f.native.settle(e);const after=workflow.status(f.a.scope,{case_id:'case_one'});assert.notEqual(after.source_digest,before.source_digest);assert.equal(after.operations[0].completed,false);assert.equal(after.operations[0].source.finance.state,'settled');}));
test('M04-G11-12 direct UI assets require no provider or private session embedded',()=>usingEdits(async f=>{await serving(f,async url=>{const page=await fetch(url+'/order-edits');assert.equal(page.status,200);const html=await page.text();assert.match(html,/Synthetic diagnostic/);assert.ok(!html.includes(f.a.bearer));assert.match(page.headers.get('content-security-policy')!,/default-src 'none'/);});}));
