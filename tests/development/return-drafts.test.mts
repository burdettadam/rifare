import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync,writeFileSync} from 'node:fs';import {join} from 'node:path';import {spawn} from 'node:child_process';
import {usingExecution} from './execution-helpers.mts';import {ReturnDrafts} from '../../packages/commerce/return-drafts.mts';
import {proposeReturnDraft} from '../../packages/agent/return-draft.mts';import {startCommerceServer} from '../../apps/commerce-api/server.mts';
import {ExecutionStops} from '../../packages/commerce/execution-stops.mts';import {IntegrationReadiness,DRAFT_ACTION} from '../../packages/commerce/integration-readiness.mts';
import {loadSkillDirectory} from '../../packages/commerce/skills.mts';import {fileURLToPath} from 'node:url';
const input=(extra={})=>({case_id:'case_one',request_key:'draft-one',resolution:'refund',...extra});
async function server(f:any,fn:(server:any,call:any)=>any){const s=await startCommerceServer({kernel:f.kernel,caps:f.caps,reads:f.reads,customers:f.customers,simulator:f.simulator});
 const call=async(path:string,data:any,bearer=f.a.bearer)=>{const r=await fetch(s.url+path,{method:'POST',headers:{authorization:'Bearer '+bearer,'content-type':'application/json'},body:JSON.stringify(data)});const b=await r.json();if(!r.ok)throw new Error(b.error);return b;};try{return await fn(s,call);}finally{await s.close();}}
test('CASE-M02-G27-01',()=>usingExecution(f=>{const d=new ReturnDrafts(f.kernel),first=d.prepare(f.a.scope,input());assert.equal(first.preview.amount.minor,String(f.order().payload.total_minor));
 f.advance(1);f.publish({expected_version:1,rules:{window_days:1,require_evidence:false,excluded_tags:[],outcomes:['refund']}});f.cases.create(f.customer,{case_id:'short_window',resource_id:f.order().id,profile_id:'default',policy_id:'returns'});
 assert.throws(()=>d.prepare(f.a.scope,input({case_id:'short_window',request_key:'short'})),/POLICY_DENIED/);assert.equal(d.read(f.a.scope,'case_one').preview.policy_digest,first.preview.policy_digest);}));
test('CASE-M02-G27-02',()=>usingExecution(f=>{const d=new ReturnDrafts(f.kernel);for(const extra of [{amount_minor:'1'},{approved:true},{tenant_id:'tenant-b'},{policy:{window_days:999}}])assert.throws(()=>d.prepare(f.agent.scope,input(extra)),/INVALID_INPUT/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_return_drafts').get().n,0);}));
test('CASE-M02-G27-03',()=>usingExecution(async f=>{const d=new ReturnDrafts(f.kernel);await server(f,async(_,call)=>{const p=await proposeReturnDraft(call,input());new ExecutionStops(f.kernel).set(f.owner.scope,{action:'model.run',stopped:true,reason:'incident',expected_revision:0});const resumed=await call('/v1/return-drafts/resume',{case_id:'case_one'});assert.equal(resumed.id,p.id);assert.equal(resumed.preview.configuration_digest,p.preview.configuration_digest);const again=d.prepare(f.a.scope,input({request_key:'new-caller'}));assert.equal(again.id,p.id);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_previews').get().n,1);});}));
test('M02-G27-ONE-GATEWAY-APPROVAL-PATH',()=>usingExecution(f=>{const d=new ReturnDrafts(f.kernel),p=d.prepare(f.a.scope,input()),a=f.approve(p);const r=f.execute(p,a);assert.equal(r.financial_effect,false);assert.equal(d.read(f.a.scope,'case_one').receipt_id,r.id);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_operations').get().n,1);}));
test('M02-G27-RESOLUTION-CONFLICT',()=>usingExecution(f=>{const d=new ReturnDrafts(f.kernel);d.prepare(f.a.scope,input());assert.throws(()=>d.prepare(f.a.scope,input({resolution:'exchange'})),/DRAFT_CONFLICT/);}));
test('M02-G27-KEY-CANNOT-MOVE-CASE',()=>usingExecution(f=>{const d=new ReturnDrafts(f.kernel);d.prepare(f.a.scope,input());f.create('second_case');assert.throws(()=>d.prepare(f.a.scope,input({case_id:'second_case'})),/DRAFT_CONFLICT/);}));
test('M02-G27-CROSS-TENANT-CASE-HIDDEN',()=>usingExecution(f=>{const d=new ReturnDrafts(f.kernel);d.prepare(f.a.scope,input());assert.throws(()=>d.read(f.b.scope,'case_one'),/NOT_FOUND/);}));
test('M02-G27-FAKE-APPROVAL-REFUSED',()=>usingExecution(f=>{const d=new ReturnDrafts(f.kernel),p=d.prepare(f.a.scope,input());assert.throws(()=>f.gateway.execute(f.agent.scope,{preview_id:p.id,preview_digest:p.digest,approval_id:'fake'}),/APPROVAL_UNAVAILABLE/);assert.equal(d.read(f.a.scope,'case_one').status,'awaiting_review');}));
test('M02-G27-READINESS-REVOKED',()=>usingExecution(f=>{const d=new ReturnDrafts(f.kernel);new IntegrationReadiness(f.kernel).revoke(f.owner.scope,{action:DRAFT_ACTION});assert.throws(()=>d.prepare(f.agent.scope,input()),/INTEGRATION_NOT_READY/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_return_drafts').get().n,0);}));
test('M02-G27-DECLARED-SKILL-VALIDATES',()=>usingExecution(f=>{const bundle=loadSkillDirectory(fileURLToPath(new URL('../../packages/commerce/skill-bundles/return-draft/',import.meta.url)));f.reads.skills.install(f.a.scope,bundle);assert.equal(f.reads.skills.describe(f.a.scope,bundle.id).id,'return-draft');assert(bundle.files['SKILL.md'].includes('server computes'));}));
test('M02-G27-PORTABLE-RUNNER-NO-STORAGE-IMPORT',()=>{const source=readFileSync(new URL('../../packages/agent/return-draft.mts',import.meta.url),'utf8');assert(!/from |sqlite|\.db\.|INSERT|UPDATE/.test(source));});
test('M02-G27-SKILL-INTENT-PRICE-REJECTED',async()=>{let calls=0;await assert.rejects(()=>proposeReturnDraft(async()=>{calls++;},{...input(),amount:'1'}),/INVALID_INTENT/);assert.equal(calls,0);});
test('M02-G27-STANDARD-LIBRARY-CLIENT-RESUMES',()=>usingExecution(async f=>{const d=new ReturnDrafts(f.kernel),p=d.prepare(f.a.scope,input());await server(f,async(s)=>{const path=join(f.directory,'session.json');writeFileSync(path,JSON.stringify({operator:f.a.bearer}),{mode:0o600});const value=await new Promise<any>((resolve,reject)=>{const child=spawn('python3',['examples/external-return-draft.py','--url',s.url,'--session-file',path,'--case','case_one','--resume'],{env:{PATH:process.env.PATH},stdio:['ignore','pipe','pipe']});let out='',err='';child.stdout.on('data',b=>out+=b);child.stderr.on('data',b=>err+=b);child.on('error',reject);child.on('close',code=>{if(code!==0)reject(new Error(err));else resolve(JSON.parse(out));});});assert.equal(value.id,p.id);assert.equal(value.preview.configuration_digest,p.preview.configuration_digest);});}));
test('M02-G27-MANUAL-PAGE-AND-CONTRACT',()=>usingExecution(async f=>{await server(f,async(s)=>{const html=await(await fetch(s.url+'/return-draft')).text();assert(html.includes('id="resume"'));const js=await(await fetch(s.url+'/return-draft-client.js')).text();assert(js.includes('/v1/return-drafts/prepare'));assert(js.includes('/v1/execution/approve'));assert(!js.includes('localStorage'));});}));
test('M02-G27-EXACT-PREVIEW-RECHECK',()=>usingExecution(f=>{const d=new ReturnDrafts(f.kernel),p=d.prepare(f.a.scope,input()),a=f.approve(p),r=f.order();f.kernel.ingest(f.a.scope,{kind:r.kind,source_system:r.source_system,external_id:r.external_id,source_version:r.source_version+1,source_updated_at:f.now(),customer_id:r.customer_id,payload:{...r.payload,total_minor:1}});assert.throws(()=>f.execute(p,a),/PREVIEW_STALE/);assert.equal(f.db.prepare('SELECT uses FROM commerce_action_approvals').get().uses,0);}));
