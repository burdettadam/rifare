import test from 'node:test';import assert from 'node:assert/strict';import {spawn} from 'node:child_process';import {usingCompletion} from './completion-helpers.mts';import {startCommerceServer} from '../../apps/commerce-api/server.mts';
async function run(scenario:string){return usingCompletion(async f=>{f.full();const s=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator});try{const r=await new Promise<any>((resolve,reject)=>{const p=spawn('python3',['tests/browser/return_completion_component.py'],{env:{...process.env,RIFARE_TEST_INPUT:JSON.stringify({scenario,url:s.url,token:f.a.bearer,request_id:f.request.id,skill_digest:f.bundles['handle-return'].digest,screenshot:scenario==='keyboard'?process.env.RIFARE_COMPLETION_SCREENSHOT:undefined})},stdio:['ignore','pipe','pipe']});let out='',err='';p.stdout.on('data',v=>out+=v);p.stderr.on('data',v=>err+=v);p.on('error',reject);p.on('close',code=>resolve({code,out,err}));});assert.equal(r.code,0,r.err);assert.equal(JSON.parse(r.out).passed,true);assert.deepEqual(JSON.parse(r.out).direct_browser_network,[]);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);}finally{await s.close();}});}
test('M03-COMPLETION-BROWSER-KEYBOARD-STATUS-QUOTE',()=>run('keyboard'));
test('M03-COMPLETION-BROWSER-STALE-QUOTE-CLEARED',()=>run('late'));
