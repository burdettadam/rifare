import test from 'node:test';import assert from 'node:assert/strict';
import { usingResolution } from './resolution-helpers.mts';
import { startCommerceServer } from '../../apps/commerce-api/server.mts';
import { PrivacyLifecycle } from '../../packages/commerce/privacy-lifecycle.mts';
async function server(f:any,fn:(post:any)=>unknown,source=true){const app=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,reads:f.reads,...(source?{resolutionSource:f.source}:{})});try{return await fn(async(path:string,input:any,bearer=f.a.bearer)=>{const r=await fetch(app.url+path,{method:'POST',headers:{'content-type':'application/json',authorization:'Bearer '+bearer},body:JSON.stringify(input)});return {status:r.status,body:await r.json()};});}finally{await app.close();}}
test('M03-G08-HTTP-APPROVAL-THEN-SYNTHETIC-DISPATCH',()=>usingResolution(async f=>{await server(f,async post=>{const p=(await post('/v1/resolutions/allocate',f.intent())).body,q=(await post('/v1/resolutions/quote',{allocation_id:p.allocations[0].id})).body,pv=(await post('/v1/execution/preview',q.proposal)).body;
 const a=(await post('/v1/execution/approve',{preview_id:pv.id,preview_digest:pv.digest},f.reviewer.bearer)).body,r=(await post('/v1/execution/execute',{preview_id:pv.id,preview_digest:pv.digest,approval_id:a.id})).body;
 const result=await post('/v1/resolutions/dispatch',{operation_id:r.resolution_operation_id});assert.equal(result.status,200);assert.equal(result.body.state,'accepted');assert.equal(result.body.cash_settled,false);});}));
test('M03-G08-HTTP-NO-DEFAULT-FINANCIAL-SOURCE',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));await server(f,async post=>{const r=await post('/v1/resolutions/dispatch',{operation_id:op.id});assert.equal(r.body.error,'ADAPTER_UNAVAILABLE');assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);},false);}));
test('M03-G07-HTTP-CLIENT-AMOUNT-REJECTED',()=>usingResolution(async f=>{const p=f.allocate();await server(f,async post=>{const r=await post('/v1/resolutions/quote',{allocation_id:p.allocations[0].id,amount_minor:'99999'});assert.equal(r.status,400);assert.equal(r.body.error,'INVALID_INPUT');});}));
test('M03-G06-HTTP-CUSTOMER-NO-ALLOCATION-AUTHORITY',()=>usingResolution(async f=>{await server(f,async post=>assert.equal((await post('/v1/resolutions/allocate',f.intent(),f.customerBearer)).status,403));}));
test('M03-G06-HTTP-CROSS-STORE-PLAN-HIDDEN',()=>usingResolution(async f=>{const p=f.allocate();await server(f,async post=>assert.equal((await post('/v1/resolutions/plan',{plan_id:p.id},f.b.bearer)).status,404));}));
test('M03-G06-PRIVACY-REDACTS-ALLOCATION-CONTENT',()=>usingResolution(f=>{const p=f.allocate(),q=f.quote(p.allocations[0]),customer=f.order().customer_id;new PrivacyLifecycle(f.kernel).erase(f.owner.scope,customer);const b=f.db.prepare('SELECT body FROM commerce_resolution_allocations LIMIT 1').get() as any;assert.equal(JSON.parse(b.body).redacted,true);assert(!b.body.includes(customer));assert.throws(()=>f.ledger.read(f.a.scope,p.id),/SUBJECT_ERASED/);assert.throws(()=>f.quotes.read(f.a.scope,q.id),/SUBJECT_ERASED/);}));
test('M03-G10-HTTP-EXCHANGE-COMMIT-UNAVAILABLE',()=>usingResolution(async f=>{await server(f,async post=>assert.equal((await post('/v1/resolutions/exchange-commit',{})).status,404));}));
