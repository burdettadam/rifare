import test from 'node:test';import assert from 'node:assert/strict';
import { usingExecution } from './execution-helpers.mts';import { PrivacyLifecycle,storageInventory } from '../../packages/commerce/privacy-lifecycle.mts';
import { subjectHash } from '../../packages/commerce/data-guards.mts';
import { OperationReceipts } from '../../packages/commerce/operation-receipts.mts';
const setup=(f:any)=>{const resource=f.order(),customer=resource.customer_id,p=new PrivacyLifecycle(f.kernel);
 f.kernel.attach(f.a.scope,resource.id,{name:'SYNTHETIC-PRIVATE-NAME'});f.reads.knowledge.put(f.a.scope,f.source({resource_id:resource.id,content:'SYNTHETIC-PRIVATE-NAME support note'}));
 f.reads.profiles.put(f.a.scope,f.profile(f.a,{id:'task-profile'}));const task=f.reads.createTask(f.a.scope,{order_id:resource.id,profile_id:'task-profile'});
 return {p,resource,customer,task};};
test('CASE-M02-G24-01',()=>usingExecution(f=>{const x=setup(f),e=x.p.export(f.owner.scope,x.customer);assert.equal(e.attachments.length,1);assert.equal(e.knowledge.length,1);assert.equal(e.credentials_included,false);assert(!JSON.stringify(e).includes(f.b.store));
 const r=x.p.erase(f.owner.scope,x.customer);assert.equal(r.status,'logically_erased');for(const table of ['commerce_attachments','commerce_read_jobs','commerce_knowledge','commerce_context_tasks'])assert.equal(f.db.prepare(`SELECT count(*) n FROM ${table} WHERE store_id=?`).get(f.a.store).n,0);assert.throws(()=>f.kernel.get(f.a.scope,x.resource.id),/SUBJECT_ERASED/);}));
test('CASE-M02-G24-02',()=>usingExecution(f=>{const x=setup(f);assert.throws(()=>x.p.export(f.b.scope,x.customer),/ACCESS_DENIED/);x.p.hold(f.owner.scope,{customer_id:x.customer,reason:'dispute',authority_ref:'hold-one',expires_at:f.now()+10000});assert.equal(x.p.erase(f.owner.scope,x.customer).status,'held');assert.equal(f.kernel.get(f.a.scope,x.resource.id).id,x.resource.id);}));
test('CASE-M02-G24-03',()=>usingExecution(f=>{const x=setup(f),before=x.resource;x.p.erase(f.owner.scope,x.customer);assert.throws(()=>f.kernel.ingest(f.a.scope,{kind:before.kind,source_system:before.source_system,external_id:before.external_id,source_version:before.source_version+1,source_updated_at:f.now(),customer_id:x.customer,payload:before.payload}),/SUBJECT_ERASED/);
 assert.throws(()=>f.reads.knowledge.put(f.a.scope,f.source({resource_id:before.id})),/SUBJECT_ERASED/);assert.equal(f.reads.knowledge.search(f.a.scope,'SYNTHETIC-PRIVATE-NAME').sources.length,0);}));
test('M02-G24-NEW-RESOURCE-SAME-SUBJECT-DENIED',()=>usingExecution(f=>{const x=setup(f);x.p.erase(f.owner.scope,x.customer);assert.throws(()=>f.kernel.ingest(f.a.scope,{kind:'order',source_system:'synthetic',external_id:'NEW-ORDER',source_version:1,source_updated_at:f.now(),customer_id:x.customer,payload:{note:'SYNTHETIC-PRIVATE-NAME'}}),/SUBJECT_ERASED/);}));
test('M02-G24-OTHER-STORE-PRESERVED',()=>usingExecution(f=>{const x=setup(f),other=f.kernel.list(f.b.scope,'order');x.p.erase(f.owner.scope,x.customer);assert.deepEqual(f.kernel.list(f.b.scope,'order'),other);}));
test('M02-G24-CUSTOMER-SESSION-INVALIDATED',()=>usingExecution(f=>{const x=setup(f);x.p.erase(f.owner.scope,x.customer);assert.throws(()=>f.kernel.require(f.customer),/ACCESS_DENIED/);}));
test('M02-G24-CASE-AND-APPROVAL-DISABLED',()=>usingExecution(f=>{const x=setup(f),p=f.preview(),a=f.approve(p);x.p.erase(f.owner.scope,x.customer);assert.throws(()=>f.execute(p,a),/SUBJECT_ERASED/);assert.equal(f.db.prepare('SELECT revoked FROM commerce_action_approvals').get().revoked,1);}));
test('M02-G24-HOLD-RELEASE-REQUIRES-REFERENCE',()=>usingExecution(f=>{const x=setup(f);x.p.hold(f.owner.scope,{customer_id:x.customer,reason:'investigation',authority_ref:'hold-one',expires_at:f.now()+1000});assert.throws(()=>x.p.releaseHold(f.owner.scope,x.customer,'different'),/HOLD_NOT_FOUND/);x.p.releaseHold(f.owner.scope,x.customer,'hold-one');assert.equal(x.p.erase(f.owner.scope,x.customer).status,'logically_erased');}));
test('M02-G24-HOLD-EXPIRY',()=>usingExecution(f=>{const x=setup(f);x.p.hold(f.owner.scope,{customer_id:x.customer,reason:'dispute',authority_ref:'short',expires_at:f.now()+100});f.advance(101);assert.equal(x.p.erase(f.owner.scope,x.customer).status,'logically_erased');}));
test('M02-G24-IDEMPOTENT-ERASURE',()=>usingExecution(f=>{const x=setup(f);x.p.erase(f.owner.scope,x.customer);assert.equal(x.p.erase(f.owner.scope,x.customer).status,'already_erased');}));
test('M02-G24-NEW-TABLE-FAILS-INVENTORY',()=>usingExecution(f=>{f.db.exec('CREATE TABLE unregistered_private_cache(value TEXT)');assert.throws(()=>storageInventory(f.kernel),/STORAGE_INVENTORY_CHANGED/);}));
test('M02-G24-NEW-COLUMN-FAILS-INVENTORY',()=>usingExecution(f=>{f.db.exec('ALTER TABLE commerce_resources ADD COLUMN hidden_copy TEXT');assert.throws(()=>new PrivacyLifecycle(f.kernel).erase(f.owner.scope,f.order().customer_id),/STORAGE_INVENTORY_CHANGED/);}));
test('M02-G24-DATABASE-REIMPORT-GUARD',()=>usingExecution(f=>{const x=setup(f);x.p.erase(f.owner.scope,x.customer);assert.throws(()=>f.db.prepare('UPDATE commerce_resources SET payload=? WHERE id=?').run('{"copy":"SYNTHETIC-PRIVATE-NAME"}',x.resource.id),/SUBJECT_ERASED/);}));
test('M02-G24-UNATTRIBUTED-KNOWLEDGE-CONSERVATIVE-PURGE',()=>usingExecution(f=>{const x=setup(f);f.reads.knowledge.put(f.a.scope,f.source({id:'unbound',content:'SYNTHETIC-PRIVATE-NAME'}));const r=x.p.erase(f.owner.scope,x.customer);assert(r.collateral_cleanup.includes('unbound_store_knowledge'));assert.equal(f.reads.knowledge.search(f.a.scope,'SYNTHETIC-PRIVATE-NAME').sources.length,0);}));
test('M02-G24-RECEIPT-NOTES-ERASED-AUDIT-RETAINED',()=>usingExecution(f=>{const x=setup(f),p=f.preview(),a=f.approve(p);f.execute(p,a);const receipt=f.db.prepare('SELECT id FROM commerce_operation_receipts LIMIT 1').get().id;new OperationReceipts(f.kernel).attach(f.owner.scope,{receipt_id:receipt,subject_ref:x.customer,kind:'customer_note',content:'SYNTHETIC-PRIVATE-NAME',expires_at:f.now()+10000});x.p.erase(f.owner.scope,x.customer);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_receipt_payloads').get().n,0);assert(f.db.prepare('SELECT count(*) n FROM commerce_operation_receipts').get().n>0);}));
test('M02-G24-UNINSTALL-STOPS-STORE',()=>usingExecution(f=>{const x=setup(f),before=f.kernel.list(f.b.scope,'order'),r=x.p.uninstall(f.owner.scope);assert.equal(r.status,'disconnected');assert.throws(()=>f.kernel.require(f.a.scope),/ACCESS_DENIED/);assert.deepEqual(f.kernel.list(f.b.scope,'order'),before);}));
test('M02-G24-EXPORT-LINKED-OPERATION-HISTORY',()=>usingExecution(f=>{const x=setup(f),p=f.preview(),a=f.approve(p);f.execute(p,a);const receipt=f.db.prepare('SELECT id FROM commerce_operation_receipts LIMIT 1').get().id;new OperationReceipts(f.kernel).attach(f.owner.scope,{receipt_id:receipt,subject_ref:x.customer,kind:'customer_note',content:'SYNTHETIC-PRIVATE-NAME',expires_at:f.now()+10000});const exported=x.p.export(f.owner.scope,x.customer);assert.equal(exported.cases.length,1);assert.equal(exported.previews.length,1);assert.equal(exported.operations.length,1);assert(exported.audit_receipts.length>0);assert.equal(exported.customer_notes.length,1);assert.equal(exported.credentials_included,false);}));
