import test from 'node:test';
import assert from 'node:assert/strict';
import {readFileSync,readdirSync} from 'node:fs';
import {DatabaseSync} from 'node:sqlite';
import {contentDigest,canonical} from '../../packages/commerce/configuration-values.mts';
import {usingWooRefund} from './woocommerce-refund-helpers.mts';
import {WooRefundFixtureSource} from '../../packages/adapters/woocommerce/refund-fixture-source.mts';
import {WooRefundGatewayFixture} from '../../packages/adapters/woocommerce/refund-gateway-fixture.mts';
import {ResolutionExecution} from '../../packages/commerce/resolution-execution.mts';
import {ExecutionStops} from '../../packages/commerce/execution-stops.mts';

const expected=JSON.parse(readFileSync(new URL('../fixtures/woocommerce/refund-ledger.v1.json',import.meta.url),'utf8'));
const count=(db:DatabaseSync,table:string)=>db.prepare('SELECT count(*) n FROM '+table).get()!.n;
function oracle(f:any,result:any,stage:'manual'|'accepted'|'settled'){const e=expected[stage];assert.equal(result.state,e.state);assert.equal(result.cash_settled,e.cash_settled);assert.equal(count(f.sourceDb,'fixture_woo_refund_records'),e.record_count);assert.equal(count(f.gatewayDb,'fixture_woo_gateway_refunds'),e.gateway_refunds);assert.equal(count(f.gatewayDb,'fixture_woo_gateway_movements'),e.gateway_movements);assert.equal(result.live_financial_effect,false);}
test('CASE-M07-G02-01',()=>usingWooRefund(async f=>{const op=f.approved(),accepted=await f.executor.dispatch(f.a.scope,op.id);oracle(f,accepted,'accepted');const proof=f.source.inspect(op.id)!;
 assert.equal(proof.refund_record.parent_id,Number(expected.original_order_id));assert.equal(proof.command.payment_id,'woo_payment_17');assert.equal(proof.gateway_effect.transaction_id,expected.original_transaction_id);assert.equal(proof.gateway_effect.instrument_id,expected.original_instrument_id);assert.equal(proof.command.amount_minor,expected.one_unit_refund_minor);assert.equal(proof.command.currency,expected.currency);assert.equal(proof.command.native_return_id,null);assert.equal(accepted.native_id,String(proof.refund_record.id));assert.equal(proof.command_digest,f.db.prepare('SELECT digest FROM commerce_resolution_operations WHERE id=?').get(op.id)!.digest);
 f.advance(1);f.gatewaySource.settle(op.id);const settled=await f.executor.reconcile(f.a.scope,op.id);oracle(f,settled,'settled');assert.equal(settled.native_id,accepted.native_id);assert.equal(settled.woo_evidence.gateway_refund_id,proof.gateway_effect.id);assert.equal(settled.financial_stage,'fixture_gateway_settled');assert.equal(count(f.db,'commerce_native_return_operations'),0);
}));
test('CASE-M07-G02-02',()=>usingWooRefund(async f=>{const op=f.approved(),result=await f.executor.dispatch(f.a.scope,op.id);oracle(f,result,'manual');assert.equal(result.manual_external_settlement_pending,true);assert.equal(result.woo_evidence.refunded_payment,false);assert.equal(f.ledger.read(f.a.scope,op.plan.id).remaining_obligation_minor,'1000');await f.executor.reconcile(f.a.scope,op.id);oracle(f,f.executor.read(f.a.scope,op.id),'manual');},{manual:true}));
test('CASE-M07-G02-03',()=>usingWooRefund(async f=>{const op=f.approved(),issue=f.source.issue.bind(f.source);let sends=0;f.source.issue=async value=>{sends++;await issue(value);throw new Error('fixture_response_lost_after_gateway_acceptance');};
 assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');assert.equal(sends,1);assert.equal(count(f.db,'commerce_resolution_operations'),expected.timeout.business_operations);assert.equal(count(f.gatewayDb,'fixture_woo_gateway_refunds'),expected.timeout.gateway_refunds);const result=await f.executor.reconcile(f.a.scope,op.id);oracle(f,result,'accepted');assert.equal(result.retry_allowed,expected.timeout.reissue_allowed);assert.equal(result.id,op.id);
}));
test('M07-G02-PORT-019',()=>usingWooRefund(async f=>{const op=f.approved();await f.executor.dispatch(f.a.scope,op.id);const proof=f.source.inspect(op.id)!;assert.equal(proof.refund_record.refunded_payment,false);assert.equal(proof.gateway_effect,null);assert.equal(f.source.result(op.id)!.state,expected.manual.state);assert.equal(f.executor.read(f.a.scope,op.id).cash_settled,false);assert.equal(f.source.result(op.id)!.woo_evidence.gateway_settled,false);},{manual:true}));
test('M07-G02-GATEWAY-BOOLEAN-IS-NOT-SETTLEMENT',()=>usingWooRefund(async f=>{const op=f.approved(),r=await f.executor.dispatch(f.a.scope,op.id);assert.equal(r.woo_evidence.refunded_payment,true);assert.equal(r.woo_evidence.gateway_settled,false);assert.equal(r.cash_settled,false);assert.equal(count(f.gatewayDb,'fixture_woo_gateway_movements'),0);}));
test('M07-G02-SOURCE-RESULT-CANNOT-INVENT-SETTLEMENT',()=>usingWooRefund(async f=>{const op=f.approved(),issue=f.source.issue.bind(f.source);f.source.issue=async value=>({...await issue(value),state:'settled'});assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');oracle(f,await f.executor.reconcile(f.a.scope,op.id),'accepted');}));
test('M07-G02-MANUAL-RECORD-FORGED-GATEWAY-FLAG-REJECTED',()=>usingWooRefund(async f=>{const op=f.approved();await f.executor.dispatch(f.a.scope,op.id);const row=f.sourceDb.prepare('SELECT body FROM fixture_woo_refund_records WHERE operation_id=?').get(op.id)!,forged={...JSON.parse(row.body as string),refunded_payment:true};f.sourceDb.prepare('UPDATE fixture_woo_refund_records SET body=?,digest=? WHERE operation_id=?').run(canonical(forged),contentDigest(forged),op.id);assert.throws(()=>f.source.inspect(op.id),/WOO_REFUND_RECORD_MISMATCH/);assert.equal(f.executor.read(f.a.scope,op.id).cash_settled,false);},{manual:true}));
test('M07-G02-GATEWAY-SETTLED-REQUIRES-INDEPENDENT-MOVEMENT',()=>usingWooRefund(async f=>{const op=f.approved();await f.executor.dispatch(f.a.scope,op.id);const row=f.gatewayDb.prepare('SELECT body FROM fixture_woo_gateway_refunds WHERE operation_id=?').get(op.id)!,forged={...JSON.parse(row.body as string),state:'settled',settled:true};f.gatewayDb.prepare('UPDATE fixture_woo_gateway_refunds SET body=?,digest=? WHERE operation_id=?').run(canonical(forged),contentDigest(forged),op.id);assert.throws(()=>f.source.inspect(op.id),/WOO_GATEWAY_SOURCE_MISSING|WOO_GATEWAY_SETTLEMENT_UNVERIFIED/);assert.equal(f.executor.read(f.a.scope,op.id).cash_settled,false);}));
test('M07-G02-NATIVE-BALANCE-REJECTS-OVERREFUND',()=>usingWooRefund(async f=>{const op=f.approved(),result=await f.executor.dispatch(f.a.scope,op.id);assert.equal(result.state,'rejected');assert.equal(result.native_id,null);assert.equal(result.cash_settled,false);assert.equal(count(f.sourceDb,'fixture_woo_refund_records'),0);assert.equal(count(f.gatewayDb,'fixture_woo_gateway_movements'),0);assert.equal(f.ledger.read(f.a.scope,op.plan.id).remaining_obligation_minor,'1000');},{gatewayPriorRefunded:'1500'}));
test('M07-G02-PAYMENT-INSTRUMENT-AND-PINS-ARE-RECHECKED',()=>usingWooRefund(async f=>{const op=f.approved(),command=JSON.parse(f.db.prepare('SELECT command FROM commerce_resolution_operations WHERE id=?').get(op.id)!.command as string);
 for(const field of ['customer_id','payment_id','currency','source_identity','tenant_id','store_id']){const changed={...command,[field]:field==='currency'?'EUR':'different'};await assert.rejects(()=>f.source.issue(changed));}
 for(const [field,value] of [['gateway_account_id','different'],['gateway_identity','different'],['api_version','wc/v2'],['contract_digest','0'.repeat(64)]])await assert.rejects(()=>f.source.issue({...command,woo_refund:{...command.woo_refund,[field]:value}}));
 await assert.rejects(()=>f.source.issue({...command,routes:[{...command.routes[0],instrument_id:'different'}]}));assert.equal(count(f.gatewayDb,'fixture_woo_gateway_refunds'),0);oracle(f,await f.executor.dispatch(f.a.scope,op.id),'accepted');
}));
test('M07-G02-MISSING-HISTORY-BLOCKS-BEFORE-AUTHORIZATION',()=>usingWooRefund(f=>{assert.throws(()=>f.publish(input=>{input.financial_contract.history_complete=false;}),/WOO_PAYMENT_HISTORY_UNVERIFIED/);f.returnSourceDb.prepare('DELETE FROM woo_fixture_order_versions WHERE native_order_id=?').run('17');assert.throws(()=>f.approved(),/WOO_SOURCE_UNAVAILABLE/);assert.equal(count(f.gatewayDb,'fixture_woo_gateway_refunds'),0);}));
test('M07-G02-SOURCE-UNKNOWN-WITH-NO-EFFECT-CANNOT-RETRY',()=>usingWooRefund(async f=>{const op=f.approved();let sends=0;f.source.issue=async()=>{sends++;throw new Error('fixture_unknown_before_send');};await f.executor.dispatch(f.a.scope,op.id);await f.executor.dispatch(f.a.scope,op.id);await f.executor.reconcile(f.a.scope,op.id);assert.equal(sends,1);assert.equal(f.executor.read(f.a.scope,op.id).state,'unknown');assert.equal(count(f.gatewayDb,'fixture_woo_gateway_refunds'),0);}));
test('M07-G02-GATEWAY-ACCEPTED-WITHOUT-WOO-RECORD-STAYS-UNSETTLED',()=>usingWooRefund(async f=>{const op=f.approved(),refund=f.gatewaySource.refund.bind(f.gatewaySource);f.gatewaySource.refund=async value=>{await refund(value);throw new Error('gateway_response_lost_before_store_record');};assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');const r=await f.executor.reconcile(f.a.scope,op.id);assert.equal(r.state,'accepted');assert.equal(r.native_id,null);assert.equal(r.cash_settled,false);assert.equal(r.financial_stage,'gateway_effect_store_record_missing');f.gatewaySource.settle(op.id);assert.equal((await f.executor.reconcile(f.a.scope,op.id)).cash_settled,false);assert.equal(count(f.gatewayDb,'fixture_woo_gateway_refunds'),1);assert.equal(count(f.sourceDb,'fixture_woo_refund_records'),0);}));
test('M07-G02-REVOKED-APPROVAL-AND-STOP-BLOCK-SEND',()=>usingWooRefund(async f=>{const op=f.approved();f.gateway.revokeApproval(f.reviewer.scope,op.approval.id);await assert.rejects(()=>f.executor.dispatch(f.a.scope,op.id),/APPROVAL_AUTHORITY_CHANGED/);new ExecutionStops(f.kernel).set(f.owner.scope,{action:'diagnostic.return.resolve',stopped:true,reason:'incident',expected_revision:0});await assert.rejects(()=>f.executor.dispatch(f.a.scope,op.id));assert.equal(count(f.gatewayDb,'fixture_woo_gateway_refunds'),0);}));
test('M07-G02-TENANT-AND-CUSTOMER-AUTHORITY-PRESERVED',()=>usingWooRefund(async f=>{const op=f.approved();assert.throws(()=>f.executor.read(f.b.scope,op.id),/NOT_FOUND/);await assert.rejects(()=>f.executor.dispatch(f.customer,op.id),/ACCESS_DENIED/);assert.equal(count(f.gatewayDb,'fixture_woo_gateway_refunds'),0);}));
test('M07-G02-THREE-INDEPENDENT-DATABASES-REQUIRED',()=>usingWooRefund(f=>{assert.throws(()=>new WooRefundFixtureSource(f.gatewayDb,f.gatewaySource,f.sourceOptions,f.now),/SEPARATE_WOO_GATEWAY_SOURCE_REQUIRED/);const db=new DatabaseSync(':memory:');try{const gateway=new WooRefundGatewayFixture(f.db,f.gatewayOptions,f.now),source=new WooRefundFixtureSource(db,gateway,f.sourceOptions,f.now);assert.throws(()=>new ResolutionExecution(f.kernel,source),/SEPARATE_WOO_GATEWAY_SOURCE_REQUIRED/);}finally{db.close();}}));
test('M07-G02-MIGRATION-PRESERVES-ALL-PRIOR-OPERATION-STATES',()=>{const db=new DatabaseSync(':memory:');try{const directory=new URL('../../migrations/commerce/',import.meta.url);for(const name of readdirSync(directory).filter(name=>name.endsWith('.sql')&&name<'031_').sort())db.exec(readFileSync(new URL(name,directory),'utf8'));
 const states=['authorized','unknown','accepted','settled','issued','rejected','unpaid','partial','failed','expired'];for(const [n,state] of states.entries())db.prepare('INSERT INTO commerce_resolution_operations VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)').run('tenant','store','op'+n,'allocation'+n,'case','resource','receipt'+n,'quote'+n,n===4?'store_credit':n>5?'additional_payment':'refund','1234','USD','source','{"original":"preserved"}','digest',state,'native'+n,123456);
 const before=db.prepare('SELECT * FROM commerce_resolution_operations ORDER BY id').all();db.exec(readFileSync(new URL('031_woocommerce_refund_state.sql',directory),'utf8'));assert.deepEqual(db.prepare('SELECT * FROM commerce_resolution_operations ORDER BY id').all(),before);assert.equal(db.prepare("SELECT name FROM sqlite_master WHERE type='index' AND name='commerce_resolution_operations_order'").get()!.name,'commerce_resolution_operations_order');
 assert.throws(()=>db.exec("UPDATE commerce_resolution_operations SET state='paid' WHERE id='op0'"),/CHECK/);assert.throws(()=>db.exec("UPDATE commerce_resolution_operations SET allocation_id='allocation0' WHERE id='op1'"),/UNIQUE/);assert.throws(()=>db.exec("UPDATE commerce_resolution_operations SET native_id='native0' WHERE id='op1'"),/UNIQUE/);db.exec("UPDATE commerce_resolution_operations SET state='manual_external_settlement_pending' WHERE id='op0'");assert.equal(db.prepare("SELECT state FROM commerce_resolution_operations WHERE id='op0'").get()!.state,expected.manual.state);
 }finally{db.close();}});
