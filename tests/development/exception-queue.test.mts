import test from 'node:test';import assert from 'node:assert/strict';import { usingControls } from './worker-controls-helpers.mts';
import { ExceptionQueue } from '../../packages/commerce/exception-queue.mts';import { startCommerceServer } from '../../apps/commerce-api/server.mts';

test('M02-G22-DISTINGUISH-KNOWN-FAILURE-AND-UNKNOWN',()=>usingControls(async f=>{const a=f.executeOperation().op;f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,a.id,f.journal);const b=f.extraOperation(1);f.journal.arm('reject');await f.work.dispatch(f.a.scope,b.id,f.journal);const q=f.queue.list(f.a.scope);assert.equal(q.items.find(i=>i.operation_id===a.id).state,'unknown');assert.equal(q.items.find(i=>i.operation_id===b.id).state,'failed');assert.equal(q.items.find(i=>i.operation_id===b.id).reason,'known_failure');}));
test('M02-G22-UNKNOWN-RETRY-NEVER-ENABLED',()=>usingControls(async f=>{const a=f.executeOperation().op;f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,a.id,f.journal);const item=f.queue.list(f.a.scope).items[0];assert.equal(item.actions.find(a=>a.name==='retry').enabled,false);assert.equal(item.actions.find(a=>a.name==='reconcile').enabled,true);assert.equal(item.actions.find(a=>a.name==='reauthorize').enabled,false);}));
test('M02-G22-RECONCILE-NOT-RESEND',()=>usingControls(async f=>{const a=f.executeOperation().op;f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,a.id,f.journal);const r=await f.queue.reconcile(f.a.scope,a.id);assert.equal(r.operation.state,'succeeded');assert.equal(f.journal.count(),1);assert.equal(f.queue.list(f.a.scope).items.length,0);}));
test('M02-G22-OWNER-HANDOFF-PERSISTENT',()=>usingControls(async f=>{const a=f.executeOperation().op;f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,a.id,f.journal);f.claim();f.advance(1001);const w=f.claim(f.a.worker);const r=f.reopen();try{const q=new ExceptionQueue(r.kernel).list(r.scope);assert.equal(q.items[0].owner,'worker');assert.equal(q.items[0].generation,w.lease.generation);assert.ok(q.items[0].timeline.some(t=>t.code==='work_claimed'));assert.equal(q.items[0].state,'unknown');}finally{r.db.close();}}));
test('M02-G22-NO-CROSS-TENANT-EXCEPTIONS',()=>usingControls(f=>{f.executeOperation();assert.equal(f.queue.list(f.b.scope).items.length,0);}));
test('M02-G22-AGENT-CANNOT-INSPECT-OPERATOR-QUEUE',()=>usingControls(f=>{f.executeOperation();assert.throws(()=>f.queue.list(f.agent.scope),/ACCESS_DENIED/);}));
test('M02-G22-EXPIRED-SENDING-IS-UNKNOWN-NOT-FAILED',()=>usingControls(f=>{const {op}=f.executeOperation(),claim=f.work.claim(f.a.scope,op.id,10)!;f.work.beginSend(f.a.scope,op.id,claim.lease_token);f.advance(11);assert.equal(f.queue.list(f.a.scope).items[0].state,'unknown');}));
test('M02-G22-UNKNOWN-NO-TRUSTED-SOURCE-NO-RECONCILE',()=>usingControls(async f=>{const {op}=f.executeOperation();f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,op.id,f.journal);const q=new ExceptionQueue(f.kernel);assert.equal(q.list(f.a.scope).items[0].actions.find(a=>a.name==='reconcile').enabled,false);await assert.rejects(q.reconcile(f.a.scope,op.id),/SOURCE_UNAVAILABLE/);}));
test('M02-G22-RECONCILIATION-RECHECKS-PERMISSION',()=>usingControls(async f=>{const {op}=f.executeOperation();f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,op.id,f.journal);f.permissions.change(f.owner.scope,{actor_id:'operator',role:'operator',expected_revision:0,actions:['exception.read','operation.read','resource.read','audit.read'],resource_ids:null});assert.equal(f.queue.list(f.a.scope).items[0].actions.find(a=>a.name==='reconcile').enabled,false);await assert.rejects(f.queue.reconcile(f.a.scope,op.id),/ACCESS_DENIED/);}));
test('M02-G22-QUEUE-REAUTHORIZATION-IS-OWNER-ONLY',()=>usingControls(f=>{const {op}=f.executeOperation();f.stops.setGlobal({stopped:true,reason:'incident',expected_revision:0});f.stops.setGlobal({stopped:false,reason:'reviewed_resume',expected_revision:1});assert.equal(f.queue.list(f.a.scope).items[0].actions.find(a=>a.name==='reauthorize').enabled,false);assert.equal(f.queue.list(f.owner.scope).items[0].actions.find(a=>a.name==='reauthorize').enabled,true);assert.throws(()=>f.queue.reauthorize(f.a.scope,op.id,op.revision),/ACCESS_DENIED/);}));
test('M02-G22-STALE-CASE-WITHOUT-OPERATION-VISIBLE',()=>usingControls(f=>{f.claim();f.advance(1001);const item=f.queue.list(f.a.scope).items[0];assert.equal(item.operation_id,null);assert.equal(item.reason,'worker_lease_expired');assert.equal(item.owner,null);assert.equal(item.previous_owner,'agent');}));
test('M02-G22-STOP-REASON-VISIBLE',()=>usingControls(f=>{f.executeOperation();f.stops.setGlobal({stopped:true,reason:'incident',expected_revision:0});const item=f.queue.list(f.a.scope).items[0];assert.equal(item.reason,'execution_stopped');assert.equal(item.actions.find(a=>a.name==='reauthorize').enabled,false);}));
test('M02-G22-HTTP-HAS-NO-RETRY-ROUTE',()=>usingControls(async f=>{const {op}=f.executeOperation(),s=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,reconciliationJournals:()=>f.journal});try{const r=await fetch(s.url+'/v1/exceptions/'+op.id+'/retry',{method:'POST',headers:{authorization:'Bearer '+f.a.bearer,'content-type':'application/json'},body:'{}'});assert.equal(r.status,404);assert.equal(f.journal.count(),0);}finally{await s.close();}}));
test('M02-G22-NO-LEASE-TOKENS-IN-TIMELINE',()=>usingControls(f=>{f.executeOperation();const w=f.claim(),raw=JSON.stringify(f.queue.list(f.a.scope));assert.equal(raw.includes(w.g.token),false);assert.equal(raw.includes('parent_session_hash'),false);assert.equal(raw.includes(f.agent.bearer),false);}));
