import test from 'node:test';import assert from 'node:assert/strict';import {spawn} from 'node:child_process';
import {createExchangeDepthDemo} from '../../packages/development/exchange-depth-demo.mts';
import {usingGift} from './gift-helpers.mts';
import {startCommerceServer} from '../../apps/commerce-api/server.mts';
async function browser(config:any){const r=await new Promise<any>((resolve,reject)=>{const p=spawn('python3',['tests/browser/exchange_depth_component.py'],{env:{...process.env,RIFARE_TEST_INPUT:JSON.stringify(config)},stdio:['ignore','pipe','pipe']});let out='',err='';p.stdout.on('data',v=>out+=v);p.stderr.on('data',v=>err+=v);p.on('error',reject);p.on('close',code=>resolve({code,out,err}));});assert.equal(r.code,0,r.err);assert.equal(JSON.parse(r.out).passed,true);assert.deepEqual(JSON.parse(r.out).direct_browser_network,[]);}
async function catalog(scenario:string){const f=await createExchangeDepthDemo(),app=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator});try{await browser({scenario,url:app.url,token:f.operator.token,allocation_id:f.exchangeAllocation.id,screenshot:scenario==='catalog'?process.env.RIFARE_EXCHANGE_SCREENSHOT:undefined});assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);assert.equal(f.fulfillmentDb.prepare('SELECT count(*) n FROM fixture_effects').get().n,0);}finally{await app.close();f.cleanup();}}
test('M06-G01-BROWSER-CATALOG-SELECTION-AND-CURRENT-QUOTE',()=>catalog('catalog'));
test('M06-G01-BROWSER-CHANGED-ALLOCATION-DISCARDS-LATE-QUOTE',()=>catalog('late'));
test('M06-G05-BROWSER-VERIFIED-PRIVATE-GIFT-CHOICES',()=>usingGift(async f=>{const gift_request={store_id:f.a.store,gift_id:f.giftFacts.gift_id,email:f.giftFacts.recipient_email},challenge=f.gifts.request(gift_request,'gift-browser'),proof=f.outbox.at(-1).proof,app=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,gifts:f.gifts});try{await browser({scenario:'gift',url:app.url,gift_request,challenge,proof,purchaser_id:f.giftOrder.customer_id,screenshot:process.env.RIFARE_GIFT_SCREENSHOT});assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_return_requests WHERE resource_id=?').get(f.giftOrder.id).n,0);}finally{await app.close();}}));
