import test from 'node:test';import assert from 'node:assert/strict';import { usingFulfillment } from './fulfillment-helpers.mts';
const event=(f:any,label:string,status='delivered',sequence=1,id='carrier-one')=>f.fulfillmentSource.carrierEvent(label,{id,sequence,status,at:f.now()});
test('CASE-M03-G15-01',()=>usingFulfillment(async f=>{const b=await f.buy();event(f,b.labelId);const s=await f.tracking.refresh(f.a.scope,b.labelId);assert.equal(s.carrier.delivered_observed,true);assert.deepEqual(s.warehouse,{receipt:'pending',inspection:'pending',inventory_disposition:'not_recorded'});assert.equal(s.resolution_trigger.execution_authorized,false);}));
test('CASE-M03-G15-02',()=>usingFulfillment(async f=>{const b=await f.buy();event(f,b.labelId);await f.tracking.refresh(f.a.scope,b.labelId);const read=f.fulfillmentSource.label.bind(f.fulfillmentSource);f.fulfillmentSource.label=async ref=>({...await read(ref),source_version:3,carrier_sequence:2,event_id:'late-transit',tracking_state:'in_transit'});await assert.rejects(()=>f.tracking.refresh(f.a.scope,b.labelId),/TRACKING_REGRESSION/);assert.equal(f.tracking.read(f.a.scope,b.labelId).carrier.status,'delivered');}));
test('CASE-M03-G15-03',()=>usingFulfillment(async f=>{const b=await f.buy();event(f,b.labelId);await f.tracking.refresh(f.a.scope,b.labelId);await f.tracking.refresh(f.a.scope,b.labelId);const s=f.tracking.read(f.a.scope,b.labelId);assert.equal(s.events.length,1);assert.equal(s.warehouse.inspection,'pending');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_resolution_operations').get().n,0);assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).available,3);}));
test('M03-G15-TEST-017-DELIVERY-NOT-INSPECTION',()=>usingFulfillment(async f=>{const b=await f.buy();event(f,b.labelId);const s=await f.tracking.refresh(f.a.scope,b.labelId);assert.equal(s.carrier_delivery_is_warehouse_receipt,false);assert.equal(s.resolution_trigger.eligible,true);assert.equal(s.warehouse.receipt,'pending');}));
test('M03-G15-UNKNOWN-WAREHOUSE-TRIGGER-NOT-ELIGIBLE',()=>usingFulfillment(async f=>{f.config.configure(f.owner.scope,{...f.configInput,expected_revision:1,resolution_trigger:'warehouse_receipt'});const b=await f.buy();event(f,b.labelId);const s=await f.tracking.refresh(f.a.scope,b.labelId);assert.equal(s.resolution_trigger.eligible,false);}));
test('M03-G15-TRANSIT-POLICY-EXPLICIT',()=>usingFulfillment(async f=>{f.config.configure(f.owner.scope,{...f.configInput,expected_revision:1,resolution_trigger:'carrier_transit'});const b=await f.buy();event(f,b.labelId,'in_transit');const s=await f.tracking.refresh(f.a.scope,b.labelId);assert.equal(s.resolution_trigger.eligible,true);assert.equal(s.carrier.delivered_observed,false);}));
test('M03-G15-WRONG-LABEL-RESULT-REJECTED',()=>usingFulfillment(async f=>{const b=await f.buy(),read=f.fulfillmentSource.label.bind(f.fulfillmentSource);f.fulfillmentSource.label=async ref=>({...await read(ref),id:'other-label',source_version:2});await assert.rejects(()=>f.tracking.refresh(f.a.scope,b.labelId),/FULFILLMENT_RESULT_MISMATCH/);}));
test('M03-G15-WRONG-SOURCE-RESULT-REJECTED',()=>usingFulfillment(async f=>{const b=await f.buy(),read=f.fulfillmentSource.label.bind(f.fulfillmentSource);f.fulfillmentSource.label=async ref=>({...await read(ref),source_identity:'other-source',source_version:2});await assert.rejects(()=>f.tracking.refresh(f.a.scope,b.labelId),/FULFILLMENT_RESULT_MISMATCH/);}));
test('M03-G15-SAME-VERSION-DIFFERENT-PAYLOAD-REJECTED',()=>usingFulfillment(async f=>{const b=await f.buy(),read=f.fulfillmentSource.label.bind(f.fulfillmentSource);f.fulfillmentSource.label=async ref=>({...await read(ref),charge_id:'different-charge'});await assert.rejects(()=>f.tracking.refresh(f.a.scope,b.labelId),/SOURCE_VERSION_CONFLICT/);}));
test('M03-G15-OLD-SNAPSHOT-CANNOT-REGRESS',()=>usingFulfillment(async f=>{const b=await f.buy(),old=await f.fulfillmentSource.label(b.labelId);event(f,b.labelId);await f.tracking.refresh(f.a.scope,b.labelId);f.fulfillmentSource.label=async()=>old;const s=await f.tracking.refresh(f.a.scope,b.labelId);assert.equal(s.carrier.status,'delivered');assert.equal(s.events.length,1);}));
test('M03-G15-EXCEPTION-PRESERVES-DELIVERY-HISTORY',()=>usingFulfillment(async f=>{const b=await f.buy();event(f,b.labelId);await f.tracking.refresh(f.a.scope,b.labelId);event(f,b.labelId,'exception',2,'exception-one');const s=await f.tracking.refresh(f.a.scope,b.labelId);assert.equal(s.carrier.delivered_observed,true);assert.equal(s.carrier.exception,true);assert.equal(s.resolution_trigger.eligible,false);assert.equal(s.warehouse.receipt,'pending');}));
test('M03-G15-EVENT-ID-CONFLICT-REJECTED',()=>usingFulfillment(async f=>{const b=await f.buy();event(f,b.labelId);await f.tracking.refresh(f.a.scope,b.labelId);const read=f.fulfillmentSource.label.bind(f.fulfillmentSource);f.fulfillmentSource.label=async ref=>({...await read(ref),source_version:3,carrier_sequence:2,tracking_state:'exception'});await assert.rejects(()=>f.tracking.refresh(f.a.scope,b.labelId),/TRACKING_EVENT_CONFLICT/);}));
test('M03-G15-NO-FINANCIAL-WRITE-FROM-EVENT',()=>usingFulfillment(async f=>{const b=await f.buy(),count=f.fulfillmentSource.effects().length;event(f,b.labelId);await f.tracking.refresh(f.a.scope,b.labelId);assert.equal(f.fulfillmentSource.effects().length,count);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);}));
test('M03-G15-FUTURE-TIMESTAMP-REJECTED',()=>usingFulfillment(async f=>{const b=await f.buy();assert.throws(()=>f.fulfillmentSource.carrierEvent(b.labelId,{id:'future',sequence:1,status:'delivered',at:f.now()+1}),/TRACKING_EVENT_INVALID/);}));
test('M03-G15-CROSS-TENANT-TRACKING-DENIED',()=>usingFulfillment(async f=>{const b=await f.buy();assert.throws(()=>f.tracking.read(f.b.scope,b.labelId),/NOT_FOUND/);}));
test('M03-G15-CUSTOMER-CANNOT-INJECT-EVENTS',()=>usingFulfillment(async f=>{const b=await f.buy();await assert.rejects(()=>f.tracking.refresh(f.customer,b.labelId),/ACCESS_DENIED/);assert.equal(f.tracking.read(f.customer,b.labelId).events.length,0);}));
test('M03-G15-APPEND-ONLY-EVENTS',()=>usingFulfillment(async f=>{const b=await f.buy();event(f,b.labelId);await f.tracking.refresh(f.a.scope,b.labelId);assert.throws(()=>f.db.prepare('DELETE FROM commerce_carrier_events').run(),/APPEND_ONLY_RECEIPT/);assert.throws(()=>f.db.prepare("UPDATE commerce_carrier_events SET digest='x'").run(),/APPEND_ONLY_RECEIPT/);}));
