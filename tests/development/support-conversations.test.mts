import test from 'node:test';import assert from 'node:assert/strict';import {usingSupport} from './support-helpers.mts';
test('CASE-M05-G01-01',()=>usingSupport(f=>{const w=f.conversations.link(f.a.scope,f.customer,{case_id:'case_one',channel:'webchat',account_id:'widget',external_id:'browser',history:'complete',source_revision:1});const h=f.conversations.history(f.customer,'case_one');assert.equal(h.links.length,2);assert.equal(h.history_complete,false);assert.equal(w.resource_id,f.order().id);assert.equal(h.unknown_history_means_no_reply,false);}));
test('CASE-M05-G01-02',()=>usingSupport(f=>{assert.throws(()=>f.conversations.link(f.b.scope,f.customer,{case_id:'case_one',channel:'email',account_id:'merchant_mail',external_id:'thread_one',history:'complete',source_revision:1}));f.conversations.ingest(f.a.scope,{link_id:f.link.id,external_id:'private',direction:'internal',visibility:'staff',text:'Private handling note',source_at:f.now()});assert.equal(f.conversations.history(f.customer,'case_one').messages.length,0);assert.equal(f.conversations.history(f.a.scope,'case_one').messages.length,1);}));
test('CASE-M05-G01-03',()=>usingSupport(f=>{const p={link_id:f.link.id,external_id:'incoming1',direction:'incoming',visibility:'public',text:'Where is my order?',source_at:f.now()};assert.equal(f.conversations.ingest(f.a.scope,p).duplicate,false);assert.equal(f.conversations.ingest(f.a.scope,p).duplicate,true);assert.equal(f.conversations.history(f.a.scope,'case_one').messages.length,1);assert.throws(()=>f.conversations.ingest(f.a.scope,{...p,text:'Different content'}),/CONFLICT/);}));
test('M05-G01-04',()=>usingSupport(f=>{f.create('case_two');assert.throws(()=>f.conversations.link(f.a.scope,f.customer,{case_id:'case_two',channel:'email',account_id:'merchant_mail',external_id:'thread_one',history:'partial',source_revision:2}),/IDENTITY_CONFLICT/);}));
test('M05-G01-05',()=>usingSupport(f=>{f.conversations.link(f.a.scope,f.customer,{case_id:'case_one',channel:'email',account_id:'merchant_mail',external_id:'thread_one',history:'complete',source_revision:2});assert.throws(()=>f.conversations.link(f.a.scope,f.customer,{case_id:'case_one',channel:'email',account_id:'merchant_mail',external_id:'thread_one',history:'partial',source_revision:1}),/SOURCE_VERSION_CONFLICT/);}));
test('M05-G01-06',()=>usingSupport(f=>{const w=f.conversations.link(f.a.scope,f.customer,{case_id:'case_one',channel:'webchat',account_id:'widget',external_id:'browser',history:'complete',source_revision:1});f.conversations.customerMessage(f.customer,{link_id:w.id,request_id:'request1',text:'Please help'});assert.equal(f.conversations.history(f.customer,'case_one').messages[0].direction,'incoming');assert.throws(()=>f.conversations.customerMessage(f.customer,{link_id:w.id,request_id:'request1',text:'Changed'}),/CONFLICT/);assert.throws(()=>f.conversations.customerMessage(f.customer,{link_id:w.id,request_id:'x',text:'X',visibility:'staff'}));}));
test('M05-G01-07',()=>usingSupport(f=>{for(let n=1;n<=3;n++)f.conversations.ingest(f.a.scope,{link_id:f.link.id,external_id:'m'+n,direction:'incoming',visibility:'public',text:'Message '+n,source_at:f.now()});const first=f.conversations.history(f.a.scope,'case_one',0,2),next=f.conversations.history(f.a.scope,'case_one',first.next_cursor,2);assert.equal(first.messages.length,2);assert.equal(next.messages.length,1);assert.equal(new Set([...first.messages,...next.messages].map(x=>x.id)).size,3);assert.equal(first.history_complete,false);}));
