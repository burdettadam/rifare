import test from 'node:test';import assert from 'node:assert/strict';
import { usingResolution } from './resolution-helpers.mts';
test('CASE-M03-G06-01',()=>usingResolution(f=>{const p=f.allocate();assert.deepEqual(p.allocations.map(a=>[a.line_id,a.outcome,a.components.paid_minor]),[['alpha','refund','1940'],['beta','store_credit','960'],['gamma','exchange','1000']]);assert.equal(p.allocated_value_minor,'3900');assert.equal(p.remaining_obligation_minor,'3900');}));
import { ResolutionLedger,unitComponents } from '../../packages/commerce/resolution-ledger.mts';
import { resolutionFixture } from './resolution-helpers.mts';
import { contentDigest } from '../../packages/commerce/configuration-values.mts';
import { CommerceKernel } from '../../packages/commerce/kernel.mts';
import { DatabaseSync } from 'node:sqlite';
test('CASE-M03-G06-02',()=>usingResolution(f=>{const i=f.intent();i.lines.push({line_id:'alpha',units:[2],outcome:'exchange'});assert.throws(()=>f.allocate(i),/UNIT_ALREADY_ALLOCATED/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_resolution_units').get().n,0);}));
test('CASE-M03-G06-03',async()=>{const values=[];for(const indices of [[0,1],[1,0]]){const f=await resolutionFixture();try{const p=f.allocate();for(const i of indices){const op=f.authorize(f.quote(p.allocations[i]));await f.executor.dispatch(f.a.scope,op.id);if(i===0){f.source.settle(op.id);await f.executor.reconcile(f.a.scope,op.id);}}values.push(f.ledger.read(f.a.scope,p.id).remaining_obligation_minor);}finally{f.cleanup();}}assert.deepEqual(values,['1000','1000']);});
test('M03-G06-PERSISTENT-IDEMPOTENT-INTENT',()=>usingResolution(f=>{const a=f.allocate(),b=f.allocate();assert.equal(a.id,b.id);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_resolution_units').get().n,3);}));
test('M03-G06-CONFLICTING-INTENT-NO-REASSIGN',()=>usingResolution(f=>{f.allocate();const i=f.intent();i.lines[0].outcome='exchange';assert.throws(()=>f.allocate(i),/RESOLUTION_CONFLICT/);}));
test('M03-G06-MISSING-LINE-REJECTED',()=>usingResolution(f=>{const i=f.intent();i.lines.pop();assert.throws(()=>f.allocate(i),/RETURN_QUANTITY_MISMATCH/);}));
test('M03-G06-PRIOR-RESOLVED-UNIT-REJECTED',()=>usingResolution(f=>{const i=f.intent();i.lines[0].units=[1];assert.throws(()=>f.allocate(i),/QUANTITY_EXCEEDED/);}));
test('M03-G06-UNFULFILLED-UNIT-REJECTED',()=>usingResolution(f=>{const i=f.intent();i.lines[0].units=[4];assert.throws(()=>f.allocate(i),/QUANTITY_EXCEEDED/);}));
test('M03-G06-CROSS-TENANT-PLAN-HIDDEN',()=>usingResolution(f=>{const p=f.allocate();assert.throws(()=>f.ledger.read(f.b.scope,p.id),/NOT_FOUND/);assert.throws(()=>f.ledger.allocate(f.b.scope,f.intent()),/NOT_FOUND/);}));
test('M03-G06-CUSTOMER-CANNOT-ALLOCATE-MONEY',()=>usingResolution(f=>{assert.throws(()=>f.ledger.allocate(f.customer,f.intent()),/ACCESS_DENIED/);}));
test('M03-G06-UNQUALIFIED-CREDIT-NO-PARTIAL-PLAN',()=>usingResolution(f=>{f.ledger.configure(f.owner.scope,{expected_revision:1,enabled:true,source_identity:'source-one',credit_instrument:'none',expires_at:f.now()+60000,inventory_buffer:2});assert.throws(()=>f.allocate(),/OUTCOME_UNSUPPORTED/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_resolution_plans').get().n,0);}));
test('M03-G06-UNAPPROVED-REQUEST-REJECTED',()=>usingResolution(f=>{f.db.prepare("UPDATE commerce_return_requests SET state='awaiting_review'").run();assert.throws(()=>f.allocate(),/RETURN_APPROVAL_REQUIRED/);}));
test('M03-G06-UNKNOWN-NATIVE-REQUEST-REMAINS-BLOCKED',()=>usingResolution(f=>{f.db.prepare("UPDATE commerce_return_requests SET state='native_unknown'").run();assert.throws(()=>f.allocate(),/RETURN_APPROVAL_REQUIRED/);}));
test('M03-G06-QUANTITY-STRING-REJECTED',()=>usingResolution(f=>{const i=f.intent();i.lines[0].units=['2'];assert.throws(()=>f.allocate(i),/INVALID_INPUT/);}));
test('M03-G06-IMMUTABLE-PAID-TOTALS-CONSERVE-CENTS',()=>{const f={currency:'USD'},l={quantity:3,gross_minor:'100',discount_minor:'0',tax_minor:'0',shipping_minor:'0',duties_minor:'0'};assert.deepEqual([1,2,3].map(n=>unitComponents(f,l,[n]).paid_minor),['34','33','33']);assert.equal(unitComponents(f,l,[3,1,2]).paid_minor,'100');});
test('M03-G06-SHIPPING-ALLOCATION-CHARGED-ONCE',()=>usingResolution(f=>{const p=f.allocate();assert.deepEqual(p.allocations.map(a=>a.return_shipping_minor),['34','33','33']);assert.equal(p.allocations.reduce((n,a)=>n+BigInt(a.return_shipping_minor),0n),100n);}));
test('M03-G06-REOPEN-RETAINS-UNIT-CLAIMS',()=>usingResolution(f=>{const p=f.allocate(),db=new DatabaseSync(f.filename);try{const k=new CommerceKernel(db,f.now),v=new ResolutionLedger(k).read(k.authenticate(f.a.bearer),p.id);assert.equal(v.remaining_obligation_minor,'3900');assert.equal(v.allocations[0].id,p.allocations[0].id);}finally{db.close();}}));
test('M03-G06-INPUT-ORDER-DOES-NOT-CHANGE-IDEMPOTENCY',()=>usingResolution(f=>{const p=f.allocate(),i=f.intent();i.lines.reverse();assert.equal(f.allocate(i).id,p.id);}));
test('M03-G06-NO-SILENT-ALLOCATION-TAMPERING',()=>usingResolution(f=>{const p=f.allocate();f.db.prepare("UPDATE commerce_resolution_allocations SET body='{}' WHERE id=?").run(p.allocations[0].id);assert.throws(()=>f.ledger.read(f.a.scope,p.id),/RESOLUTION_INTEGRITY/);}));
