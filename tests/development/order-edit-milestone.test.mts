import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';import {usingEdits} from './order-edit-helpers.mts';
test('CASE-M04-G99-01 integrated upgrade requires all independent source stages before release',()=>usingEdits(async f=>{const e=f.authorize(f.quote({variant_id:'upgrade'})).order_edit_id;await f.edits.dispatch(f.a.scope,e);assert.equal(f.native.tryPick(f.original.id,'warehouse_one').picked,false);f.native.settle(e);await f.edits.dispatch(f.a.scope,e);f.native.foreignHold(f.original.id,'warehouse_one','fraud');await assert.rejects(f.edits.release(f.a.scope,e),/FOREIGN_HOLD/);f.native.clearForeignHold(f.original.id,'warehouse_one','fraud');const final=await f.edits.release(f.a.scope,e);assert.equal(final.state,'released');assert.equal(final.source.finance.state,'settled');assert.equal(final.source.warehouses[0].stage,'unfulfilled');assert.equal(final.source.warehouses[0].ack_version,final.source.version);assert.equal(final.live_qualified,false);assert.equal(final.execution_authorized,false);}));
test('CASE-M04-G99-02 missing connected evidence blocks formal milestone acceptance despite local tests',()=>{const q=JSON.parse(readFileSync('work/qualification/M04.json','utf8'));assert.equal(q.full_milestone_accepted,false);assert.equal(q.state,'blocked');assert.ok(q.missing.includes('connected warehouse hold and final-order acknowledgement qualification'));assert.ok(q.missing.includes('live payment and refund integration'));assert.equal(q.next_milestone_started,false);});
test('CASE-M04-G99-03 component success cannot silently promote tag-only warehouse support',()=>usingEdits(f=>{f.native.configureWarehouse('warehouse_one','tag_only');assert.throws(()=>f.edits.configure(f.owner.scope,{...f.settings,expected_revision:1}),/HOLD_PROBE_FAILED/);assert.equal(f.native.order(f.original.id).version,1);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM edit_source_effects').get().n,0);}));
