import test from 'node:test';import assert from 'node:assert/strict';
import { usingResolution } from './resolution-helpers.mts';
test('CASE-M03-G09-01',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id));const r=await f.executor.dispatch(f.a.scope,op.id);assert.equal(r.state,'issued');assert.equal(r.cash_settled,false);const credit=f.credit.instrument(f.a.scope,f.executor,op.id);assert.equal(credit.amount_issued_minor,'837');assert.equal(credit.instrument?.type,'native_store_credit');assert.equal(credit.instrument?.balance_minor,'837');}));
import { StoreCredit } from '../../packages/commerce/store-credit.mts';
import { ExecutionStops } from '../../packages/commerce/execution-stops.mts';
test('CASE-M03-G09-02',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id));await f.executor.dispatch(f.a.scope,op.id);await f.executor.dispatch(f.a.scope,op.id);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_credit_accounts').get().n,1);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,1);}));
test('CASE-M03-G09-03',()=>usingResolution(f=>{const p=f.allocate();f.ledger.configure(f.owner.scope,{expected_revision:1,enabled:true,source_identity:f.source.identity,credit_instrument:'none',expires_at:f.now()+60000,inventory_buffer:2});assert.throws(()=>f.credit.quote(f.a.scope,p.allocations[1].id),/CREDIT_UNQUALIFIED/);}));
test('M03-G09-DISCOUNT-CODE-NOT-NATIVE-CREDIT',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id)),issue=f.source.issue.bind(f.source);f.source.issue=async input=>{const r=await issue(input);r.instrument.type='discount_code';return r;};assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');assert.equal(f.credit.instrument(f.a.scope,f.executor,op.id).instrument,null);}));
test('M03-G09-WRONG-CUSTOMER-ACCOUNT-REJECTED',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id)),issue=f.source.issue.bind(f.source);f.source.issue=async input=>{const r=await issue(input);r.instrument.customer_id='another';return r;};assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');}));
test('M03-G09-WRONG-CURRENCY-ACCOUNT-REJECTED',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id)),issue=f.source.issue.bind(f.source);f.source.issue=async input=>{const r=await issue(input);r.instrument.currency='JPY';return r;};assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');}));
test('M03-G09-UNQUALIFIED-EXPIRATION-REJECTED',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id)),issue=f.source.issue.bind(f.source);f.source.issue=async input=>{const r=await issue(input);r.instrument.expires_at=f.now();return r;};assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');}));
test('M03-G09-LOST-ISSUANCE-FOUND-WITHOUT-NEW-CREDIT',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id)),issue=f.source.issue.bind(f.source);let sends=0;f.source.issue=async input=>{sends++;await issue(input);throw new Error('lost');};await f.executor.dispatch(f.a.scope,op.id);await f.executor.dispatch(f.a.scope,op.id);assert.equal((await f.executor.reconcile(f.a.scope,op.id)).state,'issued');assert.equal(sends,1);assert.equal(f.credit.instrument(f.a.scope,f.executor,op.id).amount_issued_minor,'837');}));
test('M03-G09-CREDIT-CANNOT-BECOME-CASH-SETTLEMENT',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id));await f.executor.dispatch(f.a.scope,op.id);assert.throws(()=>f.source.settle(op.id),/INVALID_STAGE/);assert.equal(f.credit.instrument(f.a.scope,f.executor,op.id).cash_settlement,false);}));
test('M03-G09-REDEEMED-BALANCE-NOT-REISSUED',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id));await f.executor.dispatch(f.a.scope,op.id);const read=f.source.lookup.bind(f.source);f.source.lookup=async id=>{const r=await read(id);r.instrument.balance_minor='37';return r;};await f.executor.reconcile(f.a.scope,op.id);const c=f.credit.instrument(f.a.scope,f.executor,op.id);assert.equal(c.amount_issued_minor,'837');assert.equal(c.instrument?.balance_minor,'37');assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,1);}));
test('M03-G09-ACCOUNT-BALANCE-NOT-CREDITED-AMOUNT',()=>usingResolution(async f=>{const p=f.allocate();f.sourceDb.prepare('INSERT INTO fixture_credit_accounts VALUES(?,?,?,?)').run('previous-credit',f.order().customer_id,'USD','100');const op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id));await f.executor.dispatch(f.a.scope,op.id);const c=f.credit.instrument(f.a.scope,f.executor,op.id);assert.equal(c.amount_issued_minor,'837');assert.equal(c.instrument?.balance_minor,'937');}));
test('M03-G09-REFUND-ALLOCATION-NOT-CREDITABLE',()=>usingResolution(f=>{const p=f.allocate();assert.throws(()=>f.credit.quote(f.a.scope,p.allocations[0].id),/CREDIT_UNQUALIFIED/);}));
test('M03-G09-NATIVE-ERROR-NOT-INSTRUMENT',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id));f.source.issue=async()=>({code:'native_error'});assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');assert.equal(f.credit.instrument(f.a.scope,f.executor,op.id).instrument,null);}));
test('M03-G09-CROSS-TENANT-INSTRUMENT-HIDDEN',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id));await f.executor.dispatch(f.a.scope,op.id);assert.throws(()=>f.credit.instrument(f.b.scope,f.executor,op.id),/NOT_FOUND/);}));
test('M03-G09-NEGATIVE-INSTRUMENT-BALANCE-REJECTED',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.credit.quote(f.a.scope,p.allocations[1].id)),issue=f.source.issue.bind(f.source);f.source.issue=async input=>{const r=await issue(input);r.instrument.balance_minor='-1';return r;};assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');}));
