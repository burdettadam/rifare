import test from 'node:test';import assert from 'node:assert/strict';import { readFileSync } from 'node:fs';
import { money,decimalMoney,decimalString,addMoney,subtractMoney,ratioMoney,allocateMoney,remainingMoney,unitReturnMoney,pairedAmounts } from '../../packages/commerce/money.mts';
const gold=JSON.parse(readFileSync(new URL('../fixtures/model-policy/money-golden.json',import.meta.url),'utf8'));
test('CASE-M02-G02-01',()=>{for(const c of gold.allocations){const rows=allocateMoney(money(c.currency,c.minor),c.weights);assert.deepEqual(rows.map(r=>r.amount.minor),c.expected);assert.equal(rows.reduce((n,r)=>n+BigInt(r.amount.minor),0n).toString(),c.minor);}});
test('CASE-M02-G02-02',()=>{assert.throws(()=>addMoney(money('USD','1'),money('JPY','1')),/CURRENCY_MISMATCH/);for(const input of [NaN,Infinity,-1,'-1','1e2','0.001'])assert.throws(()=>decimalMoney('USD',input));});
test('CASE-M02-G02-03',()=>{let seed=19n;for(let i=0;i<300;i++){seed=(seed*48271n)%2147483647n;const paid=money('USD',(seed%100000n).toString()),quantity=seed%23n+1n;const refunds=[];for(let j=0n;j<quantity;j++)refunds.push(unitReturnMoney(paid,quantity.toString(),j.toString(),'1'));assert.equal(remainingMoney(paid,refunds).minor,'0');}});
test('M02-G02-NO-FLOAT-LOSS',()=>{assert.equal(decimalMoney('USD',gold.large.input).minor,gold.large.minor);assert.equal(decimalString(money('USD',gold.large.minor)),gold.large.input);});
test('M02-G02-DECIMAL-TENTHS',()=>{assert.equal(addMoney(decimalMoney('USD','0.1'),decimalMoney('USD','0.2')).minor,'30');});
test('M02-G02-JPY-ZERO-PRECISION',()=>{assert.equal(decimalMoney('JPY','10').minor,'10');assert.equal(decimalString(money('JPY','10')),'10');assert.throws(()=>decimalMoney('JPY','10.0'),/INVALID_PRECISION/);});
test('M02-G02-KWD-THREE-PLACES',()=>{assert.equal(decimalMoney('KWD','1.234').minor,'1234');assert.equal(decimalString(money('KWD','1')),'0.001');});
test('M02-G02-UNKNOWN-CURRENCY',()=>{for(const code of ['usd','XXX','BTC','__proto__'])assert.throws(()=>money(code,'1'),/UNSUPPORTED_CURRENCY/);});
test('M02-G02-STRING-MINOR-UNITS-ONLY',()=>{for(const n of [1,1n,NaN,Infinity,{},'01','1.0',' 1','1e3'])assert.throws(()=>money('USD',n));});
test('M02-G02-SIGNED-EXPLICIT',()=>{assert.throws(()=>money('USD','-1'));assert.equal(money('USD','-1',true).minor,'-1');assert.equal(decimalString(decimalMoney('USD','-1.20',true)),'-1.20');});
test('M02-G02-NEGATIVE-REMAINING-REJECTED',()=>{assert.throws(()=>remainingMoney(money('USD','100'),[money('USD','101')]),/INVALID_MINOR_UNITS/);assert.throws(()=>remainingMoney(money('USD','100'),[money('USD','-1',true)]));});
test('M02-G02-NO-CROSS-CURRENCY-PRIOR',()=>{assert.throws(()=>remainingMoney(money('USD','1'),[money('EUR','1')]),/CURRENCY_MISMATCH/);});
test('M02-G02-HALF-EVEN-EXPLICIT',()=>{assert.equal(ratioMoney(money('USD','5'),'1','2','half_even').money.minor,'2');assert.equal(ratioMoney(money('USD','7'),'1','2','half_even').money.minor,'4');});
test('M02-G02-HALF-UP-EXPLICIT',()=>{assert.equal(ratioMoney(money('USD','5'),'1','2','half_up').money.minor,'3');assert.equal(ratioMoney(money('USD','-5',true),'1','2','half_up').money.minor,'-3');});
test('M02-G02-NEGATIVE-FLOOR-CEILING',()=>{const m=money('USD','-5',true);assert.equal(ratioMoney(m,'1','2','floor').money.minor,'-3');assert.equal(ratioMoney(m,'1','2','ceiling').money.minor,'-2');assert.equal(ratioMoney(m,'1','2','toward_zero').money.minor,'-2');});
test('M02-G02-ROUNDING-NOT-IMPLICIT',()=>{assert.throws(()=>ratioMoney(money('USD','1'),'1','2',undefined as any),/ROUNDING_REQUIRED/);assert.throws(()=>ratioMoney(money('USD','1'),'1','0','half_even'),/ZERO_DENOMINATOR/);});
test('M02-G02-RATIONAL-RESIDUE',()=>{const r=ratioMoney(money('USD','5'),'1','2','half_up');assert.deepEqual(r.residue,{numerator:'-1',denominator:'2'});});
test('M02-G02-ALLOCATION-PERMUTATION',()=>{const weights=[{id:'z',weight:'1'},{id:'a',weight:'1'}];const a=allocateMoney(money('USD','1'),weights),b=allocateMoney(money('USD','1'),[...weights].reverse());assert.equal(a.find(r=>r.id==='a').amount.minor,'1');assert.equal(b.find(r=>r.id==='a').amount.minor,'1');});
test('M02-G02-ALLOCATION-ZERO-WEIGHT',()=>{const r=allocateMoney(money('USD','5'),[{id:'zero',weight:'0'},{id:'one',weight:'1'}]);assert.deepEqual(r.map(r=>r.amount.minor),['0','5']);});
test('M02-G02-ALLOCATION-INVALID',()=>{for(const weights of [[],[{id:'a',weight:'0'}],[{id:'a',weight:'-1'}],[{id:'a',weight:'1'},{id:'a',weight:'2'}]])assert.throws(()=>allocateMoney(money('USD','1'),weights));});
test('M02-G02-PARTIAL-RETURNS-RETAIN-CENTS',()=>{const g=gold.partial_returns;assert.deepEqual(['0','1','2'].map(n=>unitReturnMoney(money(g.currency,g.minor),g.quantity,n,'1').minor),g.expected);});
test('M02-G02-PARTIAL-RETURN-GROUPING',()=>{const m=money('USD','100');assert.equal(addMoney(unitReturnMoney(m,'3','0','2'),unitReturnMoney(m,'3','2','1')).minor,'100');});
test('M02-G02-QUANTITY-LIMIT',()=>{for(const values of [['3','3','1'],['0','0','1'],['3','0','0']])assert.throws(()=>unitReturnMoney(money('USD','10'),...values as [string,string,string]),/QUANTITY_EXCEEDED/);});
test('M02-G02-ORIGINAL-PRESENTMENT-NO-FX',()=>{const r=pairedAmounts(decimalMoney('USD','10'),decimalMoney('EUR','9'),'recorded-rate-1');assert.equal(r.original.minor,'1000');assert.equal(r.presentment.minor,'900');assert.equal(r.conversion_performed,false);});
test('M02-G02-IMMUTABLE-VALUES',()=>{const m=money('USD','5');assert.ok(Object.isFrozen(m));assert.throws(()=>{(m as any).minor='100';});});
test('M02-G02-ARITHMETIC-LIMITS',()=>{assert.throws(()=>money('USD','1'.repeat(37)));assert.throws(()=>addMoney(money('USD','9'.repeat(36)),money('USD','1')));});
