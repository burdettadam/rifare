import test from 'node:test';import assert from 'node:assert/strict';
import { LocalModel } from '../../packages/agent/local-model.mts';
import { useLocal } from './local-model-helpers.mts';

test('CASE-M01-G16-01',()=>useLocal(async f=>{const started=performance.now();const r=await f.runner.run(f.a.scope,f.task.id,'local');
 assert.equal(r.status,'grounded_read');assert.equal(r.claims.find((c:any)=>c.id==='order.number').value,'ORD-1001');assert.ok(performance.now()-started>=0);
 assert.equal(r.receipt.configuration.model_digest,f.config.model_digest);assert.equal(r.receipt.configuration.evidence_kind,'synthetic_wire_fixture');}));
test('CASE-M01-G16-02',()=>useLocal(async f=>{f.mutate((r,p)=>{if(p==='/api/chat'&&r.message.tool_calls[0].function.name==='finish_status')r.message.tool_calls[0].function.arguments.source_digest='0'.repeat(64);return r;});
 const r=await f.runner.run(f.a.scope,f.task.id,'local');assert.equal(r.status,'handoff');assert.equal(r.reason,'UNGROUNDED_OUTPUT');}));
test('CASE-M01-G16-03',()=>useLocal(async f=>{f.status(503);const r=await f.runner.run(f.a.scope,f.task.id,'local');assert.equal(r.status,'handoff');assert.equal(f.requests.length,1);assert.equal(f.requests[0].path,'/api/tags');}));
test('M01-G16-NO-DNS-OR-REMOTE',()=>useLocal(f=>{for(const endpoint of ['https://example.invalid','http://localhost:11434','http://127.1:11434','http://2130706433:11434','http://127.0.0.1:11434/','http://user@127.0.0.1:11434','http://[::1]:11434','http://127.0.0.1:65536'])assert.throws(()=>new LocalModel({...f.config,endpoint}),/LOCAL_ENDPOINT_REQUIRED/);}));
test('M01-G16-CLOUD-DISABLED-REQUIRED',()=>useLocal(f=>{assert.throws(()=>new LocalModel({...f.config,cloud_disabled:false}),/LOCAL_MODEL_NOT_PINNED/);assert.throws(()=>new LocalModel({...f.config,model:'large:cloud'}),/LOCAL_MODEL_NOT_PINNED/);}));
test('M01-G16-DIGEST-MISMATCH',()=>useLocal(async f=>{f.mutate((r,p)=>{if(p==='/api/tags')r.models[0].digest='b'.repeat(64);return r;});const r=await f.runner.run(f.a.scope,f.task.id,'local');assert.equal(r.reason,'LOCAL_MODEL_IDENTITY_MISMATCH');assert.ok(f.requests.every(r=>r.path==='/api/tags'));}));
test('M01-G16-REMOTE-MODEL-REFUSED',()=>useLocal(async f=>{f.mutate((r,p)=>{if(p==='/api/tags')r.models[0].remote_host='cloud.invalid';return r;});assert.equal((await f.runner.run(f.a.scope,f.task.id,'local')).status,'handoff');}));
test('M01-G16-MISSING-MODEL',()=>useLocal(async f=>{f.mutate((r,p)=>p==='/api/tags'?{models:[]}:r);assert.equal((await f.runner.run(f.a.scope,f.task.id,'local')).status,'handoff');}));
test('M01-G16-REDIRECT-NOT-FOLLOWED',()=>useLocal(async f=>{f.status(302);assert.equal((await f.runner.run(f.a.scope,f.task.id,'local')).status,'handoff');assert.equal(f.requests.length,1);}));
test('M01-G16-DEADLINE',()=>useLocal(async f=>{f.delay(250);const started=performance.now();const r=await f.make({timeout_ms:50}).run(f.a.scope,f.task.id,'local');assert.equal(r.reason,'LOCAL_MODEL_TIMEOUT');assert.ok(performance.now()-started<1000);}));
test('M01-G16-NO-SECRET-OR-AUTH-HEADER',()=>useLocal(async f=>{const r=await f.runner.run(f.a.scope,f.task.id,'local');for(const req of f.requests){assert.equal(req.headers.authorization,undefined);assert.equal(JSON.stringify(req.body).includes(f.a.bearer),false);}assert.equal(r.status,'grounded_read');}));
test('M01-G16-CONTEXT-NOT-TRUNCATED',()=>useLocal(async f=>{const r=await f.make({context_tokens:1024}).run(f.a.scope,f.task.id,'local');assert.equal(r.reason,'LOCAL_CONTEXT_LIMIT');assert.ok(f.requests.every(r=>r.path==='/api/tags'));}));
test('M01-G16-OUTPUT-BOUNDED',()=>useLocal(async f=>{f.mutate((r,p)=>p==='/api/chat'?{...r,padding:'x'.repeat(150000)}:r);assert.equal((await f.runner.run(f.a.scope,f.task.id,'local')).status,'handoff');}));
test('M01-G16-PROSE-IS-NOT-FACT-EVIDENCE',()=>useLocal(async f=>{f.mutate((r,p)=>{if(p==='/api/chat')r.message.content='Your order will arrive tomorrow';return r;});assert.equal((await f.runner.run(f.a.scope,f.task.id,'local')).reason,'MODEL_HANDOFF');}));
test('M01-G16-TRUNCATED-RESPONSE',()=>useLocal(async f=>{f.mutate((r,p)=>p==='/api/chat'?{...r,done_reason:'length'}:r);assert.equal((await f.runner.run(f.a.scope,f.task.id,'local')).status,'handoff');}));
test('M01-G16-IDENTITY-RECHECK-AFTER-RESPONSE',()=>useLocal(async f=>{let tags=0;f.mutate((r,p)=>{if(p==='/api/tags'&&++tags===2)r.models[0].digest='b'.repeat(64);return r;});assert.equal((await f.runner.run(f.a.scope,f.task.id,'local')).reason,'LOCAL_MODEL_IDENTITY_MISMATCH');}));
test('M01-G16-WRITES-ARE-NOT-EXECUTED',()=>useLocal(async f=>{f.mutate((r,p)=>{if(p==='/api/chat')r.message.tool_calls[0].function.name='refund_order';return r;});const r=await f.runner.run(f.a.scope,f.task.id,'local');assert.equal(r.reason,'MODEL_OUTPUT_INVALID');assert.deepEqual(r.receipt.history,[]);}));
test('M01-G16-NO-NATIVE-THINKING-RECEIPT',()=>useLocal(async f=>{f.mutate((r,p)=>{if(p==='/api/chat')r.message.thinking='synthetic-private-internal';return r;});const r=await f.runner.run(f.a.scope,f.task.id,'local');assert.equal(JSON.stringify(r).includes('synthetic-private-internal'),false);}));
test('M01-G16-EMPTY-USAGE-IS-UNKNOWN',()=>useLocal(async f=>{f.mutate((r,p)=>{if(p==='/api/chat'){delete r.prompt_eval_count;delete r.eval_count;}return r;});assert.equal((await f.runner.run(f.a.scope,f.task.id,'local')).receipt.reported_usage,null);}));
test('M01-G16-SEPARATE-STORE',()=>useLocal(async f=>{f.reads.profiles.put(f.b.scope,f.profile(f.b));const t=f.reads.createTask(f.b.scope,{order_id:f.order(f.b).id,profile_id:'default'});await assert.rejects(()=>f.runner.run(f.b.scope,t.id,'local'),/NO_CONFIGURATION/);assert.equal(f.requests.length,0);}));
