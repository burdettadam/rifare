import test from 'node:test';import assert from 'node:assert/strict';
import { usingControls,childJSON } from './worker-controls-helpers.mts';
import { WorkerApi } from '../../packages/commerce/worker-api.mts';
import { WorkLeases } from '../../packages/commerce/work-leases.mts';

test('CASE-M02-G18-01',()=>usingControls(f=>{const w=f.claim();f.advance(1001);const next=f.claim(f.a.worker);assert.equal(next.lease.generation,2);assert.equal(next.context().facts.resource_id,f.order().id);assert.equal(next.context().effective_skill.id,'order-status');assert.equal(next.context().lease.owner,'worker');}));
test('CASE-M02-G18-02',()=>usingControls(f=>{const w=f.claim();f.advance(1001);f.claim(f.a.worker);assert.throws(()=>f.api.submit(w.g.token,f.audience,{generation:1,envelope:{},request_key:'late',proposal:{}}),/WORK_FENCE_REJECTED/);assert.throws(()=>f.gateway.prepare(f.agent.scope,f.proposal()),/WORK_FENCE_REJECTED/);}));
test('CASE-M02-G18-03',()=>usingControls(f=>{const w=f.claim();f.advance(1001);const n=f.claim(f.a.worker);assert.throws(()=>f.api.leases.renew(w.g.token,f.audience,1,1000),/WORK_FENCE_REJECTED/);assert.equal(f.api.leases.complete(n.g.token,f.audience,{generation:2,request_key:'finish',outcome:'handoff',submission_id:null}).outcome,'handoff');f.advance(1001);assert.equal(f.claim().lease.generation,3);}));
test('M02-G18-DEADLINE-CANNOT-BE-EXTENDED',()=>usingControls(f=>{const w=f.claim(undefined,30000);f.advance(29000);const r=f.api.leases.renew(w.g.token,f.audience,1,30000);assert.equal(r.deadline_at,w.lease.deadline_at);f.advance(29000);const last=f.api.leases.renew(w.g.token,f.audience,1,30000);assert.equal(last.expires_at,w.lease.deadline_at);f.advance(2000);assert.throws(w.context,/WORK_FENCE_REJECTED/);}));
test('M02-G18-REPEATED-CLAIM-DOES-NOT-RENEW',()=>usingControls(f=>{const w=f.claim();f.advance(300);assert.deepEqual(f.api.leases.claim(w.g.token,f.audience,30000),w.lease);}));
test('M02-G18-COMPLETION-IDEMPOTENT',()=>usingControls(f=>{const w=f.claim(),p={generation:1,request_key:'done',outcome:'handoff',submission_id:null};const a=f.api.leases.complete(w.g.token,f.audience,p);assert.deepEqual(f.api.leases.complete(w.g.token,f.audience,p),a);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_worker_completions').get().n,1);assert.throws(()=>f.api.leases.complete(w.g.token,f.audience,{...p,request_key:'different'}),/WORK_FENCE_REJECTED/);}));
test('M02-G18-REVOKED-PARENT-SESSION',()=>usingControls(f=>{const w=f.claim();f.kernel.revoke(f.agent.scope);assert.throws(w.context,/ACCESS_DENIED/);}));
test('M02-G18-CURRENT-PERMISSION-RECHECKED',()=>usingControls(f=>{const w=f.claim();f.permissions.change(f.owner.scope,{actor_id:'agent',role:'agent',expected_revision:0,actions:['case.read','resource.read'],resource_ids:null});assert.throws(w.context,/ACCESS_DENIED/);}));
test('M02-G18-UNKNOWN-PRIOR-EFFECT-BLOCKS-PROPOSAL',()=>usingControls(async f=>{const {op}=f.executeOperation();f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,op.id,f.journal);const w=f.claim();assert.equal(w.context().blockers[0].state,'unknown');assert.throws(()=>f.api.submit(w.g.token,f.audience,f.submission(w)),/RECONCILIATION_REQUIRED/);await f.recon.one(f.a.scope,op.id,f.journal);assert.equal(w.context().blockers.length,0);assert.ok(f.api.submit(w.g.token,f.audience,f.submission(w)).id);}));
test('M02-G18-LEASE-IDENTITY-CANNOT-BE-FORGED',()=>usingControls(f=>{const w=f.claim();assert.throws(()=>f.api.context(w.g.token,f.audience,2),/WORK_FENCE_REJECTED/);assert.throws(()=>f.kernel.require({generation:1}),/ACCESS_DENIED/);}));
test('M02-G18-LEASE-AND-TOKEN-EXPIRY',()=>usingControls(f=>{const w=f.claim();f.advance(120001);assert.throws(w.context,/WORK_ACCESS_DENIED/);}));
test('M02-G18-CONTEXT-PINS-CHANGE-REQUIRES-NEW-LEASE',()=>usingControls(f=>{const w=f.claim();f.cases.migrate(f.owner.scope,'case_one',{expected_revision:1,profile_id:'default',policy_id:'returns',reason:'approved_update'});assert.throws(w.context,/WORK_CONTEXT_CHANGED/);}));
test('M02-G18-MANUAL-RELEASE-FENCES-OLD-OWNER',()=>usingControls(f=>{const w=f.claim();f.api.leases.release(f.owner.scope,'case_one');assert.throws(w.context,/WORK_ACCESS_DENIED/);assert.equal(f.claim(f.a.worker).lease.generation,3);}));
test('M02-G18-PROPOSAL-COMPLETION-REQUIRES-RECORDED-SUBMISSION',()=>usingControls(f=>{const w=f.claim();assert.throws(()=>f.api.leases.complete(w.g.token,f.audience,{generation:1,request_key:'done',outcome:'proposed',submission_id:'missing'}),/WORK_RESULT_INVALID/);}));
test('M02-G18-REOPEN-PRESERVES-GENERATION',()=>usingControls(f=>{const w=f.claim(),r=f.reopen();try{const api=new WorkerApi(r.kernel);assert.equal(api.context(w.g.token,f.audience,1).lease.generation,1);}finally{r.db.close();}}));
test('M02-G18-CROSS-CASE-RESTRICTED-SCOPE',()=>usingControls(f=>{const w=f.claim(),restricted=f.api.leases.scoped(w.g.token,f.audience,1).scope;f.create('other_case');assert.throws(()=>f.gateway.prepare(restricted,f.proposal('other_case')),/WORK_FENCE_REJECTED/);assert.throws(()=>f.kernel.authorize(restricted,'secret.invoke'),/WORK_SCOPE_DENIED/);}));
test('M02-G18-SAVEPOINT-ROLLS-BACK-INNER-WORK',()=>usingControls(f=>{f.kernel.transaction(()=>{assert.throws(()=>f.kernel.transaction(()=>{f.db.prepare("INSERT INTO commerce_control_events(tenant_id,store_id,code,actor_id,subject_id,generation,observed_at) VALUES('tenant-a','store-a','test','operator','case_one',1,0)").run();throw new Error('inner');}),/inner/);});assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_control_events').get().n,0);}));
test('M02-G18-TWO-PROCESSES-ONE-CLAIM',()=>usingControls(async f=>{const a=f.grant(),b=f.grant(f.a.worker);const source=`import {DatabaseSync} from 'node:sqlite';import {CommerceKernel} from './packages/commerce/kernel.mts';import {WorkLeases} from './packages/commerce/work-leases.mts';const db=new DatabaseSync(process.env.DB),k=new CommerceKernel(db,()=>Number(process.env.NOW));await new Promise(r=>setTimeout(r,Math.max(0,Number(process.env.START)-Date.now())));let result;try{result={generation:new WorkLeases(k).claim(process.env.GRANT,process.env.AUD,1000).generation};}catch(e){result={error:e.message};}db.close();console.log(JSON.stringify(result));`;
  const env={DB:f.filename,NOW:String(f.now()),START:String(Date.now()+350),AUD:f.audience};const results=await Promise.all([childJSON(source,{...env,GRANT:a.token}),childJSON(source,{...env,GRANT:b.token})]);assert.equal(results.filter(r=>r.generation===1).length,1);assert.equal(results.filter(r=>r.error==='WORK_LEASE_HELD').length,1);}));
