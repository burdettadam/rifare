import test from 'node:test';import assert from 'node:assert/strict';import { spawn } from 'node:child_process';
import { usingLineage } from './exchange-lineage-helpers.mts';
import { usingMoney } from './exchange-money-helpers.mts';
import { usingInstant } from './instant-helpers.mts';
import { startCommerceServer } from '../../apps/commerce-api/server.mts';
async function browser(config:any){const result=await new Promise<any>((resolve,reject)=>{const p=spawn('python3',['tests/browser/exchange_history_component.py'],{env:{...process.env,RIFARE_TEST_INPUT:JSON.stringify(config)},stdio:['ignore','pipe','pipe']});let out='',err='';p.stdout.on('data',v=>out+=v);p.stderr.on('data',v=>err+=v);p.on('error',reject);p.on('close',code=>resolve({code,out,err}));});assert.equal(result.code,0,result.err);const report=JSON.parse(result.out);assert.equal(report.passed,true);assert.deepEqual(report.direct_browser_network,[]);}
async function withApp(f:any,sources:any,config:any){const app=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,...sources});try{await browser({url:app.url,token:f.a.bearer,...config});}finally{await app.close();}}
test('M06-G06-BROWSER-DELIVERED-LINEAGE-SHOWS-FUNDED-VALUE',()=>usingLineage(async f=>{const p=await f.makeExchange(f.allocation,'1400');await withApp(f,{lineageSource:f.lineageSource,resolutionSource:f.source,fulfillmentSource:f.fulfillmentSource},{scenario:'lineage',operation_id:p.op.id,expected:{stage:'imported',currency:'USD',minor:'1200'},screenshot:process.env.RIFARE_LINEAGE_SCREENSHOT});assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_exchange_lineage_nodes').get().n,1);},{discount:true}));
test('M06-G07-BROWSER-ORIGINAL-PAIRED-CURRENCIES',()=>usingMoney(async f=>{await withApp(f,{resolutionSource:f.source},{scenario:'currency',allocation_id:f.allocation.id,expected:{currency:'EUR',minor:'1746',contains:['USD','1940']},screenshot:process.env.RIFARE_MONEY_SCREENSHOT});assert.equal(f.effects(),0);}));
test('M06-G07-BROWSER-INPUT-CHANGE-DISCARDS-LATE-MONEY',()=>usingMoney(async f=>{await withApp(f,{resolutionSource:f.source},{scenario:'late',allocation_id:f.allocation.id});assert.equal(f.effects(),0);}));
test('M06-G09-BROWSER-PREPARES-BOUNDED-AUTHORIZATION-QUOTE',()=>usingInstant(async f=>{await withApp(f,{instantSource:f.source},{scenario:'instant',...f.authorizeInput(),expected:{currency:'USD',minor:'3000'},screenshot:process.env.RIFARE_INSTANT_SCREENSHOT});assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_instant_operations').get().n,0);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_instant_captures').get().n,0);}));
