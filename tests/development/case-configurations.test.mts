import test from 'node:test';import assert from 'node:assert/strict';
import { usingExecution } from './execution-helpers.mts';
import { CommerceKernel } from '../../packages/commerce/kernel.mts';
import { CaseConfigurations } from '../../packages/commerce/case-configurations.mts';

test('CASE-M02-G08-01',()=>usingExecution(f=>{const old=f.cases.resume(f.a.scope,'case_one');f.advance(1);f.publish({expected_version:1,rules:{...f.input().rules,window_days:7}});f.reads.profiles.put(f.a.scope,f.profile(f.a,{revision:2,tone:'warm'}));const resumed=f.cases.resume(f.a.scope,'case_one');assert.deepEqual(resumed.pins,old.pins);assert.equal(resumed.pins.policy.version,1);assert.equal(resumed.pins.profile.tone,'neutral');}));
test('CASE-M02-G08-02',()=>usingExecution(f=>{f.db.prepare("UPDATE commerce_case_configurations SET body=json_set(body,'$.profile.revision',99)").run();assert.throws(()=>f.cases.resume(f.a.scope,'case_one'),/CASE_PIN_INTEGRITY/);}));
test('CASE-M02-G08-03',()=>usingExecution(f=>{const before=f.cases.resume(f.a.scope,'case_one');f.reads.profiles.put(f.a.scope,f.profile(f.a,{revision:2,locale:'en-GB'}));const k=new CommerceKernel(f.db,f.now);const next=new CaseConfigurations(k).resume(k.authenticate(f.a.bearer),'case_one');assert.equal(next.configuration_digest,before.configuration_digest);assert.equal(next.pins.profile.locale,'en-US');}));
test('M02-G08-ARCHIVED-SKILL-NOT-LATEST',()=>usingExecution(f=>{const old=f.cases.resume(f.a.scope,'case_one');f.changeSkill();assert.equal(f.cases.resume(f.a.scope,'case_one').pins.skill.digest,old.pins.skill.digest);}));
test('M02-G08-MISSING-SKILL-PIN',()=>usingExecution(f=>{f.db.prepare('DELETE FROM commerce_skill_archive').run();assert.throws(()=>f.cases.resume(f.a.scope,'case_one'),/SKILL_PIN_MISSING/);}));
test('M02-G08-REVOKED-SKILL-STOPS',()=>usingExecution(f=>{f.releases.revoke(f.owner.scope,{skill_id:'order-status',bundle_digest:f.bundle.digest});assert.throws(()=>f.cases.resume(f.a.scope,'case_one'),/SKILL_REVOKED/);}));
test('M02-G08-REVOKED-POLICY-STOPS',()=>usingExecution(f=>{const p=f.policies.get(f.a.scope,'returns',1);f.policies.revoke(f.owner.scope,'returns',1,p.digest);assert.throws(()=>f.cases.resume(f.a.scope,'case_one'),/POLICY_REVOKED/);}));
test('M02-G08-CURRENT-SEMANTICS-NEED-MIGRATION',()=>usingExecution(f=>{f.advance(1);f.publish({expected_version:1,selection:'current_at_quote'});f.create('current');f.advance(1);f.publish({expected_version:2});assert.throws(()=>f.cases.resume(f.a.scope,'current'),/CONFIGURATION_REPREVIEW_REQUIRED/);}));
test('M02-G08-MIGRATION-EXPLICIT-REVISION',()=>usingExecution(f=>{f.reads.profiles.put(f.a.scope,f.profile(f.a,{revision:2,tone:'warm'}));const p=f.cases.migrate(f.a.scope,'case_one',{expected_revision:1,profile_id:'default',policy_id:'returns',reason:'approved_update'});assert.equal(p.revision,2);assert.equal(p.pins.profile.tone,'warm');assert.equal(p.requires_new_preview,true);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_case_configurations').get().n,2);}));
test('M02-G08-MIGRATION-CAS',()=>usingExecution(f=>{assert.throws(()=>f.cases.migrate(f.a.scope,'case_one',{expected_revision:2,profile_id:'default',policy_id:'returns',reason:'approved_update'}),/CASE_CHANGED/);}));
test('M02-G08-AGENT-CANNOT-MIGRATE',()=>usingExecution(f=>{assert.throws(()=>f.cases.migrate(f.agent.scope,'case_one',{}),/ACCESS_DENIED/);}));
test('M02-G08-CROSS-TENANT-NONDISCLOSURE',()=>usingExecution(f=>{assert.throws(()=>f.cases.resume(f.b.scope,'case_one'),/NOT_FOUND/);assert.throws(()=>f.cases.resume(f.c.scope,'case_one'),/NOT_FOUND/);}));
test('M02-G08-CUSTOMER-REASSIGNMENT',()=>usingExecution(f=>{f.db.prepare("UPDATE commerce_resources SET customer_id='C-1002' WHERE id=?").run(f.order().id);assert.throws(()=>f.cases.resume(f.a.scope,'case_one'),/CASE_CUSTOMER_CHANGED/);}));
test('M02-G08-CONNECTION-CHANGE-REPREVIEW',()=>usingExecution(f=>{f.db.prepare('UPDATE commerce_connections SET revision=revision+1').run();assert.throws(()=>f.cases.resume(f.a.scope,'case_one'),/CONFIGURATION_REPREVIEW_REQUIRED/);}));
test('M02-G08-VERIFICATION-REVOCATION',()=>usingExecution(f=>{assert.equal(f.cases.verified(f.a.scope,'case_one').customer_id,'C-1001');f.kernel.revoke(f.customer);assert.throws(()=>f.cases.verified(f.a.scope,'case_one'),/CUSTOMER_VERIFICATION_REQUIRED/);}));
test('M02-G08-STAFF-CASE-NOT-CUSTOMER-PROOF',()=>usingExecution(f=>{f.create('staff',f.a.scope);assert.throws(()=>f.cases.verified(f.a.scope,'staff'),/CUSTOMER_VERIFICATION_REQUIRED/);}));
test('M02-G08-SNAPSHOT-CANNOT-GRANT-SCOPE',()=>usingExecution(f=>{const p=f.cases.resume(f.agent.scope,'case_one');assert.throws(()=>f.kernel.authorize(p.pins,'action.execute',p.resource_id),/ACCESS_DENIED/);}));
test('M02-G08-REPEATED-ID-NO-OVERWRITE',()=>usingExecution(f=>{assert.throws(()=>f.create(),/CASE_EXISTS/);assert.equal(f.cases.resume(f.a.scope,'case_one').revision,1);}));
