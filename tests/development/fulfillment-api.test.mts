import test from 'node:test';import assert from 'node:assert/strict';
import { usingFulfillment,fulfillmentFixture } from './fulfillment-helpers.mts';
import { startCommerceServer } from '../../apps/commerce-api/server.mts';
import { PrivacyLifecycle } from '../../packages/commerce/privacy-lifecycle.mts';
async function server(f:any,fn:(post:any)=>unknown,source=true){const app=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,reads:f.reads,...(source?{fulfillmentSource:f.fulfillmentSource}:{})});try{return await fn(async(path:string,input:any,bearer=f.a.bearer)=>{const r=await fetch(app.url+path,{method:'POST',headers:{'content-type':'application/json',authorization:'Bearer '+bearer},body:JSON.stringify(input)});return {status:r.status,body:await r.json()};});}finally{await app.close();}}
async function authorize(post:any,q:any,reviewer:string){const p=await post('/v1/execution/preview',q.proposal);assert.equal(p.status,200);const a=await post('/v1/execution/approve',{preview_id:p.body.id,preview_digest:p.body.digest},reviewer);assert.equal(a.status,200);const r=await post('/v1/execution/execute',{preview_id:p.body.id,preview_digest:p.body.digest,approval_id:a.body.id});assert.equal(r.status,200);return r.body.fulfillment_operation_id;}
test('M03-G12-HTTP-RESERVE-APPROVE-REPLACE',()=>usingFulfillment(async f=>server(f,async post=>{const r=await post('/v1/fulfillment/reserve',{quote_id:f.exchange.id,quote_digest:f.exchange.digest,location_id:'warehouse-one',ttl_ms:50000});assert.equal(r.status,200);assert.equal(r.body.state,'active');const q=await post('/v1/fulfillment/replacement-quote',{reservation_id:r.body.id});const op=await authorize(post,q.body,f.reviewer.bearer),sent=await post('/v1/fulfillment/dispatch',{operation_id:op});assert.equal(sent.body.state,'created');assert.equal(sent.body.replacement.shipment_id,null);assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).available,2);})));
test('M03-G13-HTTP-LABEL-QUOTE-IS-NOT-PURCHASE',()=>usingFulfillment(async f=>server(f,async post=>{const q=await post('/v1/fulfillment/label-quote',{request_id:f.request.id,replaces:null});assert.equal(q.status,200);assert.equal(f.fulfillmentSource.effects().length,0);const op=await authorize(post,q.body,f.reviewer.bearer);assert.equal(f.fulfillmentSource.effects().length,0);const sent=await post('/v1/fulfillment/dispatch',{operation_id:op});assert.equal(sent.body.state,'purchased');const l=await post('/v1/fulfillment/label',{label_id:sent.body.native_id});assert.equal(l.body.amount_minor,'500');assert.equal(l.body.reimbursement_counted,false);})));
test('M03-G13-HTTP-NO-DEFAULT-CARRIER',()=>usingFulfillment(async f=>server(f,async post=>{const r=await post('/v1/fulfillment/label-quote',{request_id:f.request.id,replaces:null});assert.equal(r.status,503);assert.equal(r.body.error,'ADAPTER_UNAVAILABLE');assert.equal(f.fulfillmentSource.effects().length,0);},false)));
test('M03-G13-HTTP-CLIENT-PRICE-REJECTED',()=>usingFulfillment(async f=>server(f,async post=>{const r=await post('/v1/fulfillment/label-quote',{request_id:f.request.id,replaces:null,amount_minor:'1'});assert.equal(r.status,400);assert.equal(r.body.error,'INVALID_INPUT');})));
test('M03-G11-HTTP-CUSTOMER-CANNOT-RESERVE',()=>usingFulfillment(async f=>server(f,async post=>{const r=await post('/v1/fulfillment/reserve',{quote_id:f.exchange.id,quote_digest:f.exchange.digest,location_id:'warehouse-one',ttl_ms:50000},f.customerBearer);assert.equal(r.status,403);assert.equal(f.fulfillmentSource.calls.reserve,0);})));
test('M03-G15-HTTP-CROSS-STORE-TRACKING-HIDDEN',()=>usingFulfillment(async f=>{const b=await f.buy();await server(f,async post=>assert.equal((await post('/v1/fulfillment/tracking',{label_id:b.labelId},f.b.bearer)).status,404));}));
test('M03-G15-HTTP-NO-CLIENT-EVENT-INJECTION',()=>usingFulfillment(async f=>server(f,async post=>assert.equal((await post('/v1/fulfillment/inject-event',{status:'delivered'})).status,404))));
test('M03-G14-EXPIRED-UNUSED-LABEL-CAN-BE-REPLACED-WITHOUT-REFUND',async()=>{const f=await fulfillmentFixture({label_ttl_ms:100});try{const b=await f.buy();f.advance(101);assert.equal(f.labels.inspect(f.a.scope,b.labelId).usable,false);assert.throws(()=>f.labels.quote(f.a.scope,{request_id:f.request.id,replaces:b.labelId}),/LABEL_REPLACEMENT_BLOCKED/);f.fulfillmentSource.expireLabel(b.labelId);await f.execution.refreshLabel(f.a.scope,b.labelId);const next=await f.buy(b.labelId);assert.equal(next.result.state,'purchased');assert.equal(f.labels.inspect(f.a.scope,b.labelId).void_state,'expired_unused');assert.equal(f.labels.inspect(f.a.scope,b.labelId).reimbursement_counted,false);assert.equal(f.labels.inspect(f.a.scope,next.labelId).is_current,true);}finally{f.cleanup();}});
test('M03-G13-PRIVACY-EXPORT-INCLUDES-SCOPED-FULFILLMENT',()=>usingFulfillment(async f=>{const b=await f.buy(),value=new PrivacyLifecycle(f.kernel).export(f.owner.scope,f.order().customer_id);assert.equal(value.fulfillment_records.operations.length,1);assert.equal(value.fulfillment_records.commerce_return_labels[0].id,b.labelId);assert.equal(value.fulfillment_records.commerce_return_parcels[0].request_id,f.request.id);assert.equal(JSON.stringify(value).includes(f.reviewer.bearer),false);assert.equal(JSON.stringify(value).includes('customer-address-one'),true);}));
test('M03-G15-REVOKED-POLICY-DOES-NOT-TRIGGER-RESOLUTION',()=>usingFulfillment(async f=>{const b=await f.buy();f.fulfillmentSource.carrierEvent(b.labelId,{id:'delivered-revoked',sequence:1,status:'delivered',at:f.now()});await f.tracking.refresh(f.a.scope,b.labelId);const policy=f.cases.inspect(f.a.scope,'resolution_case').pins.policy;f.policies.revoke(f.owner.scope,'returns',policy.version,policy.digest);const state=f.tracking.read(f.a.scope,b.labelId);assert.equal(state.carrier.delivered_observed,true);assert.equal(state.resolution_trigger.eligible,false);}));
