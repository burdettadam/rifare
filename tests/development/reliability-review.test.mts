import test from 'node:test';import assert from 'node:assert/strict';
import { useReliability } from './reliability-helpers.mts';

test('M02-G15-REVIEW-UNKNOWN-BLOCKS-CONFLICTING-RESOURCE',()=>useReliability(async f=>{const first=f.executeOperation('refund','first').op;f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,first.id,f.journal);const second=f.executeOperation('none','second').op;assert.equal(f.work.claim(f.a.scope,second.id),null);assert.equal(f.journal.count(),1);await f.recon.one(f.a.scope,first.id,f.journal);assert.ok(f.work.claim(f.a.scope,second.id));}));
test('M02-G14-REVIEW-ONE-ACTIVE-RESOURCE-WRITER',()=>useReliability(f=>{const a=f.executeOperation('refund','first').op,b=f.executeOperation('none','second').op;assert.ok(f.work.claim(f.a.scope,a.id));assert.equal(f.work.claim(f.a.scope,b.id),null);assert.equal(f.ops.read(f.a.scope,b.id).work.attempts,0);}));
test('M02-G17-REVIEW-CORRECTION-REASON-RETAINED',()=>useReliability(async f=>{const {op}=f.executeOperation();f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,op.id,f.journal);const old=f.receipts.list(f.a.scope,op.id).at(-1)!;await f.recon.one(f.a.scope,op.id,f.journal);const observed=f.receipts.list(f.a.scope,op.id).at(-1)!;const r=f.receipts.correct(f.owner.scope,{receipt_id:old.receipt.id,replacement_receipt_id:observed.receipt.id,reason:'reconciled_source'});assert.equal((r as any).correction_reason,'reconciled_source');}));
