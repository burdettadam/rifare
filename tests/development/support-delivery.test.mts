import test from 'node:test';import assert from 'node:assert/strict';import {usingSupport} from './support-helpers.mts';
test('CASE-M05-G04-01',()=>usingSupport(async f=>{const q=f.delivery.queue(f.a.scope,f.message());const r=await f.delivery.dispatch(f.a.scope,q.operation_id);assert.equal(r.state,'accepted');assert.equal(r.customer_delivered,false);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM support_source_effects').get().n,1);}));
test('CASE-M05-G04-02',()=>usingSupport(f=>{assert.throws(()=>f.delivery.queue(f.b.scope,f.message()));assert.throws(()=>f.delivery.queue(f.a.scope,f.message({template_id:'arbitrary'})),/TEMPLATE_UNSUPPORTED/);assert.equal(f.source.calls,0);}));
test('CASE-M05-G04-03',()=>usingSupport(async f=>{const q=f.delivery.queue(f.a.scope,f.message());f.source.fault='after';assert.equal((await f.delivery.dispatch(f.a.scope,q.operation_id)).state,'unknown');assert.equal(f.delivery.queue(f.a.scope,f.message()).operation_id,q.operation_id);await f.delivery.dispatch(f.a.scope,q.operation_id);assert.equal(f.source.calls,1);assert.equal((await f.delivery.reconcile(f.a.scope,q.operation_id)).state,'accepted');}));
test('CASE-M05-G06-01',()=>usingSupport(async f=>{f.consent.record(f.customer,f.grant());const q=f.delivery.queue(f.a.scope,f.message({template_id:'marketing_test_v1'}));f.advance(1);f.consent.record(f.customer,f.grant({state:'withdrawn',event_id:'stop',source_version:2}));await assert.rejects(()=>f.delivery.dispatch(f.a.scope,q.operation_id),/DELIVERY_SUPPRESSED/);assert.equal(f.source.calls,0);assert.equal(f.delivery.inspect(f.a.scope,q.operation_id).state,'suppressed');}));
test('CASE-M05-G06-02',()=>usingSupport(f=>{assert.throws(()=>f.delivery.queue(f.a.scope,{...f.message({template_id:'marketing_test_v1'}),purpose:'transactional'}));assert.equal(f.source.calls,0);}));
test('CASE-M05-G06-03',()=>usingSupport(async f=>{f.consent.record(f.customer,f.grant());const q=f.delivery.queue(f.a.scope,f.message({template_id:'marketing_test_v1'}));await assert.rejects(()=>f.delivery.dispatch(f.a.scope,q.operation_id,{beforeFinal:async()=>{f.advance(1);f.consent.record(f.customer,f.grant({event_id:'stop',state:'withdrawn',source_version:2}));}}),/DELIVERY_SUPPRESSED/);assert.equal(f.source.calls,0);}));
test('M05-G04-07',()=>usingSupport(async f=>{const q=f.delivery.queue(f.a.scope,f.message());await f.delivery.dispatch(f.a.scope,q.operation_id);f.advance(1);f.source.observe(q.operation_id,'delivered',2);const r=await f.delivery.reconcile(f.a.scope,q.operation_id);assert.equal(r.customer_delivered,true);assert.equal(r.state,'delivered');assert.equal(f.source.calls,1);}));
test('M05-G04-08',()=>usingSupport(async f=>{const q=f.delivery.queue(f.a.scope,f.message());const sh=f.kernel.lookup(f.a.scope,'shipment','synthetic','SHIP-1001');f.kernel.ingest(f.a.scope,{kind:'shipment',source_system:'synthetic',external_id:sh.external_id,source_version:sh.source_version+1,source_updated_at:f.now(),customer_id:sh.customer_id,payload:{...sh.payload,status:'delivered'}});await assert.rejects(()=>f.delivery.dispatch(f.a.scope,q.operation_id),/MESSAGE_FACTS_CHANGED/);assert.equal(f.source.calls,0);}));
test('M05-G11-04',()=>usingSupport(async f=>{const q=f.delivery.queue(f.a.scope,f.message());f.ownership.takeover(f.owner.scope,{case_id:'case_one',expected_generation:1,reason:'operator_requested'});await assert.rejects(()=>f.delivery.dispatch(f.a.scope,q.operation_id),/OWNERSHIP_CHANGED/);assert.equal(f.source.calls,0);}));
