import test from 'node:test';
import assert from 'node:assert/strict';
import { randomBytes } from 'node:crypto';
import { writeFileSync, readFileSync, chmodSync, mkdirSync, symlinkSync } from 'node:fs';
import { join } from 'node:path';
import { commerceFixture } from './commerce-helpers.mts';
import { SecretVault, readWrappingKey } from '../../packages/commerce/secrets.mts';

function setup(){const f=commerceFixture(),one=randomBytes(32),two=randomBytes(32);const keys={activeId:'key-one',get:(id:string)=>id==='key-one'?one:id==='key-two'?two:undefined};
 const seen:string[]=[];const vault=new SecretVault(f.kernel,keys,{'local-probe':(b)=>{seen.push(b.toString());return true;}});
 const put=(scope=f.a.scope,value='SYNTHETIC-ALPHA-CREDENTIAL')=>vault.put(scope,{provider:'model',adapter:'local-probe',value});
 return {...f,keys,one,two,seen,vault,put};}
const use=async(fn:(f:ReturnType<typeof setup>)=>unknown)=>{const f=setup();try{return await fn(f);}finally{f.cleanup();}};
test('M01-G03-01',()=>use(async f=>{const a=f.put(),b=f.put(f.b.scope,'SYNTHETIC-BETA-CREDENTIAL');await f.vault.probe(f.a.worker,a.ref,'local-probe');await f.vault.probe(f.b.worker,b.ref,'local-probe');assert.deepEqual(f.seen,['SYNTHETIC-ALPHA-CREDENTIAL','SYNTHETIC-BETA-CREDENTIAL']);}));
test('M01-G03-02',()=>use(async f=>{const a=f.put();const response=await f.vault.probe(f.a.scope,a.ref,'local-probe');assert.equal(JSON.stringify([a,response,f.vault.list(f.a.scope),f.kernel.auditRows(f.a.scope)]).includes('SYNTHETIC-ALPHA-CREDENTIAL'),false);assert.equal(readFileSync(f.filename).includes(Buffer.from('SYNTHETIC-ALPHA-CREDENTIAL')),false);assert.equal(JSON.stringify(f.db.prepare('SELECT * FROM commerce_secrets').all()).includes('SYNTHETIC-ALPHA-CREDENTIAL'),false);}));
test('M01-G03-03',()=>use(async f=>{const a=f.put();await assert.rejects(f.vault.probe(f.b.scope,a.ref,'local-probe'),/^Error: SECRET_UNAVAILABLE$/);f.keys.get=()=>undefined;await assert.rejects(f.vault.probe(f.a.scope,a.ref,'local-probe'),/^Error: SECRET_UNAVAILABLE$/);assert.deepEqual(f.seen,[]);}));
test('M01-G03-04',()=>use(async f=>{const a=f.put();let env=JSON.parse(f.db.prepare('SELECT envelope FROM commerce_secrets WHERE ref=?').get(a.ref).envelope);env.data.tag=Buffer.alloc(16).toString('base64');f.db.prepare('UPDATE commerce_secrets SET envelope=? WHERE ref=?').run(JSON.stringify(env),a.ref);await assert.rejects(f.vault.probe(f.a.scope,a.ref,'local-probe'),/SECRET_UNAVAILABLE/);assert.equal(f.seen.length,0);}));
test('M01-G03-05',()=>use(async f=>{const a=f.put(),b=f.put(f.b.scope);const env=f.db.prepare('SELECT envelope FROM commerce_secrets WHERE ref=?').get(b.ref).envelope;f.db.prepare('UPDATE commerce_secrets SET envelope=? WHERE ref=?').run(env,a.ref);await assert.rejects(f.vault.probe(f.a.scope,a.ref,'local-probe'),/SECRET_UNAVAILABLE/);}));
test('M01-G03-06',()=>use(async f=>{const a=f.put();f.db.prepare("UPDATE commerce_secrets SET provider='commerce' WHERE ref=?").run(a.ref);await assert.rejects(f.vault.probe(f.a.scope,a.ref,'local-probe'),/SECRET_UNAVAILABLE/);}));
test('M01-G03-07',()=>use(f=>{const a=f.put(),b=f.put();assert.notEqual(a.ref,b.ref);const rows=f.db.prepare('SELECT envelope FROM commerce_secrets').all();assert.notEqual(rows[0].envelope,rows[1].envelope);assert.match(a.ref,/^sec_[A-Za-z0-9_-]{43}$/);}));
test('M01-G03-08',()=>use(async f=>{const a=f.put();const bad=new SecretVault(f.kernel,f.keys,{'local-probe':()=>{throw new Error('SYNTHETIC-ALPHA-CREDENTIAL');}});await assert.rejects(bad.probe(f.a.scope,a.ref,'local-probe'),/^Error: ADAPTER_UNAVAILABLE$/);}));
test('M01-G03-09',()=>use(async f=>{const a=f.put();const bad=new SecretVault(f.kernel,f.keys,{'local-probe':(b)=>b.toString() as any});await assert.rejects(bad.probe(f.a.scope,a.ref,'local-probe'),/^Error: ADAPTER_UNAVAILABLE$/);}));
test('M01-G03-10',()=>use(async f=>{const a=f.put();f.vault.revoke(f.a.scope,a.ref);assert.deepEqual(f.vault.list(f.a.scope),[]);await assert.rejects(f.vault.probe(f.a.scope,a.ref,'local-probe'),/SECRET_UNAVAILABLE/);}));
test('M01-G03-11',()=>use(async f=>{const a=f.put();f.kernel.revoke(f.a.scope);await assert.rejects(f.vault.probe(f.a.scope,a.ref,'local-probe'),/ACCESS_DENIED/);assert.equal(f.seen.length,0);}));
test('M01-G03-12',()=>use(async f=>{const a=f.put();const before=JSON.parse(f.db.prepare('SELECT envelope FROM commerce_secrets WHERE ref=?').get(a.ref).envelope).data;f.keys.activeId='key-two';assert.equal(f.vault.rewrap(f.a.scope,a.ref).key_id,'key-two');f.keys.get=id=>id==='key-two'?f.two:undefined;assert.equal((await f.vault.probe(f.a.scope,a.ref,'local-probe')).configured,true);const after=JSON.parse(f.db.prepare('SELECT envelope FROM commerce_secrets WHERE ref=?').get(a.ref).envelope).data;assert.deepEqual(after,before);}));
test('M01-G03-13',()=>use(async f=>{const a=f.put();await assert.rejects(f.vault.probe(f.a.scope,a.ref,'unknown-adapter'),/SECRET_UNAVAILABLE/);assert.throws(()=>f.put(f.a.worker),/ACCESS_DENIED/);}));
test('M01-G03-14',()=>use(f=>{const root=join(f.directory,'source');mkdirSync(root);const key=join(f.directory,'wrapping.bin');writeFileSync(key,f.one,{mode:0o600});assert.deepEqual(readWrappingKey(key,root),f.one);chmodSync(key,0o644);assert.throws(()=>readWrappingKey(key,root),/^Error: KEY_UNAVAILABLE$/);}));
test('M01-G03-15',()=>use(f=>{const root=join(f.directory,'source');mkdirSync(root);const key=join(root,'wrapping.bin');writeFileSync(key,f.one,{mode:0o600});assert.throws(()=>readWrappingKey(key,root),/KEY_UNAVAILABLE/);const link=join(f.directory,'link');symlinkSync(key,link);assert.throws(()=>readWrappingKey(link,root),/KEY_UNAVAILABLE/);}));
test('M01-G03-16',()=>use(f=>{const root=join(f.directory,'source');mkdirSync(root);const key=join(f.directory,'wrapping.bin');writeFileSync(key,Buffer.alloc(31),{mode:0o600});assert.throws(()=>readWrappingKey(key,root),/KEY_UNAVAILABLE/);assert.throws(()=>readWrappingKey(join(f.directory,'missing'),root),/^Error: KEY_UNAVAILABLE$/);}));
test('M01-G03-17',()=>use(async f=>{const a=f.put();f.keys.get=()=>randomBytes(32);await assert.rejects(f.vault.probe(f.a.scope,a.ref,'local-probe'),/^Error: SECRET_UNAVAILABLE$/);}));
test('M01-G03-18',()=>use(async f=>{let held:Buffer|undefined;const v=new SecretVault(f.kernel,f.keys,{'local-probe':b=>{held=b;return true;}});const a=f.put();await v.probe(f.a.scope,a.ref,'local-probe');assert.ok(held);assert.ok(held.every(b=>b===0));assert.equal(f.one.some(b=>b!==0),true);}));
test('M01-G03-19',()=>use(async f=>{const a=f.put();const v=new SecretVault(f.kernel,f.keys,{'local-probe':()=>{f.vault.revoke(f.a.scope,a.ref);return true;}});await assert.rejects(v.probe(f.a.scope,a.ref,'local-probe'),/ADAPTER_UNAVAILABLE/);}));
