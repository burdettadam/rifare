import test from'node:test';import assert from'node:assert/strict';import{spawn}from'node:child_process';import{join}from'node:path';import{usingSupport}from'./support-helpers.mts';import{ModelBudgets}from'../../packages/commerce/model-budgets.mts';
function child(f:any,input:any){return new Promise<{code:number|null;out:string;err:string}>((resolve,reject)=>{const p=spawn(process.execPath,['--experimental-strip-types','tests/development/support-process-child.mts'],{stdio:['pipe','pipe','pipe']});let out='',err='';p.stdout.on('data',d=>out+=d);p.stderr.on('data',d=>err+=d);p.on('error',reject);p.on('close',code=>resolve({code,out,err}));p.stdin.end(JSON.stringify({database:f.filename,source_database:join(f.directory,'support-source.sqlite'),token:f.a.bearer,at:f.now(),...input}));});}
test('M05-G09-PROCESS-01',()=>usingSupport(async f=>{const b=new ModelBudgets(f.kernel);b.configure(f.owner.scope,{provider_id:'fixture',period_id:'period',starts_at:f.now(),ends_at:f.now()+60000,limit_micro:'1000',input_micro:'1',output_micro:'2',max_input_bytes:10000,max_output_tokens:64,expected_revision:0});const request={model:'fixture',max_output_tokens:64,instruction:'read',context:{},turns:[]},results=await Promise.all([child(f,{mode:'budget',id:'one',request}),child(f,{mode:'budget',id:'two',request})]);for(const r of results)assert.equal(r.code,0,r.err);const parsed=results.map(r=>JSON.parse(r.out));assert.equal(parsed.filter(r=>r.reserved).length,1);assert.equal(parsed.filter(r=>r.error==='MODEL_BUDGET_EXHAUSTED').length,1);assert.equal(b.inspect(f.a.scope,'fixture','period').reservation_count,1);}));
test('M05-G04-PROCESS-01',()=>usingSupport(async f=>{const q=f.delivery.queue(f.a.scope,f.message()),r=await child(f,{mode:'crash-send',operation_id:q.operation_id});assert.equal(r.code,73,r.err);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM support_source_effects').get().n,1);f.advance(30001);const observed=await f.delivery.reconcile(f.a.scope,q.operation_id);assert.equal(observed.state,'accepted');await f.delivery.dispatch(f.a.scope,q.operation_id);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM support_source_effects').get().n,1);assert.equal(f.source.calls,0);}));
