import test from 'node:test';import assert from 'node:assert/strict';
import { usingResolution } from './resolution-helpers.mts';
test('CASE-M03-G08-01',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));const r=await f.executor.dispatch(f.a.scope,op.id);assert.equal(r.state,'accepted');assert.equal(r.cash_settled,false);f.source.settle(op.id);assert.equal((await f.executor.reconcile(f.a.scope,op.id)).cash_settled,true);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,1);}));
import { ResolutionExecution } from '../../packages/commerce/resolution-execution.mts';
import { ResolutionFixtureSource } from '../../packages/adapters/resolution-fixture-source.mts';
import { CommerceKernel } from '../../packages/commerce/kernel.mts';
import { ExecutionStops } from '../../packages/commerce/execution-stops.mts';
import { DatabaseSync } from 'node:sqlite';
import { execFile } from 'node:child_process';import { promisify } from 'node:util';
const exec=promisify(execFile);
export async function child(f:any,operationId:string,die=false){const code=`import {DatabaseSync} from 'node:sqlite';import {CommerceKernel} from './packages/commerce/kernel.mts';import {ResolutionExecution} from './packages/commerce/resolution-execution.mts';import {ResolutionFixtureSource} from './packages/adapters/resolution-fixture-source.mts';
 const d=new DatabaseSync(${JSON.stringify(f.filename)}),sdb=new DatabaseSync(${JSON.stringify(f.sourceFilename)}),k=new CommerceKernel(d,()=>${f.now()}),s=new ResolutionFixtureSource(sdb,{mode:'fixture',identity:'source-one',tenant:${JSON.stringify(f.a.tenant)},store:${JSON.stringify(f.a.store)}});
 ${die?`const issue=s.issue.bind(s);s.issue=async p=>{await issue(p);process.exit(29);};`:''}
 try{const r=await new ResolutionExecution(k,s).dispatch(k.authenticate(${JSON.stringify(f.a.bearer)}),${JSON.stringify(operationId)});console.log(JSON.stringify({id:r.id,state:r.state}));}finally{d.close();sdb.close();}`;
 return exec(process.execPath,['--experimental-strip-types','--input-type=module','-e',code],{cwd:process.cwd(),timeout:15000});}
test('CASE-M03-G08-02',()=>usingResolution(async f=>{const intent=f.intent();intent.lines[1].outcome='refund';const p=f.allocate(intent),first=f.authorize(f.quote(p.allocations[0])),second=f.authorize(f.quote(p.allocations[1]));await Promise.all([child(f,first.id),child(f,second.id)]);const rows=f.sourceDb.prepare('SELECT body FROM fixture_resolution_effects').all().map((r:any)=>JSON.parse(r.body));assert.equal(rows.length,2);assert.equal(rows.filter(r=>r.state==='accepted').length,1);assert.equal(rows.filter(r=>r.state==='rejected').length,1);const total=rows.filter(r=>r.state==='accepted').reduce((n,r)=>n+BigInt(r.amount_minor),0n);assert.ok(total<=1726n);},{sourceBalance:'1726'}));
test('M03-G08-TWO-PROCESSES-SAME-OBLIGATION',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));const result=await Promise.all([child(f,op.id),child(f,op.id)]);assert.equal(result.length,2);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,1);assert.equal(f.executor.read(f.a.scope,op.id).state,'accepted');}));
test('CASE-M03-G08-03',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));await assert.rejects(()=>child(f,op.id,true),(e:any)=>e.code===29);assert.equal(f.executor.read(f.a.scope,op.id).state,'unknown');await f.executor.dispatch(f.a.scope,op.id);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,1);assert.equal((await f.executor.reconcile(f.a.scope,op.id)).state,'accepted');}));
test('M03-G08-LOST-RESPONSE-RECONCILED-NOT-RESENT',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0])),send=f.source.issue.bind(f.source);let count=0;f.source.issue=async input=>{count++;await send(input);throw new Error('lost');};assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');await f.executor.dispatch(f.a.scope,op.id);assert.equal(count,1);assert.equal((await f.executor.reconcile(f.a.scope,op.id)).state,'accepted');}));
test('M03-G08-ORIGINAL-PAYMENT-REFERENCE-PRESERVED',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));await f.executor.dispatch(f.a.scope,op.id);assert.equal((await f.source.lookup(op.id)).payment_id,'payment-one');}));
test('M03-G08-NATIVE-BALANCE-RECHECK-REJECTS-OVERREFUND',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));const r=await f.executor.dispatch(f.a.scope,op.id);assert.equal(r.state,'rejected');assert.equal(r.cash_settled,false);assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'rejected');},{sourceBalance:'1'}));
test('M03-G08-SOURCE-REJECTED-DOES-NOT-RESOLVE-UNIT',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));await f.executor.dispatch(f.a.scope,op.id);assert.equal(f.ledger.read(f.a.scope,p.id).remaining_obligation_minor,'3900');},{sourceBalance:'1'}));
test('M03-G08-WRONG-AMOUNT-RESPONSE-UNKNOWN',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0])),issue=f.source.issue.bind(f.source);f.source.issue=async input=>({...await issue(input),amount_minor:'9999'});assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');assert.equal((await f.executor.reconcile(f.a.scope,op.id)).state,'accepted');}));
test('M03-G08-WRONG-CURRENCY-RESPONSE-UNKNOWN',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0])),issue=f.source.issue.bind(f.source);f.source.issue=async input=>({...await issue(input),currency:'EUR'});assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');}));
test('M03-G08-CUSTOMER-CANNOT-DISPATCH',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));await assert.rejects(()=>f.executor.dispatch(f.customer,op.id),/ACCESS_DENIED/);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);}));
test('M03-G08-CROSS-STORE-OPERATION-HIDDEN',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));assert.throws(()=>f.executor.read(f.b.scope,op.id),/NOT_FOUND/);}));
test('M03-G08-REVOKED-APPROVAL-BLOCKS-SEND',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));f.gateway.revokeApproval(f.reviewer.scope,op.approval.id);await assert.rejects(()=>f.executor.dispatch(f.a.scope,op.id),/APPROVAL_AUTHORITY_CHANGED/);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);}));
test('M03-G08-REVOKED-REVIEWER-BLOCKS-SEND',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));f.permissions.change(f.owner.scope,{actor_id:'reviewer',role:'reviewer',expected_revision:0,actions:['return.read'],resource_ids:null});await assert.rejects(()=>f.executor.dispatch(f.a.scope,op.id),/APPROVAL_AUTHORITY_CHANGED/);}));
test('M03-G08-STOP-BLOCKS-DISPATCH',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));new ExecutionStops(f.kernel).set(f.owner.scope,{action:'diagnostic.return.resolve',stopped:true,reason:'incident',expected_revision:0});await assert.rejects(()=>f.executor.dispatch(f.a.scope,op.id),/EXECUTION_STOPPED/);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);}));
test('M03-G08-STOP-ALLOWS-RECONCILIATION',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0])),issue=f.source.issue.bind(f.source);f.source.issue=async input=>{await issue(input);throw new Error('lost');};await f.executor.dispatch(f.a.scope,op.id);new ExecutionStops(f.kernel).set(f.owner.scope,{action:'diagnostic.return.resolve',stopped:true,reason:'incident',expected_revision:0});assert.equal((await f.executor.reconcile(f.a.scope,op.id)).state,'accepted');}));
test('M03-G08-MISSING-LOOKUP-REMAINS-UNKNOWN',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));f.source.issue=async()=>{throw new Error('before_send_unknown');};await f.executor.dispatch(f.a.scope,op.id);assert.equal((await f.executor.reconcile(f.a.scope,op.id)).state,'unknown');assert.equal(f.executor.read(f.a.scope,op.id).retry_allowed,false);}));
test('M03-G08-SETTLEMENT-CANNOT-REGRESS',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));await f.executor.dispatch(f.a.scope,op.id);f.source.settle(op.id);await f.executor.reconcile(f.a.scope,op.id);const lookup=f.source.lookup.bind(f.source);f.source.lookup=async id=>({...await lookup(id),state:'accepted'});await assert.rejects(()=>f.executor.reconcile(f.a.scope,op.id),/RESOLUTION_STAGE_REGRESSION/);}));
test('M03-G08-RECEIPTS-APPEND-ONLY',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));await f.executor.dispatch(f.a.scope,op.id);assert.throws(()=>f.db.exec("UPDATE commerce_resolution_observations SET stage='settled'"),/RESOLUTION_RECEIPT_IMMUTABLE/);assert.throws(()=>f.db.exec('DELETE FROM commerce_resolution_observations'),/RESOLUTION_RECEIPT_IMMUTABLE/);}));
test('M03-G08-SAME-DATABASE-SOURCE-DENIED',()=>usingResolution(f=>{const source=new ResolutionFixtureSource(f.db,{mode:'fixture',identity:'unqualified',tenant:f.a.tenant,store:f.a.store});assert.throws(()=>new ResolutionExecution(f.kernel,source),/SEPARATE_FIXTURE_SOURCE_REQUIRED/);}));
test('M03-G08-ORIGINAL-DUPLICATE-OBLIGATION-REPLAY',()=>usingResolution(async f=>{const p=f.allocate(),op=f.authorize(f.quote(p.allocations[0]));await f.executor.dispatch(f.a.scope,op.id);await f.executor.dispatch(f.a.scope,op.id);await f.executor.reconcile(f.a.scope,op.id);await f.executor.reconcile(f.a.scope,op.id);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,1);assert.equal(f.executor.read(f.a.scope,op.id).observations.filter(o=>o.stage==='accepted').length,1);}));
