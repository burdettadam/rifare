import test from 'node:test';import assert from 'node:assert/strict';
import { usingControls,credentials } from './worker-controls-helpers.mts';
import { useModel } from './agent-provider-helpers.mts';
import { ExecutionStops } from '../../packages/commerce/execution-stops.mts';

test('M02-G22-REVIEW-EXACT-CASE-NOT-FIRST-SAME-ORDER',()=>usingControls(f=>{f.create('case_000');const {op}=f.executeOperation();f.claim();const item=f.queue.list(f.a.scope).items.find(i=>i.operation_id===op.id)!;assert.equal(item.case_id,'case_one');assert.equal(item.owner,'agent');}));
test('M02-G22-REVIEW-TIMELINE-CHRONOLOGICAL',()=>usingControls(async f=>{const w=f.claim();f.advance(1);const sub=f.api.submit(w.g.token,f.audience,f.submission(w));f.advance(1);const approval=f.approve(sub.preview);f.api.execute(w.g.token,f.audience,{generation:w.lease.generation,envelope:w.context().envelope,submission_id:sub.id,approval_id:approval.id});f.advance(1);f.api.leases.release(f.owner.scope,'case_one');const item=f.queue.list(f.a.scope).items.find(i=>i.operation_id)!;assert.ok(item.timeline.length>2);const times=item.timeline.map(t=>t.observed_at);assert.deepEqual(times,[...times].sort((a,b)=>a-b));}));
test('M02-G20-REVIEW-PROBE-DEADLINE-NO-LATE-SUCCESS',()=>usingControls(async f=>{let release!:(b:boolean)=>void,calls=0;const c=credentials(f,()=>{calls++;return new Promise(r=>release=r);});c.put();const result=await c.service.probe(f.a.scope,'test-model');assert.equal(result.state,'unknown');assert.equal(result.configured,null);assert.equal(calls,1);release(true);await new Promise(r=>setTimeout(r,5));assert.equal(c.service.history(f.owner.scope,'test-model')[0].state,'unknown');}));
test('M02-G21-REVIEW-STOP-ACTUAL-RUNNER-AFTER-PROVIDER',()=>useModel(async f=>{const stops=new ExecutionStops(f.kernel);let changed=false;f.setBefore(()=>{if(!changed){changed=true;stops.setGlobal({stopped:true,expected_revision:0,reason:'incident'});}});await assert.rejects(f.runner.run(f.a.scope,f.task.id,'openai'),/EXECUTION_STOPPED/);assert.equal(f.requests.length,1);}));
test('M02-G18-REVIEW-COMPLETION-RECHECKS-PARENT-SESSION',()=>usingControls(f=>{const w=f.claim();f.kernel.revoke(f.agent.scope);assert.throws(()=>f.api.leases.complete(w.g.token,f.audience,{generation:w.lease.generation,request_key:'done',outcome:'handoff',submission_id:null}),/ACCESS_DENIED|INVALID_SESSION/);}));
test('M02-G19-REVIEW-REVOKED-GRANT-CANNOT-READ-OLD-RESULT',()=>usingControls(f=>{const w=f.claim(),s=f.api.submit(w.g.token,f.audience,f.submission(w));f.api.leases.release(f.owner.scope,'case_one');assert.throws(()=>f.api.result(w.g.token,f.audience,s.id),/WORK_ACCESS_DENIED/);}));
test('M02-G19-REVIEW-HISTORICAL-RESULT-RECHECKS-CURRENT-PERMISSIONS',()=>usingControls(f=>{const w=f.claim(),sub=f.api.submit(w.g.token,f.audience,f.submission(w));f.permissions.change(f.owner.scope,{actor_id:'agent',role:'agent',expected_revision:0,actions:['work.claim'],resource_ids:null});assert.throws(()=>f.api.result(w.g.token,f.audience,sub.id),/ACCESS_DENIED/);}));
test('M02-G18-REVIEW-HEADLESS-DEMO-SAME-OPERATION-ONE-EFFECT',()=>usingControls(async()=>{const {spawnSync}=await import('node:child_process');const result=spawnSync(process.execPath,['--experimental-strip-types','tools/demo-worker-controls.mts'],{encoding:'utf8',timeout:10000});assert.equal(result.status,0,result.stderr);const demo=JSON.parse(result.stdout);assert.equal(demo.late_worker,'WORK_FENCE_REJECTED');assert.equal(demo.unresolved_effect_blocks_proposal,'RECONCILIATION_REQUIRED');assert.equal(demo.source_effects,1);assert.equal(demo.external_calls,0);assert.deepEqual(demo.credential_calls.map(c=>c.version),[1,2]);}));
