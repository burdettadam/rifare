import test from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';
import {usingGift} from './gift-helpers.mts';import {FulfillmentFixtureSource} from '../../packages/adapters/fulfillment-fixture-source.mts';
import {FulfillmentConfiguration} from '../../packages/commerce/return-fulfillment-core.mts';import {ReplacementInventory} from '../../packages/commerce/replacement-inventory.mts';import {ReplacementOrders} from '../../packages/commerce/replacement-orders.mts';import {FulfillmentExecution} from '../../packages/commerce/fulfillment-execution.mts';import {ExchangeFinance} from '../../packages/commerce/exchange-finance.mts';import {PrivacyLifecycle} from '../../packages/commerce/privacy-lifecycle.mts';
async function setup(f:any,price='1000',grant=true){const plan=await f.authorizeGift(),gift=f.cases.verified(f.a.scope,'gift_case'),db=new DatabaseSync(':memory:');try{if(grant)f.source.seedGiftRecipient({resource_id:f.giftOrder.id,recipient_customer_id:gift.recipient_customer_id,gift_source_digest:gift.source_digest});
 const source=new FulfillmentFixtureSource(db,{mode:'fixture',identity:'gift-fulfillment',tenant:f.a.tenant,store:f.a.store,clock:f.now,finance_source:f.source});new FulfillmentConfiguration(f.kernel).configure(f.owner.scope,{expected_revision:0,enabled:true,source_identity:source.identity,account_id:'gift-carrier',expires_at:f.now()+300000,resolution_trigger:'carrier_delivery'});
 f.exchanges.configure(f.owner.scope,{expected_revision:0,enabled:true,catalog_wide:true,price_differences:true,allowed_product_ids:[],excluded_product_ids:[],excluded_categories:[],incentive_bps:0,incentive_cap_minor:'0',minimum_margin_bps:0,expires_at:f.now()+300000});
 const catalog=f.catalog({unit_price_minor:price}),q=f.exchanges.quote(f.a.scope,{allocation_id:plan.allocations[0].id,catalog_id:catalog.id});source.seedStock({catalog_id:catalog.id,variant_id:'shoe-large',location_id:'warehouse-one',version:1,available:5});
 const inventory=new ReplacementInventory(f.kernel,source),orders=new ReplacementOrders(f.kernel),execution=new FulfillmentExecution(f.kernel,source),reserve=()=>inventory.reserve(f.a.scope,{quote_id:q.id,quote_digest:q.digest,location_id:'warehouse-one',ttl_ms:50000}),authorize=(quote:any)=>{const p=f.gateway.prepare(f.a.scope,quote.proposal),a=f.gateway.approve(f.reviewer.scope,{preview_id:p.id,preview_digest:p.digest});return f.gateway.execute(f.a.scope,{preview_id:p.id,preview_digest:p.digest,approval_id:a.id}).fulfillment_operation_id;};
 return {db,source,plan,gift,catalog,q,inventory,orders,execution,reserve,authorize};}catch(error){db.close();throw error;}}
async function using(fn:(f:any,g:any)=>unknown,price='1000',grant=true){return usingGift(async f=>{const g=await setup(f,price,grant);try{return await fn(f,g);}finally{g.db.close();}});}
test('M06-G05-EXCHANGE-PRESERVES-PURCHASER-AND-RECIPIENT-LINEAGE',()=>using(async(f,g)=>{const reservation=g.reserve(),q=g.orders.quote(f.a.scope,{reservation_id:reservation.id});assert.equal(q.quote.pin.customer_id,f.giftOrder.customer_id);assert.equal(q.quote.details.gift_recipient_customer_id,'recipient-one');const op=g.authorize(q),r=await g.execution.dispatch(f.a.scope,op);assert.equal(r.state,'created');assert.equal(g.source.stock(g.catalog.id).available,4);const native=JSON.parse(g.db.prepare('SELECT body FROM fixture_replacements').get().body);assert.equal(native.customer_id,f.giftOrder.customer_id);assert.equal(native.original_order_id,f.giftOrder.id);assert.equal(native.gift_recipient_customer_id,'recipient-one');assert.equal(native.amount_minor,'0');assert.equal(native.exchange_value_minor,'1000');assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);}));
test('M06-G05-INDEPENDENT-GIFT-GRANT-REQUIRED',()=>using((f,g)=>{assert.throws(()=>g.reserve(),/GIFT_RECIPIENT_UNQUALIFIED/);assert.equal(g.source.stock(g.catalog.id).reserved,0);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_inventory_reservations').get().n,0);},'1000',false));
test('M06-G05-NATIVE-HOLD-DETECTS-DROPPED-RECIPIENT',()=>using(async(f,g)=>{const r=g.reserve(),op=g.authorize(g.orders.quote(f.a.scope,{reservation_id:r.id})),command=JSON.parse(f.db.prepare('SELECT command FROM commerce_fulfillment_operations WHERE id=?').get(op).command);delete command.gift_recipient_customer_id;delete command.gift_source_digest;delete command.gift_source_identity;await assert.rejects(()=>g.source.replace(command),/GIFT_RECIPIENT_MISMATCH/);assert.equal(g.source.effects().length,0);assert.equal(g.source.stock(g.catalog.id).available,5);}));
test('M06-G05-NATIVE-HOLD-DETECTS-CHANGED-RECIPIENT',()=>using(async(f,g)=>{const r=g.reserve(),op=g.authorize(g.orders.quote(f.a.scope,{reservation_id:r.id})),command=JSON.parse(f.db.prepare('SELECT command FROM commerce_fulfillment_operations WHERE id=?').get(op).command);command.gift_recipient_customer_id='another-recipient';await assert.rejects(()=>g.source.replace(command),/GIFT_RECIPIENT_MISMATCH/);assert.equal(g.source.effects().length,0);assert.equal(g.source.stock(g.catalog.id).available,5);}));
test('M06-G05-LOWER-PRICE-ISSUES-RECIPIENT-CREDIT-BEFORE-REPLACEMENT',()=>using(async(f,g)=>{const r=g.reserve();assert.throws(()=>g.orders.quote(f.a.scope,{reservation_id:r.id}),/EXCHANGE_PAYMENT_OUTSTANDING/);const finance=new ExchangeFinance(f.kernel);assert.throws(()=>finance.quote(f.a.scope,{exchange_quote_id:g.q.id,exchange_quote_digest:g.q.digest,outcome:'refund'}),/GIFT_OUTCOME_DENIED/);const q=finance.quote(f.a.scope,{exchange_quote_id:g.q.id,exchange_quote_digest:g.q.digest,outcome:'store_credit'}),op=f.authorize(q);assert.equal(q.quote.amount_minor,'100');assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'issued');const replacement=g.authorize(g.orders.quote(f.a.scope,{reservation_id:r.id}));assert.equal((await g.execution.dispatch(f.a.scope,replacement)).state,'created');assert.equal(f.credit.instrument(f.a.scope,f.executor,op.id).instrument.customer_id,'recipient-one');assert.equal(g.source.stock(g.catalog.id).available,4);},'900'));
test('M06-G05-ADDITIONAL-PAYMENT-NEEDS-SEPARATE-QUALIFICATION',()=>using((f,g)=>{assert.equal(g.q.quote.allowed,false);assert.ok(g.q.quote.reasons.includes('GIFT_ADDITIONAL_PAYMENT_UNQUALIFIED'));assert.deepEqual(g.q.quote.alternatives,['store_credit']);assert.throws(()=>g.reserve(),/EXCHANGE_UNAVAILABLE/);},'1200'));
test('M06-G05-UNKNOWN-REPLACEMENT-RECONCILES-AFTER-ERASURE',()=>using(async(f,g)=>{const r=g.reserve(),op=g.authorize(g.orders.quote(f.a.scope,{reservation_id:r.id}));g.source.fault='after';assert.equal((await g.execution.dispatch(f.a.scope,op)).state,'unknown');new PrivacyLifecycle(f.kernel).erase(f.owner.scope,'recipient-one');assert.equal((await g.execution.reconcile(f.a.scope,op)).state,'created');assert.equal(g.source.effects().length,1);assert.equal(g.source.stock(g.catalog.id).available,4);}));
test('M06-G05-NATIVE-HOLD-DETECTS-CHANGED-ORIGINAL-ORDER',()=>using(async(f,g)=>{const r=g.reserve(),op=g.authorize(g.orders.quote(f.a.scope,{reservation_id:r.id})),command=JSON.parse(f.db.prepare('SELECT command FROM commerce_fulfillment_operations WHERE id=?').get(op).command);for(const field of ['resource_id','original_order_id','native_original_order_id']){const changed={...command,[field]:field==='native_original_order_id'?'gid://shopify/Order/999999':'other_order'};await assert.rejects(()=>g.source.replace(changed),/GIFT_RECIPIENT_MISMATCH/);}assert.equal(g.source.effects().length,0);assert.equal(g.source.stock(g.catalog.id).available,5);}));
