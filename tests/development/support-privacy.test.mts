import test from 'node:test';import assert from 'node:assert/strict';import{usingSupport}from'./support-helpers.mts';import{PrivacyLifecycle,storageInventory}from'../../packages/commerce/privacy-lifecycle.mts';import{installSupportSkills}from'./support-workflow-helpers.mts';
test('M05-PRIVACY-01',()=>usingSupport(f=>{f.conversations.ingest(f.a.scope,{link_id:f.link.id,external_id:'message_one',direction:'incoming',visibility:'public',text:'PRIVATE_SUPPORT_SENTINEL',source_at:f.now()});const q=f.delivery.queue(f.a.scope,f.message());const exported=new PrivacyLifecycle(f.kernel).export(f.owner.scope,f.order().customer_id),text=JSON.stringify(exported);assert.ok(text.includes('PRIVATE_SUPPORT_SENTINEL'));assert.ok(text.includes(q.operation_id));assert.ok(!text.includes(f.a.bearer));assert.ok(!text.includes(f.kernel.require(f.a.scope).token_hash));assert.equal(exported.credentials_included,false);storageInventory(f.kernel);}));
test('M05-PRIVACY-02',()=>usingSupport(async f=>{const {workflows,digests}=installSupportSkills(f);f.conversations.ingest(f.a.scope,{link_id:f.link.id,external_id:'message_one',direction:'incoming',visibility:'public',text:'PRIVATE_SUPPORT_SENTINEL',source_at:f.now()});workflows.complete(f.a.scope,'case_one','support-reply',digests['support-reply'],'answer_one');const q=f.delivery.queue(f.a.scope,f.message()),beforeOther=f.kernel.list(f.b.scope,'order');const result=new PrivacyLifecycle(f.kernel).erase(f.owner.scope,f.order().customer_id);assert.equal(result.status,'logically_erased');for(const table of ['commerce_support_messages','commerce_support_contacts','commerce_support_attempts','commerce_support_deliveries']){const rows=f.db.prepare(`SELECT * FROM ${table} WHERE store_id=?`).all(f.a.store);const text=JSON.stringify(rows);assert.ok(!text.includes('PRIVATE_SUPPORT_SENTINEL'));assert.ok(!text.includes('shopper-apparel@example.invalid'));assert.ok(!text.includes('ORD-1001'));}await assert.rejects(()=>f.delivery.dispatch(f.a.scope,q.operation_id),/SUBJECT_ERASED|ACCESS_DENIED|NOT_FOUND/);assert.equal(f.source.calls,0);assert.deepEqual(f.kernel.list(f.b.scope,'order'),beforeOther);}));
test('M05-PRIVACY-03',()=>usingSupport(f=>{f.conversations.ingest(f.a.scope,{link_id:f.link.id,external_id:'message_one',direction:'incoming',visibility:'public',text:'HELD_SUPPORT_SENTINEL',source_at:f.now()});const privacy=new PrivacyLifecycle(f.kernel);privacy.hold(f.owner.scope,{customer_id:f.order().customer_id,reason:'dispute',authority_ref:'case_review',expires_at:f.now()+1000});assert.equal(privacy.erase(f.owner.scope,f.order().customer_id).status,'held');assert.equal(f.conversations.history(f.a.scope,'case_one').messages[0].text,'HELD_SUPPORT_SENTINEL');f.advance(1001);assert.equal(privacy.erase(f.owner.scope,f.order().customer_id).status,'logically_erased');}));
test('M05-PRIVACY-04',()=>usingSupport(async f=>{const q=f.delivery.queue(f.a.scope,f.message());new PrivacyLifecycle(f.kernel).uninstall(f.owner.scope);await assert.rejects(()=>f.delivery.dispatch(f.a.scope,q.operation_id),/ACCESS_DENIED/);assert.equal(f.source.calls,0);}));
