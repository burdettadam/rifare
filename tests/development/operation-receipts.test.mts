import test from 'node:test';import assert from 'node:assert/strict';
import { useReliability } from './reliability-helpers.mts';

test('CASE-M02-G17-01',()=>useReliability(async f=>{const {op}=f.executeOperation();f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,op.id,f.journal);const original=f.receipts.list(f.a.scope,op.id).at(-1)!;assert.equal(original.receipt.state,'unknown');await f.recon.one(f.a.scope,op.id,f.journal);const replacement=f.receipts.list(f.a.scope,op.id).at(-1)!;const correction=f.receipts.correct(f.owner.scope,{receipt_id:original.receipt.id,replacement_receipt_id:replacement.receipt.id,reason:'reconciled_source'});assert.equal(correction.correction_of,original.receipt.id);assert.equal(correction.source_ref,replacement.receipt.id);assert.deepEqual(f.receipts.read(f.a.scope,original.receipt.id),original);}));
test('CASE-M02-G17-02',()=>useReliability(f=>{const {op}=f.executeOperation(),r=f.receipts.list(f.a.scope,op.id)[0];assert.throws(()=>f.db.prepare("UPDATE commerce_operation_receipts SET body='{}'").run(),/RECEIPT_IMMUTABLE/);assert.throws(()=>f.receipts.attach(f.a.scope,{receipt_id:r.receipt.id,subject_ref:'customer-ref',kind:'customer_note',content:'Bearer secret-canary-token',expires_at:f.now()+1000}),/SENSITIVE_PAYLOAD_REJECTED/);assert.deepEqual(f.receipts.read(f.a.scope,r.receipt.id),r);}));
test('CASE-M02-G17-03',()=>useReliability(f=>{const {op}=f.executeOperation(),r=f.receipts.list(f.a.scope,op.id)[0],p=f.receipts.attach(f.a.scope,{receipt_id:r.receipt.id,subject_ref:'customer-ref',kind:'customer_note',content:'Removable private customer note',expires_at:f.now()+100});f.advance(101);assert.equal(f.receipts.erase(f.owner.scope,p.id).erased,true);assert.throws(()=>f.receipts.payload(f.a.scope,p.id),/NOT_FOUND/);const chain=f.receipts.list(f.a.scope,op.id);assert.equal(chain.at(-1)?.receipt.code,'payload_erased');assert.equal(JSON.stringify(chain).includes('Removable private customer note'),false);assert.equal(JSON.stringify(chain).includes('customer-ref'),false);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_receipt_payloads').get().n,0);}));
test('M02-G17-DELETE-RECEIPT-DENIED',()=>useReliability(f=>{f.executeOperation();assert.throws(()=>f.db.prepare('DELETE FROM commerce_operation_receipts').run(),/RECEIPT_IMMUTABLE/);}));
test('M02-G17-CHAIN-LINKS-ALL-TRANSITIONS',()=>useReliability(async f=>{const {op}=f.executeOperation();await f.work.dispatch(f.a.scope,op.id,f.journal);const c=f.receipts.list(f.a.scope,op.id);assert.deepEqual(c.map(r=>r.receipt.code),['queued','dispatch_started','source_confirmed']);assert.equal(c[0].receipt.previous_digest,null);assert.equal(c[1].receipt.previous_digest,c[0].digest);assert.equal(c[2].receipt.previous_digest,c[1].digest);}));
test('M02-G17-INITIAL-RECEIPT-AUTHORITY-PINS',()=>useReliability(f=>{const {op,r}=f.executeOperation(),receipt=f.receipts.list(f.a.scope,op.id)[0].receipt;assert.equal(receipt.approval_ref,r.approval_id);assert.equal(receipt.configuration_digest,r.configuration_digest);assert.match(receipt.policy_digest,/^[a-f0-9]{64}$/);assert.equal(receipt.actor_ref,'agent');assert.equal(receipt.source_ref,r.id);}));
test('M02-G17-SECRET-KEY-VARIANTS-BLOCKED',()=>useReliability(f=>{const {op}=f.executeOperation(),r=f.receipts.list(f.a.scope,op.id)[0];for(const content of ['password=123','api_key: canary','token=canary','-----BEGIN PRIVATE KEY-----','sk-abcdefghijk'])assert.throws(()=>f.receipts.attach(f.a.scope,{receipt_id:r.receipt.id,subject_ref:'c',kind:'customer_note',content,expires_at:f.now()+100}),/SENSITIVE_PAYLOAD_REJECTED/);}));
test('M02-G17-EXTRA-IMMUTABLE-PAYLOAD-FIELDS-REJECTED',()=>useReliability(f=>{const {op}=f.executeOperation(),r=f.receipts.list(f.a.scope,op.id)[0];assert.throws(()=>f.receipts.correct(f.owner.scope,{receipt_id:r.receipt.id,replacement_receipt_id:r.receipt.id,reason:'reconciled_source',secret:'canary'}),/INVALID_INPUT/);}));
test('M02-G17-CROSS-STORE-AUDIT-DENIED',()=>useReliability(f=>{const {op}=f.executeOperation(),r=f.receipts.list(f.a.scope,op.id)[0];assert.throws(()=>f.receipts.read(f.b.scope,r.receipt.id),/NOT_FOUND/);assert.throws(()=>f.receipts.list(f.b.scope,op.id),/NOT_FOUND/);}));
test('M02-G17-AGENT-NO-AUDIT-PAYLOAD-READ',()=>useReliability(f=>{const {op}=f.executeOperation(),r=f.receipts.list(f.a.scope,op.id)[0];assert.throws(()=>f.receipts.attach(f.agent.scope,{receipt_id:r.receipt.id,subject_ref:'c',kind:'customer_note',content:'private',expires_at:f.now()+100}),/ACCESS_DENIED/);}));
test('M02-G17-RETAIN-UNTIL-ELIGIBLE',()=>useReliability(f=>{const {op}=f.executeOperation(),r=f.receipts.list(f.a.scope,op.id)[0],p=f.receipts.attach(f.a.scope,{receipt_id:r.receipt.id,subject_ref:'c',kind:'customer_note',content:'private',expires_at:f.now()+100});assert.throws(()=>f.receipts.erase(f.owner.scope,p.id),/RETENTION_NOT_ELIGIBLE/);assert.equal(f.receipts.payload(f.a.scope,p.id).content,'private');}));
test('M02-G17-EXPIRED-PAYLOAD-NOT-READABLE',()=>useReliability(f=>{const {op}=f.executeOperation(),r=f.receipts.list(f.a.scope,op.id)[0],p=f.receipts.attach(f.a.scope,{receipt_id:r.receipt.id,subject_ref:'c',kind:'customer_note',content:'private',expires_at:f.now()+100});f.advance(101);assert.throws(()=>f.receipts.payload(f.a.scope,p.id),/PAYLOAD_EXPIRED/);}));
test('M02-G17-OPERATOR-CANNOT-ERASE',()=>useReliability(f=>{const {op}=f.executeOperation(),r=f.receipts.list(f.a.scope,op.id)[0],p=f.receipts.attach(f.a.scope,{receipt_id:r.receipt.id,subject_ref:'c',kind:'customer_note',content:'private',expires_at:f.now()+100});f.advance(101);assert.throws(()=>f.receipts.erase(f.a.scope,p.id),/ACCESS_DENIED/);}));
test('M02-G17-UNOBSERVED-SUCCESS-CANNOT-CORRECT',()=>useReliability(f=>{const {op}=f.executeOperation(),r=f.receipts.list(f.a.scope,op.id)[0];assert.throws(()=>f.receipts.correct(f.owner.scope,{receipt_id:r.receipt.id,replacement_receipt_id:r.receipt.id,reason:'reconciled_source'}),/CORRECTION_INVALID/);}));
test('M02-G17-DIFFERENT-OPERATION-CORRECTION-DENIED',()=>useReliability(async f=>{const a=f.executeOperation('refund','a').op,b=f.executeOperation('none','b').op;await f.work.dispatch(f.a.scope,a.id,f.journal);await f.work.dispatch(f.a.scope,b.id,f.journal);assert.throws(()=>f.receipts.correct(f.owner.scope,{receipt_id:f.receipts.list(f.a.scope,a.id)[0].receipt.id,replacement_receipt_id:f.receipts.list(f.a.scope,b.id).at(-1)!.receipt.id,reason:'reconciled_source'}),/CORRECTION_INVALID/);}));
test('M02-G17-ERASURE-ROLLS-BACK-WITH-AUDIT-FAILURE',()=>useReliability(f=>{const {op}=f.executeOperation(),r=f.receipts.list(f.a.scope,op.id)[0],p=f.receipts.attach(f.a.scope,{receipt_id:r.receipt.id,subject_ref:'c',kind:'customer_note',content:'private',expires_at:f.now()+100});f.advance(101);f.db.exec("CREATE TRIGGER no_audit BEFORE INSERT ON commerce_operation_receipts BEGIN SELECT RAISE(ABORT,'full');END;");assert.throws(()=>f.receipts.erase(f.owner.scope,p.id),/full/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_receipt_payloads').get().n,1);}));
test('M02-G17-CHAIN-CORRUPTION-DETECTED',()=>useReliability(f=>{const {op}=f.executeOperation();f.db.exec('DROP TRIGGER commerce_operation_receipts_no_update');f.db.prepare("UPDATE commerce_operation_receipts SET body='{}'").run();assert.throws(()=>f.receipts.list(f.a.scope,op.id),/RECEIPT_INTEGRITY/);}));
test('M02-G17-CUSTOMER-NOTE-SIZE-BOUNDED',()=>useReliability(f=>{const {op}=f.executeOperation(),r=f.receipts.list(f.a.scope,op.id)[0];assert.throws(()=>f.receipts.attach(f.a.scope,{receipt_id:r.receipt.id,subject_ref:'c',kind:'customer_note',content:'x'.repeat(2049),expires_at:f.now()+100}),/SENSITIVE_PAYLOAD_REJECTED/);}));
