import test from 'node:test';import assert from 'node:assert/strict';
import { usingLineage } from './exchange-lineage-helpers.mts';
import { usingMoney } from './exchange-money-helpers.mts';
import { usingInstant,authorizeMandate,releaseReplacement,oracle } from './instant-helpers.mts';
import { startCommerceServer } from '../../apps/commerce-api/server.mts';

async function server(f:any,sources:any,fn:(post:any,app:any)=>unknown){const log:any[]=[],app=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,...sources,log:r=>log.push(r)});try{return await fn(async(path:string,input:any,bearer:string|null=f.a.bearer)=>{const r=await fetch(app.url+path,{method:'POST',headers:{'content-type':'application/json',...(bearer?{authorization:'Bearer '+bearer}:{})},body:JSON.stringify(input)});return {status:r.status,body:await r.json()};},{...app,log});}finally{await app.close();}}
const lineageSources=(f:any)=>({lineageSource:f.lineageSource,resolutionSource:f.source,fulfillmentSource:f.fulfillmentSource});
test('M06-G06-HTTP-MATERIALIZES-DELIVERED-FUNDED-CHILD',()=>usingLineage(async f=>{const p=await f.makeExchange(f.allocation,'1400');await server(f,lineageSources(f),async post=>{const r=await post('/v1/exchange-lineage/materialize',{operation_id:p.op.id});assert.equal(r.status,200);assert.equal(r.body.state,'imported');assert.equal(r.body.node.carried_minor,'1200');assert.equal(r.body.node.replacement_retail_minor,'1400');const read=await post('/v1/exchange-lineage/node',{node_id:r.body.node.id});assert.deepEqual(read.body,r.body);assert.equal(f.lineageSource.lookup(p.op.id).resource_id,r.body.node.resource_id);});},{discount:true}));
test('M06-G06-HTTP-SCOPE-AND-EXACT-INPUT-PROTECT-LINEAGE',()=>usingLineage(async f=>{const p=await f.makeExchange(f.allocation,'1000');await server(f,lineageSources(f),async post=>{assert.equal((await post('/v1/exchange-lineage/materialize',{operation_id:p.op.id},null)).status,403);assert.equal((await post('/v1/exchange-lineage/materialize',{operation_id:p.op.id,carried_minor:'2000'})).status,400);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_exchange_lineage_nodes').get().n,0);const r=await post('/v1/exchange-lineage/materialize',{operation_id:p.op.id});assert.equal((await post('/v1/exchange-lineage/node',{node_id:r.body.node.id},f.b.bearer)).status,404);});}));
test('M06-G06-HTTP-REQUIRES-EXPLICIT-NATIVE-SOURCE',()=>usingLineage(f=>server(f,{},async post=>{assert.deepEqual(await post('/v1/exchange-lineage/materialize',{operation_id:'unavailable'}),{status:503,body:{error:'ADAPTER_UNAVAILABLE'}});})));
test('M06-G07-HTTP-READS-ORIGINAL-PAIRED-MONEY',()=>usingMoney(f=>server(f,{resolutionSource:f.source},async post=>{const r=await post('/v1/exchange-money/currency',{allocation_id:f.allocation.id});assert.equal(r.status,200);assert.equal(r.body.binding.shop_currency,'USD');assert.equal(r.body.binding.presentment_currency,'EUR');assert.equal(r.body.binding.components.shop.paid_minor,'1940');assert.equal(r.body.binding.components.presentment.paid_minor,'1746');assert.equal(r.body.live_financial_authority,false);assert.equal((await post('/v1/exchange-money/bind',{allocation_id:f.allocation.id,presentment_minor:'2134'})).status,400);assert.equal(f.effects(),0);})));
test('M06-G08-HTTP-FINAL-OBSERVATION-RETAINS-ESTIMATE',()=>usingMoney(f=>server(f,{resolutionSource:f.source},async post=>{f.recordFee('final',{},false);const r=await post('/v1/exchange-money/refresh-fee',{allocation_id:f.allocation.id,event_id:'final-one'});assert.equal(r.status,200);assert.equal(r.body.state,'final_recorded');assert.equal(r.body.estimate.shop.tax_minor,'3');assert.equal(r.body.final.shop.tax_minor,'4');assert.deepEqual(r.body.delta_from_estimate,{shop:'1',presentment:'1'});assert.equal(r.body.new_effect_authorized,false);assert.equal((await post('/v1/exchange-money/refresh-fee',{allocation_id:f.allocation.id,event_id:'final-one',tax_minor:'0'})).status,400);assert.equal(f.effects(),0);}),{fees:true}));
test('M06-G08-HTTP-LATE-FINAL-SURVIVES-QUALIFICATION-EXPIRY',()=>usingMoney(async f=>{f.source.money.qualify({...f.qualification,revision:2,expires_at:f.now()+10});f.currency.bind(f.a.scope,{allocation_id:f.allocation.id});const op=f.authorize(f.moneyQuote());await f.executor.dispatch(f.a.scope,op.id);f.source.settle(op.id);await f.executor.reconcile(f.a.scope,op.id);f.advance(11);f.recordFee('final',{},false);await server(f,{resolutionSource:f.source},async post=>{const r=await post('/v1/exchange-money/refresh-fee',{allocation_id:f.allocation.id,event_id:'final-one'});assert.equal(r.status,200);assert.equal(r.body.unresolved,true);assert.equal(r.body.operation_id,op.id);assert.equal(r.body.next_action,'reconcile_original_operation');assert.equal(f.effects(),1);});},{fees:true}));
test('M06-G09-HTTP-QUOTE-REQUIRES-SEPARATE-EXECUTION-APPROVAL',()=>usingInstant(f=>server(f,{instantSource:f.source},async post=>{const q=await post('/v1/instant-exchanges/authorize-quote',f.authorizeInput());assert.equal(q.status,200);assert.equal(q.body.execution_authorized,false);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_instant_obligations').get().n,0);const preview=await post('/v1/execution/preview',q.body.proposal);assert.equal(preview.status,200);const input={preview_id:preview.body.id,preview_digest:preview.body.digest};assert.equal((await post('/v1/execution/execute',{...input,approval_id:'missing'})).status,400);const approval=await post('/v1/execution/approve',input,f.reviewer.bearer);assert.equal(approval.status,200);const receipt=await post('/v1/execution/execute',{...input,approval_id:approval.body.id});assert.equal(receipt.status,200);assert.ok(receipt.body.instant_operation_id);const sent=await post('/v1/instant-exchanges/dispatch',{operation_id:receipt.body.instant_operation_id});assert.equal(sent.status,200);assert.equal(sent.body.state,'mandate_active');const again=await post('/v1/instant-exchanges/reconcile',{operation_id:receipt.body.instant_operation_id});assert.equal(again.body.native_id,sent.body.native_id);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_instant_obligations').get().n,1);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_instant_captures').get().n,0);})));
test('M06-G09-HTTP-OMITS-SENSITIVE-VALUES-FROM-LOGS',()=>usingInstant(f=>server(f,{instantSource:f.source},async(post,app)=>{assert.equal((await post('/v1/instant-exchanges/authorize-quote',f.authorizeInput(),null)).status,403);assert.equal((await post('/v1/instant-exchanges/authorize-quote',{...f.authorizeInput(),consent_id:'private_missing_consent'})).status,400);const log=JSON.stringify(app.log);for(const value of [f.a.bearer,'private_missing_consent',f.order().customer_id,f.obligationId])assert.equal(log.includes(value),false);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_instant_captures').get().n,0);})));
test('M06-G10-HTTP-UNKNOWN-CAPTURE-RECONCILES-ORIGINAL-EFFECT',()=>usingInstant(async f=>{await authorizeMandate(f);await releaseReplacement(f);f.source.confirmReceived(f.received('one_received',[1]));f.advance(oracle.trial_ms);const op=f.authorize(f.instant.quoteCapture(f.a.scope,{obligation_id:f.obligationId}));await server(f,{instantSource:f.source},async post=>{f.source.fault='after';const sent=await post('/v1/instant-exchanges/dispatch',{operation_id:op.id});assert.equal(sent.status,200);assert.equal(sent.body.state,'unknown');const done=await post('/v1/instant-exchanges/reconcile',{operation_id:op.id});assert.equal(done.body.state,'captured');assert.equal(done.body.source.captured_minor,'2000');assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_instant_captures').get().n,1);});}));
