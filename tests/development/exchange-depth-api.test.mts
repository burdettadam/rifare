import test from 'node:test';import assert from 'node:assert/strict';
import { usingGift } from './gift-helpers.mts';
import { startCommerceServer } from '../../apps/commerce-api/server.mts';
async function withServer(f:any,fn:(post:any,app:any)=>unknown,gifts=true){const log:any[]=[],app=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator,reads:f.reads,resolutionSource:f.source,...(gifts?{gifts:f.gifts}:{}),log:r=>log.push(r)});try{return await fn(async(path:string,input:any,bearer:string|null=null)=>{const response=await fetch(app.url+path,{method:'POST',headers:{'content-type':'application/json',...(bearer?{authorization:'Bearer '+bearer}:{})},body:JSON.stringify(input)});return {status:response.status,body:await response.json()};},{...app,log});}finally{await app.close();}}
test('M06-G05-HTTP-PROOF-IS-PRIVATE-AND-NOT-BEARER',()=>usingGift(f=>withServer(f,async post=>{const q=await post('/v1/gifts/challenges',{store_id:f.a.store,gift_id:f.giftFacts.gift_id,email:f.giftFacts.recipient_email});assert.equal(q.status,202);assert.equal(q.body.proof,undefined);const v=await post('/v1/gifts/verify',{store_id:f.a.store,challenge_id:q.body.challenge_id,proof:f.outbox.at(-1).proof});assert.equal(v.status,200);const choices=await post('/v1/gifts/choices',{store_id:f.a.store,token:v.body.token});assert.equal(choices.status,200);assert.deepEqual(choices.body.outcomes,['exchange','store_credit']);const raw=await post('/v1/returns/form',{case_id:'resolution_case'},v.body.token);assert.equal(raw.status,403);assert.equal(JSON.stringify(choices.body).includes(f.giftOrder.customer_id),false);})));
test('M06-G05-HTTP-SEPARATE-STAFF-SCOPE-REQUIRED',()=>usingGift(f=>withServer(f,async post=>{const p={gift_token:f.verified.token,case_id:'gift_case',profile_id:'default',policy_id:'returns'};assert.equal((await post('/v1/gifts/case',p)).status,403);assert.equal((await post('/v1/gifts/case',p,f.a.bearer)).status,200);const selection={gift_token:f.verified.token,case_id:'gift_case',lines:[{line_id:'gamma',quantity:1}],outcome:'exchange',reason:'size',request_key:'gift-request'};assert.equal((await post('/v1/gifts/prepare',selection,f.a.bearer)).body.state,'awaiting_review');const denial=await post('/v1/gifts/prepare',{...selection,outcome:'refund',request_key:'different'},f.a.bearer);assert.equal(denial.status,400);assert.equal(denial.body.error,'GIFT_CHOICE_CONFLICT');})));
test('M06-G05-HTTP-NO-DEFAULT-GIFT-DELIVERY',()=>usingGift(f=>withServer(f,async post=>{const r=await post('/v1/gifts/challenges',{store_id:f.a.store,gift_id:f.giftFacts.gift_id,email:f.giftFacts.recipient_email});assert.equal(r.status,503);assert.equal(r.body.error,'ADAPTER_UNAVAILABLE');},false)));
test('M06-G01-HTTP-CATALOG-AND-EXACT-FINANCE-QUOTE',()=>usingGift(f=>withServer(f,async post=>{const plan=f.allocate(),allocation=plan.allocations.find(a=>a.outcome==='exchange'),catalog=f.catalog({product_id:'coat',category:'outerwear',active:true,fulfillment_qualified:true,unit_price_minor:'1200'});assert.equal((await post('/v1/resolutions/exchange-configure',{expected_revision:0,enabled:true,catalog_wide:true,price_differences:true,allowed_product_ids:[],excluded_product_ids:[],excluded_categories:['final-sale'],incentive_bps:0,incentive_cap_minor:'0',minimum_margin_bps:0,expires_at:f.now()+300000},f.owner.bearer)).status,200);const offers=await post('/v1/resolutions/exchange-browse',{allocation_id:allocation.id},f.a.bearer);assert.equal(offers.body.offers[0].variant_id,catalog.payload.variant_id);const q=(await post('/v1/resolutions/exchange-quote',{allocation_id:allocation.id,catalog_id:catalog.id},f.a.bearer)).body;const finance=await post('/v1/resolutions/exchange-finance-quote',{exchange_quote_id:q.id,exchange_quote_digest:q.digest,outcome:'additional_payment'},f.a.bearer);assert.equal(finance.body.quote.amount_minor,'200');assert.equal(finance.body.execution_authorized,false);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);})));
test('M06-G05-HTTP-LOGS-OMIT-PROOF-AND-RECIPIENT',()=>usingGift(f=>withServer(f,async(post,app)=>{await post('/v1/gifts/choices',f.accessInput);await post('/v1/gifts/verify',{store_id:f.a.store,challenge_id:f.challenge.challenge_id,proof:'secret-invalid-proof'});const text=JSON.stringify(app.log);for(const marker of [f.verified.token,f.giftFacts.recipient_email,'secret-invalid-proof',f.giftOrder.id])assert.equal(text.includes(marker),false);})));
