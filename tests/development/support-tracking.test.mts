import test from'node:test';import assert from'node:assert/strict';import{usingSupport}from'./support-helpers.mts';import{SupportBranding}from'../../packages/commerce/support-branding.mts';
function ship(f:any,id:string,status:string){return f.kernel.ingest(f.a.scope,{kind:'shipment',source_system:'synthetic',external_id:id,source_version:1,source_updated_at:f.now(),customer_id:'C-1001',payload:{order_number:'ORD-1001',status,carrier:'synthetic',tracking:'TRACK-'+id}});}
test('CASE-M05-G03-01',()=>usingSupport(f=>{new SupportBranding(f.kernel).configure(f.owner.scope,{expected_revision:0,name:'Example Apparel',theme:'contrast',locale:'en-US'});ship(f,'SHIP-2','delivered');const r=f.tracking.read(f.customer,'case_one');assert.equal(r.brand,'Example Apparel');assert.equal(r.shipments.length,2);assert.equal(r.all_delivered,false);assert.equal(r.estimated_delivery,null);}));
test('CASE-M05-G03-02',()=>usingSupport(f=>{f.advance(300001);const r=f.tracking.read(f.a.scope,'case_one');assert.equal(r.status,'unavailable');assert.equal(r.all_delivered,false);assert.equal(r.shipments.length,0);}));
test('CASE-M05-G03-03',()=>usingSupport(f=>{ship(f,'SHIP-2','delivered');const r=f.tracking.read(f.a.scope,'case_one');assert.equal(r.shipments.find(s=>s.id==='SHIP-2').status,'delivered');assert.equal(r.shipments.find(s=>s.id==='SHIP-1001').status,'in_transit');assert.equal(r.warehouse_received,false);assert.equal(r.all_delivered,false);}));
test('M05-G03-04',()=>usingSupport(f=>{assert.throws(()=>f.tracking.read(f.b.scope,'case_one'),/NOT_FOUND/);assert.throws(()=>new SupportBranding(f.kernel).configure(f.customer,{expected_revision:0,name:'Forged',theme:'plain',locale:'en-US'}),/ACCESS_DENIED/);}));
test('M05-G03-05',()=>usingSupport(f=>{f.db.prepare("DELETE FROM commerce_resources WHERE tenant_id=? AND store_id=? AND kind='shipment'").run(f.a.tenant,f.a.store);const r=f.tracking.read(f.a.scope,'case_one');assert.equal(r.shipments.length,0);assert.equal(r.all_delivered,false);}));
