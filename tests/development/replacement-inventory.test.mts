import test from 'node:test';import assert from 'node:assert/strict';
import { spawn } from 'node:child_process';import { DatabaseSync } from 'node:sqlite';
import { usingFulfillment } from './fulfillment-helpers.mts';
import { CommerceKernel } from '../../packages/commerce/kernel.mts';
import { ReplacementInventory } from '../../packages/commerce/replacement-inventory.mts';
import { FulfillmentFixtureSource } from '../../packages/adapters/fulfillment-fixture-source.mts';
import { ExecutionStops } from '../../packages/commerce/execution-stops.mts';
const child=(code:string)=>new Promise<string>((resolve,reject)=>{const p=spawn(process.execPath,['--experimental-strip-types','--input-type=module','-e',code],{cwd:process.cwd()});let out='',err='';p.stdout.on('data',x=>out+=x);p.stderr.on('data',x=>err+=x);p.on('error',reject);p.on('exit',n=>n===0?resolve(out):reject(Error(err)));});
export function inventoryChild(f:any,q:any){return `import {DatabaseSync} from 'node:sqlite';import {CommerceKernel} from './packages/commerce/kernel.mts';import {ReplacementInventory} from './packages/commerce/replacement-inventory.mts';import {FulfillmentFixtureSource} from './packages/adapters/fulfillment-fixture-source.mts';const db=new DatabaseSync(${JSON.stringify(f.filename)}),src=new DatabaseSync(${JSON.stringify(f.sourceFile)}),now=()=>${f.now()},k=new CommerceKernel(db,now),source=new FulfillmentFixtureSource(src,{mode:'fixture',identity:'fulfillment-one',tenant:${JSON.stringify(f.a.tenant)},store:${JSON.stringify(f.a.store)},clock:now});console.log(JSON.stringify(new ReplacementInventory(k,source).reserve(k.authenticate(${JSON.stringify(f.a.bearer)}),${JSON.stringify({quote_id:q.id,quote_digest:q.digest,location_id:'warehouse-one',ttl_ms:50000})})));db.close();src.close();`;}
test('CASE-M03-G11-01',()=>usingFulfillment(async f=>{const other=await f.secondExchange(),one=f.reserve(),two=f.reserve(other.quote);assert.equal(one.state,'active');assert.equal(two.state,'unavailable');assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).reserved,1);assert.equal(one.live_stock_ownership,false);}));
test('CASE-M03-G11-02',()=>usingFulfillment(async f=>{const other=await f.secondExchange();const results=(await Promise.all([child(inventoryChild(f,f.exchange)),child(inventoryChild(f,other.quote))])).map(x=>JSON.parse(x));assert.deepEqual(results.map(x=>x.state).sort(),['active','unavailable']);assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).reserved,1);}));
test('CASE-M03-G11-03',()=>usingFulfillment(f=>{const r=f.reserve(undefined,{ttl_ms:100});f.advance(100);assert.equal(f.inventory.reconcile(f.a.scope,r.id).state,'expired');assert.throws(()=>f.orders.quote(f.a.scope,{reservation_id:r.id}),/RESERVATION_UNAVAILABLE/);assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).reserved,0);}));
test('M03-G11-TEST-012-CONSERVATION',()=>usingFulfillment(async f=>{const other=await f.secondExchange(),one=f.reserve();f.reserve(other.quote);const op=f.authorizeFulfillment(f.orders.quote(f.a.scope,{reservation_id:one.id}));await f.execution.dispatch(f.a.scope,op.id);assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).available,2);assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).reserved,0);assert.equal(f.fulfillmentSource.effects().length,1);}));
test('M03-G11-REPEAT-RESUMES-SAME-HOLD',()=>usingFulfillment(f=>{const a=f.reserve(),b=f.reserve();assert.equal(a.id,b.id);assert.equal(f.fulfillmentSource.calls.reserve,1);}));
test('M03-G11-CROSS-STORE-READ-DENIED',()=>usingFulfillment(f=>{const r=f.reserve();assert.throws(()=>f.inventory.read(f.b.scope,r.id),/NOT_FOUND/);}));
test('M03-G11-CUSTOMER-CANNOT-RESERVE',()=>usingFulfillment(f=>{assert.throws(()=>f.inventory.reserve(f.customer,{quote_id:f.exchange.id,quote_digest:f.exchange.digest,location_id:'warehouse-one',ttl_ms:1000}),/ACCESS_DENIED/);assert.equal(f.fulfillmentSource.calls.reserve,0);}));
test('M03-G11-FORGED-LOCATION-CANNOT-RESERVE',()=>usingFulfillment(f=>{assert.equal(f.reserve(undefined,{location_id:'other-warehouse'}).state,'unavailable');assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).reserved,0);}));
test('M03-G11-RELEASE-REQUIRES-GENERATION',()=>usingFulfillment(f=>{const r=f.reserve();assert.throws(()=>f.inventory.release(f.a.scope,{reservation_id:r.id,generation:2}),/RESERVATION_CHANGED/);assert.equal(f.inventory.release(f.a.scope,{reservation_id:r.id,generation:1}).state,'released');}));
test('M03-G11-RELEASE-ALLOWS-NEW-GENERATION',()=>usingFulfillment(f=>{const r=f.reserve();f.inventory.release(f.a.scope,{reservation_id:r.id,generation:r.generation});const next=f.reserve();assert.equal(next.generation,2);assert.notEqual(next.id,r.id);}));
test('M03-G11-UNKNOWN-RESERVATION-NOT-RESENT',()=>usingFulfillment(f=>{const fn=f.fulfillmentSource.reserve.bind(f.fulfillmentSource);f.fulfillmentSource.reserve=command=>{fn(command);throw Error('RESPONSE_LOST');};const r=f.reserve();assert.equal(r.state,'unknown');assert.equal(f.reserve().state,'active');assert.equal(f.fulfillmentSource.calls.reserve,1);}));
test('M03-G11-UNKNOWN-REPLACEMENT-CANNOT-RELEASE',()=>usingFulfillment(async f=>{const op=f.replacement();f.fulfillmentSource.fault='after';await f.execution.dispatch(f.a.scope,op.id);assert.throws(()=>f.inventory.release(f.a.scope,{reservation_id:op.reservation.id,generation:1}),/RECONCILIATION_REQUIRED/);assert.equal(f.fulfillmentSource.stock(f.catalogResource.id).available,2);}));
test('M03-G11-SOURCE-IDENTITY-CANNOT-SUBSTITUTE',()=>usingFulfillment(f=>{const db=new DatabaseSync(':memory:');try{const source=new FulfillmentFixtureSource(db,{mode:'fixture',identity:'fulfillment-one',tenant:f.a.tenant,store:f.a.store,clock:f.now});assert.throws(()=>new ReplacementInventory(f.kernel,source).reserve(f.a.scope,{quote_id:f.exchange.id,quote_digest:f.exchange.digest,location_id:'warehouse-one',ttl_ms:1000}),/FIXTURE_SOURCE_MISMATCH/);}finally{db.close();}}));
test('M03-G11-SAME-DATABASE-DENIED',()=>usingFulfillment(f=>{assert.throws(()=>new ReplacementInventory(f.kernel,{db:f.db} as any),/SEPARATE_FIXTURE_SOURCE_REQUIRED/);}));
test('M03-G11-STOP-BEFORE-SOURCE',()=>usingFulfillment(f=>{new ExecutionStops(f.kernel).set(f.owner.scope,{action:'diagnostic.exchange.create',stopped:true,reason:'incident',expected_revision:0});assert.throws(()=>f.reserve(),/EXECUTION_STOPPED/);assert.equal(f.fulfillmentSource.calls.reserve,0);}));
test('M03-G11-STALE-CATALOG-BLOCKS',()=>usingFulfillment(f=>{f.advance(f.exchange.quote.expires_at-f.now()+1);assert.throws(()=>f.reserve(),/EXCHANGE_QUOTE_CHANGED/);assert.equal(f.fulfillmentSource.calls.reserve,0);}));
test('M03-G11-EXPIRED-SETTINGS-BLOCK',()=>usingFulfillment(f=>{f.config.configure(f.owner.scope,{...f.configInput,expected_revision:1,expires_at:f.now()+100});f.advance(100);assert.throws(()=>f.reserve(),/FULFILLMENT_NOT_READY/);}));
test('M03-G11-RESTORED-DATABASE-RETAINS-HOLD',()=>usingFulfillment(f=>{const r=f.reserve(),db=new DatabaseSync(f.filename);try{const kernel=new CommerceKernel(db,f.now),inventory=new ReplacementInventory(kernel,f.fulfillmentSource);assert.equal(inventory.read(kernel.authenticate(f.a.bearer),r.id).state,'active');}finally{db.close();}}));
