import test from 'node:test';import assert from 'node:assert/strict';
import { useReliability } from './reliability-helpers.mts';
import { DatabaseSync } from 'node:sqlite';
import { SyntheticJournal } from '../../packages/adapters/reliability/synthetic-journal.mts';

async function lost(f:any){const {op}=f.executeOperation();f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,op.id,f.journal);return op;}
async function many(f:any,n=3){const result=[];for(let i=0;i<n;i++){const op=f.extraOperation(i);f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,op.id,f.journal);result.push(op);}return result;}

test('CASE-M02-G16-01',()=>useReliability(async f=>{const op=await lost(f),r=await f.recon.one(f.a.scope,op.id,f.journal);assert.equal(r.disposition,'repaired');assert.equal(r.operation.state,'succeeded');assert.equal(r.command_repeated,false);const count=f.receipts.list(f.a.scope,op.id).length;assert.equal((await f.recon.one(f.a.scope,op.id,f.journal)).disposition,'unchanged');assert.equal(f.receipts.list(f.a.scope,op.id).length,count);assert.equal(f.journal.count(),1);}));
test('CASE-M02-G16-02',()=>useReliability(async f=>{const op=await lost(f);f.journal.arm('lookup_unavailable');const r=await f.recon.one(f.a.scope,op.id,f.journal);assert.equal(r.operation.state,'unknown');assert.equal(r.disposition,'unconfirmed');assert.equal(f.work.claim(f.a.scope,op.id),null);assert.equal(f.journal.count(),1);}));
test('CASE-M02-G16-03',()=>useReliability(async f=>{const ops=await many(f),run=f.recon.start(f.a.scope,f.journal);assert.equal(f.recon.step(f.a.scope,run.id,f.journal,1).run.cursor,1);const other=f.reopen();try{assert.equal(other.recon.step(other.scope,run.id,f.journal,1).run.cursor,2);const r=other.recon.step(other.scope,run.id,f.journal,1);assert.equal(r.run.state,'completed');for(const op of ops)assert.equal(other.ops.read(other.scope,op.id).state,'succeeded');assert.equal(f.journal.count(),3);}finally{other.db.close();}}));
test('M02-G16-TEST-006-MISSING-WEBHOOK-REPAIRED',()=>useReliability(async f=>{const op=await lost(f),run=f.recon.start(f.a.scope,f.journal);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_webhook_inbox').get().n,0);assert.equal(f.recon.step(f.a.scope,run.id,f.journal).results[0].disposition,'repaired');assert.equal(f.ops.read(f.a.scope,op.id).state,'succeeded');}));
test('M02-G16-PAGE-FAILURE-ROLLS-BACK-WATERMARK',()=>useReliability(async f=>{const ops=await many(f,2),run=f.recon.start(f.a.scope,f.journal);f.db.exec(`CREATE TRIGGER page_fault BEFORE UPDATE ON commerce_operations WHEN NEW.id='${ops[1].id}' AND NEW.state='succeeded' BEGIN SELECT RAISE(ABORT,'page_fault');END;`);assert.throws(()=>f.recon.step(f.a.scope,run.id,f.journal,2),/page_fault/);assert.equal(f.recon.read(f.a.scope,run.id).cursor,0);for(const op of ops)assert.equal(f.ops.read(f.a.scope,op.id).state,'unknown');f.db.exec('DROP TRIGGER page_fault');assert.equal(f.recon.step(f.a.scope,run.id,f.journal,2).run.state,'completed');}));
test('M02-G16-FIXED-HIGH-WATER-NO-SKIP',()=>useReliability(async f=>{const op=await lost(f),run=f.recon.start(f.a.scope,f.journal),next=f.extraOperation(9);f.journal.arm('after_accept');await f.work.dispatch(f.a.scope,next.id,f.journal);f.recon.step(f.a.scope,run.id,f.journal);assert.equal(f.ops.read(f.a.scope,op.id).state,'succeeded');assert.equal(f.ops.read(f.a.scope,next.id).state,'unknown');const another=f.recon.start(f.a.scope,f.journal);f.recon.step(f.a.scope,another.id,f.journal);assert.equal(f.ops.read(f.a.scope,next.id).state,'succeeded');}));
test('M02-G16-COMPLETE-REPLAY-NO-REPAIR',()=>useReliability(async f=>{const op=await lost(f),run=f.recon.start(f.a.scope,f.journal);f.recon.step(f.a.scope,run.id,f.journal);const n=f.receipts.list(f.a.scope,op.id).length;assert.equal(f.recon.step(f.a.scope,run.id,f.journal).replayed,true);assert.equal(f.receipts.list(f.a.scope,op.id).length,n);}));
test('M02-G16-EMPTY-SOURCE-NO-SPECULATIVE-RETRY',()=>useReliability(async f=>{const {op}=f.executeOperation(),c=f.work.claim(f.a.scope,op.id,100)!;f.work.beginSend(f.a.scope,op.id,c.lease_token);f.advance(101);f.work.recover(f.a.scope,op.id);const r=await f.recon.one(f.a.scope,op.id,f.journal);assert.equal(r.disposition,'unconfirmed');assert.equal(r.operation.state,'unknown');assert.equal(f.journal.count(),0);}));
test('M02-G16-PAGE-LIMIT-BOUNDED',()=>useReliability(f=>{const run=f.recon.start(f.a.scope,f.journal);assert.throws(()=>f.recon.step(f.a.scope,run.id,f.journal,101),/INVALID_INPUT/);assert.throws(()=>f.recon.step(f.a.scope,run.id,f.journal,0),/INVALID_INPUT/);}));
test('M02-G16-MISSING-SOURCE-RETAINS-CHECKPOINT',()=>useReliability(async f=>{await lost(f);const run=f.recon.start(f.a.scope,f.journal);f.journal.arm('lookup_unavailable');assert.throws(()=>f.recon.step(f.a.scope,run.id,f.journal),/JOURNAL_UNAVAILABLE/);assert.equal(f.recon.read(f.a.scope,run.id).cursor,0);}));
test('M02-G16-CROSS-STORE-RUN-REJECTED',()=>useReliability(f=>{const run=f.recon.start(f.a.scope,f.journal);assert.throws(()=>f.recon.read(f.b.scope,run.id),/NOT_FOUND/);}));
test('M02-G16-REVOKED-OPERATOR-REJECTED',()=>useReliability(async f=>{await lost(f);const run=f.recon.start(f.a.scope,f.journal);f.kernel.revoke(f.a.scope);assert.throws(()=>f.recon.step(f.a.scope,run.id,f.journal),/ACCESS_DENIED/);}));
test('M02-G16-DIFFERENT-SOURCE-BLOCKED',()=>useReliability(f=>{const run=f.recon.start(f.a.scope,f.journal),db=new DatabaseSync(':memory:');try{const j=new SyntheticJournal(db,f.a.tenant,f.a.store,'another-source');assert.throws(()=>f.recon.step(f.a.scope,run.id,j),/SOURCE_CHANGED/);}finally{db.close();}}));
test('M02-G16-DUPLICATE-PAGE-ROWS-BLOCKED',()=>useReliability(async f=>{await lost(f);const run=f.recon.start(f.a.scope,f.journal),old=f.journal.page.bind(f.journal);f.journal.page=(...args:any[])=>{const p=old(...args);p.entries.push(p.entries[0]);return p;};assert.throws(()=>f.recon.step(f.a.scope,run.id,f.journal),/PAGE_INVALID/);assert.equal(f.recon.read(f.a.scope,run.id).cursor,0);}));
test('M02-G16-INVALID-RESULT-DRIFT-NOT-SUCCESS',()=>useReliability(async f=>{const op=await lost(f),old=f.journal.lookup.bind(f.journal);f.journal.lookup=(id:string)=>({...old(id),payload_hash:'0'.repeat(64)});assert.equal((await f.recon.one(f.a.scope,op.id,f.journal)).disposition,'conflict');assert.equal(f.ops.read(f.a.scope,op.id).state,'unknown');assert.equal(f.recon.drift(f.a.scope,op.id)[0].code,'SOURCE_CONFLICT');}));
test('M02-G16-UNCONFIRMED-DRIFT-DEDUPLICATED',()=>useReliability(async f=>{const op=await lost(f);f.journal.arm('lookup_unavailable');await f.recon.one(f.a.scope,op.id,f.journal);await f.recon.one(f.a.scope,op.id,f.journal);assert.equal(f.recon.drift(f.a.scope,op.id).length,1);}));
test('M02-G16-ACTIVE-DISPATCH-CAN-RECONCILE',()=>useReliability(async f=>{const {op}=f.executeOperation(),c=f.work.claim(f.a.scope,op.id)!;const result=f.journal.send(f.work.beginSend(f.a.scope,op.id,c.lease_token));assert.equal((await f.recon.one(f.a.scope,op.id,f.journal)).operation.state,'succeeded');assert.throws(()=>f.work.finish(f.a.scope,op.id,c.lease_token,result),/LEASE_UNAVAILABLE/);assert.equal(f.journal.count(),1);}));
test('M02-G16-SUCCESSFUL-STATE-NOT-OVERWRITTEN',()=>useReliability(async f=>{const {op}=f.executeOperation();await f.work.dispatch(f.a.scope,op.id,f.journal);const old=f.journal.lookup.bind(f.journal);f.journal.lookup=(id:string)=>({...old(id),provider_ref:'remote_'+'0'.repeat(40)});assert.equal((await f.recon.one(f.a.scope,op.id,f.journal)).disposition,'conflict');assert.notEqual(f.ops.read(f.a.scope,op.id).provider_ref,'remote_'+'0'.repeat(40));}));
