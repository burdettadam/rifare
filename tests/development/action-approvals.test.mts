import test from 'node:test';import assert from 'node:assert/strict';
import { usingExecution } from './execution-helpers.mts';

test('CASE-M02-G11-01',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p),r=f.execute(p,a);assert.equal(r.preview_digest,p.digest);assert.equal(r.approval_id,a.id);assert.equal(r.approval_consumed,true);assert.equal(r.amount.minor,'12500');assert.equal(r.financial_effect,false);assert.equal(f.db.prepare('SELECT uses FROM commerce_action_approvals').get().uses,1);}));
test('CASE-M02-G11-02',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);assert.throws(()=>f.gateway.execute(f.agent.scope,{preview_id:p.id,preview_digest:p.digest,approval_id:a.id,amount:{currency:'USD',minor:'1'}}),/INVALID_INPUT/);f.db.prepare("UPDATE commerce_resources SET source_version=source_version+1,payload=json_set(payload,'$.total_minor',20000) WHERE id=?").run(f.order().id);assert.throws(()=>f.execute(p,a),/PREVIEW_STALE/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_case_effects').get().n,0);}));
test('CASE-M02-G11-03',()=>usingExecution(async f=>{const p=f.preview(),a=f.approve(p),results=await Promise.allSettled([Promise.resolve().then(()=>f.execute(p,a)),Promise.resolve().then(()=>f.execute(p,a))]);assert.equal(results.filter(r=>r.status==='fulfilled').length,1);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_receipts').get().n,1);}));
test('M02-G11-AGENT-FAKE-APPROVAL',()=>usingExecution(f=>{const p=f.preview();assert.throws(()=>f.gateway.approve(f.agent.scope,{preview_id:p.id,preview_digest:p.digest}),/ACCESS_DENIED/);assert.throws(()=>f.execute(p,{id:'manager_approved'}),/APPROVAL_UNAVAILABLE/);}));
test('M02-G11-SELF-APPROVAL-BLOCKED',()=>usingExecution(f=>{const p=f.gateway.prepare(f.owner.scope,f.proposal());assert.throws(()=>f.gateway.approve(f.owner.scope,{preview_id:p.id,preview_digest:p.digest}),/SELF_APPROVAL_DENIED/);}));
test('M02-G11-CROSS-TENANT-PREVIEW',()=>usingExecution(f=>{const p=f.preview();assert.throws(()=>f.gateway.approve(f.b.scope,{preview_id:p.id,preview_digest:p.digest}),/NOT_FOUND/);}));
test('M02-G11-CURRENCY-CHANGE',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.db.prepare("UPDATE commerce_resources SET payload=json_set(payload,'$.currency','CAD') WHERE id=?").run(f.order().id);assert.throws(()=>f.execute(p,a),/PREVIEW_STALE/);}));
test('M02-G11-CONFIGURATION-MIGRATION',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.cases.migrate(f.a.scope,'case_one',{expected_revision:1,profile_id:'default',policy_id:'returns',reason:'approved_update'});assert.throws(()=>f.execute(p,a),/PREVIEW_STALE/);}));
test('M02-G11-EXPIRED-PREVIEW',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.advance(300001);assert.throws(()=>f.execute(p,a),/APPROVAL_UNAVAILABLE/);}));
test('M02-G11-APPROVER-DEMOTED',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.permissions.change(f.owner.scope,{actor_id:'reviewer',role:'reviewer',actions:['policy.read'],resource_ids:null,expected_revision:0});assert.throws(()=>f.execute(p,a),/APPROVAL_AUTHORITY_CHANGED/);}));
test('M02-G11-APPROVAL-REVOKED',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.gateway.revokeApproval(f.reviewer.scope,a.id);assert.throws(()=>f.execute(p,a),/APPROVAL_UNAVAILABLE/);}));
test('M02-G11-EXACT-DIGEST-REQUIRED',()=>usingExecution(f=>{const p=f.preview();assert.throws(()=>f.gateway.approve(f.reviewer.scope,{preview_id:p.id,preview_digest:'0'.repeat(64)}),/PREVIEW_STALE/);}));
test('M02-G11-DB-FAILURE-ROLLS-BACK-CONSUMPTION',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.db.exec("CREATE TRIGGER fail_receipt BEFORE INSERT ON commerce_action_receipts BEGIN SELECT RAISE(ABORT,'fixture'); END;");assert.throws(()=>f.execute(p,a));assert.equal(f.db.prepare('SELECT uses FROM commerce_action_approvals').get().uses,0);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_case_effects').get().n,0);f.db.exec('DROP TRIGGER fail_receipt');assert.equal(f.execute(p,a).approval_consumed,true);}));
test('M02-G11-EFFECT-VERSION-INVALIDATES-OTHER-PREVIEW',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p),other=f.preview(),b=f.approve(other);f.execute(p,a);assert.throws(()=>f.execute(other,b),/PREVIEW_STALE/);}));
test('M02-G11-REPEAT-CALL-NEVER-DOUBLE-EFFECT',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p);f.execute(p,a);assert.throws(()=>f.execute(p,a),/APPROVAL_UNAVAILABLE/);assert.equal(f.gateway.state(f.a.scope,'case_one').revision,1);}));
test('M02-G11-NO-MODEL-SELECTED-MONEY',()=>usingExecution(f=>{assert.throws(()=>f.gateway.prepare(f.agent.scope,{...f.proposal(),amount_minor:'99999999999'}),/INVALID_INPUT/);}));
test('M02-G11-APPROVAL-BOUND-TO-ONE-PREVIEW',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p),q=f.preview();assert.equal(p.digest,q.digest);assert.throws(()=>f.execute(q,a),/APPROVAL_UNAVAILABLE/);}));
test('M02-G11-RECEIPT-TAMPER',()=>usingExecution(f=>{const p=f.preview(),a=f.approve(p),r=f.execute(p,a);f.db.prepare("UPDATE commerce_action_receipts SET body=json_set(body,'$.amount.minor','1')").run();assert.throws(()=>f.gateway.receipt(f.a.scope,r.id),/RECEIPT_INTEGRITY/);}));
