import { readFileSync } from 'node:fs';
import { checkoutFixture } from './delegated-checkout-helpers.mts';
import { verifiedCustomer } from './shopper-memory-helpers.mts';
import { DelegatedCommandClaims } from '../../packages/commerce/delegated-command-claims.mts';
import { CLAIM_KIND, commandClaimRecords } from '../../packages/commerce/delegated-command-claim-records.mts';

// Independent C1 expectations, not generated by the implementation under test.
export const claimOracle = JSON.parse(readFileSync(new URL('../fixtures/delegated-commands/consumer-vectors.v1.json', import.meta.url), 'utf8'));
export const claimCorrelation = Object.freeze({ provider_ref: 'synthetic-provider',
  organization_id: '12345678-1234-4234-8234-123456789abc',
  actor: Object.freeze({ type: 'MACHINE_IDENTITY' as const, id: 'urn:rifare:synthetic:machine' }) });

/** Actual customer proof, file-backed native SQLite and source owners; no JOSE,
 * provider authority, transport or preexisting command claim is supplied. */
export async function commandClaimFixture() {
  const f = await checkoutFixture({ lamp: true });
  try {
    const verified = verifiedCustomer(f), customer = verified.scope;
    const correlation = structuredClone(claimCorrelation), claims = new DelegatedCommandClaims(f.kernel, correlation);
    const start = structuredClone(claimOracle.commands.find((x: any) => x.name === 'start_use'));
    const final = structuredClone(claimOracle.commands.find((x: any) => x.name === 'finalize_use'));
    const challengeResponse = structuredClone(claimOracle.challenge_response), finalResponse = structuredClone(claimOracle.final_response);
    const claimRows = () => f.db.prepare('SELECT * FROM commerce_support_documents WHERE kind=? ORDER BY tenant_id,store_id,id,version').all(CLAIM_KIND);
    const records = () => commandClaimRecords(f.kernel);
    const record = (originalCommandId = start.request.command_id) => records().find(r => r.body.original_command_id === originalCommandId)!;
    return { ...f, ownerScope: f.owner.scope, customer, bearer: verified.bearer, correlation,
      claims, start, final, challengeResponse, finalResponse, claimRows, records, record,
      claimStart: () => claims.claim(customer, start.request), claimFinal: () => claims.claim(customer, final.request),
      observeStart: () => claims.observe(customer, start.request.command_id, challengeResponse),
      observeFinal: () => claims.observe(customer, final.request.command_id, finalResponse) };
  } catch (error) { f.cleanup(); throw error; }
}
export async function usingCommandClaim(fn: (f: Awaited<ReturnType<typeof commandClaimFixture>>) => unknown) {
  const f = await commandClaimFixture(); try { return await fn(f); } finally { f.cleanup(); }
}
