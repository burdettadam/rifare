import{fileURLToPath}from'node:url';import{SkillInstaller,readInstructionDirectory}from'../../packages/commerce/skill-installer.mts';import{SupportWorkflows}from'../../packages/commerce/support-workflows.mts';
export function installSupportSkills(f:any){const installer=new SkillInstaller(f.kernel),digests:Record<string,string>={};for(const name of ['support-reply','shipment-assistance']){const bundle=readInstructionDirectory(fileURLToPath(new URL('../../packages/commerce/skill-bundles/'+name+'/',import.meta.url))),origin='https://rifare.invalid/skills/'+name,a=installer.approve(f.owner.scope,{origin,bundle_digest:bundle.digest,skill_id:name,version:bundle.version,expires_at:f.now()+3600000});installer.install(f.a.scope,a.id,{origin,bundle});digests[name]=bundle.digest;}return{workflows:new SupportWorkflows(f.kernel,f.reads),digests};}
