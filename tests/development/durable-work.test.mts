import test from 'node:test';import assert from 'node:assert/strict';
import { DatabaseSync } from 'node:sqlite';
import { useReliability } from './reliability-helpers.mts';
import { SyntheticJournal } from '../../packages/adapters/reliability/synthetic-journal.mts';
import { retryDelay } from '../../packages/commerce/durable-work.mts';

test('CASE-M02-G14-01',()=>useReliability(async f=>{const {op}=f.executeOperation(),other=f.reopen();try{assert.equal(other.ops.read(other.scope,op.id).work.state,'pending');assert.equal((await other.work.dispatch(other.scope,op.id,f.journal)).state,'succeeded');assert.equal(f.journal.count(),1);}finally{other.db.close();}}));
test('CASE-M02-G14-02',()=>useReliability(async f=>{const {op}=f.executeOperation();f.journal.arm('after_accept');assert.equal((await f.work.dispatch(f.a.scope,op.id,f.journal)).state,'unknown');assert.equal((await f.work.dispatch(f.a.scope,op.id,f.journal)).state,'unknown');assert.equal(f.journal.count(),1);}));
test('CASE-M02-G14-03',()=>useReliability(async f=>{const {op}=f.executeOperation();const claim=f.work.claim(f.a.scope,op.id,100);assert.ok(claim);f.advance(101);assert.equal(f.work.recover(f.a.scope,op.id).state,'queued');assert.equal((await f.work.dispatch(f.a.scope,op.id,f.journal)).state,'succeeded');assert.equal(f.journal.count(),1);}));
test('M02-G14-OUTBOX-FAILURE-ROLLS-BACK-APPROVAL',()=>useReliability(f=>{const p=f.preview(),a=f.approve(p);f.db.exec("CREATE TRIGGER no_work BEFORE INSERT ON commerce_operation_work BEGIN SELECT RAISE(ABORT,'work_fail');END;");assert.throws(()=>f.execute(p,a),/work_fail/);assert.equal(f.gateway.state(f.a.scope,'case_one').revision,0);assert.equal(f.db.prepare('SELECT uses FROM commerce_action_approvals WHERE id=?').get(a.id).uses,0);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_action_receipts').get().n,0);f.db.exec('DROP TRIGGER no_work');assert.equal(f.execute(p,a).approval_consumed,true);}));
test('M02-G14-KNOWN-NOT-SENT-EXPONENTIAL-BACKOFF',()=>useReliability(async f=>{const {op}=f.executeOperation();for(let i=1;i<=2;i++){f.journal.arm('not_sent');const r=await f.work.dispatch(f.a.scope,op.id,f.journal);assert.equal(r.state,'retry_wait');assert.equal(r.work.available_at,f.now()+1000*2**(i-1));assert.equal(f.work.claim(f.a.scope,op.id),null);f.advance(1000*2**(i-1));}assert.equal((await f.work.dispatch(f.a.scope,op.id,f.journal)).state,'succeeded');assert.equal(f.journal.count(),1);}));
test('M02-G14-RETRY-EXHAUSTION-VISIBLE',()=>useReliability(async f=>{const {op}=f.executeOperation();for(let i=0;i<3;i++){f.journal.arm('not_sent');await f.work.dispatch(f.a.scope,op.id,f.journal);f.advance(5000);}const r=f.ops.read(f.a.scope,op.id);assert.equal(r.state,'failed');assert.equal(r.work.state,'dead');assert.equal(r.work.attempts,3);assert.equal(r.work.last_code,'RETRY_EXHAUSTED');assert.equal(f.work.claim(f.a.scope,op.id),null);assert.equal(f.journal.count(),0);}));
test('M02-G14-REJECT-IS-TERMINAL',()=>useReliability(async f=>{const {op}=f.executeOperation();f.journal.arm('reject');assert.equal((await f.work.dispatch(f.a.scope,op.id,f.journal)).state,'failed');assert.equal(f.journal.count(),0);assert.equal(f.work.claim(f.a.scope,op.id),null);}));
test('M02-G14-TIMEOUT-AFTER-ACCEPT-UNKNOWN',()=>useReliability(async f=>{const {op}=f.executeOperation();f.journal.arm('hang_after_accept');const r=await f.work.dispatch(f.a.scope,op.id,f.journal,{lease_ms:1000,timeout_ms:10});assert.equal(r.state,'unknown');assert.equal(f.journal.count(),1);}));
test('M02-G14-SENDING-LEASE-EXPIRY-NOT-RETRY',()=>useReliability(f=>{const {op}=f.executeOperation(),claim=f.work.claim(f.a.scope,op.id,100)!;f.work.beginSend(f.a.scope,op.id,claim.lease_token);f.advance(101);assert.equal(f.work.recover(f.a.scope,op.id).state,'unknown');assert.equal(f.work.claim(f.a.scope,op.id),null);}));
test('M02-G14-EXPIRED-WORKER-CANNOT-FINISH',()=>useReliability(f=>{const {op}=f.executeOperation(),c=f.work.claim(f.a.scope,op.id,100)!;const env=f.work.beginSend(f.a.scope,op.id,c.lease_token),result=f.journal.send(env);f.advance(101);assert.throws(()=>f.work.finish(f.a.scope,op.id,c.lease_token,result),/LEASE_UNAVAILABLE/);assert.equal(f.work.recover(f.a.scope,op.id).state,'unknown');}));
test('M02-G14-OLD-LEASE-CANNOT-SEND',()=>useReliability(f=>{const {op}=f.executeOperation(),a=f.work.claim(f.a.scope,op.id,100)!;f.advance(101);const b=f.work.claim(f.a.scope,op.id,100)!;assert.notEqual(a.lease_token,b.lease_token);assert.throws(()=>f.work.beginSend(f.a.scope,op.id,a.lease_token),/LEASE_UNAVAILABLE/);}));
test('M02-G14-WRONG-WORKER-CANNOT-FINISH',()=>useReliability(f=>{const {op}=f.executeOperation(),c=f.work.claim(f.a.scope,op.id)!;f.work.beginSend(f.a.scope,op.id,c.lease_token);assert.throws(()=>f.work.finish(f.owner.scope,op.id,c.lease_token,{kind:'unknown'}),/LEASE_UNAVAILABLE/);}));
test('M02-G14-SECOND-CLAIM-REJECTED',()=>useReliability(f=>{const {op}=f.executeOperation();assert.ok(f.work.claim(f.a.scope,op.id));assert.equal(f.work.claim(f.a.scope,op.id),null);}));
test('M02-G14-CROSS-STORE-WORK-REJECTED',()=>useReliability(f=>{const {op}=f.executeOperation();assert.throws(()=>f.work.claim(f.b.scope,op.id),/NOT_FOUND/);}));
test('M02-G14-AGENT-CANNOT-DISPATCH',()=>useReliability(f=>{const {op}=f.executeOperation();assert.throws(()=>f.work.claim(f.agent.scope,op.id),/ACCESS_DENIED/);}));
test('M02-G14-PERMISSIONS-RECHECK-BEFORE-SEND',()=>useReliability(f=>{const {op}=f.executeOperation(),c=f.work.claim(f.a.scope,op.id)!;f.permissions.change(f.owner.scope,{actor_id:'operator',expected_revision:0,role:'operator',actions:['resource.read','operation.read'],resource_ids:null});assert.throws(()=>f.work.beginSend(f.a.scope,op.id,c.lease_token),/ACCESS_DENIED/);assert.equal(f.journal.count(),0);}));
test('M02-G14-PROVIDER-STORE-BINDING',()=>useReliability(async f=>{const {op}=f.executeOperation(),db=new DatabaseSync(':memory:');try{const j=new SyntheticJournal(db,'tenant-b','store-b');await assert.rejects(f.work.dispatch(f.a.scope,op.id,j),/JOURNAL_SCOPE_CONFLICT/);assert.equal(f.ops.read(f.a.scope,op.id).work.attempts,0);}finally{db.close();}}));
test('M02-G14-MALFORMED-RESULT-UNKNOWN',()=>useReliability(f=>{const {op}=f.executeOperation(),c=f.work.claim(f.a.scope,op.id)!;f.work.beginSend(f.a.scope,op.id,c.lease_token);const r=f.work.finish(f.a.scope,op.id,c.lease_token,{kind:'applied',operation_id:'wrong',payload_hash:op.payload_hash,provider_ref:'remote_'+'a'.repeat(40),outcome:'synthetic_recorded'});assert.equal(r.state,'unknown');assert.equal(r.provider_ref,null);}));
test('M02-G14-RETRY-DELAY-BOUNDS',()=>{assert.equal(retryDelay(1),1000);assert.equal(retryDelay(2),2000);assert.equal(retryDelay(3),4000);assert.equal(retryDelay(30),30000);assert.throws(()=>retryDelay(0),/INVALID_INPUT/);});
test('M02-G14-BOUNDED-REPEATED-CLAIM-CRASH',()=>useReliability(f=>{const {op}=f.executeOperation();for(let i=0;i<3;i++){assert.ok(f.work.claim(f.a.scope,op.id,100));f.advance(101);f.work.recover(f.a.scope,op.id);}assert.equal(f.ops.read(f.a.scope,op.id).work.state,'dead');assert.equal(f.journal.count(),0);}));
