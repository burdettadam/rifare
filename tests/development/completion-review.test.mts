import test from 'node:test';import assert from 'node:assert/strict';import {usingCompletion} from './completion-helpers.mts';
import {PrivacyLifecycle,storageInventory} from '../../packages/commerce/privacy-lifecycle.mts';
import {ReturnWorkflowRunner} from '../../packages/assistance/return-workflow-runner.mts';
import {spawn} from 'node:child_process';import {startCommerceServer} from '../../apps/commerce-api/server.mts';

test('M03-COMPLETION-SCHEMA-AND-SCOPED-EXPORT',()=>usingCompletion(f=>{const r=f.full();f.workflows.open(f.a.scope,{request_id:f.request.id,workflow:'return',skill_digest:f.bundles['handle-return'].digest});f.disposition.quote(f.a.scope,{session_id:r.session_id,unit_ids:[r.units[0].id],disposition:'quarantine'});assert(storageInventory(f.kernel).tables.some(t=>t.name==='commerce_received_units'));const data=new PrivacyLifecycle(f.kernel).export(f.owner.scope,f.order().customer_id);assert.equal(data.return_completion_records.commerce_received_units.length,3);assert.equal(data.return_completion_records.commerce_return_workflow_pins.length,1);assert.equal(data.return_completion_records.commerce_lifecycle_quotes.length,1);}));
test('M03-COMPLETION-ERASURE-BLOCKS-READS-AND-SCRUBS-QUOTES',()=>usingCompletion(f=>{const r=f.full(),q=f.disposition.quote(f.a.scope,{session_id:r.session_id,unit_ids:[r.units[0].id],disposition:'quarantine'});new PrivacyLifecycle(f.kernel).erase(f.owner.scope,f.order().customer_id);assert.throws(()=>f.receiving.read(f.a.scope,r.session_id),/ACCESS_DENIED|SUBJECT_ERASED/);const body=JSON.parse(f.db.prepare('SELECT body FROM commerce_lifecycle_quotes WHERE id=?').get(q.id).body);assert.equal(body.redacted,true);assert(!JSON.stringify(body).includes('C-1001'));assert.equal(f.warehouse.stock('shirt-small','warehouse-one'),0);}));
test('M03-COMPLETION-TRACKING-USES-ACTUAL-RECEIPT-NOT-DELIVERY',()=>usingCompletion(async f=>{const label=await f.buy();assert.equal(f.tracking.read(f.a.scope,label.labelId).warehouse.receipt,'pending');f.full();const current=f.tracking.read(f.a.scope,label.labelId);assert.equal(current.carrier.delivered_observed,false);assert.equal(current.warehouse.receipt,'received');assert.equal(current.warehouse.inspection,'complete');assert.equal(current.warehouse.inventory_disposition,'not_recorded');}));
test('M03-COMPLETION-REFUND-EXCHANGE-RECEIVING-JOURNEY',()=>usingCompletion(async f=>{for(const workflow of ['return','exchange'])f.workflows.open(f.a.scope,{request_id:f.request.id,workflow,skill_digest:f.bundles[workflow==='return'?'handle-return':'handle-exchange'].digest});const received=f.full(),refund=f.authorize(f.quotes.quote(f.a.scope,{allocation_id:f.plan.allocations.find(a=>a.outcome==='refund').id}));await f.executor.dispatch(f.a.scope,refund.id);f.source.settle(refund.id);await f.executor.reconcile(f.a.scope,refund.id);const replacement=f.replacement();await f.execution.dispatch(f.a.scope,replacement.id);const op=f.authorizeLife(f.disposition.quote(f.a.scope,{session_id:received.session_id,unit_ids:[received.units.find(u=>u.line_id==='alpha').id],disposition:'restock'}));await f.disposition.dispatch(f.a.scope,op.id);const status=new ReturnWorkflowRunner(f.workflows).resume(f.a.scope,{request_id:f.request.id,workflow:'return'});assert.equal(status.stages.resolutions[0].cash_settled,true);assert.equal(status.stages.replacements[0].state,'created');assert.equal(status.stages.replacements[0].shipment_id,null);assert.equal(f.warehouse.stock('shirt-small','warehouse-one'),1);assert.equal(status.stages.receiving.inspection,'complete');assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,1);assert.equal(f.fulfillmentDb.prepare('SELECT count(*) n FROM fixture_replacements').get().n,1);}));
test('M03-COMPLETION-REPLAYED-CHILD-SCAN-COUNTS-ONCE',()=>usingCompletion(async f=>{const s=f.open(),input={session_id:s.session_id,scan_id:'child_scan',expected_revision:0,items:[f.item()]};const code=`import {DatabaseSync} from 'node:sqlite';import {CommerceKernel} from './packages/commerce/kernel.mts';import {ReturnReceiving} from './packages/commerce/return-receiving.mts';const db=new DatabaseSync(${JSON.stringify(f.filename)}),k=new CommerceKernel(db,()=>${f.now()});new ReturnReceiving(k).scan(k.authenticate(${JSON.stringify(f.a.bearer)}),${JSON.stringify(input)});process.exit(27);`;async function child(){return await new Promise<number>((resolve,reject)=>{const p=spawn(process.execPath,['--experimental-strip-types','--input-type=module','-e',code],{stdio:'ignore'});p.on('error',reject);p.on('close',resolve);});}assert.equal(await child(),27);assert.equal(await child(),27);assert.equal(f.receiving.read(f.a.scope,s.session_id).total_actual,1);assert.equal(f.receiving.read(f.a.scope,s.session_id).revision,1);}));
test('M03-COMPLETION-DISPOSITION-SOURCE-COMMIT-PROCESS-EXIT',()=>usingCompletion(async f=>{const r=f.full(),op=f.authorizeLife(f.disposition.quote(f.a.scope,{session_id:r.session_id,unit_ids:[r.units.find(u=>u.line_id==='alpha').id],disposition:'restock'}));const code=`import {DatabaseSync} from 'node:sqlite';import {CommerceKernel} from './packages/commerce/kernel.mts';import {WarehouseFixtureSource} from './packages/adapters/warehouse-fixture-source.mts';import {ReturnDisposition} from './packages/commerce/return-disposition.mts';const db=new DatabaseSync(${JSON.stringify(f.filename)}),srcDb=new DatabaseSync(${JSON.stringify(f.warehouseFile)}),k=new CommerceKernel(db,()=>${f.now()}),src=new WarehouseFixtureSource(srcDb,{mode:'fixture',identity:'warehouse-fixture',tenant:${JSON.stringify(f.a.tenant)},store:${JSON.stringify(f.a.store)}});const apply=src.apply.bind(src);src.apply=async c=>{await apply(c);process.exit(29)};await new ReturnDisposition(k,src).dispatch(k.authenticate(${JSON.stringify(f.a.bearer)}),${JSON.stringify(op.id)});`;const exit=await new Promise<number>((resolve,reject)=>{const p=spawn(process.execPath,['--experimental-strip-types','--input-type=module','-e',code],{stdio:'ignore'});p.on('error',reject);p.on('close',resolve);});assert.equal(exit,29);assert.equal(f.disposition.read(f.a.scope,op.id).state,'unknown');assert.equal(f.warehouse.stock('shirt-small','warehouse-one'),1);assert.equal((await f.disposition.reconcile(f.a.scope,op.id)).state,'applied');assert.equal(f.warehouse.calls.apply,0);}));
test('M03-COMPLETION-HTTP-CANNOT-INJECT-AUTHORITY',()=>usingCompletion(async f=>{const server=await startCommerceServer({kernel:f.kernel,caps:f.caps,customers:f.customers,simulator:f.simulator});try{const response=await fetch(server.url+'/v1/return-closure/quote',{method:'POST',headers:{'content-type':'application/json',authorization:'Bearer '+f.a.bearer},body:JSON.stringify({request_id:f.request.id,reason:'customer_cancelled',approved:true})});assert.equal(response.status,400);assert.equal((await response.json()).error,'INVALID_INPUT');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_return_closures').get().n,0);const denied=await fetch(server.url+'/v1/receiving/open',{method:'POST',headers:{'content-type':'application/json',authorization:'Bearer '+f.customerBearer},body:JSON.stringify({request_id:f.request.id,location_id:'warehouse-one'})});assert.equal(denied.status,403);}finally{await server.close();}}));
test('M03-COMPLETION-CANCELLATION-AND-AUTHORIZATION-RACE',()=>usingCompletion(async f=>{const refund=f.quotes.quote(f.a.scope,{allocation_id:f.plan.allocations.find(a=>a.outcome==='refund').id}),close=f.cancellation.quote(f.a.scope,{request_id:f.request.id,reason:'customer_cancelled'}),inputs=[refund,close].map(q=>{const p=f.gateway.prepare(f.a.scope,q.proposal),a=f.gateway.approve(f.reviewer.scope,{preview_id:p.id,preview_digest:p.digest});return {preview_id:p.id,preview_digest:p.digest,approval_id:a.id};});async function child(input:any){const code=`import {DatabaseSync} from 'node:sqlite';import {CommerceKernel} from './packages/commerce/kernel.mts';import {ActionGateway} from './packages/commerce/action-gateway.mts';const db=new DatabaseSync(${JSON.stringify(f.filename)}),k=new CommerceKernel(db,()=>${f.now()});try{new ActionGateway(k).execute(k.authenticate(${JSON.stringify(f.a.bearer)}),${JSON.stringify(input)});console.log(JSON.stringify({accepted:true}));}catch(e){console.log(JSON.stringify({accepted:false,reason:e.message}));}finally{db.close();}`;return await new Promise<any>((resolve,reject)=>{const p=spawn(process.execPath,['--experimental-strip-types','--input-type=module','-e',code],{stdio:['ignore','pipe','ignore']});let out='';p.stdout.on('data',d=>out+=d);p.on('error',reject);p.on('close',c=>c===0?resolve(JSON.parse(out)):reject(new Error('child failed')));});}const results=await Promise.all(inputs.map(child));assert.equal(results.filter(r=>r.accepted).length,1);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);}));
