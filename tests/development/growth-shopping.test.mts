const expected=JSON.parse(readFileSync(new URL('../fixtures/growth-shopping/known-answer.v1.json',import.meta.url),'utf8'));
async function mutant(file:string,name:string,marker:string,replacement:string,run:(Broken:any)=>unknown){const dir=mkdtempSync(join(tmpdir(),'rifare-growth-mutant-'));try{const url=new URL(file,import.meta.url),original=readFileSync(url,'utf8');assert.equal(original.split(marker).length,2);const changed=original.replace(marker,replacement).replace(/from '(\.[^']+)'/g,(_m,path)=>"from '"+new URL(path,url).href+"'");const target=join(dir,'mutant.mts');writeFileSync(target,changed);await run((await import(pathToFileURL(target).href))[name]);}finally{rmSync(dir,{recursive:true,force:true});}}
const nativeCount=(f:any,table:string)=>f.sourceDb.prepare('SELECT count(*) n FROM '+table).get().n;
function changedCustomerProof(f:any,kind:'email'|'source'='email'){
 const s=f.kernel.require(f.customer),proof=f.db.prepare('SELECT * FROM commerce_customer_proof_bindings WHERE token_hash=?').get(s.token_hash),customer=f.db.prepare('SELECT * FROM commerce_resources WHERE id=? AND tenant_id=? AND store_id=?').get(proof.customer_resource_id,s.tenant_id,s.store_id);
 if(kind==='source')f.db.prepare('UPDATE commerce_resources SET source_system=? WHERE tenant_id=? AND store_id=? AND id=?').run('changed-customer-source',s.tenant_id,s.store_id,customer.id);
 else f.kernel.ingest(f.a.scope,{kind:'customer',source_system:customer.source_system,external_id:customer.external_id,source_version:customer.source_version+1,source_updated_at:f.now(),customer_id:customer.customer_id,payload:{...JSON.parse(customer.payload),email:'changed-owner@example.invalid'}});
}

test('CASE-M09-G01-01',()=>usingShopping(async f=>{const r=f.carts.recommend(f.a.scope,{resource_id:f.original.id,suggestions:[{variant_id:'basic',unit_minor:'2000'}]});assert.equal(r.items[0].unit_minor,expected.cart.unit_minor);const p=f.cart();assert.equal(p.items[0].variant_id,expected.cart.variant_id);assert.equal(p.total_minor,expected.cart.total_minor);assert.equal(p.items[0].terms.id,expected.cart.terms_id);assert.equal(nativeCount(f,'growth_source_carts'),0);const c=await f.carts.confirm(f.customer,{cart_id:p.cart_id,preview_digest:p.preview_digest});assert.equal(c.committed,true);assert.equal(c.checkout_supported,false);assert.equal(nativeCount(f,'growth_source_carts'),1);assert.equal(f.catalogSource.item('basic').stock,10);const bundle=readInstructionDirectory(fileURLToPath(new URL('../../packages/commerce/skill-bundles/catalog-shopping/',import.meta.url)));assert.equal(bundle.id,'catalog-shopping');}));
test('CASE-M09-G01-02',()=>usingShopping(async f=>{assert.throws(()=>f.carts.recommend(f.a.scope,{resource_id:f.original.id,suggestions:[{variant_id:'invented',unit_minor:'1'}]}),/SOURCE_MISSING/);assert.throws(()=>f.carts.recommend(f.a.scope,{resource_id:f.original.id,suggestions:[{variant_id:'basic',unit_minor:'1'}]}),/MODEL_FACT_MISMATCH/);assert.throws(()=>f.carts.propose(f.a.scope,{cart_id:'invented',resource_id:f.original.id,items:[{variant_id:'basic',quantity:1,unit_minor:'1'}]}),/INVALID_INPUT/);assert.throws(()=>f.carts.propose(f.a.scope,{cart_id:'invented',resource_id:f.original.id,items:[{variant_id:'basic',quantity:1}],discount:'99%'}),/INVALID_INPUT/);const p=f.cart();await assert.rejects(f.carts.confirm(f.a.scope,{cart_id:p.cart_id,preview_digest:p.preview_digest}),/CUSTOMER_VERIFICATION_REQUIRED/);changedCustomerProof(f);await assert.rejects(f.carts.confirm(f.customer,{cart_id:p.cart_id,preview_digest:p.preview_digest}),/CUSTOMER_VERIFICATION_REQUIRED/);assert.equal(nativeCount(f,'growth_source_carts'),0);assert.equal(nativeCount(f,'growth_source_cart_effects'),0);}));
test('CASE-M09-G01-03',async()=>{await usingShopping(async f=>{const p=f.cart();f.native.fixtureStock('basic',0);await assert.rejects(f.carts.confirm(f.customer,{cart_id:p.cart_id,preview_digest:p.preview_digest}),/STOCK_UNAVAILABLE|PREVIEW_CHANGED/);assert.equal(nativeCount(f,'growth_source_carts'),0);});await mutant('../../packages/commerce/shopping-cart.mts','ShoppingCart','const facts = source.item(suggestion.variant_id);',"const facts = {...suggestion,available:true,excluded:false,subscription:false,stock:10,currency:'USD',terms:{id:'invented'},revision:'unobserved'};",Broken=>usingShopping(f=>{const broken=new Broken(f.kernel,f.catalogSource),oracle=()=>assert.throws(()=>broken.recommend(f.a.scope,{resource_id:f.original.id,suggestions:[{variant_id:'invented',unit_minor:'1'}]}),/SOURCE_MISSING/);assert.throws(oracle,assert.AssertionError);}));});
test('M09-G01-CART-UNKNOWN-SCOPE-AND-CURRENT-PURCHASE',()=>usingShopping(async f=>{const p=f.cart(),draft=f.cart('preexisting-draft');f.catalogSource.fault='after';const first=await f.carts.confirm(f.customer,{cart_id:p.cart_id,preview_digest:p.preview_digest});assert.equal(first.state,'unknown');assert.throws(()=>f.cart('replacement-cart'),/SHOPPING_RECONCILIATION_REQUIRED/);await assert.rejects(f.carts.confirm(f.customer,{cart_id:draft.cart_id,preview_digest:draft.preview_digest}),/SHOPPING_RECONCILIATION_REQUIRED/);assert.equal(nativeCount(f,'growth_source_carts'),1);assert.equal(nativeCount(f,'growth_source_cart_effects'),1);assert.equal(f.carts.readCart(f.a.scope,draft.cart_id).state,'proposed');const again=await f.carts.confirm(f.customer,{cart_id:p.cart_id,preview_digest:p.preview_digest});assert.equal(again.committed,true);assert.equal(nativeCount(f,'growth_source_cart_effects'),1);assert.throws(()=>f.carts.readCart(f.b.scope,p.cart_id),/NOT_FOUND|SOURCE_SCOPE/);f.catalogSource.fixturePurchase(p.cart_id,'native-order-one');const current=f.carts.readCart(f.a.scope,p.cart_id);assert.equal(current.status,'purchased');assert.equal(current.native_order_id,'native-order-one');assert.equal(current.subject_id,f.original.customer_id);assert.equal(new ShoppingCart(f.kernel).available,false);}));

test('M09-G02-PREP-01',()=>usingShopping(async f=>{const o=f.offer(),e=f.authorizeOffer(o),pending=await f.edits.dispatch(f.a.scope,e);assert.equal(pending.source.finance.amount_minor,expected.upsell.added_minor);assert.equal(pending.source.finance.state,'unpaid');assert.equal(f.native.order(f.original.id).lines.length,expected.upsell.final_lines);assert.equal(f.native.canPick(f.original.id,'warehouse_one'),false);f.native.settle(e);await f.edits.dispatch(f.a.scope,e);assert.equal((await f.edits.release(f.a.scope,e)).state,'released');assert.equal(f.native.order(f.original.id).total_minor,expected.upsell.final_total_minor);assert.equal(nativeCount(f,'edit_source_fulfillments'),expected.upsell.fulfillments);assert.equal(nativeCount(f,'edit_source_finance'),expected.upsell.invoices);assert.equal(f.native.warehouse(f.original.id,'warehouse_one').final_variant_ids.length,2);assert.equal(f.native.catalog('upgrade').stock,9);}));
test('M09-G02-PREP-02',async()=>{await usingShopping(f=>{f.native.tryPick(f.original.id,'warehouse_one');assert.throws(()=>f.offer(),/INELIGIBLE/);});await usingShopping(async f=>{const o=f.offer();assert.throws(()=>f.edits.prepare(f.a.scope,{quote_id:o.quote_id,quote_digest:o.quote_digest}),/UPSELL_CUSTOMER_CONFIRMATION_REQUIRED/);assert.throws(()=>f.upsells.confirm(f.a.scope,{offer_id:o.offer_id,quote_digest:o.quote_digest}),/CUSTOMER_VERIFICATION_REQUIRED/);const e=f.authorizeOffer(o);await f.edits.dispatch(f.a.scope,e);await assert.rejects(f.edits.release(f.a.scope,e),/PAYMENT_OUTSTANDING/);assert.equal(f.native.canPick(f.original.id,'warehouse_one'),false);});});
test('M09-G02-PREP-03',async()=>{await usingShopping(async f=>{const o=f.offer(),e=f.authorizeOffer(o);f.native.fault='after';f.native.faultStage='invoice';assert.equal((await f.edits.dispatch(f.a.scope,e)).state,'unknown');f.confirmOffer(o);await f.edits.dispatch(f.a.scope,e);f.edits.reconcile(f.a.scope,e);await f.edits.dispatch(f.a.scope,e);assert.equal(nativeCount(f,'edit_source_fulfillments'),1);assert.equal(nativeCount(f,'edit_source_finance'),1);assert.equal(nativeCount(f,'edit_source_orders'),1);assert.equal(f.upsells.status(f.a.scope,o.offer_id).edit_id,e);});await mutant('../../packages/commerce/pre-fulfillment-upsells.mts','PreFulfillmentUpsells','// Repeated customer acceptance only returns the original confirmation.',"// Deliberate fault: repeated acceptance creates another native fulfillment.\n      this.edits.source!.db.prepare(\"INSERT INTO edit_source_fulfillments SELECT order_id,'duplicate-upsell',revision,body,digest FROM edit_source_fulfillments LIMIT 1\").run();",Broken=>usingShopping(f=>{const o=f.offer();f.confirmOffer(o);const broken=new Broken(f.edits);broken.confirm(f.customer,{offer_id:o.offer_id,quote_digest:o.quote_digest});assert.equal(nativeCount(f,'edit_source_fulfillments'),2);assert.throws(()=>assert.equal(nativeCount(f,'edit_source_fulfillments'),expected.upsell.fulfillments),assert.AssertionError);}));});
test('M09-G02-CURRENT-CUSTOMER-AUTHORITY-AND-STOCK',async()=>{await usingShopping(async f=>{const o=f.offer(),e=f.authorizeOffer(o);f.kernel.revoke(f.customer);await assert.rejects(f.edits.dispatch(f.a.scope,e),/UPSELL_CONFIRMATION_UNAVAILABLE/);assert.equal(nativeCount(f,'edit_source_effects'),0);});await usingShopping(async f=>{const o=f.offer(),e=f.authorizeOffer(o);f.native.fixtureStock('upgrade',0);await f.edits.dispatch(f.a.scope,e);assert.equal(f.native.order(f.original.id).lines.length,1);assert.equal(nativeCount(f,'edit_source_finance'),0);});await usingShopping(f=>{const o=f.offer();changedCustomerProof(f,'source');assert.throws(()=>f.confirmOffer(o),/CUSTOMER_VERIFICATION_REQUIRED/);assert.equal(nativeCount(f,'edit_source_upsell_consents'),0);assert.equal(nativeCount(f,'edit_source_effects'),0);});await usingShopping(async f=>{const o=f.offer(),e=f.authorizeOffer(o);changedCustomerProof(f);await assert.rejects(f.edits.dispatch(f.a.scope,e),/UPSELL_CONFIRMATION_UNAVAILABLE/);assert.equal(nativeCount(f,'edit_source_effects'),0);assert.equal(nativeCount(f,'edit_source_finance'),0);});await usingShopping(async f=>{const o=f.offer(),e=f.authorizeOffer(o),perform=f.native.perform.bind(f.native);f.native.perform=async(command:any,authorize?:()=>void)=>{if(command.stage==='commit')changedCustomerProof(f);return perform(command,authorize);};assert.equal((await f.edits.dispatch(f.a.scope,e)).state,'unknown');assert.equal(f.native.order(f.original.id).lines.length,1);assert.equal(f.native.order(f.original.id).version,1);assert.equal(nativeCount(f,'edit_source_finance'),0);assert.equal(f.sourceDb.prepare("SELECT count(*) n FROM edit_source_effects WHERE json_extract(body_or_result,'$.stage')='commit'".replace('body_or_result','result')).get().n,0);});});

test('M09-G10-PREP-01',()=>usingShopping(f=>{f.observe();const r=f.visibility.evaluate(f.a.scope,{evaluation_id:'evaluation-one',resource_id:f.original.id,observation_id:'visibility-one'});for(const [key,value] of Object.entries(expected.visibility))assert.equal(r.summary[key],value);assert.equal(r.model.model,'fixture-model-v1');assert.equal(r.prompt_set.id,'shirts-v1');assert.ok(r.catalog_digest);assert.ok(r.source_observation_digest);assert.equal(r.connected_qualified,false);}));
test('M09-G10-PREP-02',()=>usingShopping(f=>{f.observe('incorrect',{answers:[{question_id:'q-basic',observed:true,mentions:[{variant_id:'basic',unit_minor:'2000',available:false}],citations:[]}]});let r=f.visibility.evaluate(f.a.scope,{evaluation_id:'incorrect',resource_id:f.original.id,observation_id:'incorrect'});assert.equal(r.summary.incorrect_claims,1);f.observe('scraping',{interface:'prohibited_scraping'});r=f.visibility.evaluate(f.a.scope,{evaluation_id:'unsupported',resource_id:f.original.id,observation_id:'scraping'});assert.equal(r.summary.observed_questions,0);assert.equal(r.summary.unsupported_questions,1);assert.equal(r.summary.mentions,0);}));
test('M09-G10-PREP-03',async()=>{await usingShopping(f=>{f.observe();const a=f.visibility.evaluate(f.a.scope,{evaluation_id:'baseline',resource_id:f.original.id,observation_id:'visibility-one'});f.native.fixtureStock('basic',0);f.observe('next',{model:{provider:'fixture-provider',model:'fixture-model-v2',settings:{temperature:0}}});const b=f.visibility.evaluate(f.a.scope,{evaluation_id:'later',resource_id:f.original.id,observation_id:'next'});const history=f.visibility.history(f.a.scope,f.original.id);assert.equal(history.length,2);assert.deepEqual(history.find((r:any)=>r.evaluation_id==='baseline'),a);assert.notEqual(a.catalog_digest,b.catalog_digest);assert.equal(a.prompt_digest,b.prompt_digest);});await mutant('../../packages/commerce/catalog-growth.mts','CatalogVisibility','future_placement_guaranteed: false','future_placement_guaranteed: true',Broken=>usingShopping(f=>{f.observe('unobserved',{answers:[{question_id:'q-basic',observed:false,mentions:[],citations:[]}]});const r=new Broken(f.kernel,f.catalogSource).evaluate(f.a.scope,{evaluation_id:'broken',resource_id:f.original.id,observation_id:'unobserved'});assert.equal(r.summary.observed_questions,0);assert.throws(()=>assert.equal(r.summary.future_placement_guaranteed,false,'Unobserved recommendations cannot guarantee future placement'),assert.AssertionError);}));});

test('M09-G11-PREP-01',()=>usingShopping(async f=>{const c=f.change();f.approveChange(c);const applied=await f.changes.dispatch(f.a.scope,c.change_id);assert.equal(applied.state,'applied');assert.equal(f.catalogSource.item('basic').description,expected.catalog.after);assert.equal(f.catalogSource.item('basic').unit_minor,expected.catalog.protected_unit_minor);assert.ok(applied.receipt.native_id);const rollback=f.changes.rollback(f.a.scope,{change_id:c.change_id,rollback_id:'rollback-one'});await assert.rejects(f.changes.dispatch(f.a.scope,rollback.change_id),/APPROVAL_REQUIRED/);f.approveChange(rollback);await f.changes.dispatch(f.a.scope,rollback.change_id);assert.equal(f.catalogSource.item('basic').description,expected.catalog.before);}));
test('M09-G11-PREP-02',()=>usingShopping(async f=>{assert.throws(()=>f.change('invented',{description:'Certified organic and guaranteed waterproof.'}),/UNSUPPORTED_FACT/);assert.throws(()=>f.change('price',{unit_minor:'1'}),/INVALID_INPUT/);const c=f.change();f.approveChange(c);f.native.fixtureStock('basic',9);await assert.rejects(f.changes.dispatch(f.a.scope,c.change_id),/SOURCE_CHANGED/);assert.equal(nativeCount(f,'growth_source_catalog_effects'),0);}));
test('M09-G11-PREP-03',async()=>{await usingShopping(async f=>{const c=f.change();f.approveChange(c);await f.changes.dispatch(f.a.scope,c.change_id);f.native.fixtureStock('basic',9);assert.throws(()=>f.changes.rollback(f.a.scope,{change_id:c.change_id,rollback_id:'conflicting'}),/ROLLBACK_CONFLICT/);assert.equal(f.catalogSource.item('basic').description,expected.catalog.after);});await mutant('../../packages/commerce/catalog-growth.mts','ReviewedCatalogChanges',"if (!approval) throw new Error('CATALOG_APPROVAL_REQUIRED');","if (!approval) return; // deliberate bypass of merchant review",Broken=>usingShopping(async f=>{const c=f.change(),broken=new Broken(f.kernel,f.catalogSource);await broken.dispatch(f.a.scope,c.change_id);assert.equal(f.catalogSource.item('basic').description,expected.catalog.after);assert.throws(()=>assert.equal(f.catalogSource.item('basic').description,expected.catalog.before,'Model suggestions must stay proposed without independent merchant review'),assert.AssertionError);}));});
test('M09-G11-CURRENT-AUTHORITY-UNKNOWN-STOP-AND-RESTORE',async()=>{await usingShopping(async f=>{const c=f.change();assert.throws(()=>f.changes.approve(f.a.scope,{change_id:c.change_id,expected_digest:c.digest,expires_at:f.now()+60000}),/ACCESS_DENIED|SELF_APPROVAL/);f.approveChange(c);new Permissions(f.kernel).change(f.owner.scope,{actor_id:'reviewer',role:'reviewer',expected_revision:0,actions:['resource.read','operation.read'],resource_ids:null});await assert.rejects(f.changes.dispatch(f.a.scope,c.change_id),/APPROVAL_AUTHORITY_CHANGED/);assert.equal(nativeCount(f,'growth_source_catalog_effects'),0);});await usingShopping(async f=>{const c=f.change();f.approveChange(c);f.catalogSource.fault='after';assert.equal((await f.changes.dispatch(f.a.scope,c.change_id)).state,'unknown');assert.equal((await f.changes.dispatch(f.a.scope,c.change_id)).state,'unknown');assert.equal(f.changes.reconcile(f.a.scope,c.change_id).state,'applied');assert.equal(nativeCount(f,'growth_source_catalog_effects'),1);});await usingShopping(async f=>{const c=f.change();f.approveChange(c);new ExecutionStops(f.kernel).set(f.owner.scope,{action:'diagnostic.order.edit',stopped:true,reason:'incident',expected_revision:0});await assert.rejects(f.changes.dispatch(f.a.scope,c.change_id),/EXECUTION_STOPPED/);f.db.prepare("INSERT INTO commerce_recovery_state VALUES(1,'restore-growth','quarantine',?,?,?)").run('a'.repeat(64),'b'.repeat(64),f.now());assert.throws(()=>f.cart(),/RESTORE_WRITE_BLOCKED/);});});
