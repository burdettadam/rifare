import test from 'node:test';import assert from 'node:assert/strict';
import { usingFinance,oracle } from './exchange-finance-helpers.mts';
import { ExchangeFinance,exchangeSettlement } from '../../packages/commerce/exchange-finance.mts';
import { ResolutionExecution } from '../../packages/commerce/resolution-execution.mts';
import { ResolutionFixtureSource } from '../../packages/adapters/resolution-fixture-source.mts';
import { CommerceKernel } from '../../packages/commerce/kernel.mts';
import { DatabaseSync } from 'node:sqlite';
import { canonical,contentDigest } from '../../packages/commerce/configuration-values.mts';
const count=(f:any,table:string)=>f.sourceDb.prepare('SELECT count(*) n FROM '+table).get().n;
const nativeCommand=(f:any,binding:any)=>({tenant_id:f.a.tenant,store_id:f.a.store,resource_id:f.order().id,customer_id:f.order().customer_id,allocation_id:f.allocation.id,currency:'USD',exchange_quote_digest:f.exchange.digest,variant_id:f.exchange.quote.replacement_variant,quantity:f.exchange.quote.quantity,exchange_value_minor:f.exchange.quote.replacement_minor,original_value_minor:f.exchange.quote.available_exchange_value_minor,...binding});

test('CASE-M06-G02-01',()=>usingFinance(async f=>{const quote=f.financeQuote(),op=f.authorize(quote);assert.equal(quote.quote.amount_minor,oracle.higher.additional_payment_minor);assert.equal(quote.quote.original_value_minor,oracle.higher.original_exchange_value_minor);const unpaid=await f.executor.dispatch(f.a.scope,op.id);assert.equal(unpaid.state,'unpaid');assert.equal(unpaid.payment_settled,false);assert.throws(f.settlement,/EXCHANGE_PAYMENT_OUTSTANDING/);f.source.settlePayment(op.id);const paid=await f.executor.reconcile(f.a.scope,op.id);assert.equal(paid.state,'settled');const binding=f.settlement();assert.equal(binding.balance_minor,'0');assert.equal(f.source.assertExchangeSettlement(nativeCommand(f,binding)).settled,true);assert.equal(count(f,'fixture_payment_captures'),oracle.higher.captures);}));
test('CASE-M06-G02-02',()=>usingFinance(async f=>{const op=f.authorize(f.financeQuote());await f.executor.dispatch(f.a.scope,op.id);f.source.settlePayment(op.id,{state:'partial',paid_minor:oracle.higher.partial_payment_minor});await f.executor.reconcile(f.a.scope,op.id);assert.throws(f.settlement,/EXCHANGE_PAYMENT_OUTSTANDING/);assert.equal(count(f,'fixture_payment_captures'),0);f.source.settlePayment(op.id);await f.executor.reconcile(f.a.scope,op.id);const binding=f.settlement(),forged=nativeCommand(f,binding);forged.allocation_id='different_exchange';assert.throws(()=>f.source.assertExchangeSettlement(forged),/EXCHANGE_FINANCE_MISMATCH/);}));
test('CASE-M06-G02-03',()=>usingFinance(async f=>{const op=f.authorize(f.financeQuote()),issue=f.source.issue.bind(f.source);let calls=0;f.source.issue=async command=>{calls++;await issue(command);f.source.settlePayment(op.id);throw new Error('lost after exact source capture');};assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');await f.executor.dispatch(f.a.scope,op.id);assert.equal(calls,1);assert.throws(f.settlement,/EXCHANGE_PAYMENT_OUTSTANDING/);assert.equal((await f.executor.reconcile(f.a.scope,op.id)).state,'settled');await f.executor.dispatch(f.a.scope,op.id);f.source.settlePayment(op.id);assert.equal(count(f,'fixture_resolution_effects'),oracle.higher.obligations);assert.equal(count(f,'fixture_payment_captures'),oracle.higher.captures);assert.equal(f.settlement().exchange_finance.operation_id,op.id);}));
test('M06-G02-AGENT-CANNOT-CHOOSE-AMOUNT',()=>usingFinance(f=>{assert.throws(()=>f.finance.quote(f.a.scope,{exchange_quote_id:f.exchange.id,exchange_quote_digest:f.exchange.digest,outcome:'additional_payment',amount_minor:'1'}),/INVALID_INPUT/);}));
test('M06-G02-REFUND-OUTCOME-CANNOT-PAY-UPGRADE',()=>usingFinance(f=>{assert.throws(()=>f.financeQuote('refund'),/EXCHANGE_FINANCE_OUTCOME_UNSUPPORTED/);assert.throws(()=>f.quote(f.allocation),/OUTCOME_UNSUPPORTED/);}));
test('M06-G02-REVOKED-APPROVAL-PREVENTS-INVOICE',()=>usingFinance(async f=>{const op=f.authorize(f.financeQuote());f.gateway.revokeApproval(f.reviewer.scope,op.approval.id);await assert.rejects(f.executor.dispatch(f.a.scope,op.id),/APPROVAL_AUTHORITY_CHANGED/);assert.equal(count(f,'fixture_resolution_effects'),0);}));
test('M06-G02-WRONG-SOURCE-PAYMENT-DOES-NOT-SETTLE',()=>usingFinance(async f=>{const op=f.authorize(f.financeQuote()),issue=f.source.issue.bind(f.source);f.source.issue=async command=>{const result=await issue(command);result.payment.obligation_id='unrelated_exchange';return result;};assert.equal((await f.executor.dispatch(f.a.scope,op.id)).state,'unknown');assert.throws(f.settlement,/EXCHANGE_PAYMENT_OUTSTANDING/);assert.equal(count(f,'fixture_payment_captures'),0);}));
test('M06-G02-ONE-OBLIGATION-PER-ALLOCATION',()=>usingFinance(async f=>{const op=f.authorize(f.financeQuote());await f.executor.dispatch(f.a.scope,op.id);assert.throws(()=>f.financeQuote(),/ALLOCATION_ALREADY_AUTHORIZED/);assert.throws(()=>f.exchanges.quote(f.a.scope,{allocation_id:f.allocation.id,catalog_id:f.catalogResource.id}),/ALLOCATION_ALREADY_AUTHORIZED/);assert.equal(count(f,'fixture_resolution_effects'),1);}));
test('M06-G02-CROSS-TENANT-PAYMENT-HIDDEN',()=>usingFinance(async f=>{const op=f.authorize(f.financeQuote());assert.throws(()=>f.executor.read(f.b.scope,op.id),/NOT_FOUND/);assert.throws(()=>f.finance.quote(f.customer,{exchange_quote_id:f.exchange.id,exchange_quote_digest:f.exchange.digest,outcome:'additional_payment'}),/ACCESS_DENIED/);}));
test('M06-G02-FAILED-AND-EXPIRED-PAYMENT-REMAIN-HELD',()=>usingFinance(async f=>{const op=f.authorize(f.financeQuote());await f.executor.dispatch(f.a.scope,op.id);for(const state of ['failed','expired']){f.source.settlePayment(op.id,{state,paid_minor:'0'});await f.executor.reconcile(f.a.scope,op.id);assert.throws(f.settlement,/EXCHANGE_PAYMENT_OUTSTANDING/);}assert.equal(count(f,'fixture_payment_captures'),0);}));
test('M06-G02-REOPEN-RECONCILES-SAME-OBLIGATION',()=>usingFinance(async f=>{const op=f.authorize(f.financeQuote()),issue=f.source.issue.bind(f.source);f.source.issue=async p=>{await issue(p);throw new Error('lost');};await f.executor.dispatch(f.a.scope,op.id);const db=new DatabaseSync(f.filename),nativeDb=new DatabaseSync(f.sourceFilename);try{const k=new CommerceKernel(db,f.now),scope=k.authenticate(f.a.bearer),native=new ResolutionFixtureSource(nativeDb,{mode:'fixture',identity:'source-one',tenant:f.a.tenant,store:f.a.store},f.now),execution=new ResolutionExecution(k,native);native.settlePayment(op.id);assert.equal((await execution.reconcile(scope,op.id)).state,'settled');await execution.dispatch(scope,op.id);assert.equal(count(f,'fixture_resolution_effects'),1);assert.equal(count(f,'fixture_payment_captures'),1);}finally{db.close();nativeDb.close();}}));
test('M06-G02-FORGED-LOCAL-SETTLED-ROW-NO-NATIVE-CAPTURE',()=>usingFinance(async f=>{const op=f.authorize(f.financeQuote());await f.executor.dispatch(f.a.scope,op.id);const row=f.db.prepare('SELECT * FROM commerce_resolution_operations WHERE id=?').get(op.id) as any,command=JSON.parse(row.command),proof={operation_id:op.id,source_identity:command.source_identity,exchange_quote_id:command.exchange_quote_id,exchange_quote_digest:command.exchange_quote_digest,allocation_id:command.allocation_id,resource_id:command.resource_id,customer_id:command.customer_id,currency:command.currency,kind:command.kind,amount_minor:command.amount_minor,native_id:row.native_id,state:'settled',command_digest:row.digest};assert.throws(()=>f.source.assertExchangeSettlement(nativeCommand(f,{balance_minor:'0',exchange_finance:proof})),/EXCHANGE_PAYMENT_OUTSTANDING/);}));
