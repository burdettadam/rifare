import test from 'node:test';import assert from 'node:assert/strict';import {usingCompletion} from './completion-helpers.mts';
const cancel=(f:any)=>f.authorizeLife(f.cancellation.quote(f.a.scope,{request_id:f.request.id,reason:'customer_cancelled'}));
test('CASE-M03-G18-01',()=>usingCompletion(async f=>{f.full();const alloc=f.plan.allocations.find(a=>a.outcome==='refund'),op=f.authorize(f.quotes.quote(f.a.scope,{allocation_id:alloc.id}));await f.executor.dispatch(f.a.scope,op.id);f.source.settle(op.id);await f.executor.reconcile(f.a.scope,op.id);const receipt=f.open();cancel(f);assert.equal(f.executor.read(f.a.scope,op.id).cash_settled,true);assert.equal(f.receiving.read(f.a.scope,receipt.session_id).total_actual,3);assert.equal(f.cancellation.read(f.a.scope,f.request.id).state,'cancelled');}));
test('CASE-M03-G18-02',()=>usingCompletion(async f=>{const op=f.replacement();cancel(f);await assert.rejects(f.execution.dispatch(f.a.scope,op.id),/RETURN_CLOSED|APPROVAL/);assert.equal(f.fulfillmentDb.prepare('SELECT count(*) n FROM fixture_replacements').get().n,0);}));
test('CASE-M03-G18-03',()=>usingCompletion(f=>{const q=f.cancellation.quote(f.a.scope,{request_id:f.request.id,reason:'customer_cancelled'}),op=f.authorizeLife(q);assert.throws(()=>f.gateway.execute(f.a.scope,{preview_id:op.preview.id,preview_digest:op.preview.digest,approval_id:op.approval.id}),/APPROVAL_UNAVAILABLE|RETURN_CLOSED/);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_return_closures').get().n,1);assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_return_lifecycle_events').get().n,1);assert.equal(f.cancellation.read(f.a.scope,f.request.id).notification_sent,false);}));
test('CANCELLATION-COMPLETION-CANCELLATION-DOES-NOT-RELEASE-STOCK-UNTIL-SOURCE-CONFIRMED-CLEANUP',()=>usingCompletion(f=>{const reservation=f.reserve();cancel(f);assert.equal(f.inventory.read(f.a.scope,reservation.id).state,'active');const first=f.cancellation.cleanup(f.a.scope,{request_id:f.request.id},f.fulfillmentSource);assert.equal(first.reservations[0].state,'released');const second=f.cancellation.cleanup(f.a.scope,{request_id:f.request.id},f.fulfillmentSource);assert.equal(second.reservations[0].state,'released');}));
test('CANCELLATION-COMPLETION-UNKNOWN-REPLACEMENT-PREVENTS-RELEASING-ITS-RESERVATION',()=>usingCompletion(async f=>{const op=f.replacement(),send=f.fulfillmentSource.replace.bind(f.fulfillmentSource);f.fulfillmentSource.replace=async input=>{await send(input);throw new Error('lost');};await f.execution.dispatch(f.a.scope,op.id);cancel(f);const cleanup=f.cancellation.cleanup(f.a.scope,{request_id:f.request.id},f.fulfillmentSource);assert.equal(cleanup.reservations[0].state,'manual_reconciliation_required');assert.equal((await f.execution.reconcile(f.a.scope,op.id)).state,'created');}));
test('CANCELLATION-COMPLETION-EXPIRY-REASON-CANNOT-BE-SUPPLIED-BEFORE-THE-SERVER-DEADLINE',()=>usingCompletion(f=>{assert.throws(()=>f.cancellation.quote(f.a.scope,{request_id:f.request.id,reason:'unused_expired'}),/RETURN_NOT_EXPIRED/);}));
test('CANCELLATION-COMPLETION-CANCELLATION-KEEPS-UNUSED-LABEL-AND-PENDING-REIMBURSEMENT-DISTINCT',()=>usingCompletion(async f=>{const label=await f.buy();cancel(f);let state=f.cancellation.read(f.a.scope,f.request.id);assert.equal(state.labels.length,1);assert.equal(state.labels[0].requires_separate_void_approval,true);assert.equal(state.native_return_cancelled,false);const q=f.cancellation.quoteVoid(f.a.scope,{label_id:label.labelId},f.fulfillmentSource),op=f.authorizeFulfillment(q);await f.execution.dispatch(f.a.scope,op.id);assert.equal(f.cancellation.read(f.a.scope,f.request.id).labels[0].void_state,'requested');f.fulfillmentSource.confirmVoid(label.labelId,true);await f.execution.reconcile(f.a.scope,op.id);state=f.cancellation.read(f.a.scope,f.request.id);assert.equal(state.labels[0].void_state,'confirmed');assert.notEqual(state.labels[0].reimbursement.state,'refunded');}));
test('CANCELLATION-COMPLETION-CHANGED-PHYSICAL-HISTORY-INVALIDATES-AN-OLDER-CANCELLATION-PREVIEW',()=>usingCompletion(f=>{const q=f.cancellation.quote(f.a.scope,{request_id:f.request.id,reason:'customer_cancelled'});f.scan([f.item()]);assert.throws(()=>f.gateway.prepare(f.a.scope,q.proposal),/LIFECYCLE_QUOTE_CHANGED/);assert.equal(f.cancellation.read(f.a.scope,f.request.id).state,'open');}));
test('CANCELLATION-COMPLETION-CUSTOMER-CANNOT-APPROVE-CANCELLATION',()=>usingCompletion(f=>{const q=f.cancellation.quote(f.a.scope,{request_id:f.request.id,reason:'customer_cancelled'}),p=f.gateway.prepare(f.a.scope,q.proposal);assert.throws(()=>f.gateway.approve(f.customer,{preview_id:p.id,preview_digest:p.digest}),/ACCESS_DENIED/);}));
test('CANCELLATION-COMPLETION-PHYSICAL-RECEIVING-REMAINS-POSSIBLE-AFTER-CANCELLING-REMAINING-OBLIGATIONS',()=>usingCompletion(f=>{cancel(f);const receipt=f.scan([f.item()]);assert.equal(receipt.total_actual,1);assert.equal(f.cancellation.read(f.a.scope,f.request.id).state,'cancelled');}));
test('M03-G18-EXPIRED-REQUEST-CLOSES-WITH-FRESH-OPERATOR-AUTHORITY',()=>usingCompletion(f=>{const actors=[f.owner,f.reviewer,f.a].map(a=>({record:a,subject:f.kernel.require(a.scope)}));f.advance(30*86400000+1);for(const {record,subject} of actors)record.scope=f.kernel.authenticate(f.kernel.issueSession(subject.tenant_id,subject.store_id,subject.actor_id));f.gateway.configure(f.owner.scope,{enabled:true,expected_revision:1,profile_id:'default',policy_id:'returns'});const quote=f.cancellation.quote(f.a.scope,{request_id:f.request.id,reason:'unused_expired'});f.authorizeLife(quote);assert.equal(f.cancellation.read(f.a.scope,f.request.id).state,'expired');assert.equal(f.db.prepare('SELECT count(*) n FROM commerce_return_lifecycle_events').get().n,1);assert.equal(f.sourceDb.prepare('SELECT count(*) n FROM fixture_resolution_effects').get().n,0);}));
