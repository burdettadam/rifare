  "conditions": [
    {
      "id": "VERIFIED_CUSTOMER",
      "description": "Verify tenant/store/customer ownership; no order enumeration."
    },
    {
      "id": "CURRENT_POLICY",
      "description": "Use published versioned policy and current item/order facts."
    },
    {
      "id": "SOURCE_RECONCILIATION",
      "description": "Retain native references, stable operation identity and unknown-outcome reconciliation."
    },
    {
      "id": "GATEWAY_QUALIFIED",
      "description": "Qualify the exact payment gateway, API version, account and currency before money-moving use."
    },
    {
      "id": "FULFILLMENT_QUALIFIED",
      "description": "Prove every connected fulfillment writer honors holds and final edits before permitting an edit."
    },
    {
      "id": "PAID_BALANCE",
      "description": "Do not release the owned fulfillment hold until required payment and native order state reconcile."
    },
    {
      "id": "INVENTORY_QUALIFIED",
      "description": "Qualify reservation, source stock and replacement lineage without overselling."
    },
    {
      "id": "CREDIT_QUALIFIED",
      "description": "Qualify the actual credit instrument; a local balance is not issued credit."
    },
    {
      "id": "CARRIER_QUALIFIED",
      "description": "Qualify the configured carrier/service/account and native label effects."
    },
    {
      "id": "RECEIPT_EVIDENCE",
      "description": "Record actual receipt, inspection and disposition separately from carrier delivery."
    },
    {
      "id": "HUMAN_APPROVAL",
      "description": "Require the policy-bound human authorization at the declared action boundary."
    },
    {
      "id": "MANDATE_QUALIFIED",
      "description": "Qualify mandate, authorization expiry and limited capture; otherwise instant exchange is disabled."
    },
    {
      "id": "CHANNEL_QUALIFIED",
      "description": "Qualify channel identity, takeover, consent and queued-send suppression."
    },
    {
      "id": "PLATFORM_SEMANTICS",
      "description": "Publish native/composed/manual differences and verify the connected platform version."
    },
    {
      "id": "CURRENCY_QUALIFIED",
      "description": "Qualify original allocations, estimates/final fees and currency-specific rounding."
    }
  ],
