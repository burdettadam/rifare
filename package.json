{
  "name": "rifare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Rifare commerce development preview with local synthetic demonstrations.",
  "engines": {
    "node": ">=22.16.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --experimental-strip-types tools/dev-target.mts",
    "dev:smoke": "node --experimental-strip-types tools/dev-smoke.mts",
    "stop:smoke": "node --experimental-strip-types tools/dev-stop.mts",
    "db:migrate:smoke": "node --experimental-strip-types tools/dev-migrate.mts",
    "test:runtime": "node --experimental-strip-types --test --test-concurrency=1 tests/development/config.test.mts tests/development/store.test.mts tests/development/integration.test.mts tests/development/review.test.mts",
    "verify": "python3 tools/verify.py",
    "demo:returns": "node --experimental-strip-types tools/demo-return-resolution.mts",
    "demo:support": "node --experimental-strip-types tools/demo-support.mts",
    "demo:recovery": "node --experimental-strip-types tools/demo-return-resolution.mts --guided",
    "check:preview": "python3 tools/check_publication_preview.py"
  }
}
