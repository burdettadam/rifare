{
  "contract": "image-reader.v1",
  "adapter": "cloudflare-image-decision-v1",
  "provider": "cloudflare",
  "model_id": "@cf/cloudflare/clef-omni",
  "selector": "clef-omni",
  "status": "diagnostic_fixture_only_unaccepted",
  "live_transport_available": false,
  "live_enable_option": false,
  "question_types": ["choice", "noul", "score"],
  "logical_request_contract": "decision-model.v1",
  "logical_request_unchanged": true,
  "media_envelope": {
    "fields": ["request", "image", "expected_configuration_digest", "guard", "signal"],
    "callback_boundary": "trusted_process_local_data_properties_not_json",
    "image_fields": ["mime", "base64", "sha256", "source_sha256", "transformation"],
    "max_images": 1,
    "mime": "image/png",
    "max_decoded_file_bytes": 262144,
    "max_pixels": 4000000,
    "color_types": ["rgb8", "rgba8"],
    "transformation": "restricted_png_identity_v1",
    "source_hash_equals_sent_hash": true,
    "metadata_policy": "reject",
    "remote_urls": false,
    "audio": "disabled",
    "video": "disabled",
    "unknown_fields": "reject"
  },
  "context": {
    "max_logical_request_bytes": 16384,
    "conservative_text_count": "every_utf8_byte_of_complete_mapped_model_state_questions_object",
    "image_token_allowance": 1024,
    "marker_token_allowance": 512,
    "max_combined_context_tokens": 24576,
    "max_complete_wire_bytes": 400000,
    "truncation": false
  },
  "transport": {
    "method": "POST",
    "url": "https://api.cloudflare.com/client/v4/accounts/{approved_account_id}/ai/run/@cf/cloudflare/clef-omni",
    "body_fields": ["model", "state", "questions", "images"],
    "images_encoding": "one_data_image_png_base64_string",
    "credential_location": "authorization_bearer_header_only",
    "configuration_digest_binding": true,
    "account_and_model_allowlist": true,
    "redirects": false,
    "retries": false,
    "fallback": false,
    "timeout_ms_default_and_maximum": 2000,
    "timeout_covers_response_body": true,
    "caller_abort_propagates_to_transport": true,
    "max_response_bytes_default_and_maximum": 131072,
    "stream_byte_bound": true,
    "guard_before_dispatch_and_after_awaits": true,
    "guard_exception_propagates": true
  },
  "result": {
    "contract": "decision-model.v1",
    "private_brand": {
      "actual_reader_instance": true,
      "exact_invocation_object_identity": true,
      "new_invocation_object_per_execution": true,
      "verify_raw_vault_result_before_json_clone": true,
      "deeply_frozen": true,
      "copied_result_is_branded": false,
      "weak_keys_for_invocation_and_result": true,
      "non_object_invocation_verifiable": false
    },
    "fixture_evidence_kind": "synthetic_wire_fixture",
    "unconfigured_live_evidence_kind": "live_test_unqualified",
    "unconfigured_live_failure": "DECISION_CAPABILITY_UNAVAILABLE",
    "caller_abort_failure": "DECISION_AUTHORITY_CHANGED",
    "max_reported_input_tokens": 24576,
    "max_reported_output_tokens": 131072,
    "usage_bounds_are_sanity_limits_not_observations": true,
    "unknown_serving_model": null,
    "serving_revision": null,
    "quality_qualification": false,
    "authority": "advisory_only"
  },
  "retention": {
    "persistent_cache": false,
    "request_or_response_logging": false,
    "owned_buffer_cleanup": true,
    "forensic_string_erasure_claim": false,
    "provider_erasure_claim": false
  },
  "upstream_reference": "https://developers.cloudflare.com/workers-ai/models/clef-omni/"
}
