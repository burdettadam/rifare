import{DatabaseSync}from'node:sqlite';import{fileURLToPath}from'node:url';
import{CommerceKernel}from'../commerce/kernel.mts';import{Capabilities}from'../commerce/capabilities.mts';import{StoreSimulator}from'../commerce/simulator.mts';import{ReadContext}from'../commerce/read-context.mts';import{Policies}from'../commerce/policies.mts';import{CustomerAccess}from'../commerce/customer-access.mts';import{ActionGateway}from'../commerce/action-gateway.mts';import{loadSkillDirectory}from'../commerce/skills.mts';import{SkillInstaller,readInstructionDirectory}from'../commerce/skill-installer.mts';import{ReturnIntake}from'../commerce/return-intake.mts';import{SupportService}from'../commerce/support-service.mts';import{SupportFixtureSource}from'../adapters/support-fixture-source.mts';import{ExecutionStops}from'../commerce/execution-stops.mts';
/** Two in-memory systems, explicitly synthetic actors, no configured external transport. */
export function createSupportDemo(){let at=Date.now();const db=new DatabaseSync(':memory:'),sourceDb=new DatabaseSync(':memory:');try{const store='support_demo',kernel=new CommerceKernel(db,()=>at),caps=new Capabilities(kernel),simulator=new StoreSimulator(kernel,caps),reads=new ReadContext(kernel,caps),proofs:any[]=[],customers=new CustomerAccess(kernel,p=>proofs.push(p));kernel.provisionStore('demo',store);
 const actor=(name:string,role:any)=>{kernel.provisionMember('demo',store,name,role);const token=kernel.issueSession('demo',store,name);return{token,scope:kernel.authenticate(token),actor:name};};const owner=actor('owner','owner'),operator=actor('operator','operator'),reviewer=actor('reviewer','reviewer'),agent=actor('agent','agent');simulator.reset(operator.scope);
 // Refresh all source observations to the demonstration clock without changing their identities.
 const original=kernel.lookup(operator.scope,'order','synthetic','ORD-1001');const order=kernel.ingest(operator.scope,{kind:'order',source_system:'synthetic',external_id:original.external_id,source_version:2,source_updated_at:at,customer_id:original.customer_id,payload:{...original.payload,delivered_at:at-3*86400000,tags:[],evidence_verified:true,return_lines:[{id:'line_one',fulfillment_line_id:'gid://shopify/FulfillmentLineItem/101',ordered:5,fulfilled:5,returned:0,unit_minor:'2500',tags:[]}]}});
 for(const [external,status]of[['SHIP-1001','delivered'],['SHIP-1002','in_transit']])kernel.ingest(operator.scope,{kind:'shipment',source_system:'synthetic',external_id:external,source_version:external==='SHIP-1001'?2:1,source_updated_at:at,customer_id:order.customer_id,payload:{order_number:'ORD-1001',status,carrier:'synthetic',tracking:'TEST-'+external}});
 const base=loadSkillDirectory(fileURLToPath(new URL('../commerce/skill-bundles/order-status/',import.meta.url)));reads.skills.install(operator.scope,base);reads.profiles.put(operator.scope,{id:'default',revision:1,tenant_id:'demo',store_id:store,skill_id:base.id,skill_digest:base.digest,tone:'warm',locale:'en-US',actions:['order.status','knowledge.search','knowledge.get','skill.read'],data_scope:{order:'session_or_store',knowledge:'visible_only'}});
 const policies=new Policies(kernel),policy=policies.create(operator.scope,{policy_id:'returns',expected_version:0,rules:{window_days:30,require_evidence:false,excluded_tags:['final-sale'],outcomes:['refund','exchange','store_credit']},selection:'pin_at_request',sources:[{uri:'https://merchant.example.invalid/policy',revision:'1',sha256:'a'.repeat(64)}]});policies.test(operator.scope,'returns',1,policy.digest);policies.review(reviewer.scope,'returns',1,policy.digest);policies.publish(owner.scope,{policy_id:'returns',version:1,digest:policy.digest,expected_published_version:0,effective_at:at});
 const challenge=customers.request({store_id:store,order_number:'ORD-1001',email:'shopper-apparel@example.invalid'},'127.0.0.1'),verified=customers.complete({store_id:store,challenge_id:challenge.challenge_id,proof:proofs.at(-1).proof});proofs.length=0;const customer={scope:kernel.authenticate(verified.token),token:verified.token};const gateway=new ActionGateway(kernel);gateway.configure(owner.scope,{enabled:true,expected_revision:0,profile_id:'default',policy_id:'returns'});gateway.cases.create(customer.scope,{case_id:'support_case',resource_id:order.id,profile_id:'default',policy_id:'returns'});
 const source=new SupportFixtureSource(sourceDb,'demo',store,'merchant_mail',()=>at),support=new SupportService(kernel,reads,{sources:[source]}),mail=support.conversations.link(operator.scope,customer.scope,{case_id:'support_case',channel:'email',account_id:'merchant_mail',external_id:'email_thread',history:'partial',source_revision:1}),chat=support.conversations.link(operator.scope,customer.scope,{case_id:'support_case',channel:'webchat',account_id:'merchant_chat',external_id:'chat_thread',history:'complete',source_revision:1});
 support.consent.configureSender(owner.scope,{id:'sender_one',expected_revision:0,channel:'email',address:'support@example.invalid',account_id:source.account,source_identity:source.identity,source_contract:source.contract,expires_at:at+3600000,jurisdiction:'US_TEST',transactional_basis:'order_service'});support.consent.verifyContact(operator.scope,customer.scope,{link_id:mail.id,address:'shopper-apparel@example.invalid'});support.branding.configure(owner.scope,{expected_revision:0,name:'Rifare Sample Store',theme:'warm',locale:'en-US'});support.conversations.customerMessage(customer.scope,{link_id:chat.id,request_id:'hello',text:'One parcel arrived. Where is the other one?'});support.conversations.ingest(operator.scope,{link_id:mail.id,external_id:'private_note',direction:'internal',visibility:'staff',text:'Internal: investigate the second parcel without promising a date.',source_at:at});
 const installer=new SkillInstaller(kernel),skills:Record<string,string>={};for(const name of['support-reply','shipment-assistance']){const bundle=readInstructionDirectory(fileURLToPath(new URL('../commerce/skill-bundles/'+name+'/',import.meta.url))),origin='https://rifare.invalid/bundles/'+name,a=installer.approve(owner.scope,{origin,bundle_digest:bundle.digest,skill_id:bundle.id,version:bundle.version,expires_at:at+3600000});installer.install(operator.scope,a.id,{origin,bundle});skills[name]=bundle.digest;}
 const intake=new ReturnIntake(kernel);intake.configure(owner.scope,{expected_revision:0,settings:{currency:'USD',restocking_bps:0,shipping_minor:'0',time_zone:'America/Denver',brand:'Rifare Sample Store',contact:'support@example.invalid',override_days:7,retention_days:30}});
 const approvedReturn=()=>{const q=intake.evaluate(customer.scope,{case_id:'support_case',lines:[{line_id:'line_one',quantity:1}],outcome:'refund',reason:'size',note:'',evidence_ids:[]}),r=intake.prepare(customer.scope,{quote_id:q.id,quote_digest:q.digest,request_key:'support-return',override_id:null}),approval=gateway.approve(reviewer.scope,{preview_id:r.preview_id,preview_digest:r.preview_digest}),receipt=gateway.execute(operator.scope,{preview_id:r.preview_id,preview_digest:r.preview_digest,approval_id:approval.id});return{request:r,receipt};};
 const message=()=>({case_id:'support_case',link_id:mail.id,sender_id:'sender_one',template_id:'tracking_status_v1',event_id:'support_update',expected_generation:support.ownership.inspect(operator.scope,'support_case')!.generation});
 return{db,sourceDb,kernel,caps,simulator,reads,customers,owner,operator,reviewer,agent,customer,gateway,support,source,skills,order,mail,chat,intake,approvedReturn,message,at:()=>at,advance:(ms:number)=>at+=ms,stopModel:()=>new ExecutionStops(kernel).set(owner.scope,{action:'model.run',stopped:true,reason:'incident',expected_revision:0}),cleanup:()=>{db.close();sourceDb.close();}};
 }catch(e){db.close();sourceDb.close();throw e;}}
