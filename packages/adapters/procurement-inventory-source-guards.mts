export function stockMoney(value:unknown){if(typeof value!=='string'||!/^(0|[1-9]\d{0,23})$/.test(value))throw new Error('STOCK_COST_INVALID');return BigInt(value);}
export function minorCost(quantity:number,unitCost:string,unitsPerPurchase:number){const numerator=BigInt(quantity)*stockMoney(unitCost),denominator=BigInt(stockQuantity(unitsPerPurchase,1));if(numerator%denominator!==0n)throw new Error('STOCK_COST_ALLOCATION_REQUIRED');return (numerator/denominator).toString();}
function hash(value:unknown){if(typeof value!=='string'||!/^[a-f0-9]{64}$/.test(value))throw new Error('SOURCE_INTEGRITY');return value;}
function scoped(source:Source,b:Row){if(b.source_identity!==source.identity||b.tenant_id!==source.tenant||b.store_id!==source.store)throw new Error('SOURCE_IDENTITY_CHANGED');}
export function procurementNativeBody(row:Row|undefined):Row|null{if(!row)return null;let b:Row;try{b=JSON.parse(row.body);}catch{throw new Error('SOURCE_INTEGRITY');}if(b.redacted||contentDigest(b)!==row.digest)throw new Error('SOURCE_INTEGRITY');return b;}
export function procurementEnvelope(b:Row){return {...b,digest:contentDigest(b)};}
export function ensureProcurementSourceTables(source:Source){source.db.exec(`
 CREATE TABLE IF NOT EXISTS warehouse_procurement_observations(id TEXT PRIMARY KEY,kind TEXT NOT NULL,body TEXT NOT NULL,digest TEXT NOT NULL) STRICT;
 CREATE TABLE IF NOT EXISTS warehouse_procurement_bindings(operation_id TEXT PRIMARY KEY,business_key TEXT NOT NULL UNIQUE,body TEXT NOT NULL,digest TEXT NOT NULL) STRICT;
 CREATE TABLE IF NOT EXISTS warehouse_inventory_production(production_id TEXT PRIMARY KEY,body TEXT NOT NULL,digest TEXT NOT NULL) STRICT;`);}
function observation(source:Source,ref:string){const row=source.db.prepare('SELECT * FROM warehouse_procurement_observations WHERE id=?').get(id(ref)) as Row|undefined,b=procurementNativeBody(row);if(!b)return null;scoped(source,b);if(b.observation_id!==row!.id||b.kind!==row!.kind)throw new Error('SOURCE_INTEGRITY');return procurementEnvelope(b);}

/** Native fixture observations. These methods administer synthetic source facts only. */
export class ProcurementInventoryFacts {
