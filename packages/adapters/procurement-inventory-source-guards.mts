 if(original.length){if(original.length!==1||original[0].operation_id!==c.operation_id||original[0].business_key!==c.business_key||!same(procurementNativeBody(original[0]),c))throw new Error('PROCUREMENT_ORIGINAL_OPERATION_REQUIRED');return;}source.db.prepare('INSERT INTO warehouse_procurement_bindings VALUES(?,?,?,?)').run(c.operation_id,c.business_key,canonical(c),contentDigest(c));}
export function assertProcurementGuard(source:Source,c:Row){const row=source.db.prepare('SELECT * FROM warehouse_procurement_bindings WHERE operation_id=?').get(c.operation_id) as Row|undefined;if(!row||row.business_key!==c.business_key||!same(procurementNativeBody(row),c))throw new Error('PROCUREMENT_GUARD_REQUIRED');currentGuard(source,c);}

export function procurementSourceResult(source:Source,ref:string,verifyMovements=true):Row|null{const row=source.db.prepare('SELECT * FROM warehouse_inventory_commands WHERE operation_id=?').get(id(ref)) as Row|undefined,b=procurementNativeBody(row);if(!b)return null;scoped(source,b);if(b.command?.domain!=='procurement_inventory'||b.operation_id!==ref||b.command.operation_id!==ref||row!.command_digest!==b.command_digest||contentDigest(b.command)!==b.command_digest||b.state!=='applied'||b.qualification!=='synthetic_only')throw new Error('PROCUREMENT_SOURCE_INTEGRITY');
