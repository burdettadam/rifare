type Source=WarehouseInventoryFixtureSource;
const guards=new WeakMap<object,Map<string,()=>void>>();
const fields=['available','on_hand','reserved','in_transit'];
const same=(a:unknown,b:unknown)=>canonical(a)===canonical(b);
const zero=()=>({available:0,on_hand:0,reserved:0,in_transit:0});
export function stockQuantity(value:unknown,min=0){const n=integer(value,min);if(n>1000000000)throw new Error('STOCK_QUANTITY_LIMIT');return n;}
