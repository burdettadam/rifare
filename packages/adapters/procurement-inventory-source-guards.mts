export function nativeSupplierReceipt(source:Source,receiptId:string){const results=nativeResults(source),received=results.find(result=>result.receipt?.receipt_id===receiptId);if(!received)throw new Error('RECEIPT_NOT_FOUND');return supplierReceiptProjection(received.receipt,results.filter(result=>result.event?.receipt_id===receiptId).map(result=>result.event));}
function receivedByLine(source:Source,c:Row){const results=nativeResults(source),map=new Map<string,number>();for(const result of results.filter(value=>value.receipt?.po_id===c.po_ref.po_id&&value.receipt?.po_version===c.po_ref.version)){const state=supplierReceiptProjection(result.receipt,results.filter(value=>value.event?.receipt_id===result.receipt.receipt_id).map(value=>value.event));for(const line of state.lines)map.set(line.line_id,stockQuantity((map.get(line.line_id)??0)+line.received));}return map;}
export function productionInitial(job:Row){return {version:1,production_id:job.id,source_identity:job.source_identity,tenant_id:job.tenant_id,store_id:job.store_id,resource_id:job.resource_id,location_id:job.location_id,job_digest:job.digest,bom_digest:job.plan.bom_digest,plan:job.plan,revision:1,stage:'planned',components:job.plan.materials.map((m:Row)=>({...m,reserved:0,consumed:0})),good:0,scrap:0,wip_cost_minor:'0',output_cost_minor:'0',scrap_cost_minor:'0',outputs:[],qualification:'synthetic_only'};}
