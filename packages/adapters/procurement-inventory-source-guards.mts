export function armProcurementOperation(source:Source,command:Row,guard:()=>void){const c=procurementCommand(source,command);if(typeof guard!=='function')throw new Error('PROCUREMENT_GUARD_REQUIRED');let map=guards.get(source);if(!map){map=new Map();guards.set(source,map);}map.set(contentDigest(c),guard);}
