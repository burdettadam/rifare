export function procurementCommand(source:Source,input:unknown){const c=exact(jsonValue(input),['version','domain','operation_id','source_identity','tenant_id','store_id','resource_id','business_key','kind','receipt_id','event_id','production_id','po_ref','po_pin','po_lines','lines','observation','job','expected_production','expected_positions']);
