function nativeResults(source:Source){return (source.db.prepare('SELECT * FROM warehouse_inventory_commands ORDER BY rowid').all() as Row[]).filter(row=>procurementNativeBody(row)?.command?.domain==='procurement_inventory').map(row=>procurementSourceResult(source,row.operation_id)!);}
export function supplierReceiptProjection(receipt:Row,events:Row[]){const lines=receipt.lines.map((line:Row)=>({...line,received:line.quantity,returned:0,credited_minor:'0',credit_due_minor:'0',cost_variance_minor:'0'})),returns=new Map<string,Row>();
