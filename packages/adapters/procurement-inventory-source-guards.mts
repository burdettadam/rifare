 #put(kind:string,ref:string,p:Row){id(ref);integer(p.observed_at);id(p.evidence_ref);if(p.observed_at>this.source.clock())throw new Error('SOURCE_OBSERVATION_IN_FUTURE');const b={version:1,...p,kind,observation_id:ref,source_identity:this.source.identity,tenant_id:this.source.tenant,store_id:this.source.store,qualification:'synthetic_only'},old=observation(this.source,ref);
