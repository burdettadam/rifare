export const SHOPPING_SOURCE_CONTRACT=Object.freeze({id:'rifare-shopping-catalog-fixture',version:'1.0.0',qualification:'synthetic_only',live_transport:false,checkout_supported:false});
function checked(row:Row|undefined){if(!row)throw new Error('SHOPPING_SOURCE_MISSING');const b=JSON.parse(row.body);if(contentDigest(b)!==row.digest)throw new Error('SHOPPING_SOURCE_INTEGRITY');return b;}
/** Uses the original order source's catalog and stock; no second inventory owner. */
export class ShoppingCatalogFixtureSource {
 readonly source:OrderEditFixtureSource;readonly db;readonly identity:string;readonly tenant:string;readonly store:string;readonly clock:()=>number;
 fault:'none'|'before'|'after'='none';
 constructor(source:OrderEditFixtureSource){if(!(source instanceof OrderEditFixtureSource))throw new Error('SHOPPING_SOURCE_REQUIRED');this.source=source;this.db=source.db;this.identity=source.identity;this.tenant=source.tenant;this.store=source.store;this.clock=source.clock;
  this.db.exec(`CREATE TABLE IF NOT EXISTS growth_source_listings(variant_id TEXT PRIMARY KEY,revision INTEGER NOT NULL,body TEXT NOT NULL,digest TEXT NOT NULL) STRICT;
   CREATE TABLE IF NOT EXISTS growth_source_carts(cart_id TEXT PRIMARY KEY,resource_id TEXT NOT NULL,revision INTEGER NOT NULL,body TEXT NOT NULL,digest TEXT NOT NULL) STRICT;
   CREATE TABLE IF NOT EXISTS growth_source_cart_effects(operation_id TEXT PRIMARY KEY,command_digest TEXT NOT NULL,body TEXT NOT NULL,digest TEXT NOT NULL) STRICT;
   CREATE TABLE IF NOT EXISTS growth_source_catalog_effects(operation_id TEXT PRIMARY KEY,command_digest TEXT NOT NULL,body TEXT NOT NULL,digest TEXT NOT NULL) STRICT;
   CREATE TABLE IF NOT EXISTS growth_source_visibility(observation_id TEXT PRIMARY KEY,body TEXT NOT NULL,digest TEXT NOT NULL) STRICT;`);
 }
 #tx<T>(fn:()=>T){this.db.exec('BEGIN IMMEDIATE');try{const value=fn();this.db.exec('COMMIT');return value;}catch(e){this.db.exec('ROLLBACK');throw e;}}
 #scope(c:Row){if(c.source_identity!==this.identity||c.tenant_id!==this.tenant||c.store_id!==this.store)throw new Error('SHOPPING_SOURCE_SCOPE_MISMATCH');}
 fixtureListing(input:unknown){const p=exact(jsonValue(input),['variant_id','expected_revision','title','description','approved_descriptions','terms']);id(p.variant_id);integer(p.expected_revision);growthText(p.title,150);growthText(p.description,1000);
  if(!Array.isArray(p.approved_descriptions)||!p.approved_descriptions.length||p.approved_descriptions.length>20||!p.approved_descriptions.includes(p.description))throw new Error('CATALOG_UNSUPPORTED_FACT');for(const text of p.approved_descriptions)growthText(text,1000);
  exact(p.terms,['id','revision','text']);id(p.terms.id);integer(p.terms.revision,1);growthText(p.terms.text,1000);
  return this.#tx(()=>{this.source.catalog(p.variant_id);const row=this.db.prepare('SELECT * FROM growth_source_listings WHERE variant_id=?').get(p.variant_id) as Row|undefined;if(row)checked(row);if((row?.revision??0)!==p.expected_revision)throw new Error('CATALOG_SOURCE_CHANGED');const b={title:p.title,description:p.description,approved_descriptions:p.approved_descriptions,terms:p.terms};
   this.db.prepare('INSERT INTO growth_source_listings VALUES(?,?,?,?) ON CONFLICT(variant_id) DO UPDATE SET revision=excluded.revision,body=excluded.body,digest=excluded.digest').run(p.variant_id,p.expected_revision+1,canonical(b),contentDigest(b));return this.item(p.variant_id);});
 }
 item(variant:string){const value=this.source.catalog(id(variant)),row=this.db.prepare('SELECT * FROM growth_source_listings WHERE variant_id=?').get(variant) as Row,listing=checked(row);
  if(value.id!==variant||typeof value.available!=='boolean'||typeof value.excluded!=='boolean'||typeof value.subscription!=='boolean'||value.currency!=='USD')throw new Error('SHOPPING_SOURCE_INVALID');id(value.product_id);editMinor(value.unit_minor);integer(value.stock);integer(value.tax_bps);if(value.tax_bps>10000)throw new Error('SHOPPING_SOURCE_INVALID');
  return {...value,...listing,source_identity:this.identity,listing_revision:row.revision,revision:contentDigest({value,listing,listing_revision:row.revision})};
 }
 catalog(){return (this.db.prepare('SELECT variant_id FROM growth_source_listings ORDER BY variant_id').all() as Row[]).map(row=>this.item(row.variant_id));}
 cartPreview(resource:string,items:unknown){const order=this.source.order(id(resource));if(!Array.isArray(items)||!items.length||items.length>30)throw new Error('INVALID_INPUT');const seen=new Set<string>();
  const lines=items.map(input=>{const i=exact(jsonValue(input),['variant_id','quantity']);id(i.variant_id);integer(i.quantity,1);if(i.quantity>20||seen.has(i.variant_id))throw new Error('INVALID_INPUT');seen.add(i.variant_id);const v=this.item(i.variant_id);
   if(!v.available||v.excluded||v.subscription||v.currency!==order.currency)throw new Error('SHOPPING_ITEM_UNSUPPORTED');integer(v.stock);if(v.stock<i.quantity)throw new Error('SHOPPING_STOCK_UNAVAILABLE');integer(v.tax_bps);const gross=editMinor(v.unit_minor)*BigInt(i.quantity),tax=gross*BigInt(v.tax_bps);if(tax%10000n)throw new Error('SHOPPING_TAX_UNQUALIFIED');
   return {variant_id:v.id,product_id:v.product_id,quantity:i.quantity,unit_minor:v.unit_minor,tax_minor:(tax/10000n).toString(),total_minor:(gross+tax/10000n).toString(),currency:v.currency,source_revision:v.revision,terms:v.terms};
  }).sort((a,b)=>a.variant_id.localeCompare(b.variant_id));
  return {resource_id:resource,subject_id:order.customer_id,source_identity:this.identity,currency:order.currency,items:lines,total_minor:lines.reduce((n,l)=>n+BigInt(l.total_minor),0n).toString(),catalog_digest:contentDigest(lines),checkout_supported:false,payment_authorized:false,qualification:'synthetic_only'};
 }
 cart(cartId:string){const row=this.db.prepare('SELECT * FROM growth_source_carts WHERE cart_id=?').get(id(cartId)) as Row|undefined;return row?{...checked(row),revision:row.revision}:null;}
 async commitCart(command:Row,authorize:()=>void){const c=jsonValue(command);this.#scope(c);id(c.operation_id);id(c.cart_id);const hash=contentDigest(c),fault=this.fault;this.fault='none';if(fault==='before')throw new Error('SHOPPING_SOURCE_UNAVAILABLE');
  const result=this.#tx(()=>{const old=this.db.prepare('SELECT * FROM growth_source_cart_effects WHERE operation_id=?').get(c.operation_id) as Row|undefined;if(old){if(old.command_digest!==hash)throw new Error('SHOPPING_OPERATION_CONFLICT');return checked(old);}authorize();
   const current=this.cartPreview(c.resource_id,c.items);if(current.subject_id!==c.customer_id||contentDigest(current)!==c.preview_digest)throw new Error('SHOPPING_PREVIEW_CHANGED');if(this.cart(c.cart_id))throw new Error('SHOPPING_CART_EXISTS');
   const body={cart_id:c.cart_id,resource_id:c.resource_id,subject_id:c.customer_id,status:'active',updated_at:this.clock(),native_order_id:null,native_id:'cart_native_'+randomUUID().replaceAll('-',''),operation_id:c.operation_id,preview_digest:c.preview_digest,preview:current,source_identity:this.identity,qualification:'synthetic_only'};
   this.db.prepare('INSERT INTO growth_source_carts VALUES(?,?,1,?,?)').run(c.cart_id,c.resource_id,canonical(body),contentDigest(body));const receipt={operation_id:c.operation_id,cart_id:c.cart_id,resource_id:c.resource_id,customer_id:c.customer_id,native_id:body.native_id,preview_digest:c.preview_digest,command_digest:hash,source_identity:this.identity,qualification:'synthetic_only'};
   this.db.prepare('INSERT INTO growth_source_cart_effects VALUES(?,?,?,?)').run(c.operation_id,hash,canonical(receipt),contentDigest(receipt));return receipt;});if(fault==='after')throw new Error('SHOPPING_SOURCE_RESPONSE_LOST');return result;
 }
 lookupCart(operation:string){const row=this.db.prepare('SELECT * FROM growth_source_cart_effects WHERE operation_id=?').get(id(operation)) as Row|undefined;return row?checked(row):null;}
 /** Explicit synthetic external purchase observation; never an application checkout action. */
 fixturePurchase(cartId:string,nativeOrderId:string){id(nativeOrderId);return this.#tx(()=>{const row=this.db.prepare('SELECT * FROM growth_source_carts WHERE cart_id=?').get(id(cartId)) as Row,b=checked(row);if(b.status==='purchased'){if(b.native_order_id!==nativeOrderId)throw new Error('SHOPPING_PURCHASE_CONFLICT');return this.cart(cartId);}const body={...b,status:'purchased',native_order_id:nativeOrderId,updated_at:this.clock()};this.db.prepare('UPDATE growth_source_carts SET revision=revision+1,body=?,digest=? WHERE cart_id=?').run(canonical(body),contentDigest(body),cartId);return this.cart(cartId);});}
 fixtureVisibility(input:unknown){const p=exact(jsonValue(input),['observation_id','interface','prompt_set','model','answers']);id(p.observation_id);if(!['permitted_fixture','prohibited_scraping','unavailable'].includes(p.interface))throw new Error('INVALID_INPUT');exact(p.prompt_set,['id','questions']);id(p.prompt_set.id);if(!Array.isArray(p.prompt_set.questions)||!p.prompt_set.questions.length||p.prompt_set.questions.length>30)throw new Error('INVALID_INPUT');
  const questions=new Set<string>();for(const q of p.prompt_set.questions){exact(q,['id','text']);id(q.id);growthText(q.text);if(questions.has(q.id))throw new Error('INVALID_INPUT');questions.add(q.id);}exact(p.model,['provider','model','settings']);id(p.model.provider);id(p.model.model);if(canonical(p.model.settings).length>2000)throw new Error('INVALID_INPUT');
  if(!Array.isArray(p.answers)||p.answers.length>30)throw new Error('INVALID_INPUT');const seen=new Set<string>();for(const a of p.answers){exact(a,['question_id','observed','mentions','citations']);if(!questions.has(a.question_id)||seen.has(a.question_id)||typeof a.observed!=='boolean'||!Array.isArray(a.mentions)||!Array.isArray(a.citations)||a.mentions.length>30||a.citations.length>30)throw new Error('INVALID_INPUT');seen.add(a.question_id);for(const m of a.mentions){exact(m,['variant_id','unit_minor','available']);id(m.variant_id);editMinor(m.unit_minor);if(typeof m.available!=='boolean')throw new Error('INVALID_INPUT');}for(const c of a.citations){exact(c,['variant_id','source_revision','uri']);id(c.variant_id);growthText(c.source_revision,64);growthText(c.uri,500);if(!c.uri.startsWith('https://'))throw new Error('INVALID_INPUT');}}
  const catalog=this.catalog(),body={...p,source_identity:this.identity,catalog,catalog_digest:contentDigest(catalog),observed_at:this.clock(),qualification:'synthetic_only'};
  return this.#tx(()=>{const old=this.db.prepare('SELECT * FROM growth_source_visibility WHERE observation_id=?').get(p.observation_id) as Row|undefined;if(old){if(old.digest!==contentDigest(body))throw new Error('VISIBILITY_OBSERVATION_CONFLICT');return checked(old);}this.db.prepare('INSERT INTO growth_source_visibility VALUES(?,?,?)').run(p.observation_id,canonical(body),contentDigest(body));return body;});
 }
 visibility(observationId:string){return checked(this.db.prepare('SELECT * FROM growth_source_visibility WHERE observation_id=?').get(id(observationId)) as Row);}
 async applyCatalog(command:Row,authorize:()=>void){const c=jsonValue(command);this.#scope(c);id(c.operation_id);id(c.change_id);const hash=contentDigest(c),fault=this.fault;this.fault='none';if(fault==='before')throw new Error('CATALOG_SOURCE_UNAVAILABLE');
  const receipt=this.#tx(()=>{const old=this.db.prepare('SELECT * FROM growth_source_catalog_effects WHERE operation_id=?').get(c.operation_id) as Row|undefined;if(old){if(old.command_digest!==hash)throw new Error('CATALOG_OPERATION_CONFLICT');return checked(old);}authorize();const before=this.item(c.variant_id);if(before.revision!==c.expected_revision)throw new Error('CATALOG_SOURCE_CHANGED');if(!before.approved_descriptions.includes(c.description))throw new Error('CATALOG_UNSUPPORTED_FACT');
   const row=this.db.prepare('SELECT * FROM growth_source_listings WHERE variant_id=?').get(c.variant_id) as Row,listing=checked(row),body={...listing,description:c.description};this.db.prepare('UPDATE growth_source_listings SET revision=revision+1,body=?,digest=? WHERE variant_id=?').run(canonical(body),contentDigest(body),c.variant_id);const after=this.item(c.variant_id),result={native_id:'catalog_native_'+randomUUID().replaceAll('-',''),operation_id:c.operation_id,change_id:c.change_id,resource_id:c.resource_id,customer_id:c.customer_id,source_identity:this.identity,command_digest:hash,variant_id:c.variant_id,before_revision:before.revision,after_revision:after.revision,before_description:before.description,after_description:after.description,qualification:'synthetic_only'};
   this.db.prepare('INSERT INTO growth_source_catalog_effects VALUES(?,?,?,?)').run(c.operation_id,hash,canonical(result),contentDigest(result));return result;});if(fault==='after')throw new Error('CATALOG_SOURCE_RESPONSE_LOST');return receipt;
 }
 lookupCatalog(operation:string){const row=this.db.prepare('SELECT * FROM growth_source_catalog_effects WHERE operation_id=?').get(id(operation)) as Row|undefined;return row?checked(row):null;}
}
