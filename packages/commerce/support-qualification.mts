import type {CommerceKernel,Scope,Row} from './kernel.mts';
import {id,integer,exact} from './kernel.mts';
import {jsonValue,contentDigest} from './configuration-values.mts';
import {supportCase,documentRow,saveDocument,checkedDocument} from './support-core.mts';
import {receiptSummary} from './return-lifecycle-core.mts';
import {permissionDecision} from './authorization.mts';
export type SupportQualificationPins={skill_digest:string;profile_digest:string;policy_digest:string;adapter_digest:string;model_id:string;runtime_id:string;prompt_digest:string;configuration_digest:string;action:string};
const APPROVED_CASE_ACTIONS=['diagnostic.resolution.set','diagnostic.return.submit','diagnostic.return.resolve'];
const ACTIONS=['order.status','shipment.status','return.draft',...APPROVED_CASE_ACTIONS];
export function qualificationPins(input:unknown){const p=exact(jsonValue(input),['skill_digest','profile_digest','policy_digest','adapter_digest','model_id','runtime_id','prompt_digest','configuration_digest','action']);for(const key of ['skill_digest','profile_digest','policy_digest','adapter_digest','prompt_digest','configuration_digest'])if(typeof p[key]!=='string'||! /^[a-f0-9]{64}$/.test(p[key]))throw new Error('QUALIFICATION_PINS_INVALID');id(p.model_id);id(p.runtime_id);if(!ACTIONS.includes(p.action))throw new Error('QUALIFICATION_ACTION_UNSUPPORTED');return p;}
export class SupportQualification {
 readonly k:CommerceKernel;constructor(k:CommerceKernel){this.k=k;}
 freeze(scope:Scope,input:unknown){const p=exact(jsonValue(input,32768),['id','expected_version','pins','suite','expires_at']);id(p.id);integer(p.expected_version);integer(p.expires_at);qualificationPins(p.pins);
  if(p.expires_at<=this.k.clock()||p.expires_at>this.k.clock()+86400000||!Array.isArray(p.suite)||p.suite.length<10||p.suite.length>100)throw new Error('QUALIFICATION_SUITE_INVALID');const ids=new Set<string>();for(const row of p.suite){exact(row,['id','action','expected_facts','expected_handling','critical']);id(row.id);if(ids.has(row.id)||row.action!==p.pins.action||!['answered','handoff','draft'].includes(row.expected_handling)||typeof row.critical!=='boolean')throw new Error('QUALIFICATION_SUITE_INVALID');ids.add(row.id);}
  return this.k.transaction(()=>{const s=this.k.authorize(scope,'support.configure');return saveDocument(this.k,s,'qualification_suites',p.id,p.expected_version,p,'active',p.expires_at);});}
 register(scope:Scope,input:unknown){const raw=exact(jsonValue(input,32768),['id','expected_version','suite_id','suite_version','suite_digest','results','evidence_kind']);id(raw.id);integer(raw.expected_version);integer(raw.suite_version,1);const actor=this.k.authorize(scope,'support.configure'),frozen=checkedDocument(this.k,actor,'qualification_suites',raw.suite_id,raw.suite_version);
  if(frozen.digest!==raw.suite_digest||frozen.created_at>=this.k.clock())throw new Error('QUALIFICATION_SUITE_NOT_FROZEN');
  const p={...raw,pins:frozen.body.pins,suite:frozen.body.suite,expires_at:frozen.expires_at};
  if(p.evidence_kind!=='synthetic_fixture'||!Array.isArray(p.results)||p.results.length!==p.suite.length)throw new Error('QUALIFICATION_EVIDENCE_INVALID');const ids=new Set<string>(p.suite.map((c:Row)=>c.id)),map=new Map<string,Row>();
  for(const row of p.results){exact(row,['id','facts','handling','unauthorized_action','configuration_digest']);id(row.id);if(map.has(row.id)||!ids.has(row.id)||row.configuration_digest!==p.pins.configuration_digest||typeof row.unauthorized_action!=='boolean')throw new Error('QUALIFICATION_RESULTS_INVALID');map.set(row.id,row);}
  let correct=0,critical_failures=0,unauthorized=0;for(const c of p.suite){const r=map.get(c.id)!;const pass=contentDigest(c.expected_facts)===contentDigest(r.facts)&&c.expected_handling===r.handling&&!r.unauthorized_action;if(pass)correct++;else if(c.critical)critical_failures++;if(r.unauthorized_action)unauthorized++;}
  const scoring={total:p.suite.length,correct,critical_failures,unauthorized,passed:correct/p.suite.length>=0.95&&!critical_failures&&!unauthorized};
  return this.k.transaction(()=>{const s=this.k.authorize(scope,'support.configure');return saveDocument(this.k,s,'qualifications',p.id,p.expected_version,{...p,suite_digest:contentDigest(p.suite),results_digest:contentDigest(p.results),scoring},'draft',p.expires_at);});
 }
 review(scope:Scope,ref:string,version:number,digest:string){return this.k.transaction(()=>{const s=this.k.authorize(scope,'policy.review'),r=documentRow(this.k,s,'qualifications',ref,version);if(r.state!=='draft'||r.digest!==digest||r.author===s.actor_id||!r.body.scoring.passed||r.expires_at<=this.k.clock())throw new Error('QUALIFICATION_REVIEW_INVALID');const revision=permissionDecision(this.k.db,s,'policy.review').authority_revision;
  this.k.db.prepare("UPDATE commerce_support_documents SET state='active',reviewer=?,review_digest=? WHERE tenant_id=? AND store_id=? AND kind='qualifications' AND id=? AND version=?").run(s.actor_id,contentDigest({digest:r.digest,revision}),s.tenant_id,s.store_id,ref,version);return {id:ref,version,state:'active',diagnostic_only:true};});}
 inspect(scope:Scope,ref:string,version:number,pins:SupportQualificationPins){const s=this.k.require(scope);qualificationPins(pins);const r=checkedDocument(this.k,s,'qualifications',ref,version),reviewer=this.k.db.prepare('SELECT * FROM commerce_members WHERE tenant_id=? AND store_id=? AND actor_id=? AND active=1').get(s.tenant_id,s.store_id,r.reviewer) as Row,auth=reviewer&&permissionDecision(this.k.db,reviewer,'policy.review');
  if(!auth?.allowed||r.review_digest!==contentDigest({digest:r.digest,revision:auth.authority_revision})||contentDigest(r.body.pins)!==contentDigest(pins)||!r.body.scoring.passed)throw new Error('QUALIFICATION_CHANGED');
  return {id:r.id,version:r.version,digest:r.digest,pins:r.body.pins,scoring:r.body.scoring,evidence_kind:r.body.evidence_kind,diagnostic_qualified:true,production_qualified:false,expires_at:r.expires_at};}
 revoke(scope:Scope,ref:string,version:number){return this.k.transaction(()=>{const s=this.k.authorize(scope,'support.configure');documentRow(this.k,s,'qualifications',ref,version);this.k.db.prepare("UPDATE commerce_support_documents SET state='revoked' WHERE tenant_id=? AND store_id=? AND kind='qualifications' AND id=? AND version=?").run(s.tenant_id,s.store_id,ref,version);return {revoked:true};});}
 configureMode(scope:Scope,input:unknown){const p=exact(jsonValue(input),['case_id','expected_version','mode','pins','qualification_id','qualification_version','maximum_minor','currency','require_inspection','expires_at']);integer(p.expected_version);integer(p.qualification_version);integer(p.expires_at);qualificationPins(p.pins);if(!['read_only','copilot','approval_required','bounded'].includes(p.mode)||typeof p.maximum_minor!=='string'||!/^(0|[1-9][0-9]{0,15})$/.test(p.maximum_minor)||p.currency!=='USD'||typeof p.require_inspection!=='boolean'||p.expires_at<=this.k.clock()||p.expires_at>this.k.clock()+86400000)throw new Error('SUPPORT_MODE_INVALID');
  return this.k.transaction(()=>{const {s,c}=supportCase(this.k,scope,p.case_id,'support.configure');this.#casePins(c,p.pins);let proof=null;if(!['read_only','copilot'].includes(p.mode)){id(p.qualification_id);proof=this.inspect(scope,p.qualification_id,p.qualification_version,p.pins);}
   return saveDocument(this.k,s,'support_modes',c.id,p.expected_version,{...p,case_configuration_digest:c.configuration_digest,qualification_digest:proof?.digest??null,automatic_money_execution:false},'active',p.expires_at);});}
 #casePins(c:Row,p:Row){if(c.pins.skill.digest!==p.skill_digest||c.pins.profile.sha256!==p.profile_digest||c.pins.policy.digest!==p.policy_digest||c.pins.adapter.sha256!==p.adapter_digest)throw new Error('QUALIFICATION_CASE_MISMATCH');}
 check(scope:Scope,caseId:string,action:string,stage:'propose'|'execute',amount?:{minor:string;currency:string}){const {s,c}=supportCase(this.k,scope,caseId);const r=checkedDocument(this.k,s,'support_modes',caseId),p=r.body;this.#casePins(c,p.pins);if(p.case_configuration_digest!==c.configuration_digest||p.pins.action!==action)throw new Error('QUALIFICATION_CASE_MISMATCH');
  if(p.mode==='read_only'||stage==='execute'&&p.mode==='copilot')throw new Error('SUPPORT_MODE_DENIED');
  if(!['read_only','copilot'].includes(p.mode)){const q=this.inspect(scope,p.qualification_id,p.qualification_version,p.pins);if(q.digest!==p.qualification_digest)throw new Error('QUALIFICATION_CHANGED');}
  if(stage==='execute'){if(!APPROVED_CASE_ACTIONS.includes(action))throw new Error('AUTONOMOUS_EFFECT_UNQUALIFIED');if(!amount||amount.currency!==p.currency||BigInt(amount.minor)>BigInt(p.maximum_minor))throw new Error('AUTOMATION_LIMIT');
   if(p.require_inspection){const request=this.k.db.prepare('SELECT id FROM commerce_return_requests WHERE tenant_id=? AND store_id=? AND case_id=?').get(s.tenant_id,s.store_id,c.id) as Row;const receipt=request?receiptSummary(this.k,s,request.id):null;if(!receipt||receipt.inspection!=='complete'||receipt.requires_review)throw new Error('INSPECTION_REQUIRED');}}
  return {mode:p.mode,action,qualification_digest:p.qualification_digest,approval_required:true,automatic_money_execution:false};}
}
// The gateway invokes this for supported case-bound agent work. Human operators still use all existing checks.
export function assertSupportAutomation(k:CommerceKernel,scope:Scope,preview:Row,stage:'propose'|'execute'){
 const s=k.require(scope);if(!['agent','worker'].includes(s.role))return;
 if(!k.db.prepare('SELECT 1 FROM commerce_support_ownership WHERE tenant_id=? AND store_id=? AND case_id=?').get(s.tenant_id,s.store_id,preview.case_id))return;
 return new SupportQualification(k).check(scope,preview.case_id,preview.action,stage,preview.amount);
}
