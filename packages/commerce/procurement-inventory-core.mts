/** Additive reconciliation only: never replace or delete an original purchase receipt. */
export function recordSupplierReceiptEvent(k:CommerceKernel,command:Row,result:Row){
 // Keep the original receipt throughout supplier event recording.
 const event=result.event;if(!event||event.event_id!==command.event_id||event.receipt_id!==command.receipt_id||event.operation_id!==command.operation_id||event.source_identity!==command.source_identity)throw new Error('SUPPLIER_EVENT_RESULT_MISMATCH');
 const prior=k.db.prepare('SELECT * FROM commerce_supplier_receipt_events WHERE tenant_id=? AND store_id=? AND event_id=?').get(command.tenant_id,command.store_id,event.event_id) as Row|undefined;if(prior){if(!same(stockBody(prior),event))throw new Error('SUPPLIER_EVENT_INTEGRITY');return;}
 k.db.prepare('INSERT INTO commerce_supplier_receipt_events VALUES(?,?,?,?,?,?,?,?,?,?)').run(command.tenant_id,command.store_id,command.resource_id,event.event_id,event.receipt_id,command.operation_id,command.source_identity,command.kind,canonical(event),contentDigest(event));
}

