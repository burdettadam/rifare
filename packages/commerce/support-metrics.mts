import type {CommerceKernel,Scope,Row} from './kernel.mts';
import {id,integer,exact} from './kernel.mts';
import {jsonValue,contentDigest,canonical} from './configuration-values.mts';
import {supportCase,saveDocument,documentRow} from './support-core.mts';
const DAY=86400000;
function signed(x:unknown){if(typeof x!=='string'||! /^-?(0|[1-9][0-9]{0,20})$/.test(x)||x==='-0')throw new Error('METRIC_MONEY_INVALID');return BigInt(x);}
function checkedBody(r:Row){const b=JSON.parse(r.body);if(contentDigest(b)!==r.digest)throw new Error('METRIC_RECEIPT_INTEGRITY');return b;}
export class SupportMetrics {
 readonly k:CommerceKernel;constructor(k:CommerceKernel){this.k=k;}
 freeze(scope:Scope,input:unknown){const p=exact(jsonValue(input),['id','case_ids','starts_at','ends_at']);id(p.id);integer(p.starts_at);integer(p.ends_at);if(p.starts_at<this.k.clock()||p.ends_at<=p.starts_at||p.ends_at-p.starts_at>30*DAY||!Array.isArray(p.case_ids)||!p.case_ids.length||p.case_ids.length>500||new Set(p.case_ids).size!==p.case_ids.length)throw new Error('METRIC_COHORT_INVALID');p.case_ids.forEach(id);
  return this.k.transaction(()=>{const s=this.k.authorize(scope,'support.analytics'),members=p.case_ids.map((caseId:string)=>{const {c}=supportCase(this.k,scope,caseId);return {case_id:caseId,resource_id:c.resource_id,configuration_digest:c.configuration_digest};});return saveDocument(this.k,s,'metric_cohorts',p.id,0,{...p,members},'active');});}
 close(scope:Scope,input:unknown){const p=exact(jsonValue(input),['case_id','event_id']);id(p.event_id);return this.k.transaction(()=>{const {s,c}=supportCase(this.k,scope,p.case_id,'support.reply');return this.#completion(s,c,p.event_id,'ticket_closed',{meaning:'operator_closure_not_resolution'});});}
 confirm(scope:Scope,input:unknown){const p=exact(jsonValue(input),['case_id','event_id','attempt_id']);id(p.event_id);id(p.attempt_id);return this.k.transaction(()=>{const {s,c}=supportCase(this.k,scope,p.case_id);if(s.role!=='customer'||s.resource_id!==c.resource_id)throw new Error('CUSTOMER_VERIFICATION_REQUIRED');const r=this.k.db.prepare('SELECT * FROM commerce_support_attempts WHERE tenant_id=? AND store_id=? AND id=? AND case_id=? AND erased=0').get(s.tenant_id,s.store_id,p.attempt_id,c.id) as Row;
  if(!r||checkedBody(r).result.status!=='answered')throw new Error('CONFIRMED_ANSWER_REQUIRED');return this.#completion(s,c,p.event_id,'customer_confirmed',{attempt_id:r.id,meaning:'customer_reported_support_resolution_not_financial_settlement'});});}
 #completion(s:Row,c:Row,event:string,kind:string,body:Row){return this.k.transaction(()=>{const b={...body,case_id:c.id,kind},hash=contentDigest(b),old=this.k.db.prepare('SELECT * FROM commerce_support_completions WHERE tenant_id=? AND store_id=? AND id=?').get(s.tenant_id,s.store_id,event) as Row;if(old){if(old.case_id!==c.id||old.digest!==hash)throw new Error('METRIC_EVENT_CONFLICT');return {id:event,kind,duplicate:true};}
  this.k.db.prepare('INSERT INTO commerce_support_completions VALUES(?,?,?,?,?,?,?,?,?)').run(s.tenant_id,s.store_id,event,c.id,c.resource_id,kind,canonical(b),hash,this.k.clock());return {id:event,kind,duplicate:false};});}
 cost(scope:Scope,input:unknown){const p=exact(jsonValue(input),['id','case_id','category','currency','amount_minor','source_ref','adjustment_of']);id(p.id);id(p.source_ref);if(p.adjustment_of!==null)id(p.adjustment_of);if(p.currency!=='USD'||!['retained_revenue','goods','shipping','platform_fees','operator_time'].includes(p.category))throw new Error('METRIC_COST_INVALID');if(p.amount_minor!==null)signed(p.amount_minor);
  return this.k.transaction(()=>{const {s,c}=supportCase(this.k,scope,p.case_id,'support.analytics'),hash=contentDigest(p),old=this.k.db.prepare('SELECT * FROM commerce_support_costs WHERE tenant_id=? AND store_id=? AND id=?').get(s.tenant_id,s.store_id,p.id) as Row;if(old){if(old.digest!==hash)throw new Error('METRIC_EVENT_CONFLICT');return {id:p.id,duplicate:true};}
   if(p.adjustment_of!==null){const original=this.k.db.prepare('SELECT * FROM commerce_support_costs WHERE tenant_id=? AND store_id=? AND id=?').get(s.tenant_id,s.store_id,p.adjustment_of) as Row;
    if(!original||original.case_id!==c.id||original.category!==p.category||original.currency!==p.currency||original.adjustment_of!==null||original.amount_minor===null||p.amount_minor===null)throw new Error('METRIC_ADJUSTMENT_INVALID');const previous=this.k.db.prepare('SELECT amount_minor FROM commerce_support_costs WHERE tenant_id=? AND store_id=? AND adjustment_of=?').all(s.tenant_id,s.store_id,p.adjustment_of) as Row[];
    if(previous.reduce((n,r)=>n+signed(r.amount_minor),signed(original.amount_minor))+signed(p.amount_minor)<0n)throw new Error('METRIC_ADJUSTMENT_INVALID');
   }else if(p.amount_minor!==null&&signed(p.amount_minor)<0n)throw new Error('METRIC_COST_INVALID');
   this.k.db.prepare('INSERT INTO commerce_support_costs VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)').run(s.tenant_id,s.store_id,p.id,c.id,c.resource_id,p.category,p.currency,p.amount_minor,p.source_ref,p.adjustment_of,canonical(p),hash,this.k.clock());return {id:p.id,duplicate:false,basis:'declared_operating_cost_not_provider_verified'};});}
 followup(scope:Scope,input:unknown){const p=exact(jsonValue(input),['case_id','through_at','expected_version','source_ref']);integer(p.through_at);integer(p.expected_version);id(p.source_ref);if(p.through_at>this.k.clock())throw new Error('METRIC_FOLLOWUP_INVALID');return this.k.transaction(()=>{const {s,c}=supportCase(this.k,scope,p.case_id,'support.analytics'),links=this.k.db.prepare('SELECT * FROM commerce_support_links WHERE tenant_id=? AND store_id=? AND case_id=? AND erased=0').all(s.tenant_id,s.store_id,c.id) as Row[];
  if(!links.length||links.some(l=>l.history!=='complete'))throw new Error('HISTORY_COVERAGE_INCOMPLETE');let old:Row|undefined;try{old=documentRow(this.k,s,'followup',c.id);}catch{}if(old&&p.through_at<old.body.through_at)throw new Error('METRIC_FOLLOWUP_INVALID');return saveDocument(this.k,s,'followup',c.id,p.expected_version,{...p,links:links.map(l=>({id:l.id,revision:l.source_revision}))});});}
 report(scope:Scope,cohortId:string){const s=this.k.authorize(scope,'support.analytics'),frozen=documentRow(this.k,s,'metric_cohorts',cohortId),p=frozen.body,now=this.k.clock();let correct=0,resolved=0,handed=0,closed=0,attempted=0,pending=0,redacted=0,mature=0,immature=0,missing=0,recontacts=0;const cases:Row[]=[];
  for(const member of p.members){try{supportCase(this.k,scope,member.case_id);}catch{redacted++;pending++;cases.push({case_id:member.case_id,state:'unavailable_still_in_denominator'});continue;}
   const attempts=(this.k.db.prepare('SELECT * FROM commerce_support_attempts WHERE tenant_id=? AND store_id=? AND case_id=? AND at>=? AND at<=? AND erased=0 ORDER BY at,id').all(s.tenant_id,s.store_id,member.case_id,p.starts_at,Math.min(now,p.ends_at)) as Row[]).map(r=>({...r,content:checkedBody(r)}));
   const completions=this.k.db.prepare('SELECT * FROM commerce_support_completions WHERE tenant_id=? AND store_id=? AND case_id=? AND at>=? AND at<=? ORDER BY at,id').all(s.tenant_id,s.store_id,member.case_id,p.starts_at,Math.min(now,p.ends_at)) as Row[];completions.forEach(checkedBody);
   const answered=attempts.some(r=>r.content.result.status==='answered'&&r.content.result.handling_correct_at_capture),handoff=attempts.some(r=>r.content.result.status==='handoff'),confirmation=completions.find(r=>r.kind==='customer_confirmed');if(attempts.length)attempted++;if(answered||handoff)correct++;if(handoff)handed++;if(completions.some(r=>r.kind==='ticket_closed'))closed++;if(confirmation)resolved++;else pending++;
   let followup='not_resolved';if(confirmation){const cutoff=confirmation.at+7*DAY;if(now<cutoff){immature++;followup='immature';}else{let coverage:Row|undefined;try{coverage=documentRow(this.k,s,'followup',member.case_id);}catch{}const currentLinks=this.k.db.prepare('SELECT id,source_revision,history FROM commerce_support_links WHERE tenant_id=? AND store_id=? AND case_id=? AND erased=0').all(s.tenant_id,s.store_id,member.case_id) as Row[];
     const covered=coverage&&coverage.body.through_at>=cutoff&&currentLinks.length===coverage.body.links.length&&currentLinks.every(l=>l.history==='complete'&&coverage!.body.links.some((r:Row)=>r.id===l.id&&r.revision===l.source_revision));if(!covered){missing++;followup='missing';}else{mature++;followup='observed';const inbound=this.k.db.prepare("SELECT 1 FROM commerce_support_messages WHERE tenant_id=? AND store_id=? AND case_id=? AND direction='incoming' AND source_at>? AND source_at<=? AND erased=0 LIMIT 1").get(s.tenant_id,s.store_id,member.case_id,confirmation.at,cutoff);if(inbound)recontacts++;}}}
   const financial=this.k.db.prepare('SELECT id,kind,state,amount_minor,currency FROM commerce_resolution_operations WHERE tenant_id=? AND store_id=? AND case_id=?').all(s.tenant_id,s.store_id,member.case_id) as Row[];
   const costs=this.k.db.prepare('SELECT * FROM commerce_support_costs WHERE tenant_id=? AND store_id=? AND case_id=? AND at<=?').all(s.tenant_id,s.store_id,member.case_id,now) as Row[];costs.forEach(checkedBody);const required=['retained_revenue','goods','shipping','platform_fees','operator_time'],known=required.every(cat=>costs.some(r=>r.category===cat))&&costs.every(r=>r.amount_minor!==null);
   const contribution=known?costs.reduce((n,r)=>n+(r.category==='retained_revenue'?1n:-1n)*signed(r.amount_minor),0n).toString():null;
   cases.push({case_id:member.case_id,answered,handoff,customer_confirmed:!!confirmation,followup,financial_observations:financial,declared_contribution_minor:contribution,missing_cost_categories:required.filter(cat=>!costs.some(r=>r.category===cat)),declared_costs_verified:false,late_cost_adjustments:costs.filter(r=>r.adjustment_of!==null).length});
  }
  return {cohort_id:cohortId,cohort_digest:frozen.digest,denominator:p.members.length,attempted_cases:attempted,correct_handling:correct,required_or_requested_handoffs:handed,customer_confirmed_resolutions:resolved,ticket_closures:closed,pending_cases:pending,unavailable_cases:redacted,autonomous_financial_resolutions:0,correct_handling_rate:correct/p.members.length,resolution_rate:resolved/p.members.length,repeat_contact:{mature,immature,missing_followup:missing,recontacts,rate:missing||!mature?null:recontacts/mature},cases,receipt_state_not_ticket_state:true,production_qualified:false};
 }
}
