import { exact,id,integer } from './kernel.mts';
import type { CommerceKernel,Row,Scope } from './kernel.mts';
import { canonical,contentDigest,jsonValue } from './configuration-values.mts';
import { assertExecution } from './execution-stops.mts';

type Rational={n:bigint;d:bigint};
const LIMIT=1000000000n;
function gcd(a:bigint,b:bigint):bigint{return b===0n?a:gcd(b,a%b);}
function ratio(n:number|bigint,d:number|bigint=1):Rational{const a=BigInt(n),b=BigInt(d);if(a<0n||b<=0n)throw new Error('BOM_QUANTITY_INVALID');const g=gcd(a,b);return {n:a/g,d:b/g};}
function multiply(a:Rational,b:Rational){return ratio(a.n*b.n,a.d*b.d);}
function divide(a:Rational,b:Rational){if(b.n===0n)throw new Error('BOM_YIELD_INVALID');return ratio(a.n*b.d,a.d*b.n);}
function add(a:Rational,b:Rational){return ratio(a.n*b.d+b.n*a.d,a.d*b.d);}
function decimal(value:unknown){if(typeof value!=='string'||!/^\d{1,9}(?:\.\d{1,6})?$/.test(value))throw new Error('BOM_QUANTITY_INVALID');const [whole,fraction='']=value.split('.'),r=ratio(BigInt(whole+fraction),10n**BigInt(fraction.length));if(r.n===0n)throw new Error('BOM_QUANTITY_INVALID');return r;}
const units:Record<string,{dimension:string;factor:number}>={each:{dimension:'count',factor:1},dozen:{dimension:'count',factor:12},g:{dimension:'mass',factor:1},kg:{dimension:'mass',factor:1000},ml:{dimension:'volume',factor:1},l:{dimension:'volume',factor:1000}};
function quantity(value:unknown,unit:unknown,base:unknown){if(typeof unit!=='string'||typeof base!=='string'||!units[unit]||!['each','g','ml'].includes(base)||units[unit].dimension!==units[base].dimension)throw new Error('BOM_UNIT_DIMENSION');return multiply(decimal(value),ratio(units[unit].factor));}
function whole(value:Rational){if(value.n%value.d!==0n)throw new Error('BOM_FRACTIONAL_BASE_UNIT');const n=value.n/value.d;if(n<1n||n>LIMIT)throw new Error('BOM_QUANTITY_INVALID');return Number(n);}
function money(value:unknown){if(typeof value!=='string'||! /^(0|[1-9]\d{0,23})$/.test(value))throw new Error('BOM_COST_INVALID');return BigInt(value);}
function reference(value:unknown){const p=exact(value,['id','version','digest']);id(p.id);integer(p.version,1);if(typeof p.digest!=='string'||!/^[a-f0-9]{64}$/.test(p.digest))throw new Error('BOM_REFERENCE_INVALID');return p;}
function batches(required:Rational,output:Rational,yieldNumerator:number,yieldDenominator:number){
 return divide(required,multiply(output,ratio(yieldNumerator,yieldDenominator)));
}
function body(row:Row|undefined){if(!row)throw new Error('BOM_COMPONENT_NOT_FOUND');let b:Row;try{b=JSON.parse(row.body);}catch{throw new Error('BOM_INTEGRITY');}if(contentDigest(b)!==row.digest||b.redacted)throw new Error('BOM_INTEGRITY');for(const key of ['tenant_id','store_id','resource_id','id','version'])if(b[key]!==row[key])throw new Error('BOM_INTEGRITY');return b;}
function scope(k:CommerceKernel,s:Scope,resource:string,action='resource.read'){const actor=k.authorize(s,action,id(resource)),r=k.get(s,resource);if(r.kind!=='catalog'||r.customer_id!==null)throw new Error('MATERIAL_CATALOG_RESOURCE_REQUIRED');return actor;}

/** Exact, immutable material and BOM versions. Definitions have no stock effect. */
export class BillOfMaterials {
 readonly k:CommerceKernel;constructor(k:CommerceKernel){this.k=k;}
 #read(s:Scope,table:string,p:Row){const actor=this.k.require(s),row=this.k.db.prepare('SELECT * FROM '+table+' WHERE tenant_id=? AND store_id=? AND id=? AND version=?').get(actor.tenant_id,actor.store_id,p.id,p.version) as Row|undefined,b=body(row);scope(this.k,s,b.resource_id);if(row!.digest!==p.digest)throw new Error('BOM_REFERENCE_CHANGED');return {...b,digest:row!.digest};}
 material(scopeValue:Scope,input:unknown){const p=exact(jsonValue(input),['material_id','expected_version','resource_id','variant_id','base_unit','currency_code','unit_cost_minor']);id(p.material_id);id(p.variant_id);integer(p.expected_version);if(!['each','g','ml'].includes(p.base_unit)||typeof p.currency_code!=='string'||!/^[A-Z]{3}$/.test(p.currency_code))throw new Error('MATERIAL_UNIT_INVALID');money(p.unit_cost_minor);
  return this.k.transaction(()=>{const s=scope(this.k,scopeValue,p.resource_id,'action.configure');assertExecution(this.k,s,'diagnostic.procurement.stock');const prior=this.k.db.prepare('SELECT max(version) version FROM commerce_material_items WHERE tenant_id=? AND store_id=? AND id=?').get(s.tenant_id,s.store_id,p.material_id) as Row;if((prior.version??0)!==p.expected_version)throw new Error('MATERIAL_VERSION_CHANGED');
   const b={tenant_id:s.tenant_id,store_id:s.store_id,resource_id:p.resource_id,id:p.material_id,version:p.expected_version+1,variant_id:p.variant_id,base_unit:p.base_unit,currency_code:p.currency_code,unit_cost_minor:p.unit_cost_minor,defined_by:s.actor_id,created_at:this.k.clock(),qualification:'synthetic_local_only'};
   this.k.db.prepare('INSERT INTO commerce_material_items VALUES(?,?,?,?,?,?,?)').run(s.tenant_id,s.store_id,p.resource_id,b.id,b.version,canonical(b),contentDigest(b));this.k.audit(scopeValue,'material_version_defined','allowed');return {...b,digest:contentDigest(b)};});
 }
 define(scopeValue:Scope,input:unknown){const p=exact(jsonValue(input),['bom_id','expected_version','output','yield_numerator','yield_denominator','components']);id(p.bom_id);integer(p.expected_version);exact(p.output,['material','quantity','unit']);reference(p.output.material);integer(p.yield_numerator,1);integer(p.yield_denominator,1);if(p.yield_numerator>p.yield_denominator||p.yield_denominator>1000000)throw new Error('BOM_YIELD_INVALID');if(!Array.isArray(p.components)||!p.components.length||p.components.length>64)throw new Error('BOM_COMPONENT_INVALID');
  return this.k.transaction(()=>{const output=this.#read(scopeValue,'commerce_material_items',p.output.material),s=scope(this.k,scopeValue,output.resource_id,'action.configure');assertExecution(this.k,s,'diagnostic.procurement.stock');whole(quantity(p.output.quantity,p.output.unit,output.base_unit));
   const visit=(ref:Row,path:string[],depth:number):void=>{if(depth>16||path.includes(ref.id)||ref.id===p.bom_id)throw new Error('BOM_CYCLE');const b=this.#read(scopeValue,'commerce_bom_versions',ref);for(const item of b.components)if(item.bom)visit(item.bom,[...path,ref.id],depth+1);};
   for(const component of p.components){exact(component,['quantity','unit','material','bom']);if((component.material===null)===(component.bom===null))throw new Error('BOM_COMPONENT_INVALID');let material:Row;
    if(component.material){reference(component.material);material=this.#read(scopeValue,'commerce_material_items',component.material);}else{reference(component.bom);visit(component.bom,[],0);const nested=this.#read(scopeValue,'commerce_bom_versions',component.bom);material=this.#read(scopeValue,'commerce_material_items',nested.output.material);}
    if(material.resource_id!==output.resource_id||material.currency_code!==output.currency_code)throw new Error('BOM_COMPONENT_SCOPE');quantity(component.quantity,component.unit,material.base_unit);
   }
   const prior=this.k.db.prepare('SELECT max(version) version FROM commerce_bom_versions WHERE tenant_id=? AND store_id=? AND id=?').get(s.tenant_id,s.store_id,p.bom_id) as Row;if((prior.version??0)!==p.expected_version)throw new Error('BOM_VERSION_CHANGED');const b={tenant_id:s.tenant_id,store_id:s.store_id,resource_id:output.resource_id,id:p.bom_id,version:p.expected_version+1,output:p.output,yield_numerator:p.yield_numerator,yield_denominator:p.yield_denominator,components:p.components,defined_by:s.actor_id,created_at:this.k.clock(),qualification:'synthetic_local_only'};
   this.k.db.prepare('INSERT INTO commerce_bom_versions VALUES(?,?,?,?,?,?,?)').run(s.tenant_id,s.store_id,b.resource_id,b.id,b.version,canonical(b),contentDigest(b));this.k.audit(scopeValue,'bom_version_defined','allowed');return {...b,digest:contentDigest(b)};});
 }
 read(scopeValue:Scope,input:unknown){const p=exact(jsonValue(input),['bom_id','version','expected_digest']);return this.#read(scopeValue,'commerce_bom_versions',reference({id:p.bom_id,version:p.version,digest:p.expected_digest}));}
 expand(scopeValue:Scope,input:unknown){const p=exact(jsonValue(input),['bom_id','version','expected_digest','quantity']);integer(p.quantity,1);if(p.quantity>Number(LIMIT))throw new Error('BOM_QUANTITY_INVALID');const bom=this.read(scopeValue,{bom_id:p.bom_id,version:p.version,expected_digest:p.expected_digest}),output=this.#read(scopeValue,'commerce_material_items',bom.output.material),materials=new Map<string,{material:Row;required:Rational}>(),refs=new Map<string,Row>();let count=0;
  const walk=(b:Row,required:Rational,path:string[])=>{if(path.includes(b.id)||path.length>16||++count>256)throw new Error('BOM_CYCLE_OR_EXPANSION_LIMIT');const out=this.#read(scopeValue,'commerce_material_items',b.output.material),factor=batches(required,quantity(b.output.quantity,b.output.unit,out.base_unit),b.yield_numerator,b.yield_denominator);refs.set(b.id+':'+b.version,{id:b.id,version:b.version,digest:b.digest});
   for(const component of b.components){if(component.material){const m=this.#read(scopeValue,'commerce_material_items',component.material),need=multiply(factor,quantity(component.quantity,component.unit,m.base_unit)),key=m.variant_id,prior=materials.get(key);if(prior&&(prior.material.id!==m.id||prior.material.digest!==m.digest))throw new Error('BOM_MATERIAL_VERSION_CONFLICT');materials.set(key,{material:m,required:prior?add(prior.required,need):need});}
    else{const child=this.#read(scopeValue,'commerce_bom_versions',component.bom),childOutput=this.#read(scopeValue,'commerce_material_items',child.output.material);walk(child,multiply(factor,quantity(component.quantity,component.unit,childOutput.base_unit)),[...path,b.id]);}
   }
  };walk(bom,ratio(p.quantity),[]);const expanded=[...materials.values()].map(({material:m,required})=>{const q=whole(required);if(m.currency_code!==output.currency_code)throw new Error('BOM_CURRENCY_MISMATCH');return {material_id:m.id,material_version:m.version,material_digest:m.digest,resource_id:m.resource_id,variant_id:m.variant_id,base_unit:m.base_unit,quantity:q,currency_code:m.currency_code,unit_cost_minor:m.unit_cost_minor,total_minor:(BigInt(q)*money(m.unit_cost_minor)).toString()};}).sort((a,b)=>a.variant_id.localeCompare(b.variant_id));
  const gross=whole(divide(ratio(p.quantity),ratio(bom.yield_numerator,bom.yield_denominator))),total=expanded.reduce((sum,m)=>sum+BigInt(m.total_minor),0n);money(total.toString());if(total%BigInt(gross)!==0n)throw new Error('PRODUCTION_COST_ALLOCATION_REQUIRED');
  return {bom_id:bom.id,bom_version:bom.version,bom_digest:bom.digest,resource_id:bom.resource_id,quantity:p.quantity,gross_quantity:gross,expected_scrap:gross-p.quantity,output_material:{id:output.id,version:output.version,digest:output.digest,variant_id:output.variant_id,base_unit:output.base_unit},materials:expanded,currency_code:output.currency_code,total_cost_minor:total.toString(),unit_output_cost_minor:(total/BigInt(gross)).toString(),bom_refs:[...refs.values()].sort((a,b)=>a.id.localeCompare(b.id)),quantity_rounding:'reject_fractional_base_units',cost_allocation:'exact_per_gross_output_unit',qualification:'synthetic_local_only',physical_effect:false};
 }
}
