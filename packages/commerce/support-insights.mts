import type {CommerceKernel,Scope,Row} from './kernel.mts';
import {id,exact} from './kernel.mts';
import {jsonValue,contentDigest} from './configuration-values.mts';
import {supportCase,saveDocument,documentRow} from './support-core.mts';
const WORDS:Readonly<Record<string,RegExp>>=Object.freeze({fit:/\b(fit|size|small|large|tight|loose)\b/i,damage:/\b(broken|damaged|cracked|torn)\b/i,delivery:/\b(late|delivery|delay|missing)\b/i,quality:/\b(quality|fabric|material|stitch)\b/i});
export function sanitizedSignals(note:unknown){if(typeof note!=='string'||Buffer.byteLength(note)>2000)throw new Error('INSIGHT_INPUT_INVALID');return Object.keys(WORDS).filter(k=>WORDS[k].test(note));}
export class SupportInsights {
 readonly k:CommerceKernel;constructor(k:CommerceKernel){this.k=k;}
 analyze(scope:Scope,input:unknown){const p=exact(jsonValue(input),['request_ids']);if(!Array.isArray(p.request_ids)||!p.request_ids.length||p.request_ids.length>500||new Set(p.request_ids).size!==p.request_ids.length)throw new Error('INSIGHT_COHORT_INVALID');p.request_ids.forEach(id);const s=this.k.authorize(scope,'support.analytics'),groups=new Map<string,Row>(),sources:Row[]=[];
  for(const ref of p.request_ids){const r=this.k.db.prepare('SELECT * FROM commerce_return_requests WHERE tenant_id=? AND store_id=? AND id=?').get(s.tenant_id,s.store_id,ref) as Row;if(!r)throw new Error('NOT_FOUND');const {c}=supportCase(this.k,scope,r.case_id,'return.read'),b=JSON.parse(r.body);if(contentDigest(b)!==r.digest||!Array.isArray(b.selection?.lines))throw new Error('INSIGHT_SOURCE_UNAVAILABLE');
   const signals=sanitizedSignals(b.selection.note),reason=b.selection.reason;if(typeof reason!=='string'||!/^[a-z_]{1,40}$/.test(reason))throw new Error('INSIGHT_SOURCE_UNAVAILABLE');
   sources.push({request_id:r.id,digest:r.digest,order_revision:c.order.source_version,case_id:c.id});for(const line of b.selection.lines){const native=c.order.payload.resolution_facts?.paid_lines?.find((l:Row)=>l.id===line.line_id),sku=typeof native?.sku==='string'&&/^[A-Za-z0-9_-]{1,96}$/.test(native.sku)?native.sku:null,key=JSON.stringify([line.line_id,sku,reason]),g=groups.get(key)??{line_id:line.line_id,sku,reason,quantity:0,requests:new Set<string>(),signals:new Set<string>()};g.quantity+=line.quantity;g.requests.add(r.id);for(const signal of signals)g.signals.add(signal);groups.set(key,g);}}
  const rows=[...groups.values()].map(g=>({line_id:g.line_id,sku:g.sku,reason:g.reason,returned_units:g.quantity,request_count:g.requests.size,sample_size:p.request_ids.length,sanitized_signals:[...g.signals].sort(),confidence:g.requests.size<20?'insufficient_sample':'descriptive_only_no_causation'})).sort((a,b)=>a.line_id.localeCompare(b.line_id)||a.reason.localeCompare(b.reason));
  return {sample_size:p.request_ids.length,groups:rows,sources,source_digest:contentDigest(sources),raw_text_included:false,model_input_sent:false,scope:'selected_returns_not_all_purchases',bias_warning:'Return-only selection and user-selected reasons do not establish prevalence or causation.',recommendations_status:'draft_only',execution_authorized:false};
 }
 draft(scope:Scope,input:unknown){const p=exact(jsonValue(input),['id','expected_version','request_ids','source_digest']);id(p.id);return this.k.transaction(()=>{const s=this.k.authorize(scope,'support.analytics'),analysis=this.analyze(scope,{request_ids:p.request_ids});if(analysis.source_digest!==p.source_digest)throw new Error('INSIGHT_SOURCE_CHANGED');const recommendations=analysis.groups.map(g=>({line_id:g.line_id,sku:g.sku,reason:g.reason,proposal:g.confidence==='insufficient_sample'?'Collect more representative evidence before changing the product or policy.':'Review the cited return cohort alongside purchase volume and other customer evidence.',sample_size:g.request_count,policy_change_authorized:false}));return saveDocument(this.k,s,'insight_drafts',p.id,p.expected_version,{analysis,recommendations,activation:'requires_separate_policy_workflow'},'draft');});}
 read(scope:Scope,ref:string){const s=this.k.authorize(scope,'support.analytics'),r=documentRow(this.k,s,'insight_drafts',ref);if(r.state!=='draft')throw new Error('INSIGHT_SOURCE_UNAVAILABLE');for(const source of r.body.analysis.sources)supportCase(this.k,scope,source.case_id,'return.read');const current=this.analyze(scope,{request_ids:r.body.analysis.sources.map((s:Row)=>s.request_id)});if(current.source_digest!==r.body.analysis.source_digest)throw new Error('INSIGHT_SOURCE_CHANGED');return r;}
}
