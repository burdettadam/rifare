{
  "schema_version": 1,
  "id": "rifare-commerce-journeys-v1",
  "qualification": "synthetic_local_composition_only",
  "document_kind": "commerce_journey",
  "methods": ["open", "context", "attach", "prepare", "execute", "reconcile", "forget"],
  "common_input": ["case_id", "link_id", "expected_generation"],
  "mutations_require": ["current_customer_proof", "current_owner_generation", "exact_journey_version", "new_request_id"],
  "raw_native_responses_require": ["current_operation_read", "unchanged_native_action_permission"],
  "intents": ["tracking", "return", "exchange", "edit", "shopping", "followup", "handoff"],
  "references": ["preview", "approval", "receipt", "return_request", "fulfillment", "resolution", "edit", "cart", "delivery"],
  "reference_fields": ["kind", "id", "digest"],
  "digest_exceptions": {"approval": "original_preview_digest", "cart": "original_cart_preview_digest"},
  "input_bytes_max": 32768,
  "intents_max": 10,
  "references_max": 32,
  "retained_rows_max": 10000,
  "unresolved_scan_rows_max_per_family": 100,
  "unresolved_families": ["generic", "native_return", "resolution", "fulfillment", "edit", "cart"],
  "statuses": ["missing", "active", "forgotten", "restored", "unavailable"],
  "preparation_excludes": ["diagnostic.return.submit"],
  "pending_intake_owner": "ReturnIntake",
  "approval_owner": "ActionGateway",
  "effect_owners": "unchanged native services",
  "restoration": "validate original and destination histories; revoke and minimize; never resume",
  "model_thread_required": false,
  "execution_authorized": false,
  "production_qualified": false,
  "remote_qualification": "missing"
}
