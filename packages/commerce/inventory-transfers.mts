import { exact,id,integer,token } from './kernel.mts';
import type { CommerceKernel,Row,Scope } from './kernel.mts';
import { canonical,contentDigest,jsonValue } from './configuration-values.mts';
import { permissionDecision } from './authorization.mts';
import { assertExecution } from './execution-stops.mts';
import { assertRecoveryEgress } from './data-guards.mts';
import { LocationInventory,assertInventorySource,inventoryRow,INVENTORY_FIELDS } from './location-inventory.mts';
import { WarehouseInventoryFixtureSource,inventoryTransferState,nextInventoryTransfer } from '../adapters/warehouse-inventory-fixture-source.mts';

// Transfers use the existing named warehouse-disposition stop and recovery boundary.
export const INVENTORY_TRANSFER_ACTION='diagnostic.warehouse.disposition';
const same=(a:unknown,b:unknown)=>canonical(a)===canonical(b);
const stock=(value:Row)=>Object.fromEntries(INVENTORY_FIELDS.map(field=>[field,value[field]]));
function resourceDigest(r:Row){return contentDigest({id:r.id,kind:r.kind,source_system:r.source_system,external_id:r.external_id,source_version:r.source_version,source_updated_at:r.source_updated_at,payload:r.payload});}
function resultBody(input:unknown){const b=exact(jsonValue(input),['version','operation_id','source_identity','tenant_id','store_id','resource_id','command_digest','command','state','transfer','movements','qualification','digest']),hash=b.digest;delete b.digest;if(contentDigest(b)!==hash||b.state!=='applied'||b.qualification!=='synthetic_only'||b.version!==1)throw new Error('TRANSFER_RESULT_INTEGRITY');return {...b,digest:hash};}

/** Independently approved commands. Unknown outcomes permit lookup of the original identity only. */
export class InventoryTransfers {
  readonly kernel:CommerceKernel;readonly inventory:LocationInventory;readonly source:WarehouseInventoryFixtureSource;readonly deadlineMs:number;
  constructor(k:CommerceKernel,inventory:LocationInventory,source:WarehouseInventoryFixtureSource,options:{deadline_ms?:number}={}){
    if(!(inventory instanceof LocationInventory)||inventory.kernel!==k||inventory.source!==source||Object.keys(options).some(key=>key!=='deadline_ms'))throw new Error('INVENTORY_SERVICE_MISMATCH');assertInventorySource(k,source);this.deadlineMs=integer(options.deadline_ms??1000,5);if(this.deadlineMs>30000)throw new Error('INVALID_INPUT');this.kernel=k;this.inventory=inventory;this.source=source;
  }
  #scope(scope:Scope){const s=this.kernel.require(scope);assertInventorySource(this.kernel,this.source,s);return s;}
  #transfer(scope:Scope,ref:string,action='operation.read',optional=false):Row|null {const k=this.kernel,s=this.#scope(scope),row=k.db.prepare('SELECT * FROM commerce_inventory_transfers WHERE tenant_id=? AND store_id=? AND transfer_id=?').get(s.tenant_id,s.store_id,id(ref)) as Row;
    if(!row){if(optional)return null;throw new Error('NOT_FOUND');}k.authorize(scope,action,row.resource_id);k.get(scope,row.resource_id);const b=inventoryRow(row);
    if(b.source_identity!==this.source.identity)throw new Error('SOURCE_IDENTITY_CHANGED');for(const field of ['tenant_id','store_id','resource_id','transfer_id','source_identity'])if(b.transfer[field]!==b[field])throw new Error('TRANSFER_INTEGRITY');return b;
  }
  #operation(scope:Scope,ref:string,action='operation.read',optional=false):Row|null {const k=this.kernel,s=this.#scope(scope),row=k.db.prepare('SELECT * FROM commerce_inventory_transfer_operations WHERE tenant_id=? AND store_id=? AND operation_id=?').get(s.tenant_id,s.store_id,id(ref)) as Row;
    if(!row){if(optional)return null;throw new Error('NOT_FOUND');}k.authorize(scope,action,row.resource_id);k.get(scope,row.resource_id);const b=inventoryRow(row),transfer=this.#transfer(scope,row.transfer_id)!,c=b.command;
    if(b.source_identity!==this.source.identity||c.source_identity!==this.source.identity)throw new Error('SOURCE_IDENTITY_CHANGED');if(contentDigest(c)!==b.command_digest)throw new Error('TRANSFER_INTEGRITY');
    for(const field of ['tenant_id','store_id','resource_id','transfer_id','operation_id'])if(c[field]!==b[field])throw new Error('TRANSFER_INTEGRITY');for(const field of ['source_identity','tenant_id','store_id','resource_id','transfer_id','variant_id','from_location','to_location'])if(c[field]!==transfer.transfer[field])throw new Error('TRANSFER_INTEGRITY');if(c.transfer_quantity!==transfer.transfer.quantity)throw new Error('TRANSFER_INTEGRITY');return b;
  }
  #saveTransfer(body:Row){this.kernel.db.prepare('UPDATE commerce_inventory_transfers SET body=?,digest=? WHERE tenant_id=? AND store_id=? AND transfer_id=?').run(canonical(body),contentDigest(body),body.tenant_id,body.store_id,body.transfer_id);}
  #saveOperation(body:Row){this.kernel.db.prepare('UPDATE commerce_inventory_transfer_operations SET body=?,digest=? WHERE tenant_id=? AND store_id=? AND operation_id=?').run(canonical(body),contentDigest(body),body.tenant_id,body.store_id,body.operation_id);}
  #positions(t:Row){return {from:this.source.position({variant_id:t.variant_id,location_id:t.from_location}),to:this.source.position({variant_id:t.variant_id,location_id:t.to_location})};}
  #ledgerCurrent(scope:Scope,t:Row){const positions=this.#positions(t);for(const [key,location] of [['from',t.from_location],['to',t.to_location]]){const balance=this.inventory.balance(scope,{resource_id:t.resource_id,variant_id:t.variant_id,location_id:location});if(!balance.anchored||!same(stock(balance),positions[key]))throw new Error('INVENTORY_RECONCILIATION_REQUIRED');}return positions;}
  plan(scope:Scope,input:unknown){const p=exact(jsonValue(input),['transfer_id','resource_id','variant_id','from_location','to_location','quantity']);for(const field of ['transfer_id','resource_id','variant_id','from_location','to_location'])id(p[field]);integer(p.quantity,1);if(p.quantity>1000000||p.from_location===p.to_location)throw new Error('INVALID_TRANSFER');
    return this.kernel.transaction(()=>{const k=this.kernel,s=this.#scope(scope);k.authorize(scope,'action.propose',p.resource_id);const resource=k.get(scope,p.resource_id);assertExecution(k,s,INVENTORY_TRANSFER_ACTION);const old=this.#transfer(scope,p.transfer_id,'action.propose',true);
      if(old){for(const field of ['resource_id','variant_id','from_location','to_location','quantity'])if(old.transfer[field]!==p[field])throw new Error('TRANSFER_CONFLICT');return this.read(scope,p.transfer_id);}
      const transfer=inventoryTransferState({...p,source_identity:this.source.identity,tenant_id:s.tenant_id,store_id:s.store_id,transfer_quantity:p.quantity});this.#ledgerCurrent(scope,transfer);
      const body={version:1,tenant_id:s.tenant_id,store_id:s.store_id,resource_id:p.resource_id,transfer_id:p.transfer_id,source_identity:this.source.identity,proposer:s.actor_id,resource_digest:resourceDigest(resource),transfer,qualification:'synthetic_only'};
      k.db.prepare('INSERT INTO commerce_inventory_transfers VALUES(?,?,?,?,?,?)').run(s.tenant_id,s.store_id,p.resource_id,p.transfer_id,canonical(body),contentDigest(body));k.audit(scope,'inventory_transfer_planned','allowed');return this.read(scope,p.transfer_id);});
  }
  propose(scope:Scope,transferId:string,input:unknown){const p=exact(jsonValue(input),['operation_id','kind','quantity','expected_revision']);id(p.operation_id);integer(p.quantity,1);integer(p.expected_revision,1);if(!['reserve','dispatch','receive','lose','correct_loss','release'].includes(p.kind))throw new Error('INVALID_TRANSFER_OPERATION');
    return this.kernel.transaction(()=>{const k=this.kernel,s=this.#scope(scope),body=this.#transfer(scope,transferId,'action.propose')!,t=body.transfer,old=this.#operation(scope,p.operation_id,'action.propose',true);
      if(old){if(old.transfer_id!==transferId||old.command.kind!==p.kind||old.command.quantity!==p.quantity||old.command.expected_revision!==p.expected_revision)throw new Error('OPERATION_CONFLICT');return this.#status(scope,p.operation_id);}
      if((k.db.prepare('SELECT body,digest FROM commerce_inventory_transfer_operations WHERE tenant_id=? AND store_id=? AND transfer_id=?').all(s.tenant_id,s.store_id,transferId) as Row[]).some(row=>{const b=JSON.parse(row.body);if(contentDigest(b)!==row.digest)throw new Error('TRANSFER_INTEGRITY');return ['proposed','unknown'].includes(b.state);}))throw new Error('TRANSFER_PENDING');
      if(t.revision!==p.expected_revision)throw new Error('TRANSFER_REVISION_CHANGED');if(body.resource_digest!==resourceDigest(k.get(scope,t.resource_id)))throw new Error('RESOURCE_CHANGED');const control=assertExecution(k,s,INVENTORY_TRANSFER_ACTION),positions=this.#ledgerCurrent(scope,t);
      const correction=p.kind==='correct_loss'?t.losses.find((loss:Row)=>loss.remaining>=p.quantity)?.operation_id??null:null;if(p.kind==='correct_loss'&&!correction)throw new Error('TRANSFER_QUANTITY_INVALID');
      const command={version:1,operation_id:p.operation_id,source_identity:this.source.identity,tenant_id:s.tenant_id,store_id:s.store_id,resource_id:t.resource_id,transfer_id:t.transfer_id,variant_id:t.variant_id,from_location:t.from_location,to_location:t.to_location,transfer_quantity:t.quantity,expected_revision:t.revision,kind:p.kind,quantity:p.quantity,correction_of:correction,expected_positions:positions};nextInventoryTransfer(t,command);
      const op={version:1,tenant_id:s.tenant_id,store_id:s.store_id,resource_id:t.resource_id,transfer_id:t.transfer_id,operation_id:p.operation_id,source_identity:this.source.identity,command,command_digest:contentDigest(command),resource_digest:body.resource_digest,control_stamp:control.stamp,proposer:s.actor_id,state:'proposed',approval_id:null,receipt:null,created_at:k.clock()};
      k.db.prepare('INSERT INTO commerce_inventory_transfer_operations VALUES(?,?,?,?,?,?,?)').run(s.tenant_id,s.store_id,t.resource_id,t.transfer_id,p.operation_id,canonical(op),contentDigest(op));k.audit(scope,'inventory_transfer_proposed','allowed');return this.#status(scope,p.operation_id);});
  }
  approve(scope:Scope,operationId:string,input:unknown){const p=exact(jsonValue(input),['expected_digest','expires_at']);integer(p.expires_at);return this.kernel.transaction(()=>{const k=this.kernel,op=this.#operation(scope,operationId,'action.approve')!,s=k.authorize(scope,'action.approve',op.resource_id);
      if(!['owner','reviewer'].includes(s.role))throw new Error('HUMAN_REVIEWER_REQUIRED');if(s.actor_id===op.proposer)throw new Error('SELF_APPROVAL_DENIED');if(op.state!=='proposed'||p.expected_digest!==op.command_digest)throw new Error('PROPOSAL_CHANGED');if(p.expires_at<=k.clock()||p.expires_at>k.clock()+300000)throw new Error('APPROVAL_EXPIRY_INVALID');assertExecution(k,s,INVENTORY_TRANSFER_ACTION,op.control_stamp);
      if(op.approval_id)k.db.prepare('UPDATE commerce_inventory_transfer_approvals SET revoked=1 WHERE tenant_id=? AND store_id=? AND id=?').run(s.tenant_id,s.store_id,op.approval_id);
      const approval={id:'inventory_approval_'+token().slice(0,32),tenant_id:s.tenant_id,store_id:s.store_id,resource_id:op.resource_id,operation_id:op.operation_id,command_digest:op.command_digest,approver:s.actor_id,authority_revision:permissionDecision(k.db,s,'action.approve',op.resource_id).authority_revision,expires_at:p.expires_at,control_stamp:op.control_stamp,used:false};
      k.db.prepare('INSERT INTO commerce_inventory_transfer_approvals VALUES(?,?,?,?,?,?,?,0)').run(s.tenant_id,s.store_id,op.resource_id,op.operation_id,approval.id,canonical(approval),contentDigest(approval));op.approval_id=approval.id;this.#saveOperation(op);k.audit(scope,'inventory_transfer_approved','allowed');return {id:approval.id,operation_id:operationId,command_digest:op.command_digest,expires_at:approval.expires_at,physical_effect:false};});
  }
  #approval(op:Row,used=false){const k=this.kernel,row=op.approval_id&&k.db.prepare('SELECT * FROM commerce_inventory_transfer_approvals WHERE tenant_id=? AND store_id=? AND id=?').get(op.tenant_id,op.store_id,op.approval_id) as Row;if(!row)throw new Error('APPROVAL_REQUIRED');const b=inventoryRow(row),member=k.db.prepare('SELECT * FROM commerce_members WHERE tenant_id=? AND store_id=? AND actor_id=? AND active=1').get(op.tenant_id,op.store_id,b.approver) as Row,decision=member&&permissionDecision(k.db,member,'action.approve',op.resource_id);
    if(row.revoked||b.used!==used||b.expires_at<=k.clock()||b.command_digest!==op.command_digest||b.operation_id!==op.operation_id||b.approver===op.proposer||b.control_stamp!==op.control_stamp||!member||!['owner','reviewer'].includes(member.role)||!decision?.allowed||decision.authority_revision!==b.authority_revision)throw new Error('APPROVAL_AUTHORITY_CHANGED');return b;
  }
  #before(scope:Scope,ref:string,used=false){const k=this.kernel,op=this.#operation(scope,ref,'operation.dispatch')!,s=this.#scope(scope),t=this.#transfer(scope,op.transfer_id)!.transfer;k.authorize(scope,'action.execute',op.resource_id);const approval=this.#approval(op,used);
    assertExecution(k,s,INVENTORY_TRANSFER_ACTION,op.control_stamp);assertRecoveryEgress(k);if(resourceDigest(k.get(scope,op.resource_id))!==op.resource_digest)throw new Error('RESOURCE_CHANGED');if(t.revision!==op.command.expected_revision)throw new Error('TRANSFER_REVISION_CHANGED');if(!same(this.#positions(t),op.command.expected_positions))throw new Error('TRANSFER_SOURCE_CHANGED');this.#ledgerCurrent(scope,t);nextInventoryTransfer(t,op.command);return {op,approval};
  }
  #status(scope:Scope,ref:string){const op=this.#operation(scope,ref)!;return {operation_id:ref,transfer_id:op.transfer_id,state:op.state,command:op.command,command_digest:op.command_digest,approval_id:op.approval_id,receipt:op.receipt,retry_allowed:false,qualification:'synthetic_only',physical_qualified:false};}
  #expectedMovements(c:Row){const q=c.quantity,from={available:0,on_hand:0,reserved:0,in_transit:0},to={...from};
    if(c.kind==='reserve'){from.available=-q;from.reserved=q;}if(c.kind==='release'){from.available=q;from.reserved=-q;}if(c.kind==='dispatch'){from.on_hand=-q;from.reserved=-q;from.in_transit=q;}
    if(c.kind==='receive'){from.in_transit=-q;to.available=q;to.on_hand=q;}if(c.kind==='lose')from.in_transit=-q;if(c.kind==='correct_loss'){to.available=q;to.on_hand=q;}
    return [[c.from_location,from],[c.to_location,to]].filter(([,delta])=>INVENTORY_FIELDS.some(field=>(delta as Row)[field]!==0)).map(([location,delta])=>({location_id:location,delta}));
  }
  #record(scope:Scope,ref:string,input:unknown){const k=this.kernel,op=this.#operation(scope,ref,'operation.reconcile')!,result=resultBody(input),c=op.command;
    if(result.operation_id!==ref||result.source_identity!==this.source.identity||result.tenant_id!==op.tenant_id||result.store_id!==op.store_id||result.resource_id!==op.resource_id||result.command_digest!==op.command_digest||!same(result.command,c))throw new Error('TRANSFER_RESULT_MISMATCH');
    if(op.state==='applied'){if(result.digest!==op.receipt?.digest)throw new Error('TRANSFER_RESULT_MISMATCH');return;}if(op.state!=='unknown')throw new Error('TRANSFER_NOT_SENT');const parent=this.#transfer(scope,op.transfer_id)!,t=parent.transfer;if(t.revision!==c.expected_revision||!same(result.transfer,nextInventoryTransfer(t,c)))throw new Error('TRANSFER_RESULT_MISMATCH');
    const expected=this.#expectedMovements(c);if(!Array.isArray(result.movements)||result.movements.length!==expected.length||new Set(result.movements.map((m:Row)=>m.movement_id)).size!==result.movements.length)throw new Error('TRANSFER_RESULT_MISMATCH');
    for(const [index,movement] of result.movements.entries()){const b={...movement};delete b.digest;const native=this.source.movement(movement.movement_id),e=expected[index];if(contentDigest(b)!==movement.digest||!native||native.digest!==movement.digest||movement.source_identity!==this.source.identity||movement.resource_id!==op.resource_id||movement.variant_id!==c.variant_id||movement.location_id!==e.location_id||movement.kind!==c.kind||!same(movement.delta,e.delta)||movement.reference_id!==ref||movement.origin.kind!=='transfer'||movement.origin.id!==ref)throw new Error('TRANSFER_RESULT_MISMATCH');this.inventory.importMovement(scope,movement.movement_id);}
    parent.transfer=result.transfer;this.#saveTransfer(parent);op.state='applied';op.receipt=result;this.#saveOperation(op);k.audit(scope,'inventory_transfer_observed','allowed');
  }
  async #bounded<T>(call:()=>Promise<T>){let timer:ReturnType<typeof setTimeout>|undefined;try{return await Promise.race([Promise.resolve().then(call),new Promise<never>((_,reject)=>{timer=setTimeout(()=>reject(new Error('WAREHOUSE_TIMEOUT')),this.deadlineMs);})]);}finally{if(timer)clearTimeout(timer);}}
  async dispatch(scope:Scope,operationId:string){const k=this.kernel,ready=k.transaction(()=>{const old=this.#operation(scope,operationId,'operation.dispatch')!;if(old.state!=='proposed')return false;const {op,approval}=this.#before(scope,operationId);approval.used=true;k.db.prepare('UPDATE commerce_inventory_transfer_approvals SET body=?,digest=? WHERE tenant_id=? AND store_id=? AND id=?').run(canonical(approval),contentDigest(approval),op.tenant_id,op.store_id,approval.id);op.state='unknown';this.#saveOperation(op);k.audit(scope,'inventory_transfer_sent','allowed');return true;});
    if(ready)try{const result=await this.#bounded(()=>{const {op}=this.#before(scope,operationId,true);return this.source.apply(op.command);});k.transaction(()=>this.#record(scope,operationId,result));}catch{/* Keep the persisted original operation unknown; never recreate or resend it. */}return this.#status(scope,operationId);
  }
  async reconcile(scope:Scope,operationId:string){const op=this.#operation(scope,operationId,'operation.reconcile')!;if(op.state==='proposed')throw new Error('TRANSFER_NOT_SENT');let result:unknown;try{result=await this.#bounded(()=>this.source.lookup(operationId));}catch{return this.#status(scope,operationId);}if(result)this.kernel.transaction(()=>this.#record(scope,operationId,result));return this.#status(scope,operationId);}
  read(scope:Scope,transferId:string){const body=this.#transfer(scope,transferId)!,s=this.#scope(scope),operations=(this.kernel.db.prepare('SELECT operation_id FROM commerce_inventory_transfer_operations WHERE tenant_id=? AND store_id=? AND transfer_id=? ORDER BY operation_id').all(s.tenant_id,s.store_id,transferId) as Row[]).map(row=>this.#status(scope,row.operation_id));return {...body.transfer,operations,qualification:'synthetic_only',physical_qualified:false,formal_goal_accepted:false};}
}
